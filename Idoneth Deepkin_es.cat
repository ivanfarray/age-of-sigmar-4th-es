              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Puedes volver a tirar las tiradas de correr y de carga de las unidades amigas **^^Namarti^^** mientras estén totalmente a 12" o menos de una unidad amiga **^^Akhelian^^**.</characteristic>
              </characteristics>
