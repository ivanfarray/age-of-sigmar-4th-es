          <rules>
            <rule name="Restricciones de mejoras" id="8cbc-96b6-2caa-3ffb" hidden="true">
              <description>Los Compañeros del Mar Etérico son mejoras únicas que pueden otorgarse a unidades que no sean **^^Hero Idoneth de las Profundidades^^**. Una unidad solo puede tener 1 Ethersea Compañero.</description>
            </rule>
