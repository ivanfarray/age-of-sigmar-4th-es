              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="4db6-0301-ee0d-5b7b" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Incursor despiadado" hidden="false" id="5496-f193-b381-394e">
              <profiles>
                <profile name="Incursor despiadado" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="19f8-f915-31d5-4972">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está a 6" o menos de una unidad enemiga dañada, esta unidad puede moverse 6". Puede atravesar los alcances de combate de unidades enemigas, pero debe terminar ese movimiento en combate con una unidad enemiga dañada.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute typeId="2d74-4dcd-8468-87fa" name="Parent Node"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="fb6b-1435-4721-ed33" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Señor de la tormenta y el mar" hidden="false" id="7fdc-077d-7905-24f6">
              <profiles>
                <profile name="Señor de la tormenta y el mar" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="de85-b42e-65c0-639c">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una habilidad devuelva al menos 1 miniatura abatida a una unidad amiga totalmente a 12" o menos de esta unidad, después de resolver esa habilidad, puedes devolverle 1 miniatura abatida adicional.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
                    <attribute typeId="e2e1-15ca-d345-22b8" name="Parent Node"/>
                  </attributes>
                </profile>
