                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un marcador de objetivo a 18" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, las unidades enemigas que estén disputando el objetivo elegido no pueden usar habilidades **^^Correr^^**, **^^Retirarse^^** ni **^^Cargar^^**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Linaje maldito" id="f929-8e09-a699-af97" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9aca-60a3-5629-5792" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Linaje maldito" id="9509-14ba-a28f-9fb0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de tu turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un número de dados igual al **nivel de furia** de tu oponente. Por cada 3+, inflige 1 de daño mortal al objetivo.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Seguidor de Kir-Nadarr" id="9312-253d-33f3-15ab" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="172e-e548-1475-b868" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Seguidor de Kir-Nadarr" id="5184-cf50-543b-115c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Puedes gastar 1 **dado de ira**. Si lo haces:
• Aplica el efecto siguiente.
• Si el **nivel de furia** de tu oponente es inferior al tuyo, debe aumentar su **nivel de furia** en 1, hasta un máximo de 7.
En caso contrario, tira un dado. Con un 3+, aplica el efecto siguiente.
Durante el resto del turno, ignora los modificadores negativos a las tiradas de impacto y de herida de los ataques de combate de unidades amigas **^^Idoneth de las Profundidades^^** que tengan como objetivo a esa unidad enemiga.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
