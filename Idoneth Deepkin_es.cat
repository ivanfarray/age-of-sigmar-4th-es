            <selectionEntry type="upgrade" import="true" name="Sanguijuela dritch" hidden="false" id="28b7-bd66-911d-348e">
              <profiles>
                <profile name="Sanguijuela dritch" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="e5f2-76b5-1f9f-147">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de lanzamiento de los **^^Wizards^^** enemigos mientras estén a 18" o menos de esta unidad. Además, cada vez que un hechizo enemigo falle, después de resolver esa habilidad, **Heal (1)** esta unidad</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Yellow</attribute>
