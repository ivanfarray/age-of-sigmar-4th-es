          <selectionEntries>
            <selectionEntry name="Tormenta marina interminable" id="1356-963c-1229-9b9d" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4db6-0301-ee0d-5b7b" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Tormenta marina interminable" id="d1c4-56ab-6f30-00ff" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad es un **^^Wizard^^**, suma 1 a su nivel de poder durante el resto del turno. Si esta unidad no es un **^^Wizard^^**, gana **^^Wizard (1)^^** durante el resto del turno.
Además, suma 2 a la siguiente tirada de lanzamiento o tirada de destierro de esta unidad este turno.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Incursor despiadado" id="5496-f193-b381-394e" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fb6b-1435-4721-ed33" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Incursor despiadado" id="19f8-f915-31d5-4972" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está a 6" o menos de una unidad enemiga dañada, esta unidad puede moverse 6". Puede atravesar los alcances de combate de unidades enemigas, pero debe terminar ese movimiento en combate con una unidad enemiga dañada.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Señor de la tormenta y el mar" id="7fdc-077d-7905-24f6" hidden="false" import="true" type="upgrade">
