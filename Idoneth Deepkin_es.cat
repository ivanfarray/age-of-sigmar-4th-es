          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Morador abisal" hidden="false" id="ed84-bc2d-9950-1763">
              <profiles>
                <profile name="Morador abisal" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="833d-c45f-18dd-7233">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un marcador de objetivo a 18" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, mientras las unidades enemigas estén disputando el marcador de objetivo elegido como objetivo:
• Resta el número de la ronda de batalla actual a la característica de Move de esas unidades.
• Esas unidades no pueden usar habilidades de **^^Run^^**, **^^Retreat^^** o **^^Charge^^**</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
