          <profiles>
            <profile name="Sabiduría de las profundidades" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="f7d1-e7a5-a821-195c">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de lanzamiento, a las tiradas de ritual Isharann y a las tiradas de lurelight de las unidades amigas **^^Isharann^^** mientras estén dentro de los alcances de combate de cualquier otra unidad amiga **^^Isharann^^**</characteristic>
              </characteristics>
              <attributes>
                <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Yellow</attribute>
                <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Special</attribute>
                <attribute typeId="e2e1-15ca-d345-22b8" name="Parent Node"/>
