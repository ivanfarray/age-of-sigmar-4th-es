  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Los Jardineros de Nurgle" id="9fcb-a1b6-1285-3c7b" hidden="false" import="true" publicationId="9c71-86cb-e1d0-ec8d" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="02a2-4378-b001-e7be" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="El jardín crece" id="e6a2-d5ce-116a-38c4" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca un **Fauces retorcidas feculentas** en el campo de batalla a más de 3" de todas las unidades enemigas, marcadores de objetivo y demás elementos de escenografía.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Trasplantar" id="8679-bf6f-54a2-1c27" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **Fauces retorcidas feculentas** amigo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira el objetivo del campo de batalla y colócalo de nuevo a 3" o menos de un **^^Gardeners of Nurgle Hero^^** amigo y a más de 3" de todas las unidades enemigas, marcadores de objetivo y demás elementos de escenografía.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Jardinero jefe" id="defa-429a-ee54-b1de" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El **Horticulous Slimux** amigo puede usar su habilidad &apos;Cultivar el Jardín de Nurgle&apos; esta fase aunque haya 1 o más **Feculent Gnarlmaws** amigos en el campo de batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Savia putrescente" id="832e-29d4-5bb2-a786" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos todas las unidades enemigas a 3" o menos de cualquier **Fauces retorcidas feculentas** amigo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3 por cada objetivo. Con un 2+, inflige a ese objetivo una cantidad de daño mortal igual al resultado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Fauna inmunda" id="ee35-3f18-c21e-b32e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 2" a la característica de Move de las unidades amigas **^^Gardeners of Nurgle^^** **Bestias de Nurgle** y **Zánganos de plaga** mientras estén totalmente a 6" o menos de cualquier **Fauces retorcidas feculentas** amigo.</characteristic>
          </characteristics>
        </profile>
        <profile name="Esporas enfermizas" id="24e7-5fa3-e04f-bddd" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras una unidad amiga **^^Gardeners of Nurgle Infantry^^** esté totalmente a 12" o menos de un **Fauces retorcidas feculentas** amigo, ignora el primer punto de daño que se le asignaría en cada fase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
