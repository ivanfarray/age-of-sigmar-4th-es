  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Estampida del Zigurat" id="49f7-4682-f568-e225" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="6954-20c4-a0c0-4caa" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Que tiemblen los reinos" id="5fee-492f-2904-17d2" hidden="false" publicationId="487d-9798-0633-8040" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma **X** a las tiradas de carga de las unidades amigas **^^Ziggurat Stampede^^**, donde **X** es el número de unidades amigas **^^Ziggurat Stampede^^** que ya hayan cargado esta fase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Pasar por encima" id="7e18-aab9-8491-ccc9" hidden="false" publicationId="487d-9798-0633-8040" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Grey</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Special</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de movimiento</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga **^^Ziggurat Stampede^^** que esté en combate.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Durante el resto del turno:
• El objetivo puede usar habilidades **^^Disparar^^** y/o **^^Cargar^^** aunque haya usado una habilidad **^^Retirarse^^** en el mismo turno.
• Las habilidades **^^Retirarse^^** no infligen daño mortal al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="«Quebradlos a todos...»" id="836a-5836-aaf7-8fae" hidden="false" publicationId="487d-9798-0633-8040" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cualquier número de unidades amigas **^^Ziggurat Stampede^^** puede usar la orden &apos;Arrollar&apos; en el mismo turno.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
