        </profile>
        <profile name="Balas y proyectiles" id="b04f-7b84-08c8-1272" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad use una habilidad **^^Disparar^^**, si está en posición fortificada, elige las características de arma **Cannonball** o **Grapeshot** para todos los ataques que haga con su **Gran cañón**. Si no está en posición fortificada, usa las características de arma **Grapeshot**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fortificar la posición" id="1eb6-b202-9844-824e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
