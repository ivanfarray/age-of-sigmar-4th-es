          </characteristics>
        </profile>
        <profile name="¡Fusileros, fuego!" id="6bc5-d0d3-d93d-d77a" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad use una habilidad **^^Disparar^^**, si está en posición fortificada, puede elegir cualquiera de los perfiles de arma a distancia para todos los ataques que haga con sus **Fusil-cannons**. Si no está en posición fortificada, usa las características de arma **Mobile**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Escudero de pólvora negra" id="1269-79ff-bf08-d103" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad tiene un marcador **Escudero de pólvora negra**. Cada vez que esta unidad use una habilidad **^^Disparar^^**, si el **Escudero de pólvora negra** de esta unidad está en el campo de batalla, puedes volver a tirar 1 tirada de impacto. Si una tirada de impacto vuelta a tirar de esta forma es 1, retira el **Escudero de pólvora negra** de esta unidad del campo de batalla.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fortificar la posición" id="2f1b-3913-ffc8-da75" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad establece una posición fortificada y permanece en posición fortificada hasta que use una habilidad **^^Move^^** o sea retirada del campo de batalla. Mientras esta unidad esté en posición fortificada, resta 1 a la característica de Rend de las armas usadas en ataques que tengan como objetivo a esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Básica^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
