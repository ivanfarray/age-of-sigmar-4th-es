                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a cada tirada de dado al usar la habilidad &apos;Bastidores de bombas pesadas&apos;, &apos;Bastidores de bombas medianas&apos; o &apos;Bastidores de bombas ligeras&apos; de esta unidad.</characteristic>
