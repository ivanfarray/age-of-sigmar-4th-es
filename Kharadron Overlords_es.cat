            <selectionEntry name="Equipo de combate de energía etérea Karst-Bana" id="dc9b-c3a9-63ef-7166" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="25f1-9332-6221-b030" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Equipo de combate de energía etérea Karst-Bana" id="b54a-d273-6b45-2481" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
