  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Señores Supremos Kharadron" id="8b5f-e3cf-35c2-fa90" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="8b52-605d-efca-1bdd" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Cobertura de nave celeste" id="e798-72bd-b061-35b8" hidden="false" publicationId="d4a9-b568-9525-d6ac" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de impacto de los ataques que tengan como objetivo unidades amigas **^^Señores Supremos Kharadron Infantry^^** que no hayan cargado en el mismo turno, mientras estén totalmente a 6" o menos de un **Acorazado arkanauta** o **Fragata arkanauta** amigo que no haya cargado en el mismo turno.</characteristic>
          </characteristics>
        </profile>
        <profile name="Volar alto" id="e190-a20d-42bc-de41" hidden="false" publicationId="d4a9-b568-9525-d6ac" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Skyvessel^^** amigo que esté en un regimiento del que no se haya desplegado ninguna unidad y, después, elige un número de unidades de ese regimiento hasta su característica de Capacidad de transporte (consulta su pergamino de guerra).</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca todas esas unidades en reserva **en las nubes**. Ahora se consideran desplegadas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Descender de las nubes" id="a897-99d9-3a96-c616" hidden="false" publicationId="d4a9-b568-9525-d6ac" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Skyvessel^^** amigo **en las nubes** para usar esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca ese **^^Skyvessel^^** en cualquier punto del campo de batalla a más de 9" de todas las unidades enemigas. Después, coloca todas las demás unidades que se colocaron **en las nubes** junto a ese **^^Skyvessel^^** totalmente a 6" o menos de él y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Transportar navegantes celestes" id="9df2-b463-a090-fbd8" hidden="false" publicationId="d4a9-b568-9525-d6ac" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento, reacción: has declarado una habilidad que no sea **^^Cargar Move^^** para un **^^Skyvessel^^** amigo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">El **^^Skyvessel^^** que use esa habilidad de **^^Move^^**</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige como objetivos un número de unidades hasta la característica de Capacidad de transporte (consulta su pergamino de guerra) de ese **^^Skyvessel^^** que estén totalmente a 6" o menos de él y no estén en combate. Las unidades que hayan sido transportadas este turno no pueden ser objetivos.
Retira los objetivos del campo de batalla. Después de que el **^^Skyvessel^^** termine su movimiento, debes colocar cada unidad objetivo en el campo de batalla, totalmente a 6" o menos de ese **^^Skyvessel^^** y sin estar en combate. Esas unidades han sido transportadas. Una unidad no puede usar habilidades de **^^Cargar^^** si ha sido transportada en el mismo turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="La nave insignia" id="f098-b25c-ab72-ed10" hidden="false" publicationId="d4a9-b568-9525-d6ac" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Skyvessel^^** amigo. El objetivo puede estar en reserva.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El objetivo tiene la palabra clave **^^Flagship^^** durante el resto de la batalla. Si el objetivo no tiene un Great Endrinwork, dale 1 Great Endrinwork.
**Nota del diseñador:** *Este Great Endrinwork se otorga a la unidad durante la fase de despliegue, no durante la composición del ejército.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
