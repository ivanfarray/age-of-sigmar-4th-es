        <profile name="Wicked Wardens" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="c80d-5335-62e3-479c">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad esté totalmente a 12" o menos de una **Reina bruja en caldero de sangre**, **Reina de la matanza en caldero de sangre** o **Santuario del tributo oscuro** amiga, sus armas de combate tienen **^^Anti-charge (+1 Rend)^^**.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Crimson Offerings" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="863b-54a7-0844-dbeb">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), reacción: Declaraste la habilidad &apos;Blessings of Khaine&apos;</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si los ataques de combate de esta unidad destruyeron una unidad enemiga este turno, al resolver esa habilidad puedes elegir 2 bendiciones en lugar de 1.</characteristic>
