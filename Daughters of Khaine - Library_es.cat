          </characteristics>
        </profile>
        <profile name="Consecrated Revulsion" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="0caa-e1d5-64e7-a67d">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Añade 1 a las tiradas de salvación de las unidades amigas **^^Daughters of Khaine Infantry^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Icon of Slaughter" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="1bc5-76b1-223d-8394">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Exaltado^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una unidad amiga **^^Daughters of Khaine^^** totalmente a 12" o menos de esta unidad use la orden &apos;Rally&apos;, puedes hacer 3 tiradas de reagrupamiento adicionales de D6. Además, si hay alguna **Hag Queens on Cauldrons of Blood** amiga en el campo de batalla cuando se usa esa orden, recibes D3 puntos de reagrupamiento adicionales.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
