                  <profiles>
                    <profile name="Mirada fija de tormento sangriento" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="7dea-f79f-4360-bc80">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de disparo</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 18" o menos de esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, tira un número de dados igual a la característica de Health del objetivo. Resta 1 a cada tirada si el objetivo es un **^^Monster^^**. Por cada 5+, inflige 1 de daño mortal al objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
                  </profiles>
                </selectionEntry>
