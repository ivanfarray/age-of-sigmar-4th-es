        <profile name="Wracking Gaze" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="a4c5-a298-e0c6-8c30">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 15" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Si el resultado es igual o inferior a la característica de Health de esa unidad enemiga, durante el resto de la fase puedes volver a tirar las tiradas de impacto fallidas de los ataques de esta unidad cuyo objetivo sea esa unidad enemiga.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
