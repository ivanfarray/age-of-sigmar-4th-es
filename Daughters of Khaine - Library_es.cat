      </categoryLinks>
      <profiles>
        <profile name="Maleneth Hoja Bruja" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="2264-ae5d-4910-b7d1">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Hidden Agent" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="5fc0-6950-3c0a-e660">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad no se ha desplegado, colócala en reserva **oculta**. Ahora ya se ha desplegado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Strike from the Shadows" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="5e7f-2e70-8933-5403">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad si está oculta. Después, elige como objetivo una unidad amiga **^^Infantry^^** que tenga 5 o más miniaturas.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, coloca esta unidad en cualquier lugar del campo de batalla totalmente a 6" o menos del objetivo. Si lo haces, esta unidad debe colocarse en combate y tiene **^^Strike-first^^** durante el resto del turno. Si la tirada falla, esta unidad permanece oculta, pero superas automáticamente la tirada la próxima vez que uses esta habilidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Vial of Secrets" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="f378-e436-3f43-6557">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si la tirada de impacto sin modificar de un ataque que tenga como objetivo esta unidad es 1-4, el ataque falla y la secuencia de ataque termina.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Maleneth Hoja Bruja" hidden="false" id="00e9-261a-b12f-fdbf">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Hojas mortíferas" hidden="false" id="b2a2-fc70-9d7c-36c9">
              <constraints>
