        <profile name="Roaring Idol" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f16c-01bc-b26c-c34d">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una **^^Daughters of Khaine Manifestation^^** amiga totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, el objetivo no puede ser elegido como objetivo de habilidades **^^Banish^^** usadas por unidades enemigas hasta el inicio de tu siguiente turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
