          </attributes>
        </profile>
        <profile name="Reflected Agony" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="2375-69bd-ca6c-f3a1">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, las unidades enemigas y las **^^Manifestations^^** enemigas no pueden colocarse a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2"/>
