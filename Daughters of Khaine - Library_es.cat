        <profile name="Aura of Agony" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="93af-9bbf-edc6-456e">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno:
• Las **^^Manifestations^^** enemigas no pueden colocarse a 12" o menos de esta unidad.
• Esta unidad tiene **^^Ward (4+)^^** contra el daño mortal infligido por habilidades **^^Spell^^**, habilidades **^^Prayer^^** y habilidades usadas por **^^Manifestations^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">^^**Exaltado^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Born of Slaughter" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="b21f-9739-5c53-7860">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Si hay menos **Avatars of Khaine** amigos en el campo de batalla que **Bloodwrack Shrines** amigos en el campo de batalla, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Coloca un **Avatar de Khaine** totalmente a 12" o menos del lanzador, visible para él y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Invocación^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
        </profile>
        <profile name="Agonising Spasms" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="43ce-1903-7fc9-bf04">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Declaraste una habilidad **^^Shoot^^** para esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Después de resolver esa habilidad **^^Shoot^^**, si todos los ataques de esta unidad realizados como parte de esa habilidad **^^Shoot^^** tuvieron como objetivo la misma unidad enemiga y esos ataques abatieron alguna miniatura enemiga, tira un dado. Con un 3+, esa unidad enemiga tiene una puntuación de control máxima de 1 durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
