            <selectionEntryGroup name="Legendary" id="99a5-6ef4-3053-83d2" hidden="false" sortIndex="4">
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Bellowed Exhortations" hidden="false" id="82f0-51d6-4296-e1fd">
                  <profiles>
                    <profile name="Bellowed Exhortations" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="d0dc-902e-b6e0-16f7">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga visible **^^Daughters of Khaine^^** que no sea **^^Hero^^** totalmente a 12" o menos de esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si has usado la habilidad &apos;Blessings of Khaine&apos; 3 o más veces esta batalla, los ataques de combate del objetivo consiguen impactos críticos con tiradas de impacto sin modificar de 4+ durante el resto del turno. En caso contrario, tira un dado. Si el resultado es igual o inferior al número de la ronda de batalla actual, los ataques de combate del objetivo consiguen impactos críticos con tiradas de impacto sin modificar de 4+ durante el resto del turno.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c3f8-6cbd-8abd-5b85"/>
                  </constraints>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Blessed of the Goddess" hidden="false" id="c6c0-5899-8deb-c8b2">
                  <profiles>
                    <profile name="Blessed of the Goddess" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="4927-f56c-80bd-5e84">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una **^^Daughters of Khaine Manifestation^^** amiga que no esté en el campo de batalla.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 4+, si elegiste un **Corazón de furia**, colócalo totalmente a 18" o menos de esta unidad y visible para ella. En caso contrario, con un 4+, coloca la **^^Manifestation^^** totalmente a 12" o menos de esta unidad, visible para ella y a más de 9" de todas las unidades enemigas. Esta unidad ha invocado esa **^^Manifestation^^**.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fb71-85b5-3a3e-1589"/>
                  </constraints>
                </selectionEntry>
              </selectionEntries>
