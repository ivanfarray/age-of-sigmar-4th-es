        <profile name="Exsanguinating Glare" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c9e5-4ff8-bf47-fc58">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad está en combate, elige como objetivo una unidad enemiga en combate con ella. Si esta unidad no está en combate, elige como objetivo una unidad enemiga visible a 12" o menos de ella.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3. Con un 2+, inflige al objetivo una cantidad de daño mortal igual al resultado. Después, si ese daño mortal abatió alguna miniatura enemiga, inflige al objetivo una cantidad de daño mortal igual a su característica de Health.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Arcane Resonance" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="734f-48a5-13ca-61e0">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Exaltado^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Añade 1 a las tiradas de lanzamiento de esta unidad cuando use una habilidad **^^Summon^^** y añade 1 a sus tiradas de destierro.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
