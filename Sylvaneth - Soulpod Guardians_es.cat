                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de movimiento</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si hay una unidad enemiga totalmente a 12" o menos de tu **Soulpod Grove**, elige como objetivos hasta 3 unidades amigas **^^Soulpod Guardians^^**.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira los objetivos del campo de batalla y colócalos de nuevo totalmente a 12" o menos de tu **Soulpod Grove** y a más de 6" de todas las unidades enemigas.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
