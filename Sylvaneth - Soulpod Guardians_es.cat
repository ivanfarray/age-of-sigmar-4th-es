<catalogue library="false" id="b0b9-ece2-dec7-9e78" name="Sylvaneth - Guardianes de Vainas de Almas" gameSystemId="e51d-b1a3-75fc-dc3g" gameSystemRevision="87" revision="7" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Rasgos de batalla: Guardianes de Vainas de Almas" hidden="false" id="6ea5-3d64-861a-255a" publicationId="61ee-fae0-f1da-2591">
      <profiles>
        <profile name="Las arboledas sagradas" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="4f0a-545a-feb7-0bf6">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Debes usar esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca 3 **Awakened Wyldwoods** (una Bosque salvaje despierto es una única miniatura de árbol con peana en forma de media luna) totalmente dentro de tu territorio, a más de 1" de todos los demás elementos de escenografía y a más de 3" de todos los marcadores de objetivo. Las puntas de cada peana en forma de media luna deben tocarse, formando un círculo.
Una vez hecho esto, durante el resto de la batalla, las 3 miniaturas de árbol se unen para formar 1 elemento de escenografía **Soulpod Grove**. El área dentro del círculo formado por los árboles forma parte del elemento de escenografía.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desplegar terreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Refugio de jade" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="0967-654e-4ac2-7fa2">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La característica de Salud de tu **Soulpod Grove** es 18. La **maleza reptante** se extiende 12" desde tu **Soulpod Grove**.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Venganza por los perdidos" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="1bf5-7b8c-44e0-3158">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si tu **Soulpod Grove** ha sido demolida esta batalla, suma 2 a la característica de Attacks de las armas de cuerpo a cuerpo de las unidades amigas **^^Soulpod Guardians^^**.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Corazón del bosque" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="6790-edf5-0f6e-f70c">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">No puedes asignar más de 10 puntos de daño por fase a una unidad amiga **^^Soulpod Guardians^^** mientras esté totalmente a 12" o menos de tu **Soulpod Grove** (los puntos de daño restantes que se le inflijan en esa fase no tienen efecto).</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="Reference" hidden="false" id="2546-a4bf-3c41-26dd" targetId="3360-1158-e879-9606" primary="true"/>
      </categoryLinks>
