                  </costs>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Maestro de balística" hidden="false" id="dd96-04c9-0034-cd42" sortIndex="4">
                  <profiles>
                    <profile name="Maestro de balística" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="16e9-3da2-b112-c8e7">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, reacción: Declaraste una habilidad **^^Disparar^^** para una unidad a 3" o menos de esta unidad</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
