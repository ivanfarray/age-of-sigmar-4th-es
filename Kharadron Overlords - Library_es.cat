      <profiles>
        <profile name="Rutinas de reparación" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="7e09-4dc4-4a3b-ae1d">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Skyvessel^^** amigo a 3" o menos de este elemento de escenografía.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Haz una tirada de reparación de D6. Añade 1 a la tirada si hay un **Maestro endrinero con traje dirigible** o un **Maestro endrinero con arnés endrín** amigo a 3" o menos de este elemento de escenografía. Con un 4+, aplica **Heal (3)** al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Muelle endrín Zontari" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="a56b-1899-4cb2-aea8">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">10</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Soltar los autoendrines" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="9d97-689e-ffb9-a558">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca un **Autoendrín anulador**, un **Autoendrín de nube aturdidora** y un **Autoendrín de estallido de agravios** amigos (ver el pergamino de Autoendrín) en el campo de batalla dentro del territorio amigo, totalmente a 6" o menos de este elemento de escenografía y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Puesto avanzado de ingeniería endrín" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c3b7-203a-39c0-4005">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Autoendrín^^** amigo o un **^^Autoendrín^^** de reemplazo amigo que haya sido retirado del campo de batalla.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Haz una tirada de fabricación de D6. Añade 1 a la tirada si hay un **Maestro endrinero con traje dirigible** o un **Maestro endrinero con arnés endrín** amigo a 3" o menos de este elemento de escenografía. Con un 4+, coloca un **^^Autoendrín^^** de reemplazo en el campo de batalla, totalmente a 6" o menos de este elemento de escenografía y a más de 3" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <rules>
        <rule name="Muelle endrín Zontari" id="81d3-e763-5a55-a4e5" hidden="false">
          <description>**Habilidades universales de escenografía: Cobertura, Infranqueable**</description>
        </rule>
        <rule name="Tamaño de peana" id="a8c2-60b8-e9fb-5bbe" hidden="true">
          <description>80mm</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Autoendrín" hidden="false" id="34f5-2761-de10-6710" publicationId="d4a9-b568-9525-d6ac">
      <categoryLinks>
        <categoryLink name="ORDER" hidden="false" id="8c13-c864-3e2d-a77c" targetId="ee22-3575-6590-25c" primary="false"/>
        <categoryLink name="KHARADRON OVERLORDS" hidden="false" id="6cd5-8992-1283-d877" targetId="9c8d-276-b7d2-f1fd" primary="false"/>
        <categoryLink name="FLY" hidden="false" id="f7a3-1ed8-84ba-aade" targetId="b979-4c3e-7d0e-6921" primary="false"/>
        <categoryLink name="WAR MACHINE" hidden="false" id="2421-354c-8428-22bf" targetId="f7bc-b618-4b5d-2bae" primary="true"/>
        <categoryLink name="AUTO-ENDRIN" hidden="false" id="8435-4deb-5f9f-41cf" targetId="6c83-ce3d-570e-e833" primary="false"/>
      </categoryLinks>
      <profiles>
        <profile name="Autoendrín anulador" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="a3fe-6590-140c-963f">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad es un **Autoendrín anulador** y está en combate con alguna **^^Manifestations^^** enemiga, elige como objetivos todas las **^^Manifestation^^** enemigas en combate con ella.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Haz una **tirada de destierro** de 3D6 por cada objetivo. Si la tirada de destierro iguala o supera el **valor de destierro** del pergamino de la **^^Manifestation^^**, esta es desterrada y retirada del juego. Después, retira esta unidad del campo de batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Autoendrín" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="e530-e672-1b4d-e187">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Municiones prescindibles" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="e4e6-9af8-b526-ef98">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Se aplica lo siguiente a esta unidad:
• Esta unidad tiene una puntuación de control máxima de &apos;-&apos;.
• Cuando esta unidad es destruida o retirada del campo de batalla, no cuenta como destruida a efectos de otras reglas (como puntuar tácticas de batalla).
• Esta unidad no puede ser elegida como objetivo ni verse afectada por habilidades que no sean **^^Core^^** usadas por otras unidades amigas, salvo que la habilidad especifique **^^Autoendrín^^**
• Ignora esta unidad a efectos de las tácticas de batalla amigas y enemigas.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Autoendrín de nube aturdidora" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="43a7-2faa-0553-0222">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad es un **Autoendrín de nube aturdidora** y está en combate, elige como objetivos todas las unidades enemigas en combate con ella.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado por cada objetivo. Si el resultado es igual o inferior a la característica de Salud de ese objetivo, resta 10 a su puntuación de control durante el resto del turno. Después, retira esta unidad del campo de batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Autoendrín de estallido de agravios" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="ea99-cbfd-3cb2-3b86">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad es un **Autoendrín de estallido de agravios** y está en combate, elige como objetivos todas las unidades enemigas en combate con ella.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3 por cada objetivo. Con un 2+, inflige al objetivo una cantidad de daño mortal igual al resultado. Después, retira esta unidad del campo de batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <rules>
        <rule name="Autoendrín" id="12f6-a2ea-854d-1e83" hidden="false">
          <description>*Esta unidad consta de 1 de los siguientes: Autoendrín anulador, Autoendrín de nube aturdidora o Autoendrín de estallido de agravios.*</description>
        </rule>
        <rule name="Tamaño de peana" id="b483-7327-3bd8-925c" hidden="true">
          <description>40mm</description>
        </rule>
      </rules>
    </selectionEntry>
