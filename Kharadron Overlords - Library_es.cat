      <categoryLinks>
        <categoryLink name="FACTION TERRAIN" hidden="false" id="0923-113f-187b-1b5b" targetId="cdd6-ffa1-9b32-4cb8" primary="true"/>
        <categoryLink name="ORDER" hidden="false" id="2c3e-6142-15b9-2483" targetId="ee22-3575-6590-25c" primary="false"/>
