                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Si el resultado es igual o inferior al número de miniaturas del objetivo, elige 1 de los siguientes efectos:
• Durante el resto del turno, resta 1 a las tiradas de impacto de los ataques de disparo del objetivo.
• Durante el resto del turno, vuelve a tirar las tiradas de impacto de 1 de los ataques de disparo de esta unidad cuyo objetivo sea esa unidad enemiga.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
