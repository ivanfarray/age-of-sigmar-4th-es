                <selectionEntry type="upgrade" import="true" name="Sirena de cuerno celeste" hidden="false" id="55e5-de12-aade-2bb2">
                  <profiles>
                    <profile name="Sirena de cuerno celeste" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="ae44-2cc4-07c5-489b">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, final de cualquier turno</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Haz una tirada de **toque de cuerno celeste** de 4D6. Cada unidad enemiga a **X**" o menos de esta unidad es un objetivo, donde **X** es la **tirada de toque de cuerno celeste**.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado por cada objetivo. Resta el resultado a la puntuación de control del objetivo durante el resto del turno.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
