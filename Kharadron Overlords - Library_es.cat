                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3c17-4124-678d-5b5e"/>
                  </constraints>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Ventilación del escape" hidden="false" id="0fd1-5228-fe5f-1dd4">
                  <profiles>
                    <profile name="Ventilación del escape" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="9f19-791e-e67e-f145">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, reacción: El oponente declaró una habilidad **^^Disparar^^**.</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si la tirada de impacto sin modificar de un ataque realizado como parte de esa habilidad **^^Disparar^^** es de 1-4, el ataque falla y la secuencia de ataque termina.</characteristic>
