        </profile>
        <profile name="¡Puede soportarlo!" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="d128-f45e-424f-381a">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
