        <profile name="Capacidad de transporte" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="79f5-5de-4c0d-aa8a">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad puede transportar hasta 2 unidades amigas **^^Señores Supremos Kharadron Infantry^^** con un total combinado de hasta 12 miniaturas (ver Rasgos de batalla).</characteristic>
