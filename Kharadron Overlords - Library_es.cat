    <selectionEntry type="unit" import="true" name="Atronadores Grundstok" hidden="false" id="9f81-a727-f6ab-e7cc" publicationId="d4a9-b568-9525-d6ac">
      <profiles>
        <profile name="Munición especializada Grundstok" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="fe2d-101b-5071-72ab">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de disparo, reacción: Declaraste una habilidad **^^Disparar^^** para esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige munición **Rompeescudos** o munición **Thunderdrakk**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si todos los ataques realizados para esa habilidad **^^Disparar^^** tienen como objetivo a la misma unidad enemiga, después de resolver esa habilidad **^^Disparar^^**, tira un dado y añade el número de puntos de daño asignados al objetivo mediante esa habilidad **^^Disparar^^**. Si el resultado supera la característica de Control del objetivo, aplica al objetivo el siguiente efecto según el tipo de munición elegido:
***Rompeescudos:*** No pueden hacerse tiradas de salvaguardia para el objetivo hasta el inicio de tu siguiente turno.
***Thunderdrakk:*** Ese objetivo tiene una puntuación de control máxima de 1 hasta el inicio de tu siguiente turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Atronadores Grundstok" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="d4f5-bf2a-6be5-2fe7">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">4&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Atronador Grundstok" hidden="false" id="b1a8-867d-3ee1-e959" defaultAmount="1,1,1,1,1" collective="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Mortero Grundstok o cañón etéreo" hidden="false" id="4a6-ea6-c503-5b7b" defaultAmount="0,0,0,1,1">
