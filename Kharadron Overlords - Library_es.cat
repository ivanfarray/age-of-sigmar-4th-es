        <profile name="Daños de batalla" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="3265-df0b-7c39-1fd7">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 10 o más puntos de daño, la característica de Attacks de su **Gran artillería celeste** es 4.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Bastidores de bombas pesadas" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="ef89-b9ef-172f-4ce9">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga que no tenga **^^Volar^^** y sobre la que esta unidad haya pasado esta fase.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira 10 dados. Por cada 4+, inflige 1 de daño mortal al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
