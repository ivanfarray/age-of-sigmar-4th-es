        <profile name="Estamos trabajando aquí" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="d260-8ab3-c1e6-3863">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno, si esta unidad no ha cargado en el mismo turno, se aplican los siguientes efectos acumulativos según tu **nivel de furia**.
**1+ *Irked*:** Las **Aethermatic Saws** de esta unidad tienen **Crítico (herida automática)**.
**4+ *Exasperated*:** Esta unidad tiene Ward (5+).
**7 *Enfurecido*:** Añade 1 a la característica de Damage de las armas de combate de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
