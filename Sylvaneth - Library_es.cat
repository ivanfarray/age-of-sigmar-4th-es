          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad puede usar habilidades **^^Disparar^^** y/o **^^Cargar^^** aunque haya usado una habilidad **^^Correr^^** o **^^Retirarse^^** en el mismo turno.</characteristic>
          </characteristics>
