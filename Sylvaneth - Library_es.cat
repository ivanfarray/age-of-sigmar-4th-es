                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Al usar la habilidad &apos;Crecimiento interminable&apos;, añade **X** a la tirada de D3 de esta unidad, donde **X** es el número de elementos de escenografía a 12" o menos de esta unidad que tengan un **marcador de maleza** amigo.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
