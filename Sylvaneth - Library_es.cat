            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras el **Karthaen, Invocador de la Cacería** de esta unidad esté en el campo de batalla, tiene **^^Wizard (1)^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Pies veloces" id="6701-0849-f9de-e747" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
