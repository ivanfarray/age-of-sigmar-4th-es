                <selectionEntry name="Canción de la tierra" id="cd0c-4aee-8841-1e6d" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="0640-6f91-51b2-a1e7" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Canción de la tierra" id="2c94-55dd-e65f-0f56" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Da a cada marcador de objetivo y elemento de escenografía a 18" o menos de esta unidad un **marcador de maleza**. Puedes medir la maleza reptante desde los objetivos que tengan un marcador de maleza amigo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Truco de la oscuridad" id="03ab-4813-7a8d-6cf8" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="ed3c-bc5c-d4ca-3c02" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Truco de la oscuridad" id="861a-7dc8-913a-5288" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **Bosque salvaje despierto** amigo.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira el objetivo del campo de batalla y vuelve a colocarlo totalmente a 6" o menos de esta unidad, a más de 1" de todas las unidades enemigas y de otros elementos de escenografía, y a más de 3" de todos los objetivos. Después, retira esta unidad del campo de batalla y vuelve a colocarla totalmente dentro de la **maleza reptante** y a más de 9" de todas las unidades enemigas.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
