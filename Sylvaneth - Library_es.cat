                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: El oponente declaró una habilidad **^^Hechizo^^**</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad fue elegida como objetivo de ese hechizo, tira un dado. Con un 4+, ignora el efecto de ese hechizo sobre esta unidad.</characteristic>
