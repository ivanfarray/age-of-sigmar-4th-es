          </characteristics>
        </profile>
        <profile name="Corona verdiana" id="43d-79ea-b852-4898" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un elemento de escenografía a 18" o menos de esta unidad que no tenga un **marcador de maleza** amigo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Da al objetivo un **marcador de maleza** amigo</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Protección de la Reina Eterna" id="b3f2-fbf6-5483-7d40" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Haz una tirada de lanzamiento de 2D6. Añade 1 a la tirada si esta unidad está totalmente dentro de la **maleza reptante**.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, las unidades amigas **^^Sylvaneth^^** tienen **^^Ward (5+)^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Manos de la Reina Eterna" id="95a7-7f72-7aee-d38c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un elemento de escenografía a 18" o menos de esta unidad que tenga un **marcador de maleza** amigo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">La próxima vez que esta unidad use una habilidad Hechizo que no sea Summon esta fase, al elegir los objetivos de ese hechizo puedes medir el alcance y la visibilidad desde el elemento de escenografía objetivo en lugar de desde esta unidad, y tu oponente puede medir el alcance y la visibilidad hasta el elemento de escenografía objetivo en lugar de hasta esta unidad a efectos de la habilidad &apos;Desvincular&apos;.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
