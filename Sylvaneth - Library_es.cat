                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de carga</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad no está en combate y no ha usado una habilidad **^^Correr^^** o **^^Retirarse^^** este turno, retírala del campo de batalla y vuelve a colocarla totalmente dentro de la **maleza reptante** y a más de 9" de todas las unidades enemigas.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
