          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), reacción: Hiciste una tirada de cántico sin modificar de 1 para un **^^Sylvaneth Priest**^^ totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
