                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, fase de héroe enemiga</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada **^^Discípulos de Tzeentch Wizard^^** amigo visible totalmente a 12" o menos de esta unidad puede usar una habilidad **^^Hechizo^^** como si fuera tu fase de héroe.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
