                <selectionEntry type="upgrade" import="true" name="Sangre de azogue" hidden="false" id="2f1d-a930-a834-acec">
                  <profiles>
                    <profile name="Sangre de azogue" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="adae-d297-a30b-c6d5">
                      <characteristics>
