        <profile name="Pergaminos de hechicería" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="00b1-47b7-8351-0407">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">La próxima vez que esta unidad use una habilidad **^^Hechizo^^** que no sea **^^Summon^^** esta fase, no hagas una tirada de lanzamiento como parte de esa habilidad. En su lugar, tira un dado. Con un 2+, el hechizo se lanza con éxito y no puede ser desvinculado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
