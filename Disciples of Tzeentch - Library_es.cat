            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Haz una tirada de desvinculación de 2D6. Si el resultado supera el valor de lanzamiento, el hechizo es desvinculado y su efecto no se resuelve.
Si el hechizo es desvinculado, añade 1 a las tiradas de lanzamiento de esta unidad durante el resto de la fase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desvinculación^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
