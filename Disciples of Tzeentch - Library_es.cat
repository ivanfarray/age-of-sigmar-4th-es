                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de carga</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad ha cargado esta fase, elige como objetivo una unidad enemiga en combate con ella.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un número de dados igual a la tirada de carga sin modificar. Por cada 4+, inflige 1 de daño mortal al objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Tajar y desgarrar" id="b916-7764-5cc3-fb4b" hidden="true">
                      <description>Añade la habilidad &apos;Tajar y desgarrar&apos; al pergamino de tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
