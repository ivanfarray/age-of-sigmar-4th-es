    <selectionEntry type="unit" import="true" name="Horrores rosas" hidden="false" id="2631-6ae3-b25b-2bbf" publicationId="72d2-ae0-e519-f2f7">
      <profiles>
        <profile name="Horrores rosas" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="2f24-6170-b3f4-1d38">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic>
