        <profile name="Escudo ligado al alma" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="d869-3ff5-ffd9-4ae1">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: El oponente declaró una habilidad **^^Hechizo^^**</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad ha sido elegida como objetivo de ese hechizo, tira un dado. Con un 4+, ignora el efecto de ese hechizo sobre esta unidad. Esta unidad puede usar esta habilidad más de una vez por fase, pero solo una vez por cada habilidad de **^^Hechizo^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Yellow</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Señor del destino" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="f101-9721-3aa1-3d94">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Añade 1 a las tiradas de herida de los ataques de las unidades amigas **^^Arcanite^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Red</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
