        <profile name="Señor del Cambio" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="9800-7b11-1cab-4f7f">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">14</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Invocar demonios de Tzeentch" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" hidden="false" id="54ed-e5a1-df72-8177">
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por turno (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga **^^Discípulos de Tzeentch Daemon^^** que no sea **^^Hero^^** ni **^^Unique^^** y haya sido destruida.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de reemplazo con la mitad del número de miniaturas de la unidad objetivo (redondeando hacia arriba), totalmente a 9" o menos de esta unidad y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
          <attributes>
            <attribute typeId="5c69-e4b9-19bc-e801" name="Color">Gray</attribute>
            <attribute typeId="2bd5-08f1-f3d1-86f7" name="Type">Rallying</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
        </profile>
        <profile name="Manipulación temporal" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="2591-cb94-c62f-6a73">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo otra unidad amiga visible **^^Discípulos de Tzeentch^^** que no haya sido colocada este turno y esté totalmente a 18" o menos de esta unidad. Después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">El objetivo puede usar la habilidad &apos;Movimiento normal&apos; como si fuera tu fase de movimiento, pero debe terminar ese movimiento más cerca de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Llama del destino^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
          </attributes>
        </profile>
        <profile name="Foco de imposibilidad" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="767a-ee51-b8df-8906">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Añade 1 a las tiradas de lanzamiento de esta unidad. Además, resta 1 a las tiradas de impacto de los ataques cuyo objetivo sean unidades amigas **^^Discípulos de Tzeentch Daemon^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
