          </characteristics>
        </profile>
        <profile name="Devoción hasta el alma" id="cc34-50a3-2104-3991" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad esté dentro del alcance de combate de una unidad amiga **^^Arcanite^^** que no sea **^^Hero^^**:
• Esta unidad tiene **Ward (4+)**.
• Cada vez que hagas una tirada de salvaguardia exitosa para esta unidad, asigna 1 punto de daño a una unidad amiga **^^Arcanite^^** que no sea **^^Hero^^** dentro del alcance de combate de esta unidad después de resolver la secuencia de daño de esta unidad (no pueden hacerse tiradas de salvaguardia por esos puntos de daño).</characteristic>
          </characteristics>
        </profile>
        <profile name="Ira del taumaturgo" id="769c-6c6c-9529-6a43" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad no está en combate, elige como objetivo una unidad amiga **^^Arcanite^^** en combate.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira esta unidad del campo de batalla y vuelve a colocarla a 1" o menos del objetivo y en combate. Esta unidad ha cargado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Básica^^**, **^^Carga^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
