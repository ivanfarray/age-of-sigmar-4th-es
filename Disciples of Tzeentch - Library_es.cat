      </entryLinks>
      <profiles>
        <profile name="Maldito, Ojo de Tzeentch" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="29d2-1fd4-ac96-68d9">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
