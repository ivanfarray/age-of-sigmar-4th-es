              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Hechicería oculta" hidden="false" id="fdce-7273-26e2-dff7">
                  <profiles>
                    <profile name="Hechicería oculta" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="246a-c273-38b2-60da">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad solo puede usar esta habilidad si está **enmascarada por ilusión**. Elige como objetivo una miniatura de una unidad amiga **^^Discípulos de Tzeentch^^**.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede usar inmediatamente una habilidad **^^Hechizo^^**. Cuando lo haga, mide el alcance y la visibilidad de esa habilidad **^^Hechizo^^** desde el objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="797a-b9c6-1517-1169"/>
                  </constraints>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Aquelarre sobrenatural" hidden="false" id="90fd-ce96-75a8-8a38">
                  <profiles>
                    <profile name="Aquelarre sobrenatural" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c1e5-6eba-24d4-34b2">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, fase de héroe enemiga</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada **^^Discípulos de Tzeentch Wizard^^** amigo visible totalmente a 12" o menos de esta unidad puede usar una habilidad **^^Hechizo^^** como si fuera tu fase de héroe.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
