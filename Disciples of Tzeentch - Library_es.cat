                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad es destruida, antes de retirarla del juego, coloca una unidad de reemplazo con la mitad del número de miniaturas de la unidad objetivo (redondeando hacia arriba) en reserva **enmascarada por ilusión**</characteristic>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
