        <profile name="Atraído por la magia" id="c684-62c5-67a7-5254" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
