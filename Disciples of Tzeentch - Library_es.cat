            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Archiengañador" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="1c6b-97d0-ebea-f49c">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad solo puede usar esta habilidad si está **enmascarada por ilusión**. Elige como objetivo una miniatura de una unidad amiga **^^Discípulos de Tzeentch^^**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede usar inmediatamente una habilidad **^^Hechizo^^**. Cuando lo haga, mide el alcance y la visibilidad de esa habilidad **^^Hechizo^^** desde el objetivo. El objetivo se trata como el lanzador a efectos de otras habilidades como &apos;Desvincular&apos;.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Despiste travieso" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="2d39-8af0-b6f3-567e">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén totalmente a 12" o menos de esta unidad, las unidades amigas **^^Discípulos de Tzeentch^^** pueden usar la orden &apos;Redesplegar&apos; aunque hayan sido colocadas en el mismo turno.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Susurros de traición" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="1b63-b0b4-f62b-d5be">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad enemiga visible a 18" o menos de esta unidad y después haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Tira un dado por cada miniatura de la unidad objetivo. Por cada 5+, inflige 1 de daño mortal al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
          </attributes>
        </profile>
      </profiles>
