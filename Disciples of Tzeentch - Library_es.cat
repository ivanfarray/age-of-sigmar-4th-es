      <entryLinks>
        <entryLink import="true" name="General" hidden="false" id="0768-be9a-2078-3134" type="selectionEntry" targetId="a56b-952e-ad15-7868"/>
      </entryLinks>
      <profiles>
        <profile name="Taumaturgo ogroide" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="cf54-4027-65fb-5eb2">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic>
