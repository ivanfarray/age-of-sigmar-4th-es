                        <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de reemplazo con la mitad del número de miniaturas de la unidad objetivo (redondeando hacia arriba), totalmente a 9" o menos de un borde del campo de batalla y a más de 9" de todas las unidades enemigas.</characteristic>
                        <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Grey</attribute>
