        <profile name="Vínculo traicionero" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="447e-48cc-0bee-0e9c">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad amiga dentro del alcance de combate de esta unidad y después haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno:
• Esta unidad tiene **^^Ward (4+)^^**.
• Cada vez que hagas una tirada de salvaguardia sin modificar de 1-3 para esta unidad, asigna 1 punto de daño al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="16b6-0911-f549-a4bd" name="Color">Yellow</attribute>
