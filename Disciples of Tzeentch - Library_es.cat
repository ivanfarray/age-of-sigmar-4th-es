          </characteristics>
        </profile>
        <profile name="Foco mágico" id="70b3-9ca8-4148-e08e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">La próxima vez que una unidad amiga **^^Discípulos de Tzeentch^^** use una habilidad **^^Hechizo^^** esta fase, al elegir objetivos para ese hechizo puedes medir el alcance y la visibilidad desde este elemento de escenografía en lugar de desde el lanzador, y tu oponente puede medir el alcance y la visibilidad hasta este elemento de escenografía en lugar de hasta el lanzador a efectos de la habilidad &apos;Desvincular&apos;.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Duplicación hechicera" id="f149-7071-dc56-90f9" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de los siguientes efectos:
• Si solo hay 1 **Fragmento argénteo** amigo en el campo de batalla, coloca otro **Fragmento argénteo** totalmente a 12" o menos de este elemento de escenografía, a más de 1" de todos los demás elementos de escenografía, a más de 3" de todos los objetivos y a más de 9" de todas las unidades enemigas.
• Retira este elemento de escenografía del campo de batalla y vuelve a colocarlo en el campo de batalla a más de 1" de todos los demás elementos de escenografía, a más de 3" de todos los objetivos y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Tamaño de peana" id="beda-e853-4de5-99cf" hidden="true">
          <description>80mm</description>
        </rule>
        <rule name="Fragmento argénteo" id="dc17-4ac4-3f6e-cd86" hidden="false">
          <description>**Las siguientes habilidades universales de escenografía se aplican a este elemento de escenografía (Terrain, 1.2):
Cobertura, Infranqueable**</description>
        </rule>
      </rules>
    </selectionEntry>
