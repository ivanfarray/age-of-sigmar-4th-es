          </characteristics>
        </profile>
        <profile name="Maldición rompearmaduras" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="6773-1db-97-9e66">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad y después haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Resta 1 a las tiradas de salvación contra los ataques de combate cuyo objetivo sea esa unidad hasta el inicio de tu siguiente turno.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="16b6-0911-f549-a4bd" name="Color">Yellow</attribute>
            <attribute typeId="da27-8d61-f955-5031" name="Parent Node">Offensive</attribute>
          </attributes>
        </profile>
        <profile name="Con hechizo y espada" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="e140-c6f7-53fd-280e">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está en combate, puede usar una habilidad **^^Hechizo^^** que no sea **^^Summon^^** como si fuera tu fase de héroe, como si esa habilidad tuviera la palabra clave **^^Unlimited^^** y como si esta unidad no hubiera lanzado ningún hechizo este turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
