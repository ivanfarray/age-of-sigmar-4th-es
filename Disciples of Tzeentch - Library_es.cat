        <profile name="Séquito vinculado" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="51fa-9ee8-93ef-b276">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad solo puede usar esta habilidad si está **enmascarada por ilusión**. Elige como objetivo hasta 1 otra unidad amiga que esté **enmascarada por ilusión**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en el campo de batalla a más de 9" de todas las unidades enemigas. Después, coloca el objetivo totalmente a 6" o menos de esta unidad y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Planeado durante mucho tiempo" typeId="9b15-469e-8bf3-70c7" typeName="Ability (Fate)" hidden="false" id="16ec-7820-d137-e504">
          <characteristics>
            <characteristic name="Timing" typeId="ee08-f0bb-c101-58d5">Una vez por turno (ejército), fase de héroe enemiga</characteristic>
            <characteristic name="Declare" typeId="74f4-c00a-61c2-280d">Gasta 2 **puntos de destino**. Después, elige como objetivo una unidad amiga visible **^^Arcanite^^** totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="c24b-9e80-9805-8ccf">Durante el resto del turno, la primera vez que una unidad enemiga termine un movimiento de carga a 3" o menos del objetivo, puedes retirar el objetivo del campo de batalla y colocarlo en reserva **enmascarado por ilusión**.</characteristic>
            <characteristic name="Keywords" typeId="3a10-e240-163d-d34a"/>
            <characteristic name="Used By" typeId="fb10-043b-0db8-f864"/>
            <characteristic name="Fate Points" typeId="2817-a813-f11c-2961">2</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="7117-6fca-9b35-9a1b">Yellow</attribute>
            <attribute name="Type" typeId="bafa-c720-e165-8c34">Movement</attribute>
            <attribute name="Parent Node" typeId="65cf-bbb1-eb30-7049"/>
          </attributes>
        </profile>
      </profiles>
