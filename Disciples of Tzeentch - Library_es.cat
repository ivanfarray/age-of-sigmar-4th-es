      <profiles>
        <profile name="Obelisco de Jade" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="989e-34fd-9c68-c280">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
