                    <profile name="Corona de llama arcana" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="7c56-505b-b446-4389">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de carga</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad ha cargado este turno, elige como objetivo una unidad enemiga en combate con ella.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira 9 dados. Por cada 5+, inflige 1 de daño mortal al objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
