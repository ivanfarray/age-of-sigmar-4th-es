              <selectionEntries>
                <selectionEntry name="Astillar hechizo" id="3421-9c83-676a-8b2e" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="bd92-4346-3d1d-51c1" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Astillar hechizo" id="1b64-b2a1-3a28-60ff" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, reacción: Declaraste una habilidad **^^Hechizo^^** para esta unidad.</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si ese hechizo se lanza con éxito, tira un dado. Con un 4+, después de resolver el efecto de ese hechizo, esta unidad puede lanzar inmediatamente ese hechizo una segunda vez usando la misma tirada de lanzamiento. No cuentes el segundo hechizo para el número de habilidades **^^Hechizo^^** que esta unidad puede usar este turno.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Impulsado por el destino" id="4a41-bb1f-d4a1-a6a2" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="2644-5247-baef-ad19" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Impulsado por el destino" id="5bc9-434f-59c4-cd3d" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras tengas 3 o más **puntos de destino**, añade 1 a las tiradas de impacto de los ataques de esta unidad.
Mientras tengas 6 o más **puntos de destino**, añade 1 a las tiradas de herida de los ataques de esta unidad.
Mientras tengas 9 o más **puntos de destino**, añade 1 a la característica de Rend de las armas de combate de esta unidad.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
