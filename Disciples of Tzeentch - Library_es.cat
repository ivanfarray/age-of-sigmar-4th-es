            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Guardián del Pandemónium" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="eacf-6ed8-4f05-6617">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Puedes devolver D3 miniaturas abatidas a esta unidad.</characteristic>
