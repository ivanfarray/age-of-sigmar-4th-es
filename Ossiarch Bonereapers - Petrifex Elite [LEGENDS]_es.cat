      <profiles>
        <profile name="Constructos de hueso petrificado" id="b8e2-83c2-5fd5-ca91" hidden="false" publicationId="e47d-cde6-bbd2-9db9" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6"/>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4"/>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignora el primer punto de daño que se asignaría a cada unidad amiga **^^Petrifex Élite^^** en cada fase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Asalto implacable" id="936a-7300-f762-ad3a" hidden="false" publicationId="e47d-cde6-bbd2-9db9" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5"/>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4"/>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga que no sea **^^Hero Infantry^^** que haya sido destruida,</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Si el resultado es inferior al número de miniaturas de la unidad objetivo, coloca una unidad de reemplazo con la mitad de las miniaturas de la unidad objetivo (redondeando hacia arriba) en tu territorio, totalmente a 6" o menos de un borde del campo de batalla y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Golpe quebrantador" id="77a5-7d5e-8f91-faf3" hidden="false" publicationId="e47d-cde6-bbd2-9db9" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801"/>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7"/>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Cualquier fase de combate</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga **^^Petrifex Élite^^** que haya cargado este turno.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">El objetivo puede usar 2 habilidades de **^^Combatir^^** esta fase. Sin embargo, después de usar la primera, esta unidad tiene **^^Strike-last^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Avance incesante" id="cf36-96fc-8f86-ce5f" hidden="false" publicationId="e47d-cde6-bbd2-9db9" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5"/>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4"/>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Petrifex Élite^^** que esté en combate.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, no se inflige daño mortal al objetivo por habilidades de **^^Retirarse^^**, pero cuando el objetivo use una habilidad de **^^Retirarse^^**, debe terminar el movimiento más cerca del territorio enemigo o dentro de él.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
