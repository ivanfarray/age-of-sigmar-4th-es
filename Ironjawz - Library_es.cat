          </characteristics>
        </profile>
        <profile name="Daños de batalla" id="ac77-f712-7ad8-318c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 10 o más puntos de daño, la característica de Attacks de sus **Colmillos de gruñefauces** es 3.</characteristic>
          </characteristics>
        </profile>
        <profile name="Al frente de la estampida" id="106-2a7e-b0f5-d29c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad ha cargado esta fase, elige como objetivos hasta 3 unidades amigas **^^Maw‑grunta^^** totalmente a 12" o menos de esta unidad que hayan cargado este turno.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 1 **punto de ímpetu** a cada objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Impulso imparable" id="b59a-39f9-2271-db6e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad haya cargado como resultado de usar una habilidad de **^^Cargar^^**, gana 1 **punto de ímpetu**. Cada vez que use una habilidad de **^^Correr^^**, gana 2 **puntos de ímpetu**. Puede tener un máximo de 3 **puntos de ímpetu** a la vez.
Suma el número de **puntos de ímpetu** que tiene esta unidad a la característica de Damage de su **^^Colmillos de gruñefauces^^**. Al final de cada ronda de batalla, resta 1 a sus **puntos de ímpetu**, hasta un mínimo de 0.</characteristic>
          </characteristics>
        </profile>
      </profiles>
