        <profile name="¡Entrad ahí y dadles una paliza!" id="c29b-21ae-4345-b102" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
