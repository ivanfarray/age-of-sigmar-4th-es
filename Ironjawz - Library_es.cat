        <profile name="Klonk" id="2f1e-9a5-dca3-bac8" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">**Klonk** es una ficha. Puedes volver a tirar las tiradas de forja de esta unidad mientras la ficha **Klonk** de esta unidad esté en el campo de batalla. Si haces una tirada de salvación sin modificar de 1 para esta unidad, retira la ficha **Klonk** de esta unidad del campo de batalla después de que se haya resuelto la habilidad de **^^Attack^^** (el punto de daño se sigue infligiendo).</characteristic>
          </characteristics>
        </profile>
        <profile name="Poder del Gran Dios Verde" id="be8b-b8e0-cf66-346f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Mandíbulas de Hierro Infantry^^** visible totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Haz una tirada de forja de D6. Suma 1 al resultado si esta unidad va armada con **Tenazas de gruñidor**. Con un 4+, las armas de cuerpo a cuerpo del objetivo tienen **Crítico (mortal)** hasta el inicio de tu siguiente turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
