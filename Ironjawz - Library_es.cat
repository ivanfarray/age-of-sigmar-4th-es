                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, reacción: el oponente ha declarado una orden para una unidad a 12" o menos de esta unidad</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 4+, a menos que tu oponente gaste 1 punto de orden adicional para usar esa orden, la orden no tiene efecto; aun así cuenta como usada y los puntos de orden gastados para usarla se pierden igualmente.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="El Ruidoso" id="dd52-3534-5aac-4a15" hidden="true">
                      <description>Solo **^^Monster^^**. Añade la habilidad &apos;El Ruidoso&apos; al pergamino de guerra de tu héroe.</description>
                    </rule>
                  </rules>
