          <profiles>
            <profile name="Hordas abrumadoras" id="a04d-3c24-5c79-712e" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
              <attributes>
                <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Red</attribute>
                <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Defensive</attribute>
                <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Cualquier fase de combate</characteristic>
                <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige una unidad amiga **^^Serfs^^** que no haya cargado este turno y esté en combate para usar esta habilidad y, después, elige como objetivo una unidad enemiga en combate con esa unidad **^^Serfs^^**.</characteristic>
                <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">El objetivo no puede hacer movimientos de aproximación durante el resto del turno.</characteristic>
                <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
