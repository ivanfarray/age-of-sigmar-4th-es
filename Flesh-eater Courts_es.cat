          <selectionEntries>
            <selectionEntry name="Gorro de bufón" id="579d-5b7c-7449-e276" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="45a2-17d9-b109-eebf" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Gorro de bufón" id="786b-14e0-c9d8-c0bf" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de movimiento</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Gasta 1 dado de ira. Si el nivel de furia de tu oponente es inferior al tuyo, debe aumentar su nivel de furia en 1, hasta un máximo de 7.
Después, durante el resto del turno:
• Suma 1 a las tiradas de carga del objetivo.
• Cada vez que el objetivo use una habilidad de **^^Cargar^^**, si es posible, debe terminar el movimiento de carga a 1/2" o menos de esta unidad.
• Mientras el objetivo esté en combate con esta unidad, resta 1 a las tiradas de impacto de los ataques de combate del objetivo que no tengan como objetivo esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Banderas desolladas" id="7a49-f4c4-14dd-549d" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ef57-62f8-78dd-711d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Banderas desolladas" id="7737-007a-f7f3-443e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un marcador de objetivo que no controles a 18" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno, al resolver la secuencia de daño de las unidades enemigas que estén disputando el marcador de objetivo, tu oponente no puede gastar dados de ira como parte de la habilidad &apos;Combatir pese al dolor&apos;.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Anillo de visiones de pesadilla" id="cd11-9753-e21a-a8f4" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4918-5d13-a614-4719" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Anillo de visiones de pesadilla" id="4feb-2469-ed59-7494" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga en combate con esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un número de dados igual a tu nivel de furia. Suma 1 a cada resultado si esta unidad ha cargado este turno. Por cada 4+, inflige 1 de daño mortal al objetivo.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
