  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Insurrección del Culto del Cambio" id="61a3-8433-e5ea-d426" hidden="false" import="true" publicationId="72d2-ae0-e519-f2f7" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="6efd-572b-0d0f-5434" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Infiltración ilusoria" id="599d-d838-a59e-0cc3" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas no reforzadas **^^Change-cult^^** **Acólitos kairitas**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira a los objetivos del campo de batalla y vuelve a colocarlos totalmente a 3" o menos de un elemento de escenografía y sin estar en combate.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Marioneta de hilos" id="ba5a-87aa-e8f4-da4e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una **^^Hero^^** enemiga a 24" o menos y visible para una **^^Change-cult Hero^^** amiga.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, cada vez que el objetivo use una habilidad **^^Core^^**, gana 1 **punto de destino**.
**Nota del diseñador:** *Solo puedes ganar puntos de destino usando esta habilidad y la habilidad &apos;Colgante devorahechizos&apos;.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Simulacro de plata" id="caf5-ab65-716f-ce82" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si hay un **Fragmento argénteo** amigo en el campo de batalla, puedes colocar 1 **Fragmento argénteo** adicional en el campo de batalla. Debe colocarse totalmente dentro de tu territorio y a más de 3" de todos los objetivos y demás elementos de escenografía.
**Nota del diseñador**: *El Fragmento argénteo original se coloca en el Paso 1 de la fase de despliegue usando la habilidad &apos;Desplegar escenografía de facción&apos;. Esta habilidad permite colocar un segundo elemento de escenografía de este tipo y se usa en el Paso 3 de la fase de despliegue, después de que los ejércitos hayan sido desplegados.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Superado por los acontecimientos" id="ea7c-4670-a748-8951" hidden="false" typeId="9b15-469e-8bf3-70c7" typeName="Ability (Fate)">
          <attributes>
            <attribute name="Color" typeId="7117-6fca-9b35-9a1b">Yellow</attribute>
            <attribute name="Type" typeId="bafa-c720-e165-8c34">Special</attribute>
            <attribute name="Parent Node" typeId="65cf-bbb1-eb30-7049"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="ee08-f0bb-c101-58d5">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="74f4-c00a-61c2-280d">Gasta 1 **punto de destino**. Después, elige como objetivo una unidad enemiga a 24" o menos y visible para una **^^Change-cult Hero^^** amiga.</characteristic>
            <characteristic name="Effect" typeId="c24b-9e80-9805-8ccf">El objetivo no puede usar órdenes durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="3a10-e240-163d-d34a"/>
            <characteristic name="Used By" typeId="fb10-043b-0db8-f864"/>
            <characteristic name="Fate Points" typeId="2817-a813-f11c-2961">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Semillas de discordia" id="355b-cf43-b7a1-3e60" hidden="false" typeId="9b15-469e-8bf3-70c7" typeName="Ability (Fate)">
          <attributes>
            <attribute name="Color" typeId="7117-6fca-9b35-9a1b">Purple</attribute>
            <attribute name="Type" typeId="bafa-c720-e165-8c34">Offensive</attribute>
            <attribute name="Parent Node" typeId="65cf-bbb1-eb30-7049"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="ee08-f0bb-c101-58d5">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="74f4-c00a-61c2-280d">Gasta 1 **punto de destino**. Después, elige como objetivo una unidad enemiga a 24" o menos y visible para una **^^Change-cult Hero^^** amiga, después elige como víctima otra unidad enemiga dentro del alcance de combate del objetivo.</characteristic>
            <characteristic name="Effect" typeId="c24b-9e80-9805-8ccf">Elige 1 de las armas de combate cuerpo a cuerpo del objetivo. Resuelve inmediatamente los ataques de combate del objetivo realizados con esa arma contra la víctima.</characteristic>
            <characteristic name="Keywords" typeId="3a10-e240-163d-d34a"/>
            <characteristic name="Used By" typeId="fb10-043b-0db8-f864"/>
            <characteristic name="Fate Points" typeId="2817-a813-f11c-2961">1</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
