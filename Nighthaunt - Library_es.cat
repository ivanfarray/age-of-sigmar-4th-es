                  <profiles>
                    <profile name="Devorar magia" id="9aac-2c17-0833-81d0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Tu oponente declaró una habilidad **^^Hechizo^^**</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si una unidad amiga **^^Noctánimas^^** totalmente a 12" o menos de esta unidad fue elegida como objetivo de ese hechizo, esta unidad puede usar la habilidad &apos;Desvincular&apos; como si tuviera **^^Wizard (1)^^**. Si el hechizo es desvinculado, aplica **Heal (D3)** a esta unidad.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Devorador arcano" id="6cfc-abfd-d586-7250" hidden="true">
                      <description>Solo unidades que no sean **^^Wizard^^**. Tu héroe obtiene la habilidad &apos;Devorar magia&apos;.</description>
                    </rule>
                  </rules>
                </selectionEntry>
