        <profile name="Velas de cadáver" id="3698-696e-ea48-4852" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo esta unidad o una unidad enemiga visible a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si elegiste esta unidad, asigna 1 punto de daño a esta unidad y añade 1 a sus tiradas de lanzamiento durante el resto del turno (no pueden hacerse tiradas de salvaguardia por ese punto de daño).
Si elegiste una unidad enemiga, tira un dado. Con un 3+, inflige 1 de daño mortal a esa unidad enemiga y, durante el resto del turno:
• Añade 1 a las tiradas de lanzamiento de esta unidad.
• Añade 1 al nivel de poder de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Justicia sombría" id="4638-69e1-b541-7746" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" id="48c2-5f42-2ed9-3e5a" hidden="false" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" id="b546-845b-7fba-2639" hidden="false" typeId="fd7f-888d-3257-a12b">Añade 1 a las tiradas de impacto y de herida de los ataques realizados con el **Segador siniestro** de esta unidad si el objetivo es un **^^Priest^^** o un **^^Wizard^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tormenta de espectros" id="d09b-1ffa-f0e5-636b" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad y después haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflige D3 de daño mortal al objetivo. Si alguna miniatura es abatida como resultado de esta habilidad, inflige otros D3 de daño mortal al objetivo</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
