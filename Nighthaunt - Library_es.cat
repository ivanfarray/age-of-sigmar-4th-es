          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si la tirada de impacto sin modificar o la tirada de herida sin modificar de un ataque cuyo objetivo sea esta unidad es de 1-4, el ataque falla y la secuencia de ataque termina.</characteristic>
          </characteristics>
        </profile>
        <profile name="Abrumado por el pesar" id="ffa7-4783-5327-9adb" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
