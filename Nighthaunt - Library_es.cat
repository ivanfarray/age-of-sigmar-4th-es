            <characteristic name="Declare" id="9e77-bd23-2348-9752" hidden="false" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos cualquier número de unidades amigas **^^Noctánimas^^** en el campo de batalla.</characteristic>
            <characteristic name="Effect" id="3b1f-f178-ab22-fe90" hidden="false" typeId="b6f1-ba36-6cd-3b03">Por cada objetivo, puedes devolver a esa unidad un número de miniaturas abatidas con una característica de Salud combinada de hasta D3+3.</characteristic>
            <characteristic name="Keywords" id="aa7-1d11-8ac1-b3af" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Mortarca del Pesar" id="608b-2465-cbf2-96b5" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
