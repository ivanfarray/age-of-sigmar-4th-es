                    <modifier affects="profiles.Unit" field="96be-54ae-ce7b-10b7" scope="root-entry" type="set" value="7"/>
                    <modifier affects="profiles.Unit" field="fed0-d1b3-1bb8-c501" scope="root-entry" type="set" value="12&quot;"/>
                    <modifier field="category" scope="root-entry" type="remove" value="75d6-6995-dfcc-3898"/>
                    <modifier field="category" scope="root-entry" type="add" value="926c-df8c-6841-d49e"/>
                  </modifiers>
                  <rules>
                    <rule name="Corcel etéreo" id="966d-ff9c-417d-8286" hidden="true">
                      <description>Añade el arma **Cascos y dientes fantasmales de corcel etéreo** al pergamino de tu héroe.
Además, haz los siguientes cambios en el pergamino de tu héroe:
• Cambia la característica de Move a 12".
• Cambia la característica de Salud a 7.
• Sustituye la palabra clave **^^Infantry^^** por la palabra clave **^^Cavalry^^**.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Edificio de los condenados" id="7a9e-78b4-1bf9-c025" hidden="false" import="true" sortIndex="2" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-8"/>
                    <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                    <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
                  </costs>
                  <modifiers>
                    <modifier affects="profiles.Unit" field="96be-54ae-ce7b-10b7" scope="root-entry" type="set" value="7"/>
                  </modifiers>
                  <rules>
                    <rule name="Edificio de los condenados" id="1513-74f4-5e8d-d322" hidden="true">
                      <description>Elige la habilidad &apos;Tren del terror&apos; o &apos;Coloso ctónico&apos; para añadirla al pergamino de tu héroe.
Además, haz los siguientes cambios en el pergamino de tu héroe:
• Cambia la característica de Salud a 7.
• Puedes sustituir la palabra clave **^^Infantry^^** por la palabra clave **^^War Machine^^**.</description>
                    </rule>
                  </rules>
                  <selectionEntries>
                    <selectionEntry name="MÁQUINA DE GUERRA" id="bed1-e1b8-6287-2b18" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="29ab-a493-6f61-8eb3" field="selections" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <modifiers>
                        <modifier field="category" scope="root-entry" type="remove" value="75d6-6995-dfcc-3898"/>
                        <modifier field="category" scope="root-entry" type="add" value="f7bc-b618-4b5d-2bae"/>
                      </modifiers>
                    </selectionEntry>
                  </selectionEntries>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="55a0-6cb8-693a-b8df" flatten="true" hidden="false">
                      <constraints>
                        <constraint id="cb68-25e0-a407-3c11-min" field="selections" scope="parent" shared="true" type="min" value="1"/>
                        <constraint id="cb68-25e0-a407-3c11-max" field="selections" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <selectionEntries>
                        <selectionEntry name="Tren del terror" id="ccce-fd33-5091-a1c3" hidden="false" import="true" type="upgrade">
                          <constraints>
                            <constraint id="8998-2d18-f7e9-b81c" field="selections" scope="parent" shared="true" type="max" value="1"/>
                          </constraints>
                          <profiles>
                            <profile name="Tren del terror" id="3f4a-74f3-be59-d7d2" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                              <attributes>
                                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                              </attributes>
                              <characteristics>
                                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de carga</characteristic>
                                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad puede usar esta habilidad si cargó esta fase. Elige como objetivos todas las unidades enemigas a 1" o menos de esta unidad.</characteristic>
                                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 2+, ignora los modificadores positivos a las tiradas de salvación de los objetivos durante el resto del turno.</characteristic>
                                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
