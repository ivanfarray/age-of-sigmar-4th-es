                    <constraint id="c40b-cc83-cf6c-42e8" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Justicia de la muerte" id="8330-af8a-b8bb-bcc3" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad enemiga a 18" o menos de esta unidad para que sea una unidad **acusada** durante el resto de la batalla.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">La próxima vez que esa unidad **acusada** use una habilidad **^^Core^^**, inflígele D3 de daño mortal después de resolver esa habilidad.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
