          <characteristics>
            <characteristic name="Keywords" id="f0e-23e4-a384-c08c" hidden="false" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" id="44c2-274f-4ef1-ab70" hidden="false" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad use una habilidad **^^Combatir^^**, después de resolver esa habilidad **^^Combatir^^**, aplica **Curar (X)** a esta unidad, donde X es el número de puntos de daño asignados a unidades enemigas mediante ataques de combate realizados como parte de esa habilidad **^^Combatir^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supervisor de infantería" id="8ed9-aa42-dcb2-eeda" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
