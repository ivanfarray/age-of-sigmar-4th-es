        </profile>
        <profile name="Pasaje por los inframundos" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="859a-f549-5b04-032d">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad no está en combate, elige como objetivo una unidad amiga **^^Nighthaunt^^** que no sea **^^Hero^^**, no esté en combate y esté totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira esta unidad y el objetivo del campo de batalla y después vuelve a colocarlos en el campo de batalla totalmente a 6" o menos entre sí y a más de 7" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Gray</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
