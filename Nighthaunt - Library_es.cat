        <profile name="Carruaje desbocado" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="8e30-3a62-8d8d-689e">
          <characteristics>
            <characteristic name="Timing" id="ee34-5fbd-8b52-548b" hidden="false" typeId="652c-3d84-4e7-14f4">Cualquier fase de carga</characteristic>
            <characteristic name="Declare" id="42b5-c953-5f1-c631" hidden="false" typeId="bad3-f9c5-ba46-18cb">Si esta unidad ha cargado esta fase, elige como objetivo una unidad enemiga a 1" o menos de ella.</characteristic>
            <characteristic name="Effect" id="3cfb-37bb-beb0-aff2" hidden="false" typeId="b6f1-ba36-6cd-3b03">Tira un D3. Con un 2+, inflige al objetivo una cantidad de daño mortal igual al resultado.</characteristic>
            <characteristic name="Keywords" id="602e-db0c-813e-e297" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Orange</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Nimbo de poder" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="bcd8-1993-c889-100b">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad no está en combate, retírala del campo de batalla y vuelve a colocarla en el campo de batalla a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Básica^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Gray</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Evocación de la muerte" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="2e01-d5f2-5c3b-ff14">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si se asignaron puntos de daño a una unidad enemiga mediante los ataques de combate de esta unidad este turno y esa unidad enemiga fue destruida este turno, elige un **^^Nighthaunt Hero^^** amigo que no sea **^^Unique^^** y haya sido destruido.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca una unidad de reemplazo totalmente a 12" o menos de esta unidad. La unidad de reemplazo solo puede colocarse en combate con unidades enemigas que estén en combate con esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Purple</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
