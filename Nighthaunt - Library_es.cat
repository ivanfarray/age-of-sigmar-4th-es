                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" id="6e8a-9a16-4941-6299" hidden="false" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" id="7c58-b186-4495-4d25" hidden="false" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad use una habilidad **^^Combatir^^**, después de resolver esa habilidad **^^Combatir^^**, aplica **Curar (X)** a esta unidad, donde X es el número de puntos de daño asignados a unidades enemigas mediante ataques de combate realizados como parte de esa habilidad **^^Combatir^^**.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Caballero de los sudarios" id="e1c7-4f27-ab74-5def" hidden="true">
                      <description>La **Hoja maligna** de tu héroe tiene una característica de Attacks de 5 y **Crítico (herida automática)**. Además, tu héroe obtiene la habilidad &apos;Horas robadas&apos; y las siguientes opciones de regimiento:
Cualquier unidad **^^Noctánimas^^**</description>
                    </rule>
                  </rules>
                </selectionEntry>
