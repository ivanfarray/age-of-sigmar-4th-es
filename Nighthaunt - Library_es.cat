      <profiles>
        <profile name="Kurdoss Valentian, el Rey Cobarde" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="2d78-6df3-292d-6c4d">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="¡Salve, Kurdoss! ¡Rey de la Nada!" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="7b27-efd7-5737-650a">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad cargó esta fase, elige como objetivo una unidad amiga de **Guardia del trono cobarde** que no esté en combate.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El objetivo puede usar inmediatamente una habilidad **^^Disparar^^** como si fuera tu fase de disparo, pero todos sus ataques deben tener como objetivo una unidad enemiga en combate con esta unidad. El objetivo no puede usar habilidades **^^Cargar^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="¡Si yo no puedo gobernar, nadie lo hará!" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="20f8-9166-47fb-43d9">
          <characteristics>
            <characteristic name="Timing" id="2bcc-9ce7-63d8-a92b" hidden="false" typeId="652c-3d84-4e7-14f4">Una vez por turno, reacción: el oponente ha declarado una orden para una unidad a 12" o menos de esta unidad</characteristic>
            <characteristic name="Declare" id="f139-5560-683d-59a7" hidden="false" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" id="bda1-63f8-ee44-8e7d" hidden="false" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, salvo que tu oponente gaste 1 punto de orden adicional para usar esa orden, la orden no tiene efecto, sigue contando como usada y los puntos de orden gastados para usarla se pierden igualmente.</characteristic>
            <characteristic name="Keywords" id="f749-2e46-1370-9033" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Black</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
