      </categoryLinks>
      <profiles>
        <profile name="Nexo del pesar" id="70dc-1068-35f2-0262" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Remodelación espantosa" id="4b77-1a79-0b84-2646" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **Nexo del pesar** amigo y después elige como objetivos hasta 3 unidades amigas **^^Noctánimas^^** totalmente a 12" o menos de él. No puedes elegir la misma unidad como objetivo de esta habilidad más de una vez por fase.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Por cada objetivo:
• Si el objetivo está dañado, aplica **Heal (D3)** al objetivo.
• Si el objetivo no está dañado, devuélvele un número de miniaturas abatidas con una característica de Salud combinada de hasta D3.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Gritos de los penitentes" id="391a-f304-cc8f-56b0" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las unidades enemigas no pueden usar órdenes mientras estén a 3" o menos de este elemento de escenografía.</characteristic>
          </characteristics>
        </profile>
        <profile name="Criptas hambrientas" id="53a0-0c1a-5694-33a3" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira este elemento de escenografía del campo de batalla y vuelve a colocarlo en el campo de batalla a 3" o menos de una unidad amiga **^^Noctánimas^^**, a más de 3" de todos los objetivos y unidades enemigas, a más de 1" de todos los elementos de escenografía y a más de 12" de todos los demás **Nexuses of Grief** amigos.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Nexo del pesar" id="2fb0-b403-50b2-cdd3" hidden="false">
          <description>**Las siguientes habilidades universales de escenografía se aplican a este elemento de escenografía (Terrain, 1.2):
Cobertura, Infranqueable**</description>
        </rule>
        <rule name="Tamaño de peana" id="aa58-1cbe-4dbe-6eb9" hidden="true">
          <description>Usar miniatura</description>
        </rule>
      </rules>
    </selectionEntry>
