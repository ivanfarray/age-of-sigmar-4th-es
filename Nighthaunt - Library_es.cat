          </characteristics>
        </profile>
        <profile name="Daños de batalla" id="77fd-ea7b-a33a-8355" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" id="d853-68b2-d888-f1da" hidden="false" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" id="c13b-aeac-881-cc0b" hidden="false" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 10 o más puntos de daño, resta 3 a su nivel de poder.</characteristic>
          </characteristics>
        </profile>
        <profile name="El Bastón del Poder" id="a057-d767-3e60-ad7e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" id="c617-2f56-7608-ab20" hidden="false" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" id="a35b-2e14-b24d-10d7" hidden="false" typeId="fd7f-888d-3257-a12b">Suma 2 a las tiradas de lanzamiento de esta unidad mientras no haya fallado el lanzamiento de ningún hechizo este turno. Si esta unidad falla el lanzamiento de un hechizo, ignora la restricción que le impediría lanzar más hechizos este turno.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mano de polvo" id="e02a-729c-d7f3-7445" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hero^^** o **^^Monster^^** enemigo visible en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esconde un dado en una de tus manos o debajo de uno de dos recipientes adecuados. Tu oponente debe elegir una de tus manos o recipientes. Si elige el que esconde el dado, esta habilidad no tiene efecto. Si elige el vacío, el objetivo es destruido automáticamente.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Señor Supremo de los No Muertos" id="c991-3cd3-fb95-b2ad" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" id="df57-39da-54bb-5a4b" hidden="false" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de héroe</characteristic>
            <characteristic name="Declare" id="ae93-a259-b279-9db9" hidden="false" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Death^^** que no sea **^^Hero^^** ni **^^Unique^^** y que haya sido destruida.</characteristic>
            <characteristic name="Effect" id="3b00-6a39-bbe1-8da0" hidden="false" typeId="b6f1-ba36-6cd-3b03">Coloca una unidad de reemplazo idéntica al objetivo totalmente a 12" o menos de esta unidad y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" id="1430-7f77-7d0d-e27" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Invocación de Nagash" id="5a30-3bcf-8c86-14d" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Esta unidad puede lanzar este hechizo más de una vez por fase. Elige como objetivo una unidad visible totalmente a 18" o menos de esta unidad que no haya sido elegida como objetivo de este hechizo este turno y después haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Si el objetivo es una unidad enemiga, inflígele D3 de daño mortal. Si el objetivo es una unidad amiga **^^Death^^**, elige 1 de los siguientes efectos:
• Devuelve a la unidad objetivo un número de miniaturas abatidas con una característica de Salud combinada de hasta 3.
• Si el objetivo no fue colocado este turno y no está en combate, puede moverse hasta 3". No puede entrar en combate.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
