                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Puedes volver a tirar las tiradas de impacto de los ataques de combate de esta unidad cuyo objetivo sean unidades **^^Order^^**. Además, puedes volver a tirar las tiradas de herida de los ataques de combate de esta unidad cuyo objetivo sean unidades **^^Stormcast Etetrnals^^**.</characteristic>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
