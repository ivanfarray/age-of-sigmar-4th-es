                <selectionEntry type="upgrade" import="true" name="Gastrónomo nihilista" hidden="false" id="fb31-389d-a157-3d26" sortIndex="3">
                  <profiles>
                    <profile name="Gastrónomo nihilista" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="2c00-6a13-6289-0758">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Nighthaunt^^**.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, mientras el objetivo esté dentro del alcance de combate de esta unidad, cada vez que una miniatura de la unidad objetivo sea abatida, aplica **Heal (1)** a esta unidad.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-2"/>
                  </costs>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Parecido espantoso" hidden="false" id="45cc-9b9e-7f6d-56c4" sortIndex="1">
                  <profiles>
                    <profile name="Parecido espantoso" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="fbd9-789c-cfa4-544e">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga en combate con esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, durante el resto del turno:
• Esta unidad no puede ser elegida como objetivo de los movimientos de aproximación del objetivo.
• Salvo la habilidad de arma **Compañero**, las habilidades de arma de los ataques cuyo objetivo sea esta unidad no tienen efecto.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
