    <selectionEntry name="Nexo del pesar" id="ca5e-5353-81bc-4e13" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="DEATH" id="8689-bf9b-15b7-0aa0" hidden="false" primary="false" targetId="d484-a2d7-cf4f-c4a0"/>
        <categoryLink name="FACTION TERRAIN" id="6bd8-b9da-18cd-3295" hidden="false" primary="true" targetId="cdd6-ffa1-9b32-4cb8"/>
