            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si se asignaron puntos de daño a una unidad enemiga mediante los ataques de combate de esta unidad este turno y esa unidad enemiga fue destruida este turno, elige un **^^Noctánimas Hero^^** amigo que no sea **^^Unique^^** y haya sido destruido.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca una unidad de reemplazo totalmente a 12" o menos de esta unidad. La unidad de reemplazo solo puede colocarse en combate con unidades enemigas que estén en combate con esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
