      <profiles>
        <profile name="Nagash, Señor Supremo de los No Muertos" id="f6d8-5e02-e519-2483" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" id="3696-794e-b7f5-9667" hidden="false" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic>
            <characteristic name="Health" id="44be-d249-9c49-9542" hidden="false" typeId="96be-54ae-ce7b-10b7">18</characteristic>
