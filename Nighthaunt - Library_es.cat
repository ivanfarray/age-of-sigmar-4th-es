                              <characteristics>
                                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de carga</characteristic>
                                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad puede usar esta habilidad si cargó esta fase.</characteristic>
                                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3. Con un 2+, añade el resultado a la característica de Attacks de las armas de combate de esta unidad durante el resto del turno.</characteristic>
                                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
