    <selectionEntry type="unit" import="true" name="Carruaje negro (Azote de Aqshy)" hidden="false" id="81d3-2d76-65b3-6081">
      <profiles>
        <profile name="Carruaje negro" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="e5c7-2a1a-cc32-448b">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Asistentes espectrales" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="a8c9-bdea-e8c8-1ab6">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de los siguientes para aplicarlo durante el resto del turno:
**Hoja noble:** Las armas de combate de esta unidad, incluidas las armas **Compañero**, tienen **Crítico (mortal)** en lugar de **Crítico (herida automática)**.
**Grial impío:** Cada vez que una unidad amiga **^^Nighthaunt^^** totalmente a 12" o menos de esta unidad use la orden &apos;Reagrupamiento&apos;, recibes 3 puntos de reagrupamiento adicionales.
**Tomo del saber de la no muerte:** Esta unidad tiene **^^Wizard (1)^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Yellow</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Una parada, sin retorno" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="9537-43c5-c74f-049c">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un marcador de objetivo que no controles.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, mientras las unidades enemigas estén disputando el objetivo elegido, los ataques de esas unidades no pueden conseguir impactos críticos mientras esta unidad también lo esté disputando (trátalos como impactos normales en su lugar).</characteristic>
