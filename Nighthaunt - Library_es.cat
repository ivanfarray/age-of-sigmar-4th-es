            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Sin descanso para los malvados" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f367-31f5-d9dc-6d28">
          <characteristics>
            <characteristic name="Timing" id="9ca0-d254-574b-b8df" hidden="false" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de héroe</characteristic>
            <characteristic name="Declare" id="9e77-bd23-2348-9752" hidden="false" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos cualquier número de unidades amigas **^^Nighthaunt^^** en el campo de batalla.</characteristic>
            <characteristic name="Effect" id="3b1f-f178-ab22-fe90" hidden="false" typeId="b6f1-ba36-6cd-3b03">Por cada objetivo, puedes devolver a esa unidad un número de miniaturas abatidas con una característica de Health combinada de hasta D3+3.</characteristic>
            <characteristic name="Keywords" id="aa7-1d11-8ac1-b3af" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
