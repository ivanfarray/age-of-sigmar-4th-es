            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Espectros aterradores" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="5b2b-6faa-8a05-a336">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad enemiga en combate con esta unidad como objetivo enemigo. Después, puedes elegir un **^^Nighthaunt Hero^^** amigo en combate con el objetivo enemigo como objetivo amigo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Puedes gastar 1 **dado de ira**. Si lo haces:
• Aplica el efecto de abajo.
• Si el **nivel de furia** de tu oponente es inferior al tuyo, debe aumentar su **nivel de furia** en 1, hasta un máximo de 7.
En caso contrario, tira un dado. Con un 3+, aplica el efecto de abajo.
Durante el resto del turno:
• Resta 1 a las tiradas de impacto de los ataques del objetivo enemigo que no tengan como objetivo esta unidad.
• Ignora los modificadores positivos a las tiradas de impacto de los ataques del objetivo enemigo.
• Si elegiste un objetivo amigo, añade 1 a la característica de Damage de sus armas de combate para los ataques cuyo objetivo sea el objetivo enemigo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Red</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="INFANTRY" hidden="false" id="ed0b-953e-7392-259e" targetId="75d6-6995-dfcc-3898" primary="true"/>
        <categoryLink name="DEATH" hidden="false" id="6027-f072-e25b-3cb1" targetId="d484-a2d7-cf4f-c4a0" primary="false"/>
        <categoryLink name="FLY" hidden="false" id="065c-999d-3835-82bf" targetId="b979-4c3e-7d0e-6921" primary="false"/>
        <categoryLink name="NIGHTHAUNT" hidden="false" id="4ec7-cdc4-5d9a-978b" targetId="e3a4-4581-9f76-4215" primary="false"/>
