                  <profiles>
                    <profile name="¡Eso es mío!" id="2859-caee-f5dd-c5f6" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hero^^** enemigo en combate con esta unidad y, después, elige un artefacto de poder que tenga el objetivo o 1 de sus armas de cuerpo a cuerpo.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, si has elegido un artefacto de poder, el objetivo deja de tener ese artefacto de poder. Si has elegido un arma de cuerpo a cuerpo, esa arma tiene una característica de Rend de &apos;-&apos; durante el resto de la batalla.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="El saqueador de la vieja Estrua" id="6009-d73b-4869-4fc0" hidden="true">
                      <description>Añade la habilidad &apos;¡Eso es mío!&apos; al pergamino de tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
