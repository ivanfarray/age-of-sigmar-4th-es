                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"></characteristic>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 2 a las tiradas de desmán de esta unidad mientras esté a 3" o menos de algún elemento de escenografía de facción enemigo.</characteristic>
                      </characteristics>
