            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad use la habilidad &apos;Carga de gigante&apos;, suma 1 a la cantidad de daño mortal infligido, si lo hay, por cada miniatura de esta unidad.</characteristic>
          </characteristics>
        </profile>
