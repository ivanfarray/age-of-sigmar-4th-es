<catalogue name="Hijos de Behemat - Biblioteca" id="e691-c828-52e1-f1a8" battleScribeVersion="2.03" gameSystemId="e51d-b1a3-75fc-dc3g" gameSystemRevision="2" library="true" revision="22" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <sharedProfiles>
    <profile name="Hijo de Behemat" id="ff24-51d-54d2-c80b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad fuera a ser destruida automáticamente, no queda destruida automáticamente. En su lugar, asígnale 6 puntos de daño (no se pueden hacer tiradas de salvaguardia contra esos puntos de daño).</characteristic>
      </characteristics>
    </profile>
    <profile name="Zanquilargos" id="c219-8bc2-6da1-f74f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad puede atravesar miniaturas de unidades que no sean **^^Monster^^** y partes de elementos de escenografía de menos de 4" de altura.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
