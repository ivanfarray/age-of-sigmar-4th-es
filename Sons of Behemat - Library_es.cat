          </characteristics>
        </profile>
        <profile name="Daños de batalla" id="9d8a-8e5f-2070-1a12" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 15 o más puntos de daño, la característica de Attacks de su **Obelisco de Tor Crania** es 4 y esta unidad tiene una característica de Control de 10.</characteristic>
          </characteristics>
        </profile>
        <profile name="Trepadores" id="3a28-2ca4-157d-661c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad no puede ser elegida como objetivo de habilidades de **^^Rampage^^** enemigas.</characteristic>
          </characteristics>
        </profile>
        <profile name="Poder de Behemat" id="3807-d745-251a-dbb7" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
          <attributes>
            <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
            <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
            <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
            <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
            <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Haz una tirada de cántico de D6.</characteristic>
            <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Elige 1 de los siguientes efectos. Si la tirada de cántico fue de 10+, elige 2 en su lugar:
***Quebrar las montañas:*** Suma 2" a la característica de Move de las unidades amigas **^^Hijos de Behemat^^** durante el resto del turno.
***Poderío de la tierra:*** **Heal (D3)** cada unidad amiga **^^Hijos de Behemat^^**.
***Reducirlo todo a polvo a golpes:*** Durante el resto del turno, suma 1 a la característica de Rend del **Obelisco de Tor Crania**, **Garrote de menhir**, **Mayal aplastafortalezas**, **Garrote de guerra destrozabarcos**, **Garrote de roca titánico** y **Garrote enorme** usados por unidades Hijos de Behemat amigas.</characteristic>
            <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
