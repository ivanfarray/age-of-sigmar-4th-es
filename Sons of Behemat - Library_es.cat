          </characteristics>
        </profile>
        <profile name="Daños de batalla" id="a62f-378-39d9-958" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 15 o más puntos de daño, el atributo Attacks de su **Garrote de guerra destrozabarcos** es 11 para **Calamitous Sweep** y 4 para **Crushing Blow**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Garrote de guerra destrozabarcos" id="4233-2fe2-855b-0a48" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad use una habilidad **^^Combatir^^**, elige los atributos de arma **Calamitous Sweep** o **Crushing Blow** para todos los ataques que haga con su **Garrote de guerra destrozabarcos**.</characteristic>
          </characteristics>
        </profile>
        <profile name="¡Fuera de mis tierras!" id="1551-87b7-fda3-3eba" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un marcador de objetivo o un elemento de escenografía del campo de batalla.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, el objetivo es el **alijo de botín** de esta unidad.

Mientras la unidad que usó esta habilidad esté disputando su **alijo de botín**, suma 10 a su puntuación de control.

Mientras la unidad que usó esta habilidad no esté disputando su **alijo de botín**, suma 2 al atributo Attacks de su **Pisotón todopoderoso**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Fanfarrones codiciosos" id="5d55-cd32-b105-e074" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo otra unidad amiga visible **^^Big^^** o **^^Little^^** totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está disputando su **alijo de botín**, aplica el efecto de abajo. Si no, haz una tirada de Rampage de D6. Con un 3+, aplica el efecto de abajo.

Suma 1 a las tiradas de carga del objetivo durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
