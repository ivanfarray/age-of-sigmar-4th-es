                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga en combate con esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Si el resultado iguala o supera la característica de Salud del objetivo, inflige al objetivo una cantidad de daño mortal igual a su característica de Salud.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"></characteristic>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Aplastaelfos" id="363f-d46d-2e0a-367b" hidden="true">
                      <description>Añade la habilidad &apos;Agarre asesino&apos; al pergamino de tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="El saqueador de la vieja Estrua" id="b3dc-9068-7e60-53da" hidden="false" import="true" sortIndex="5" type="upgrade">
