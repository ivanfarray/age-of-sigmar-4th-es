      </categoryLinks>
      <entryLinks>
        <entryLink name="General" id="5871-4d20-461-b17c" hidden="false" import="true" targetId="a56b-952e-ad15-7868" type="selectionEntry"/>
      </entryLinks>
      <profiles>
        <profile name="Mariscal de los Gremios Libres y emisario de reliquias" id="49b9-ad15-e5ba-ad18" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Comandante de primera línea" id="3bce-aa90-96d2-acc9" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Red</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Offensive</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por batalla (ejército), Reacción: Has declarado una habilidad **^^Combatir^^** para esta unidad.</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086"/>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Si esta unidad está **bajo órdenes**, elige una unidad **^^Sigmarite Infantry^^** o **^^Monster^^** amiga que esté totalmente a 12" o menos de esta unidad o tenga el **Relic Envoy** de esta unidad junto a ella, y que no haya usado una habilidad **^^Combatir^^** en este turno, como blanco. Se puede elegir al blanco para usar una habilidad **^^Combatir^^** inmediatamente después de resolver la habilidad **^^Combatir^^** usada por esta unidad. Si se elige para hacerlo, el blanco puede usar 2 habilidades **^^Combatir^^** en esta fase. Sin embargo, después de usar la primera, el blanco tiene **^^Strike-last^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Emisario de reliquias asistente" id="2112-548a-2352-e516" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
