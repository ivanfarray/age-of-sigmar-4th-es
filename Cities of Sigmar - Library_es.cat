          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras una unidad **Callis y Toll** amiga esté totalmente dentro del alcance de combate de esta unidad, tanto esta unidad como esa unidad amiga tienen **^^Ward (5+)^^**.</characteristic>
          </characteristics>
        </profile>
