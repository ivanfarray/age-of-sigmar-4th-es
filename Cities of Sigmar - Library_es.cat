      <profiles>
        <profile name="Jorvan Kreel, Heredero del Kraken" id="24f0-6ac4-377f-f0c0" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Ataques de hostigamiento" id="0758-9662-bc46-755e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras la **Thexa** de esta unidad esté junto a una unidad enemiga, los ataques de esa unidad enemiga no pueden obtener impactos críticos (trátalos como impactos normales).</characteristic>
          </characteristics>
        </profile>
        <profile name="Pantera de ceniza al acecho" id="ebde-a75b-562f-c7fb" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">La **Thexa** de esta unidad es una ficha. Si la **Thexa** de esta unidad no está en el campo de batalla, elige una unidad enemiga en combate con esta unidad como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca la **Thexa** de esta unidad junto al blanco y, después, tira un D3. Con un 2+, inflige al blanco una cantidad de daño mortal igual a la tirada. Si el blanco es destruido mientras la **Thexa** de esta unidad está junto a él, retira la **Thexa** de esta unidad del campo de batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Estilo de combate fluido" id="109d-d64b-fe8b-49e0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una habilidad **^^Combatir^^** para esta unidad o para una unidad **^^Sigmarite Infantry^^** que no sea **^^Hero^^**, totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Inmediatamente después de resolver la habilidad **^^Combatir^^** usada por esa unidad, elige un punto del campo de batalla a 6" o menos de esta unidad y a más de 3" de todas las unidades (amigas y enemigas) y elementos de terreno. Retira del campo de batalla la unidad que haya usado la habilidad **^^Combatir^^** y vuelve a colocarla totalmente a 6" o menos de ese punto y sin estar en combate.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
