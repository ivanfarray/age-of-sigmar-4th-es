            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad no ha cargado en este turno, suma 1 a los atributos Attacks y Damage de sus armas de combate.</characteristic>
          </characteristics>
        </profile>
        <profile name="Quebrarlos contra las murallas" id="ccc8-16f8-f643-24bd" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
