      <profiles>
        <profile name="Pontífice Zenestra, Matriarca de la Gran Rueda" id="d548-daa2-7bbc-e1aa" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">9</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Palabra del Dios Rey" id="4724-5e9b-7d8e-200f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Wizard^^**, **^^Priest^^** o **^^Manifestation^^** enemigo visible a 18" o menos de esta unidad como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+:
• Si el blanco es una **^^Manifestation^^**, queda desterrado y se retira del campo de batalla.
• Si el blanco es **^^Wizard^^** o **^^Priest^^**, inflige al blanco una cantidad de daño mortal igual a la tirada.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Voluntad de Sigmar" id="7197-e46a-d08b-94d0" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
          <attributes>
            <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
            <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
            <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
            <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
            <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Haz una tirada de cántico de D6. Si la tirada sin modificar es un 1, puedes volver a tirar el dado.</characteristic>
            <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Elige 1 de los siguientes efectos. Elige hasta 2 efectos distintos en su lugar si la tirada de cántico ha sido de 10+.
***Suelo sagrado:*** Hasta el inicio de tu próximo turno, las unidades enemigas que usen la habilidad &apos;Movimiento normal&apos; no pueden terminar ese movimiento a 5" o menos de una unidad **^^Ciudades de Sigmar Human^^** amiga mientras esta esté totalmente a 12" o menos de esta unidad.
***Plegarias fervientes:*** Hasta el inicio de tu próximo turno, cada vez que una miniatura **^^Ciudades de Sigmar Human^^** amiga sea abatida por un ataque de combate mientras esté totalmente a 12" o menos de esta unidad y esa miniatura estuviera en combate con la unidad atacante, tira un dado. Con un 6, inflige 1 daño mortal a la unidad atacante después de resolver la habilidad **^^Combatir^^**.
***Salvación:*** Elige 1 unidad **^^Ciudades de Sigmar Human^^** amiga que esté a más de 12" de esta unidad y no esté en combate como blanco. Retira al blanco del campo de batalla y vuelve a colocarlo totalmente a 12" o menos de esta unidad y a más de 9" de todas las unidades enemigas. Esa unidad no puede usar habilidades **^^Cargar^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Pontífice Zenestra, Matriarca de la Gran Rueda" id="b013-bc35-399d-0fcf" hidden="false" import="true" type="model">
          <constraints>
