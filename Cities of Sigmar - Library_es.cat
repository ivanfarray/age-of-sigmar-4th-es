                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition childId="716d-fe9e-86f5-ee75" field="selections" includeChildForces="true" includeChildSelections="true" scope="root-entry" shared="true" type="lessThan" value="1"/>
                            <condition childId="fc48-e501-434f-f980" field="selections" includeChildForces="true" includeChildSelections="true" scope="root-entry" shared="true" type="lessThan" value="1"/>
