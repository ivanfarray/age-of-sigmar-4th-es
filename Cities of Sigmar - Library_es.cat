          </characteristics>
        </profile>
        <profile name="Fuego de forja" id="f804-1d1d-1d46-ace3" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
          <attributes>
            <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
            <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
            <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
            <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
            <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige una unidad **^^Ciudades de Sigmar Duardin^^** amiga totalmente a 12" o menos de esta unidad como blanco y, después, haz una tirada de cántico de D6.</characteristic>
            <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Si la tirada de cántico ha sido de 10+, puedes elegir otra unidad válida como segundo blanco. Hasta el inicio de tu próximo turno, suma 1 al atributo Rend de las armas de combate de cada blanco.</characteristic>
            <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
