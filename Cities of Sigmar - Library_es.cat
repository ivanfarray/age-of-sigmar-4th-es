                  </characteristics>
                  <modifiers>
                    <modifier field="24f8-3803-4ab1-3b6c" type="set" value="Pick a visible enemy unit within 6&quot; of this unit to be the target, then make a casting roll of 2D6.">
                      <conditions>
                        <condition childId="4cf1-e9b0-10ae-c529" childName="Enemy, 6&quot;" field="selections" includeChildSelections="true" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                    <modifier field="24f8-3803-4ab1-3b6c" type="set" value="Pick a visible friendly unit wholly within 6&quot; of this unit to be the target, then make a casting roll of 2D6.">
                      <conditions>
                        <condition childId="5540-9903-9b1f-a107" childName="Friendly, 6&quot;" field="selections" includeChildSelections="true" scope="root-entry" shared="true" type="atLeast" value="1"/>
