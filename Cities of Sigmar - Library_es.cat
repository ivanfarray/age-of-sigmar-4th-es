        <profile name="Crisol de ira" id="6456-4a7a-d0e4-b3c8" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Puedes gastar 1 **dado de ira**. Si lo haces:
• Aplica el efecto de abajo.
• Si el **nivel de furia** de tu oponente es inferior al tuyo, debe aumentar su nivel de furia en 1, hasta un máximo de 7.
De lo contrario, tira un dado. Con un 3+, aplica el efecto de abajo.
Hasta el inicio de tu próximo turno, suma 1 a las tiradas de lanzamiento de las unidades **^^Ciudades de Sigmar^^** amigas mientras estén totalmente a 6" o menos de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
