          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 al atributo Rend de las armas usadas para ataques que tengan como blanco a **^^Infantry Heroes^^** amigos mientras esas unidades amigas estén a 3" o menos de esta unidad.</characteristic>
          </characteristics>
