          </characteristics>
        </profile>
        <profile name="Incineración incandescente" id="f726-3695-c3c0-458c" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad y después haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Si el blanco no estaba **incandescente** cuando fue elegido como blanco de este hechizo:
• Inflige D3 de daño mortal al blanco.
• El blanco está **incandescente** durante el resto de la batalla.
Si el blanco estaba **incandescente** cuando fue elegido como blanco de este hechizo:
• Asigna 3 puntos de daño al blanco (no pueden hacerse tiradas de salvaguardia para esos puntos de daño).
• El blanco deja de estar **incandescente**.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2"/>
          </characteristics>
        </profile>
        <profile name="Las llamas de Aqshy" id="18a1-61b5-2577-80dd" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Haz una tirada de manipulación arcana de D6. Con un 3+, durante el resto del turno, al elegir un blanco para la habilidad &apos;Incineración incandescente&apos;, puedes elegir una unidad enemiga visible a 18" o menos de esta unidad en lugar de a 12" o menos.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
