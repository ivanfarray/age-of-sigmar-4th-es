          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Inicio de la ronda de batalla</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad puede usar esta habilidad incluso si está **en las sombras**. Si no hay una **presa** enemiga, elige un **^^Hero^^** enemigo en el campo de batalla como blanco. Si no hay **^^Heroes^^** enemigos en el campo de batalla, elige una unidad enemiga que no sea **^^Hero^^** en el campo de batalla como blanco en su lugar.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El blanco es la **presa** durante el resto de la batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Las herramientas adecuadas" id="913d-a159-a223-9eb9" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Duplica el atributo Damage de las armas de combate de esta unidad para ataques que tengan como blanco a la **presa** enemiga.</characteristic>
          </characteristics>
        </profile>
      </profiles>
