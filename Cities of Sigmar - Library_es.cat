      </entryLinks>
      <profiles>
        <profile name="Mariscal de caballería de los Gremios Libres" id="8ad5-2121-1ad0-5e10" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="¡Por Sigmar, por la gloria!" id="9d2f-f3d6-2668-108c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado la orden &apos;Contracarga&apos; para esta unidad.</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige una unidad **^^Sigmarite Cavalry^^** amiga visible que no sea **^^Hero^^**, que esté totalmente a 12" o menos de esta unidad, no esté en combate y no haya usado una habilidad **^^Correr^^** en este turno, como blanco. Después de resolver la orden &apos;Contracarga&apos; de esta unidad, si esta unidad está en combate, el blanco puede usar inmediatamente la habilidad &apos;Cargar&apos; como si fuera tu fase de carga. Además, puedes repetir las tiradas de carga del blanco durante el resto de la fase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Arrollar al enemigo" id="b1f7-272d-c217-cb7c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad ha cargado en este turno, elige esta unidad y hasta 2 unidades **^^Sigmarite Cavalry^^** que no sean **^^Hero^^**, que hayan cargado en este turno y estén totalmente a 12" o menos de esta unidad, como blancos.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Por cada objetivo:
• Haz un movimiento de aproximación.
• Después, elige una unidad enemiga en combate con el objetivo y tira un D3. Con un 2+, inflige a esa unidad enemiga una cantidad de daño mortal igual al resultado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
