                    <modifier field="1cb9-a-1345-907f" join="

" type="append" value="For the rest of the turn, subtract 1 from hit rolls for attacks made by enemy units that target that unit.">
                      <conditions>
                        <condition childId="ebc2-1a37-1a2f-c8ce" childName="-1 to be hit" field="selections" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                    <modifier field="1cb9-a-1345-907f" join="

" type="append" value="Roll a number of dice equal to the number of models in the target unit. For each 5+:
• Inflict 1 mortal damage on the target.
• **Heal (1)** this unit.
">
                      <conditions>
                        <condition childId="a4a0-3022-db45-e882" childName="5+ horde clear/heal" field="selections" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                    <modifier field="1cb9-a-1345-907f" join="

" type="append" value="Inflict D3 mortal damage on the target.">
                      <conditions>
                        <condition childId="ccfa-8054-b950-1d2f" childName="D3 mortal damage" field="selections" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                    <modifier field="1cb9-a-1345-907f" join="

" type="append" value="Until the start of your next turn, halve the target&apos;s Move characteristic and halve charge rolls for the target.">
                      <conditions>
                        <condition childId="384b-ae0c-6ded-051e" childName="Half move/charge" field="selections" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                    <modifier field="1cb9-a-1345-907f" join="

" type="append" value="**Heal (D3)** the target and this unit.">
                      <conditions>
                        <condition childId="0f6b-058d-5e32-61fa" childName="Heal D3" field="selections" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                    <modifier field="1cb9-a-1345-907f" join="

" type="append" value="The target is not visible to units (friendly and enemy) while they are more than 3&quot; from them.">
                      <conditions>
                        <condition childId="47a5-d72b-bbed-fd5d" childName="Invisible" field="selections" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                    <modifier field="1cb9-a-1345-907f" join="

" type="append" value="Pick 1 model in the target&apos;s unit, then pick 1 of that model&apos;s melee weapons. Add 1 to the Rend and Damage characteristics of that weapon for the rest of the turn.">
                      <conditions>
                        <condition childId="011f-b582-8de3-2bbf" childName="+1 rend/damage" field="selections" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                    <modifier field="1cb9-a-1345-907f" join="

" type="append" value="For the rest of the turn, the following effects apply:
• Add 2&quot; to the target&apos;s Move characteristic.
• The target has **^^Fly^^**.
">
                      <conditions>
                        <condition childId="7e90-f0a7-50e7-611a" childName="+2&quot; move and fly" field="selections" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                    <modifier field="1cb9-a-1345-907f" join="

" type="append" value="Pick 1 weapon the target has and roll a dice. Until the start of your next turn, the Hit characteristic of that weapon is the result of the roll (e.g. a roll of 2 would change its Hit characteristic to 2+).">
                      <conditions>
                        <condition childId="b5bc-839d-c45d-6914" childName="Random hit" field="selections" scope="root-entry" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
              </profiles>
