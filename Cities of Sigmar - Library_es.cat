          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad esté **bajo órdenes**, las armas de combate de las demás unidades **^^Sigmarite^^** amigas visibles, excluidas las unidades **Gallardos de los Gremios Libres**, tienen **Anti-charge (+1 Rend)** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
        </profile>
      </profiles>
