          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que hagas una tirada de salvación sin modificar de 1 para un ataque de combate que tenga como blanco a esta unidad, inflige 1 daño mortal a la unidad atacante después de resolver esa habilidad **^^Combatir^^**.</characteristic>
          </characteristics>
        </profile>
      </profiles>
