    <selectionEntry name="Yunque de la apoteosis: mago colegiado" id="8475-af27-5753-d2fb" collapsible="false" flatten="false" hidden="true" import="true" publicationId="712d-a907-b456-e511" type="unit">
      <categoryLinks>
