              <selectionEntries>
                <selectionEntry name="Llega el momento" id="5daa-3bef-2a7c-6f68" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="c10c-3c75-4a55-adec" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Llega el momento" id="5b59-174a-0c18-de2c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de combate</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede usar hasta 3 habilidades **^^Combatir^^** en esta fase. Sin embargo, después de usar la primera, esta unidad tiene **^^Strike-last^^** durante el resto del turno y, después de usar la segunda, asigna 6 puntos de daño a esta unidad tras resolver la habilidad **^^Combatir^^** (no pueden hacerse tiradas de salvaguardia para esos puntos de daño).</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Invocación distintiva" id="8de3-ddb9-0f96-e5b2" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="8d8b-8e79-43e2-76f7" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Invocación distintiva" id="36c1-b204-091d-3224" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una habilidad **^^Hechizo^^** o **^^Prayer^^** que esta unidad pueda usar.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, esta unidad puede usar esa habilidad en la fase de héroe enemiga como si fuera tu fase de héroe.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
