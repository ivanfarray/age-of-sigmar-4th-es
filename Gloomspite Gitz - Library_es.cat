        <profile name="Daños de batalla" id="a19f-e955-9a2e-8fd" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 10 o más puntos de daño, la característica de Attacks de sus **Patas quitinosas** es 6.</characteristic>
          </characteristics>
        </profile>
        <profile name="Acechador de la telaraña de los reinos" id="bfb7-f794-521-1704" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad si no ha sido desplegada.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en reserva **correteando por túneles en la realidad**. Ahora se considera desplegada.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Terror escurridizo" id="e52c-b38a-445e-b75b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad ha cargado este turno, tira un dado. Con un 3+, puede moverse 2D6". Puede atravesar los alcances de combate de las unidades enemigas y las miniaturas de unidades **^^Infantry^^** enemigas, pero debe terminar ese movimiento en combate.
Después, elige una unidad **^^Infantry^^** enemiga por encima de la cual haya pasado esta unidad durante ese movimiento. Inflige D3 daño mortal a esa unidad enemiga.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Emboscada del más allá" id="9843-b5aa-4a9b-b8ad" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad si está **correteando por túneles** en la realidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en cualquier parte del campo de batalla a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
