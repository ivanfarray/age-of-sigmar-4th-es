                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditionGroups>
                        <conditionGroup type="or">
                          <conditions>
                            <condition childId="6d54-625c-d063-13e2" field="selections" includeChildSelections="true" scope="root-entry" shared="true" type="notInstanceOf" value="1"/>
                            <condition childId="378e-9edc-581-d24f" field="selections" includeChildSelections="true" scope="root-entry" shared="true" type="notInstanceOf" value="1"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="¡Boing y plaf!" id="0b75-5718-2da6-4951" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de carga</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad ha cargado en esta fase, elige como objetivos cualquier número de unidades enemigas a 1" o menos de ella.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado y suma el número de objetivos a la tirada. Si el resultado es menor que 6, inflige 1 daño mortal a cada objetivo y repite la secuencia, pero añade otro dado a la tirada cada vez que lo hagas.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="¡Boing y plaf!" id="6889-2a5c-a15a-d82e" hidden="true">
                      <description>Solo **^^Squig Monster^^**. Añade la habilidad &apos;¡Boing y plaf!&apos; al pergamino de tu héroe. No puedes elegir esta mejora si tu héroe tiene otra habilidad **^^Rampage^^**.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Atadura de telarañas" id="9417-a89c-cf32-38a8" hidden="false" import="true" sortIndex="7" type="upgrade">
                  <constraints>
                    <constraint id="bb2b-6efe-488a-8c6d" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-5"/>
                  </costs>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="89c9-7736-a326-a629" field="selections" includeChildSelections="true" scope="root-entry" shared="true" type="notInstanceOf" value="1"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                  <profiles>
                    <profile name="¡Atrapado en la red!" id="89e3-e71e-5012-1d6e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hero^^** enemigo a 1" o menos de esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira 2D6. Si el resultado supera la característica de Move del objetivo, hasta el inicio de tu siguiente turno, el objetivo no puede hacer movimientos de aproximación ni usar habilidades **^^Retirarse^^**.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Atadura de telarañas" id="cdcd-b883-c8b2-2937" hidden="true">
                      <description>Solo **^^Arachnarok^^**. Añade la habilidad &apos;¡Atrapado en la red!&apos; al pergamino de tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
