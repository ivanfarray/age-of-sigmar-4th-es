                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Salvo la habilidad de arma **Compañero**, las habilidades de arma de los ataques que tengan como objetivo esta unidad no tienen efecto.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="El rayo de la Mala Luna" id="0ff2-702f-47fb-dfaf" hidden="false" import="true" sortIndex="3" type="upgrade">
