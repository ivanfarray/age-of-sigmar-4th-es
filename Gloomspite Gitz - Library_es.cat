                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-4"/>
                  </costs>
                  <profiles>
                    <profile name="Tipejo furtivo" id="b1e7-0e9c-214b-450e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad no es un **^^Monster^^**, mientras esté totalmente sobre un elemento de escenografía, no es visible para las unidades enemigas que no estén dentro de su alcance de combate. Si esta unidad es un **^^Monster^^**, resta 1 a las tiradas de impacto de los ataques que tengan como objetivo esta unidad mientras esté totalmente sobre un elemento de escenografía.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup name="Defectos" id="ee3d-6ac1-7df0-9109" collapsible="true" hidden="false" sortIndex="3">
              <constraints>
                <constraint id="20a0-7169-9200-6114" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <selectionEntries>
                <selectionEntry name="Exceso de confianza de tipejo" id="78fc-811e-9977-b05d" hidden="false" import="true" sortIndex="3" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="2"/>
                  </costs>
                  <profiles>
                    <profile name="Exceso de confianza de tipejo" id="7331-4fb4-5f7f-68e2" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">En tu fase de carga, si esta unidad no está en combate y hay un **^^Hero^^** enemigo a 12" o menos de esta unidad, debe usar la habilidad &apos;Cargar&apos;; si la tirada de carga le permite terminar a 1/2" o menos de ese **^^Hero^^** enemigo, debe hacerlo.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="El último en llegar a la pelea" id="a1d3-7bc6-cf4c-f6bb" hidden="false" import="true" sortIndex="1" type="upgrade">
