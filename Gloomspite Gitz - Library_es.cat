                      </conditions>
                    </modifier>
                  </modifiers>
                  <rules>
                    <rule name="Dientes adicionales" id="f88f-1907-f15f-291d" hidden="true">
                      <description>Solo **^^Squig^^**. Suma 1 a la característica de Attacks del arma **Bocaza enorme llena de colmillos** o **Enormes bocazas llenas de colmillos** de tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Feroz hasta el final" id="7991-efa3-c079-671f" hidden="false" import="true" sortIndex="5" type="upgrade">
                  <constraints>
                    <constraint id="0df3-e85f-c693-c559" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-5"/>
                  </costs>
                  <profiles>
                    <profile name="Feroz hasta el final" id="c359-5dca-7344-278f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad es destruida, antes de retirarla del juego, elige una unidad enemiga en combate con ella y tira tantos dados como la característica de Salud de esta unidad. Por cada 5+, inflige 1 daño mortal a esa unidad enemiga.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Feroz hasta el final" id="413b-940a-f4a4-c230" hidden="true">
                      <description>Añade la habilidad &apos;Feroz hasta el final&apos; al pergamino de tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="¡Boing y plaf!" id="6a1d-c77f-90f2-c4e3" hidden="false" import="true" sortIndex="6" type="upgrade">
                  <constraints>
                    <constraint id="519c-80c3-c8ed-2f9a" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
