                  <rules>
                    <rule name="Lanzarrocas" id="2a51-7e4b-e0ab-465f" hidden="true">
                      <description>Añade el arma a distancia Lanzarrocas al pergamino de tu héroe. No puedes elegir esta mejora si tu héroe tiene otra arma a distancia **Compañero**.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Dientes adicionales" id="5498-9d75-6b35-0462" hidden="false" import="true" sortIndex="4" type="upgrade">
                  <constraints>
                    <constraint id="d3a1-ea79-5a90-a603" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
