                  </modifiers>
                  <rules>
                    <rule name="Colosal" id="d6fb-60bb-38de-65dd" hidden="true">
                      <description>Suma 2 a la característica de Salud de tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Lanzarrocas" id="7cfe-c0e8-a600-5ba9" hidden="false" import="true" sortIndex="2" type="upgrade">
