          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: El oponente ha declarado una habilidad **^^Hechizo^^**</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad ha sido elegida como objetivo de ese hechizo, tira un dado. Con un 4+, ignora el efecto de ese hechizo sobre esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Regeneración superior" id="adff-e5e7-4f3b-181e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
