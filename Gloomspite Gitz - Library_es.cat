        <profile name="Furia de garrapato" id="5c69-e4e6-cf3b-f44f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
