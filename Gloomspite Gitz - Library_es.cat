      <profiles>
        <profile name="Droggz el Mascasol" id="9e62-6cdf-8ea4-a8cd" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic>
