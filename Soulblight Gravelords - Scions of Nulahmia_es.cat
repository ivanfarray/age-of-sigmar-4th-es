  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Vástagos de Nulahmia" id="c41-f19-dfcd-a02" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="c05c-160-4602-3c2a" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="El premio de la reina" id="e992-d2d9-6ceb-79c3" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si no has usado ninguna habilidad de **^^Exquisite Plot^^** este turno. Elige como objetivo una unidad amiga.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, suma 5 a la puntuación de control del objetivo.
Además, al final de este turno, después de determinar el control de los marcadores de objetivo, si el objetivo está disputando un marcador de objetivo que controlas y que estaba controlado por tu oponente al inicio de este turno, suma 5 a la puntuación de control del objetivo durante el resto de la batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Intriga exquisita^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Realineación taumatúrgica" id="535b-9461-b0a6-c120" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si no has usado ninguna habilidad de **^^Exquisite Plot^^** este turno. Elige como objetivo un **^^Wizard^^** amigo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, suma 1 a las tiradas de lanzamiento del objetivo. Además, al final de este turno, si el objetivo ha lanzado con éxito algún hechizo este turno, suma 1 a su nivel de poder durante el resto de la batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Intriga exquisita^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Campaña de reclutamiento" id="8511-bec3-19fe-4abf" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si no has usado ninguna habilidad de **^^Exquisite Plot^^** este turno. Elige una unidad amiga para que sea el **cazador** y una unidad enemiga con 5 o más miniaturas como objetivo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, suma 1 a las tiradas de impacto de los ataques de combate del **cazador** que tengan como objetivo esa unidad enemiga. Además, si el objetivo es destruido este turno por el **cazador**, suma 1 a la característica de Attacks de las armas de cuerpo a cuerpo del **cazador** durante el resto de la batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Intriga exquisita^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Buscar sangre digna" id="421b-a1b4-ae60-c813" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si no has usado ninguna habilidad de **^^Exquisite Plot^^** este turno. Elige como objetivo una unidad amiga.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, las armas del objetivo tienen **Anti-^^Hero^^ (+1 Rend)**. Además, si el objetivo destruye algún **^^Heroes^^** enemigo este turno, las armas del objetivo tienen **Anti-^^Hero^^ (+1 Rend)** durante el resto de la batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Intriga exquisita^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
