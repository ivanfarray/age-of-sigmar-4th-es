            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Néctar del Claro de Ámbar" hidden="false" id="e4e4-838a-a42b-98d7" publicationId="61ee-fae0-f1da-2591">
              <profiles>
                <profile name="Néctar del Claro de Ámbar" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="95a9-63d1-425c-7b7e">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 6" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, suma 1 a la característica de Damage de las armas **Compañero** usadas por unidades amigas **^^Sylvaneth^^** en ataques que tengan como objetivo esa unidad enemiga.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Red</attribute>
                    <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="6a6-1cf0-f729-3f3c" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Guja de madera embrujada" hidden="false" id="7121-e09e-d407-9785" publicationId="61ee-fae0-f1da-2591">
              <profiles>
                <profile name="Guja de madera embrujada" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f04-8155-a9be-9320">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga a la que los ataques de combate de esta unidad le hayan asignado algún punto de daño este turno.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, resta 1 a las tiradas de salvación del objetivo. Esta unidad puede usar esta habilidad aunque haya sido destruida.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="d22d-88ab-b1e0-9f26" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
          <rules>
            <rule name="Restricciones de mejoras" id="ddc4-1b68-e7be-e198" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Tesoros del Claro de Guerra" id="49a2-5200-662d-c6cc" hidden="true" publicationId="f894-7929-f79a-a269">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Bellota de las eras" hidden="false" id="9d53-a568-c0b0-8d42">
              <profiles>
                <profile name="Bellota de las eras" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="ff09-db65-b50b-5724">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén totalmente a 12" o menos de esta unidad, las **Awakened Wyldwoods** amigas tienen **^^Ward (5+)^^**.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="e9c2-1a47-7f87-65d6" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Lamentiri de Ranu" hidden="false" id="2735-ee04-eec1-84d5">
              <profiles>
                <profile name="Lamentiri de Ranu" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="0405-f80c-c7d7-45d8">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), reacción: el oponente declaró una habilidad de **^^Hechizo^^** para una unidad a 30" o menos de esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Haz una tirada de desvinculación de 2D6. Si el resultado supera la tirada de lanzamiento del hechizo, el hechizo queda desvinculado y su efecto no se resuelve. Después, inflige al lanzador una cantidad de daño mortal igual a la diferencia entre la tirada de lanzamiento y la tirada de desvinculación, hasta un máximo de 6.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desvinculación^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="370b-e4ca-fd61-2959" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tejido de encantamiento" hidden="false" id="06b8-9691-ac18-5c3a">
              <profiles>
                <profile name="Tejido de encantamiento" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="6444-3488-3586-2282">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">En cada fase, puedes volver a tirar 1 tirada de impacto, 1 tirada de herida y 1 tirada de salvación de esta unidad.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="cf17-9535-a3d6-ada7" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Restricciones de mejoras" id="6d0a-cea6-d76d-5fef" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Reliquias de la naturaleza" id="e1c2-19b3-ba80-88d3" hidden="true" publicationId="9e18-bb03-7b60-d4ff">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Moscas místicas danzantes" hidden="false" id="bf45-799c-eb69-67e0">
              <profiles>
                <profile name="Moscas místicas danzantes" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="5a9b-9618-4c4a-ffde">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: el oponente declaró una habilidad de ^^**Hechizo**^^ para una unidad a 30" o menos de esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">• Si esta unidad no es **^^Wizard^^**, puede usar la habilidad &apos;Desvincular&apos; como si tuviera **^^Wizard (1)^^**. Si lo es, puede usar la habilidad &apos;Desvincular&apos; una vez adicional en cada fase.
• Si esta unidad desvincula con éxito el hechizo al que está reaccionando y el lanzador está dentro de la maleza reptante, inflige al lanzador una cantidad de daño mortal igual a la diferencia entre la tirada de lanzamiento y la tirada de desvinculación, hasta un máximo de 6.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="30c2-d865-8ca0-a9b6" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Amuleto de resonancia" hidden="false" id="78b0-4118-545b-85e8">
              <profiles>
                <profile name="Amuleto de resonancia" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="36b2-9890-eb18-e9a1">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad ha usado la habilidad &apos;Erupción de furia&apos; este turno o has gastado **dados de ira** como parte de la habilidad &apos;Combatir pese al dolor&apos; al resolver la secuencia de daño de esta unidad este turno, da 1 punto de ritual a cada **^^Sylvaneth Priest^^** amigo visible totalmente a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="c0e7-825e-fdb6-a3b2" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tejido de encantamiento" hidden="false" id="dec7-46cb-e9df-e167">
              <profiles>
                <profile name="Tejido de encantamiento" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="cafd-9cf1-871c-f47e">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">En cada fase, puedes volver a tirar 1 tirada de impacto, 1 tirada de herida y 1 tirada de salvación de esta unidad.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
