    <selectionEntryGroup name="Formaciones de batalla: Sylvaneth" id="3167-3a8b-117a-f589" hidden="false" flatten="true">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Señores del Clan" hidden="false" id="c221-6b4b-f446-59c6" publicationId="61ee-fae0-f1da-2591">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7272-c329-2b07-f60"/>
          </constraints>
          <profiles>
            <profile name="Titanes de la naturaleza" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="470d-dce9-5e70-29fb">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Al usar la habilidad &apos;Crecimiento interminable&apos;, no tires un D3 para los objetivos **^^Monster^^**. En su lugar, aplica **Heal (3)** a cada uno de esos objetivos.</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Seguidores de Kurnoth" hidden="false" id="f1ec-31e8-5064-fe66" publicationId="61ee-fae0-f1da-2591">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="83d9-919a-9331-8fbe"/>
          </constraints>
          <profiles>
            <profile name="Presa sagrada" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c880-7052-a9f5-e4dd">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Sylvaneth^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno, suma 1 a las tiradas de impacto de los ataques del objetivo mientras esté totalmente a 12" o menos del general enemigo o de un **^^Warmaster^^** enemigo.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Defensores del Claro" hidden="false" id="e792-e352-7d9-b64c" publicationId="61ee-fae0-f1da-2591">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="364d-d2e8-5df6-89ed"/>
          </constraints>
          <profiles>
            <profile name="Recuerdos de los caídos" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="5e1f-17c8-15aa-6e7f">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Por cada unidad amiga **^^Sylvaneth^^** o **Bosque salvaje despierto** amiga que haya sido destruida en el turno anterior, puedes elegir como objetivo una unidad amiga **^^Sylvaneth^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, suma 1 a la característica de Attacks de las armas de cuerpo a cuerpo de cada objetivo.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Exiliados" hidden="false" id="86c5-fa33-9428-ee16" publicationId="61ee-fae0-f1da-2591">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="68f6-e029-bff9-5389"/>
          </constraints>
          <profiles>
            <profile name="Miedo al bosque profundo" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="f18a-6e1-a8c9-c743">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">En la habilidad &apos;Terror creciente&apos;, sustituye &apos;mientras no esté totalmente a 12" o menos de un **^^Hero^^** de su ejército&apos; por &apos;mientras no esté totalmente a 6" o menos de un **^^Hero^^** de su ejército&apos;.</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Arboleda de Guerra del Crecimiento" hidden="true" id="efa1-1ee3-6317-10e9" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0d32-19ba-724f-63c9"/>
          </constraints>
          <profiles>
            <profile name="Caminar por los senderos ocultos" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="6edb-37ce-77b2-e843">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de tu turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Sylvaneth^^** que esté totalmente a 12" o menos de una **Bosque salvaje despierto** amiga.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira el objetivo del campo de batalla y colócalo de nuevo totalmente a 12" o menos de otra **Bosque salvaje despierto** amiga y a más de 9" de todos los enemigos.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Arboleda de Guerra del Ocaso Eterno" hidden="true" id="ae2c-ded5-2d0c-469d" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a38f-3984-cd26-6a1d"/>
          </constraints>
          <profiles>
            <profile name="Crepúsculo rencoroso" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="45ef-3a0f-e134-7c9a">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La primera vez en cada fase que una unidad enemiga dentro de la **maleza reptante** use una orden, inflige D3 de daño mortal a esa unidad después de que se resuelva esa orden. Si esa orden era una reacción, en su lugar inflige D3 de daño mortal a esa unidad después de que se resuelva la habilidad a la que esa orden reaccionaba.</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
