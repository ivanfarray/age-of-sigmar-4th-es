          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Aspecto de Cosecha Bendita" hidden="false" id="012e-015d-04ea-be6f">
              <profiles>
                <profile name="Aspecto de Cosecha Bendita" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="dde3-2eee-c142-a925">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 2" a la característica de Move de esta unidad mientras esté totalmente dentro de la **maleza reptante**.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
