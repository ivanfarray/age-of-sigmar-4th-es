  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Rasgos de batalla: Sylvaneth" hidden="false" id="583a-37b4-52b2-9058">
      <profiles>
        <profile name="Crecimiento interminable" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="3ff5-8812-c55e-7f5a" publicationId="61ee-fae0-f1da-2591">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos todas las unidades amigas **^^Sylvaneth^^** que estén totalmente dentro de la **maleza reptante**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Por cada objetivo, tira un D3 y elige 1 de los siguientes efectos:


• Aplica **Curar (X)** al objetivo, donde **X** es igual al resultado.
• Devuélvele un número de miniaturas abatidas con una característica de Health combinada de hasta el valor del resultado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="La maleza reptante" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="bf2f-f70a-be1e-4d63" publicationId="61ee-fae0-f1da-2591">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La **maleza reptante** se mide desde cada elemento de escenografía que tenga un **marcador de maleza** amigo. El alcance de la **maleza reptante** depende del número de **marcadores de maleza** amigos que haya en el campo de batalla, como se indica:

• 0-2 **marcadores de maleza**: 6"
• 3-5 **marcadores de maleza**: 9"
• 6-8 **marcadores de maleza**: 12"
• 9+ **marcadores de maleza**: Todo el campo de batalla


***Nota del diseñador**: Las Awakened Wyldwoods son tu principal manera de generar marcadores de maleza. Algunas habilidades de unidad también te permiten hacerlo.*</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Furia del bosque" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" hidden="false" id="081a-ebf2-6a79-c4db" publicationId="61ee-fae0-f1da-2591">
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Fase de combate enemiga</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige una unidad amiga **^^Sylvaneth^^** que esté totalmente dentro de la **maleza reptante** y que esté en combate con solo 1 unidad enemiga para usar esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">La unidad que usa esta habilidad tiene **^^Strike-first^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Red</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Offensive</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
        </profile>
        <profile name="La tierra despierta" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" hidden="false" id="dcad-fc9a-65a3-b46f" publicationId="61ee-fae0-f1da-2591">
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Final de tu turno</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga que no sea **^^Hero Revenant Infantry^^**, o una unidad amiga **Dríades**, que haya sido destruida.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de reemplazo con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba), totalmente dentro de la **maleza reptante** y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Purple</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
        </profile>
        <profile name="Reclamado por la naturaleza" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="cea9-4cb0-e5fb-bd3e" publicationId="61ee-fae0-f1da-2591">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si hay menos de 3 **Awakened Wyldwoods** amigas en el campo de batalla, puedes colocar una **Bosque salvaje despierto** en el campo de batalla a más de 3" de todos los marcadores de objetivo y unidades enemigas, a más de 12" de todas las demás **Awakened Wyldwoods** amigas y a más de 1" de todos los demás elementos de escenografía.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Terror creciente" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c9cf-21d7-880d-e59f" publicationId="61ee-fae0-f1da-2591">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), inicio de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga que esté dentro de la **maleza reptante**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, la primera vez que tu oponente declare una orden para el objetivo mientras no esté totalmente a 12" o menos de un **^^Hero^^** de su ejército, a menos que tu oponente gaste 1 punto de orden adicional para usar esa orden, la orden no tiene efecto, pero sigue contando como usada y los puntos de orden gastados en usarla se pierden igualmente.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="Reference" hidden="false" id="28-9238-9172-750f" targetId="3360-1158-e879-9606" primary="true"/>
      </categoryLinks>
    </selectionEntry>
