            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Tomo de perspicacia abrasada" id="18e0-da7a-b468-3b4d" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d218-e07a-737a-9525" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Tomo de perspicacia abrasada" id="5211-25a8-b5cb-0952" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una habilidad **^^Hechizo^^** que no es **^^Summon^^** para esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cambia la tirada de lanzamiento de ese hechizo a un valor de 12 que no se puede modificar. Ese hechizo no se puede desvincular y esta unidad no puede volver a usar esa habilidad **^^Hechizo^^** durante el resto de la batalla.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="El Ojo Abrasador" id="e2af-a842-bbc1-df75" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="018f-00c4-684c-80bc" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="El Ojo Abrasador" id="a146-fd5d-729e-2453" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una habilidad **^^Hechizo^^** para una unidad **^^Discípulos de Tzeentch^^** totalmente a 12" o menos de esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Gasta 1 **dado de ira**. Si el **nivel de furia** de tu oponente es inferior al tuyo, debe subir su **nivel de furia** en 1, hasta un máximo de 7.
Después, tira un dado. Si el resultado coincide con alguno de los dados de la tirada de lanzamiento, ese hechizo falla (miscast). Si no, suma el resultado a la tirada de lanzamiento.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Los Cinco Versos de Volarian" id="6ea8-42f5-632e-103f" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7757-1ea0-9949-b5bc" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Los Cinco Versos de Volarian" id="d49c-367f-ade1-d9b9" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
