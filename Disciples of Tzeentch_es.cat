              <profiles>
                <profile name="Invocador de plata" id="7ba6-cf74-8a9-c34d" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
                  <attributes>
                    <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Movement</attribute>
                    <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute>
                    <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
