                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad (amiga o enemiga).</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si el objetivo es destruido este turno, gana 1 **punto de destino**.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
