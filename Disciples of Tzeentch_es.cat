          <selectionEntries>
            <selectionEntry name="Tomo kairita" id="cd8a-3f1e-f25f-5a53" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ba96-75a2-4978-d67d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
