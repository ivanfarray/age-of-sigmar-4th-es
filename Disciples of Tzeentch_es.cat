                  <characteristics>
                    <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de movimiento</characteristic>
                    <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                    <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga que no sea **^^Warflock Arcanite^^** y que haya sido destruida.</characteristic>
                    <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de reemplazo con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) a más de 9" de todas las unidades enemigas y totalmente a 12" o menos de un **Fragmento argénteo** amigo que sea visible para esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Gran ilusionista" id="cc3a-4581-ff63-e6ec" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5d60-a12a-a07d-391d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="0"/>
