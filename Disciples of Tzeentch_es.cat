              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si haces una tirada de carga de 9+ para una unidad amiga **^^Discípulos de Tzeentch^^**, suma 1 a la característica de Attacks de las armas de combate cuerpo a cuerpo de esa unidad durante el resto del turno.</characteristic>
              </characteristics>
            </profile>
