                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">A efectos de la habilidad &apos;Resistencia demoníaca&apos;, esta unidad siempre cuenta como si tuviera 1 **punto de poder demoníaco** más de los que realmente tiene, hasta un máximo de 3.</characteristic>
                      </characteristics>
