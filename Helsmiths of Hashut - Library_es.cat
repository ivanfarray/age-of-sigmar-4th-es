                      <description>Añade la habilidad &apos;Cuerpo de obsidiana endurecida&apos; al pergamino de batalla de tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Aura fundecarne" id="c49b-3fbd-e241-5942" hidden="false" import="true" sortIndex="2" type="upgrade">
