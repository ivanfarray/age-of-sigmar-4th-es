          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está en combate con alguna unidad enemiga **^^Heroes^^**, puede usar 2 habilidades de **^^Combatir^^** esta fase. Sin embargo, después de usar la primera, esta unidad tiene **^^Strike-last^^** durante el resto de la fase, y solo puede ser elegida para usar una segunda habilidad de **^^Combatir^^** si sigue en combate con alguna unidad enemiga **^^Heroes^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Fuerza demoníaca" id="59d1-9ec2-9d5c-90bd" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
