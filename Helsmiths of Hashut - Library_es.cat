        <profile name="Marcha disciplinada" id="86ef-4b5b-f2a4-e4fc" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Al hacer tiradas de correr para esta unidad, si sacas un 1-3, puedes usar un valor de 4 en su lugar.</characteristic>
          </characteristics>
        </profile>
        <profile name="Resistencia demoníaca" id="1357-4360-2429-dd24" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Aplica el efecto de abajo que corresponda al número de **puntos de poder demoníaco** que tenga esta unidad:
**1** Esta unidad tiene **^^Ward (6+)^^**.
**2** Esta unidad tiene **^^Ward (5+)^^**.
**3** Esta unidad tiene **^^Ward (4+)^^** contra el daño infligido por **^^Spells^^**, **^^Prayers^^** y habilidades usadas por **^^Manifestations^^**. En caso contrario, tiene **^^Ward (5+)^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gongs sagrados" id="e95c-664b-2d66-d04f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Los **Gong Carriers** de esta unidad son fichas. Hay 1 **Gong Carrier** por cada **^^Músico^^** en esta unidad. Si esta unidad usa la orden &apos;Reagrupamiento&apos;, como reacción, puedes retirar un **Gong Carrier** para hacer una tirada de reagrupamiento de D6 adicional.</characteristic>
          </characteristics>
        </profile>
      </profiles>
