                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 2 a las tiradas de correr y de carga de esta unidad.
Además, al final de cada batalla, tira un dado. Con un 1, da a esta unidad 1 **punto de carne pétrea** y anótalo en tu lista de Path to Glory. Cuando esta unidad tenga 3 **puntos de carne pétrea**, debes retirar esta unidad de tu lista de Path to Glory.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <selectionEntries>
                    <selectionEntry name="Puntos de carne pétrea" id="c42e-df69-4b9c-5ba7" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="74eb-8760-3d91-05b3" field="selections" scope="parent" shared="true" type="max" value="3"/>
