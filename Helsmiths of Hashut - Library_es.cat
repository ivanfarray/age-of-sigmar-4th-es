      </categoryLinks>
      <entryLinks>
        <entryLink name="General" id="f9e8-89e6-00a7-2def" hidden="false" import="true" targetId="a56b-952e-ad15-7868" type="selectionEntry"/>
      </entryLinks>
      <modifiers>
        <modifier field="error" type="add" value="A roster cannot contain both the standard and Scourge of Ghyran variant of the same unit.">
          <conditions>
            <condition childId="9d64-66aa-7eaa-7b55" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
