                <constraint id="e205-bbd6-e3b0-c077" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <selectionEntries>
                <selectionEntry name="Poder mediante pactos oscuros" id="0c36-8c2b-3d8e-3aa9" hidden="false" import="true" sortIndex="2" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-2"/>
                    <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                    <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Poder mediante pactos oscuros" id="d904-4428-e0e2-dee6" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Debes usar esta habilidad en cada una de tus fases de héroe.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado y aplica el efecto correspondiente:
**1-3 *Exigencia sacrificial:*** Elige otra unidad amiga a 12" o menos de esta unidad. 1 miniatura de esa unidad queda abatida. En caso contrario, inflige D6 de daño mortal a esta unidad.
**4+ *Conocimiento prohibido:*** Elige 1 de los siguientes efectos para aplicarlo hasta el inicio de tu siguiente turno:
• Si esta unidad es un **^^Wizard^^** o un **^^Priest^^**, suma 1 a su nivel de poder.
• Suma 1 a la característica de Damage de las armas de combate cuerpo a cuerpo de esta unidad.
• Suma 3 a la puntuación de control de las unidades amigas mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Industrial despiadado" id="cd08-9c7e-bb6e-4fd7" hidden="false" import="true" sortIndex="3" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-2"/>
                  </costs>
                  <profiles>
                    <profile name="Industrial despiadado" id="dc4e-1443-a683-9302" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Durante tu campaña de Path to Glory, lleva la cuenta del número de **fichas de desolación** que das. Cada vez que la cuenta alcance un múltiplo de 15, esta unidad obtiene el siguiente rango de su Path.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <selectionEntries>
                    <selectionEntry name="Marcadores de desolación" id="356f-31af-8b99-f75b" hidden="false" import="true" type="upgrade"/>
                  </selectionEntries>
                </selectionEntry>
                <selectionEntry name="Proveedor de mecanismos oscuros" id="c93a-2cc6-63b3-642f" hidden="false" import="true" sortIndex="1" type="upgrade">
