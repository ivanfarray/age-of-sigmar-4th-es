          </characteristics>
        </profile>
        <profile name="Todo debe arder" id="99f4-cc8c-ae39-c651" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos 2 o más unidades enemigas visibles a 8" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, suma 2 a la característica de Attacks de los **Cañones de inmolación** de esta unidad por cada unidad elegida como objetivo de esta habilidad, pero cada vez que esta unidad use una habilidad de **^^Disparar^^**, debe dirigir a cada una de esas unidades al menos 3 de sus ataques.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Fuerza demoníaca" id="6f2f-d47d-0df9-468e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Por cada **punto de poder demoníaco** que tenga esta unidad:
• Suma 1" a su característica de Move
• Suma 1 a la característica de Attacks de sus armas.</characteristic>
          </characteristics>
        </profile>
      </profiles>
