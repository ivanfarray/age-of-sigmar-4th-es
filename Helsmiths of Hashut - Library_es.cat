            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 10 o más puntos de daño, la característica de Attacks de sus **Cuernos y pezuñas** es 4.</characteristic>
          </characteristics>
        </profile>
        <profile name="Presencia inmoladora" id="1c6a-8f4f-5455-6e60" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
