                    <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Proveedor de mecanismos oscuros" id="dd9f-83a0-b9f8-31cc" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^War Machine^^** que esté dentro del alcance de combate de esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** al objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
