                  <profiles>
                    <profile name="Consejero hobgrot" id="507d-72c7-d913-c9bd" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">El **Consejero hobgrot** de esta unidad es una ficha. Mientras el **Consejero hobgrot** de esta unidad esté en el campo de batalla, suma 3 a la puntuación de control de las unidades amigas **^^Herreros Infernales de Hashut^^** que estén totalmente a 12" o menos de esta unidad. Si haces una tirada de salvación sin modificar de 1 para esta unidad, retira del campo de batalla el **Hobgrod Advisor** de esta unidad, el ataque falla y la secuencia de ataque termina.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Consejero hobgrot" id="2971-1e96-421f-2237" hidden="true">
                      <description>Solo **^^Infantry^^**. Añade la habilidad &apos;Consejero hobgrot&apos; al pergamino de batalla de tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
