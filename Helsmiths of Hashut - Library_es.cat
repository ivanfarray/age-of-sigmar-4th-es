                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Pisotear y cornear" id="d0a7-c44e-c643-0653" hidden="false" import="true" sortIndex="5" type="upgrade">
                  <constraints>
                    <constraint id="50bb-3740-8424-483f" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
