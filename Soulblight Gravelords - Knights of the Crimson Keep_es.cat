  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Caballeros del Torreón Carmesí" id="be88-5863-24a9-c376" hidden="false" import="true" publicationId="e3a0-cfae-cbb3-0215" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="45c7-a355-7da8-495c" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Abrir un camino sangriento" id="fc94-9979-6c00-e7d8" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Orange</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Movement</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de carga</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige una unidad amiga **Caballeros de sangre** que esté en combate para usar esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Esa unidad puede usar una habilidad de **^^Cargar^^** aunque esté en combate y aunque ya haya usado una habilidad de **^^Cargar^^** este turno.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Desenfreno sangriento" id="bfbb-3dc9-df1c-cd7a" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Crimson Keep Monster^^** amigo que esté en combate y no haya usado ninguna habilidad de **^^Rampage^^** este turno para usar esta habilidad, y después elige como objetivo una unidad enemiga en combate con él.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede hacer un movimiento de 2D6". Debe terminar ese movimiento en combate con la unidad objetivo. Después, tira un dado. Si el resultado supera la característica de Salud de la unidad objetivo, 1 miniatura de la unidad objetivo queda abatida.
Después de resolver esta habilidad, esta unidad no puede usar habilidades de **^^Rampage^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="La Fortaleza Carmesí" id="2f81-60b9-02bc-ab8d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Crimson Keep^^** que no haya sido desplegada.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esa unidad en reserva **en el Crimson Keep**. Ahora se considera desplegada. No puedes colocar más unidades amigas **en el Crimson Keep** que las que haya en el campo de batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Desde un flanco invisible" id="c12b-4461-52ab-8034" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), cualquier fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">No puedes usar esta habilidad en la primera ronda de batalla. Elige como objetivos todas las unidades amigas que estén **en el Crimson Keep**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca cada objetivo totalmente a 9" o menos del borde del campo de batalla y a más de 9" de todas las unidades enemigas. Si colocas alguna unidad usando esta habilidad en la tercera ronda de batalla o en una posterior, no gastes puntos de orden al usar la orden &apos;Abrir un camino sangriento&apos; este turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
