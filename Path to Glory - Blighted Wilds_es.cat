                    <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Absorción de vida" id="cb45-b82d-e942-6203" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si este elemento de escenografía tiene un conservador, elige como objetivo un elemento de escenografía visible a 9" o menos de él.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, aplica **Curar (X)** a este elemento de escenografía, donde **X** es igual al resultado. Después, el objetivo está **contaminado** para los ejércitos de ambos jugadores.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Absorción de vida" id="f391-49fd-fbc5-021e" hidden="true">
                      <description>Añade la habilidad &apos;Absorción de vida&apos; al pergamino de tu hito de Ghyran.</description>
                    </rule>
                  </rules>
                </selectionEntry>
