        <selectionEntry name="Vitalidad de Ghyran" id="752d-a745-b452-62f6" hidden="false" import="true" sortIndex="3" type="upgrade">
          <profiles>
            <profile name="Vitalidad de Ghyran" id="bcab-802d-3585-ede0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hero^^** amigo visible dentro del alcance de combate de esta unidad.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 1 a las tiradas de correr, de carga y de salvación del objetivo durante el resto del turno. Después, retira este brebaje ghyranita de tu hoja de ejército.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Brebaje ghyranita^^**</characteristic>
