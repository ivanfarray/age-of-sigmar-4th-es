                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de disparo</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad no está en combate, elige como objetivo una unidad enemiga visible a 18" o menos de ella.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira 3 dados. Por cada 4+, inflige 1 de daño mortal al objetivo.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
