    <selectionEntryGroup name="Brebajes de Ghyran" id="17d6-baae-dbeb-3e2c" hidden="true" publicationId="9082-4798-2e31-dab8">
      <constraints>
        <constraint id="7830-5139-4f1f-77f5" field="selections" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditionGroups>
            <conditionGroup type="and">
