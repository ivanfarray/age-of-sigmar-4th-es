              <profiles>
                <profile name="Bendecido por las antiguas magias" id="29c6-e509-8caa-1589" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, Reacción: Has declarado una habilidad **^^Hechizo^^** del Saber de las tierras salvajes exuberantes para una unidad totalmente a 6" o menos de esta unidad.</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cambia la tirada de lanzamiento de ese hechizo a un valor de 9 que no puede modificarse. Si ese hechizo es desvinculado, inflige D6 daño mortal a la unidad que usó la habilidad **^^Desvincular^^**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
