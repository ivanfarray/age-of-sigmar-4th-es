              <description>1 x Néctar de hierba sangrienta, 1 x Musgo saltarín, 1 x Corteza de madera susurrante</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Brebaje ampollante" id="4167-3ed1-ba7c-e95f" hidden="false" import="true" sortIndex="7" type="upgrade">
