                  </modifiers>
                  <profiles>
                    <profile name="Oculto en el interior" id="52e6-0b5c-cf43-3762" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
                      <attributes>
                        <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Purple</attribute>
                        <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Control</attribute>
                        <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por batalla, final de tu turno</characteristic>
                        <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                        <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga que no sea **^^Unique^^** y haya sido destruida.</characteristic>
                        <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de reemplazo con la mitad de las miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 7" o menos de este elemento de escenografía y a más de 3" de todas las unidades enemigas.
Si el objetivo es un **^^Hero^^**, **^^War Machine^^** o **^^Monster^^**, debes gastar un punto de orden adicional para usar esta habilidad y, si el objetivo tiene un tamaño de unidad de 1, debes asignar a la unidad de reemplazo tantos puntos de daño como la mitad de su característica de Salud.</characteristic>
                        <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Oculto en el interior" id="d143-10e3-67e9-f79e" hidden="true">
                      <description>Solo puedes elegir esta mejora si tu hito de Ghyran no es un Metalito reforzado. Añade la habilidad &apos;Oculto en el interior&apos; al pergamino de tu hito de Ghyran.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Letal" id="86e3-add0-e4aa-27d5" hidden="false" import="true" sortIndex="10" type="upgrade">
                  <constraints>
                    <constraint id="5856-ed92-5379-8aa0" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
