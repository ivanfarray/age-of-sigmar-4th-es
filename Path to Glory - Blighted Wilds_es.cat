            </profile>
          </profiles>
          <rules>
            <rule name="Paso aelfo" id="ce9d-3900-254f-3fef" hidden="false">
              <description>2 x Cardo de raíz de jade, 1 x Flor etérica fresca</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Niebla verdeante" id="3a5c-c3c1-3a70-7b2b" hidden="false" import="true" sortIndex="6" type="upgrade">
          <profiles>
            <profile name="Niebla verdeante" id="6b72-8595-21aa-5360" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
