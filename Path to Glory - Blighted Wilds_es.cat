                  <profiles>
                    <profile name="Carterista de pociones" id="3e4c-903a-eef9-07db" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
