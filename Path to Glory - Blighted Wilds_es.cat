      <selectionEntryGroups>
        <selectionEntryGroup name="Cicatrices de batalla críticas" id="ccee-8736-a1d0-da03" hidden="false" sortIndex="3">
          <constraints>
            <constraint id="9f25-f0aa-808a-4780" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Sangre débil, corazones fuertes" id="9282-f482-dba7-8c43" hidden="false" import="true" sortIndex="1" type="upgrade">
              <constraints>
                <constraint id="afb1-d024-16a5-e75d" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Sangre débil, corazones fuertes" id="4de3-0307-0aec-3207" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a la característica de Rend de las armas de combate usadas para ataques que tengan como objetivo esta unidad. Cada vez que esta unidad use la orden &apos;Reagrupamiento&apos;, puedes hacer 1 tirada de reagrupamiento adicional de D6.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Manía del bosque profundo" id="0e86-7fd2-c643-92e5" hidden="false" import="true" sortIndex="2" type="upgrade">
              <constraints>
                <constraint id="1038-32fe-6283-f024" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Manía del bosque profundo" id="2d3b-2c9c-2adf-f4b3" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si la tirada de impacto sin modificar de un ataque de esta unidad es de 1-4, el ataque falla y termina la secuencia de ataque. Los ataques de combate de esta unidad logran impactos críticos con tiradas de impacto sin modificar de 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Colonias parasitarias" id="c3b6-af5c-1021-e4b1" hidden="false" import="true" sortIndex="3" type="upgrade">
              <constraints>
                <constraint id="35ca-e9b0-775d-a01b" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Colonias parasitarias" id="8925-771c-8d8f-fd2c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad sea colocada en el campo de batalla como resultado de una habilidad amiga, incluido durante el despliegue, debe colocarse a 1" o menos de un borde del campo de batalla y a más de 9" de todas las demás unidades.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Cicatrices de batalla graves" id="8bba-b811-5ea7-dc5d" hidden="false" sortIndex="1">
          <constraints>
            <constraint id="0ca4-745d-cc63-63d2" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Melancolía cínica" id="8054-e807-1c26-87ce" hidden="false" import="true" sortIndex="1" type="upgrade">
              <constraints>
                <constraint id="7084-6b90-4f57-6325" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Melancolía cínica" id="1c19-9234-d728-cd6b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 10 a la puntuación de control de esta unidad. Suma 3 a las puntuaciones de control de las unidades amigas mientras estén totalmente dentro del alcance de combate de esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Almizcle de duende prensil" id="5c3c-87ac-aece-2668" hidden="false" import="true" sortIndex="3" type="upgrade">
              <constraints>
                <constraint id="37ee-89d5-ae76-7787" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Almizcle de duende prensil" id="db84-e3c9-acf5-bddb" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Tira un D3 en lugar de un D6 al hacer tiradas de correr para esta unidad y cuando esta unidad use la orden &apos;Redesplegar&apos;. Cada vez que una unidad enemiga en combate con esta unidad use una habilidad **^^Retirarse^^**, tira un D6 en lugar de un D3 al determinar la cantidad de daño mortal que esa habilidad inflige a esa unidad enemiga.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Piel de astillas" id="dbef-d032-75bf-7ee3" hidden="false" import="true" sortIndex="2" type="upgrade">
              <constraints>
                <constraint id="cfd5-9528-7f78-5967" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Piel de astillas" id="33d3-7ecb-6f92-f6e4" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
