                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de disparo</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira tantos dados como miniaturas tenga la unidad objetivo. Por cada 5+, inflige 1 daño mortal al objetivo. Después, retira este brebaje ghyranita de tu hoja de ejército.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Brebaje ghyranita^^**</characteristic>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
