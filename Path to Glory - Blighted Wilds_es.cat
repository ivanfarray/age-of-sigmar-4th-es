              <description>1 x Estambre de espino férreo, 1 x Néctar de hierba sangrienta, 1 x Musgo saltarín</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Paso aelfo" id="621b-219b-6e2a-e7b9" hidden="false" import="true" sortIndex="4" type="upgrade">
          <profiles>
            <profile name="Paso aelfo" id="bd36-d5f5-543e-b4e4" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
