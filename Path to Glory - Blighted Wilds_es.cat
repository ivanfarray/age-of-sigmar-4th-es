                  <conditions>
                    <condition childId="75d6-6995-dfcc-3898" field="selections" scope="root-entry" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Montura de Ghyran" id="c6a6-c5d4-dcec-35d4" hidden="true">
                  <description>Solo **^^Infantry^^** que no sea **^^Hero^^**.
Añade el arma **Montura de Ghyran&apos;s Teeth, Hooves, or Claws** al pergamino de tu héroe de regimiento.
Después, realiza los siguientes cambios en su pergamino:
• Cambia la característica de Move a 12".
• Cambia la característica de Salud a 3 o suma 1 a la característica de Salud.
• Cambia la característica de Save a 4+.
• Sustituye la palabra clave **^^Infantry^^** por **^^Cavalry^^**.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Salud" id="ccd9-cf25-f970-2e60" flatten="true" hidden="false">
                  <constraints>
                    <constraint id="b2e3-a02d-31a9-65de-min" field="selections" scope="parent" shared="true" type="min" value="1"/>
                    <constraint id="b2e3-a02d-31a9-65de-max" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <selectionEntries>
