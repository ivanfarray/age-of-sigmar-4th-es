              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Furia de Durthu" id="5455-8e3a-c5f9-11d7" hidden="false" import="true" sortIndex="2" type="upgrade">
          <profiles>
            <profile name="Furia de Durthu" id="cc01-1ccc-3e34-e782" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad como objetivo.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 1 a la característica de Damage de las armas de combate de esta unidad durante el resto del turno. Si el objetivo es **^^Infantry^^**, suma D3 a la característica de Damage de sus armas de combate durante el resto del turno en su lugar. Después, retira este brebaje ghyranita de tu hoja de ejército.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Brebaje ghyranita^^**</characteristic>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Furia de Durthu" id="8668-8ceb-57bb-8b65" hidden="false">
              <description>2 x Musgo saltarín, 1 x Néctar de hierba sangrienta</description>
            </rule>
          </rules>
        </selectionEntry>
