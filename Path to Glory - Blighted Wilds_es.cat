        </selectionEntry>
        <selectionEntry name="Semilla de Wyrdron" id="f782-4c1d-35ad-83cc" hidden="false" import="true" sortIndex="4" type="upgrade">
          <profiles>
            <profile name="Semilla de Wyrdron" id="5cf7-34c0-ef16-5d87" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), cualquier fase de disparo</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 9" o menos de un **^^Hero^^** amigo.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 1-2, durante el resto del turno, resta 1 al número de dados tirados al hacer tiradas de carga para el objetivo, hasta un mínimo de 1. Con un 3+, inflige al objetivo una cantidad de daño mortal igual al resultado.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Potenciado por Ghyran" id="cdee-0b79-f95c-8290" hidden="false" import="true" sortIndex="10" type="upgrade">
          <profiles>
            <profile name="Potenciado por Ghyran" id="6f3b-cf3d-7505-428f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hero^^** amigo que no sea **^^Filos de Khorne^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si el objetivo es un **^^Wizard^^** o **^^Priest^^**, suma 1 a su nivel de poder durante el resto de la batalla. Si el objetivo no es un **^^Wizard^^** ni **^^Priest^^**, elige la palabra clave **^^Wizard (1)^^** o **^^Priest (1)^^**. El objetivo tiene esa palabra clave durante el resto de la batalla.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
