                  <profiles>
                    <profile name="Pociones improvisadas" id="f166-fcb7-97e6-dcd9" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de disparo</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3 y aplica el efecto correspondiente:
**1 *Poción de corrosión instantánea:*** Inflige D3 daño mortal al objetivo.
**2 *Poción de imprecisión:*** Resta 1 a las tiradas de impacto de los ataques del objetivo durante el resto del turno.
**3 *Poción de vulnerabilidad:*** No se pueden hacer tiradas de salvaguardia por el objetivo durante el resto del turno.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
