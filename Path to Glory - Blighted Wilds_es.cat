          <selectionEntries>
            <selectionEntry name="Bendecido por las antiguas magias" id="1c54-9e61-8f65-2e51" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6543-4c78-26ec-b3b2" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
