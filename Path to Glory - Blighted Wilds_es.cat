            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Repelente de ratas del doctor Rothli" id="e90f-0ff9-be58-c29d" hidden="false" import="true" sortIndex="5" type="upgrade">
          <profiles>
            <profile name="Repelente de ratas del doctor Rothli" id="3606-c530-d3ea-3f84" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
