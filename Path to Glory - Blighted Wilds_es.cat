              <selectionEntries>
                <selectionEntry name="Señor de sangre y zarzas" id="85ee-c7a9-1c97-f57b" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="a180-a10f-e844-d8ee" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Señor de sangre y zarzas" id="5b06-1a25-5065-d4ee" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras una unidad enemiga esté en combate con esta unidad:
• Esa unidad enemiga tiene una puntuación de control máxima de 1.
• Resta 1 a su nivel de poder, hasta un mínimo de 0.
• Sus ataques no pueden lograr impactos críticos (trátalos como impactos normales).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Todos debemos hacer sacrificios" id="4a6b-7c7a-af6b-df8b" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="31a9-934a-045e-27c9" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Todos debemos hacer sacrificios" id="6240-9622-7d25-3592" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Green</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Tu oponente ha declarado una orden para una unidad a 6" o menos de esta unidad.</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Si el resultado iguala o supera el número de puntos de orden que tenga tu oponente, después de resolver la orden, inflige una cantidad de daño mortal igual al resultado a la unidad que use esa orden. Esta unidad puede usar esta habilidad más de una vez por fase, pero solo una vez por orden.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
