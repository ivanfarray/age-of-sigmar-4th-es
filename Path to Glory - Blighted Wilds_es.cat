                <modifier affects="profiles.Unit" field="6c6f-8510-9ce1-fc6e" scope="root-entry" type="increment" value="3"/>
                <modifier field="bc33-05f5-8d3f-af43" type="decrement" value="3">
                  <repeats>
                    <repeat childId="model" field="selections" repeats="1" roundUp="false" scope="root-entry" shared="true" value="1"/>
