                  <constraints>
                    <constraint id="97f4-5a2b-c53f-c0bd" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Nexo de regeneración" id="301e-a2f6-e9b2-cbfb" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, final de cualquier turno</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos todas las unidades amigas totalmente a 12" o menos de esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de los siguientes efectos por cada objetivo:
• Devuelve 1 miniatura abatida a la unidad objetivo.
• Si el objetivo no es un **^^Monster^^**, aplica **Heal (D6)** al objetivo.
• Si el objetivo es un **^^Monster^^**, aplica **Heal (2D6)** al objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Vinculado al ciclo" id="4dc5-18a9-9c82-7e46" hidden="false" import="true" type="upgrade">
                  <constraints>
