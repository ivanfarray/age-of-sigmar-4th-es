                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <modifiers>
                <modifier affects="profiles.Unit" field="96be-54ae-ce7b-10b7" scope="root-entry" type="increment" value="2"/>
