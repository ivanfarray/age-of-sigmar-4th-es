        <profile name="Pie de Gork" id="0053-e352-4095-1187" hidden="false" typeId="1287-3a-9799-7e40" typeName="Manifestation">
          <attributes>
            <attribute name="Base Size" typeId="50db-066e-a3e7-696f"/>
          </attributes>
          <characteristics>
            <characteristic name="Move" typeId="c28a-6000-2a0b-e7cf">-</characteristic>
            <characteristic name="Health" typeId="d1b9-3068-515-131e">8</characteristic>
            <characteristic name="Save" typeId="80c7-7691-b6ed-d6a6">4+</characteristic>
            <characteristic name="Banishment" typeId="97a2-d412-9ac-6a37">7+</characteristic>
          </characteristics>
        </profile>
        <profile name="Destrucción errante" id="c283-48bf-19e6-0911" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una parte de esta **^^Manifestation^^**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira el objetivo del campo de batalla y colócalo de nuevo en el campo de batalla totalmente a 9" o menos de la otra parte de esta **^^Manifestation^^**.
Después, tira un D3 por cada unidad enemiga a 3" o menos del objetivo. Con un 2+:
• Inflige a esa unidad una cantidad de daño mortal igual al resultado.
• Esa unidad tiene la palabra clave **^^Stomped^^** hasta el inicio de tu siguiente turno.
• Resta 1 al número de dados que se tiran al hacer tiradas de carga para unidades **^^Stomped^^**, hasta un mínimo de 1.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Múltiples partes" id="e24e-51c6-ebf9-ede1" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" id="358d-da50-4598-7dd8" hidden="false" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" id="2ff6-4e3f-c346-c9eb" hidden="false" typeId="fd7f-888d-3257-a12b">Cuando se le asigna un número de puntos de daño igual a la característica de Salud de esta **^^Manifestation^^**, esta **^^Manifestation^^** es destruida y todas sus partes se retiran del juego.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Tamaño de peana" id="859b-6598-5fa8-477d" hidden="true">
          <description>Usar miniatura</description>
        </rule>
      </rules>
