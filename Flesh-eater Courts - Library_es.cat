            <characteristic name="Banishment" typeId="97a2-d412-9ac-6a37">7+</characteristic>
          </characteristics>
        </profile>
        <profile name="Sangre desbordante" id="7f32-94af-b73d-8879" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga a 6" o menos de esta **^^Manifestation^^**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, tu oponente debe elegir 1 de los siguientes efectos para aplicarlo durante el resto del turno:
***Beber abundantemente del cáliz:*** Salvo la habilidad de arma **Compañero**, las habilidades de arma de los ataques del objetivo no tienen efecto.
***Apartarse y sufrir las consecuencias:*** Los ataques de combate que tengan como objetivo esa unidad enemiga logran impactos críticos con tiradas de impacto sin modificar de 5+.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Tamaño de peana" id="5748-bc02-b936-2514" hidden="true">
          <description>50mm</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Estampida de corceles cadavéricos" id="95b3-ea5e-9e7-7f69" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="DEATH" id="ff33-c420-e57-7337" hidden="false" primary="false" targetId="d484-a2d7-cf4f-c4a0"/>
        <categoryLink name="WARD (6+)" id="a23c-c91a-95c0-83ae" hidden="false" primary="false" targetId="70a4-383f-421f-52cd"/>
        <categoryLink name="MANIFESTATION" id="f186-3c5d-5288-7e2c" hidden="false" primary="true" targetId="bff0-8be9-719f-4afc"/>
        <categoryLink name="ENDLESS SPELL" id="9e3b-42f-bf28-b35b" hidden="false" primary="false" targetId="e7bc-543-4076-553c"/>
        <categoryLink name="FLY" id="eec9-7e3e-5403-5340" hidden="false" primary="false" targetId="b979-4c3e-7d0e-6921"/>
        <categoryLink name="FLESH-EATER COURTS" id="d144-5cb-e97-4004" hidden="false" primary="false" targetId="8d10-dc24-7ece-50df"/>
      </categoryLinks>
      <profiles>
        <profile name="Estampida de corceles cadavéricos" id="9cda-9666-fdf3-c6f6" hidden="false" typeId="1287-3a-9799-7e40" typeName="Manifestation">
          <attributes>
            <attribute name="Base Size" typeId="50db-066e-a3e7-696f"/>
          </attributes>
          <characteristics>
            <characteristic name="Move" typeId="c28a-6000-2a0b-e7cf">12&quot;</characteristic>
            <characteristic name="Health" typeId="d1b9-3068-515-131e">10</characteristic>
            <characteristic name="Save" typeId="80c7-7691-b6ed-d6a6">5+</characteristic>
            <characteristic name="Banishment" typeId="97a2-d412-9ac-6a37">7+</characteristic>
          </characteristics>
        </profile>
        <profile name="Pisoteados" id="62af-fefd-b71-618f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta **^^Manifestation^^** puede usar esta habilidad aunque esté en combate.
Elige como objetivo un punto de un borde del campo de batalla. Después, haz una tirada de estampida de 2D6. Añade 1D6 a la tirada por cada ronda de batalla que esta **^^Manifestation^^** haya estado en el campo de batalla sin haber sido desterrada. Por ejemplo, la tirada de estampida sería de 2D6 en el turno en que fue invocada, de 3D6 en tu siguiente turno, y así sucesivamente.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta **^^Manifestation^^** puede moverse hasta una distancia igual al resultado de la tirada de estampida en línea recta directamente hacia el objetivo. Puede atravesar los alcances de combate de las unidades enemigas. No puede terminar ese movimiento en combate salvo que lo termine a 1/2" o menos de una unidad enemiga visible. Si lo hace, esta **^^Manifestation^^** ha cargado.
Tira un D3 por cada unidad enemiga por encima de la cual haya pasado esta **^^Manifestation^^** durante ese movimiento. Con un 2+, inflige a esa unidad enemiga una cantidad de daño mortal igual al resultado.
Además, si esta **^^Manifestation^^** ha cargado este turno, suma el resultado de la tirada de estampida a la característica de Attacks de su **Pisoteo de corcel cadavérico** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Básica^^**, **^^Movimiento^^**, **^^Carga^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Tamaño de peana" id="28af-09c8-5479-20a4" hidden="true">
          <description>120x92mm</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Pisoteo de corcel cadavérico" id="9522-7146-3265-724a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2dbc-a183-764a-bd07" field="selections" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="aa73-bb51-f002-d5fc" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Pisoteo de corcel cadavérico" id="6866-7d4d-1e9f-541d" hidden="false" typeId="9074-76b6-9e2f-81e3" typeName="Melee Weapon">
