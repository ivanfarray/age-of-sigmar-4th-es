          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que un ataque de combate de esta unidad logre un impacto crítico, otorga 1 **punto de corte selecto** a esta unidad, hasta un máximo de 6.</characteristic>
          </characteristics>
        </profile>
        <profile name="La cena está servida" id="7c44-def8-c312-d5c8" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
