            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Larga vida al rey" id="16a1-1bcb-2d3c-012a" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad fuera a ser destruida, antes de retirarla del juego, las unidades **^^Cortes Devoradoras de Carne^^** amigas que no sean **^^Unique^^** y estén totalmente a 12" o menos de ella se enfurecen hasta el inicio de tu siguiente turno. Las armas de combate usadas por unidades amigas enfurecidas tienen **Crítico (herida automática)** y logran impactos críticos con tiradas de impacto sin modificar de 5+, incluso si esta unidad ha sido destruida.</characteristic>
          </characteristics>
        </profile>
        <profile name="La corte del rey" id="59b6-3b9e-d5d2-4f83" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a la característica de Attacks de las armas de combate usadas por otros **^^Cortes Devoradoras de Carne Heroes^^** amigos que no sean **^^Monster^^** mientras estén totalmente a 12" o menos de esta unidad. Además, suma 1 a la característica de Attacks de las armas de combate de esta unidad por cada otro **^^Cortes Devoradoras de Carne Hero^^** amigo que no sea **^^Monster^^** y esté totalmente a 12" o menos de ella, hasta un máximo de +3.</characteristic>
          </characteristics>
        </profile>
      </profiles>
