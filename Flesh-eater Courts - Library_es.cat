        <profile name="Descenso en picado" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="2017-d209-1511-66c7">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final del turno enemigo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira esta unidad del campo de batalla y vuelve a colocarla a más de 9" de todas las unidades enemigas y, además:
• Totalmente a 6" o menos del borde del campo de batalla, o
• A 3" o menos de un objetivo que no controles.</characteristic>
