                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: El oponente ha declarado una orden para una unidad en combate con esta unidad</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
