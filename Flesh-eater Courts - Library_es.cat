        <profile name="Felgryn, Gran Halconero" id="6058-a1ad-de4c-de1c" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
