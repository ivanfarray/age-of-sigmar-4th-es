      <profiles>
        <profile name="Rey necrófago aborrecible en dragón zombi real" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="c3cd-fa25-8fab-82da">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">16</characteristic>
