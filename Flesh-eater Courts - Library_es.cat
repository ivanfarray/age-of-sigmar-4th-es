            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Límites nigrománticos" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="b2a-6b78-4f3c-50e9">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las **Garras dracónicas** de esta unidad tienen una característica de Attacks máxima de 10.
Mientras esta unidad tenga 10 o más puntos de daño, la característica de Attacks de sus **Garras dracónicas** es 5.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Damage</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Hambre monstruosa" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="1c3-f4fe-657a-d595">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén totalmente a 12" o menos de esta unidad, los **^^Flesh-eater Courts Monsters^^** amigos que no sean **^^Hero^^** pueden usar habilidades **^^Charge^^** aunque hayan usado una habilidad Run en el mismo turno.</characteristic>
