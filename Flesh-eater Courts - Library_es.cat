                  <rules>
                    <rule name="Preferred Prey" id="c425-f18c-fcd5-6587" hidden="true">
                      <description>Solo **^^Cavalry^^**. Las armas de combate **Companion** de tu héroe tienen **Anti-X (+1 Rend)**, donde **X** es una palabra clave de facción o una de las siguientes: **^^Infantry^^**, **^^Cavalry^^**, **^^Monster^^**, **^^War Machine^^**, **^^Hero^^**, **^^Wizard^^**, **^^Priest^^**.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Fauces poderosas" hidden="false" id="ae57-a384-968c-f296" sortIndex="6">
                  <profiles>
                    <profile name="Fauces poderosas" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f7a4-a7cc-ba11-ae6c">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Monster^^** enemigo en combate con esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tu oponente y tú debéis tirar 2D6 cada uno. Si tu resultado es mayor, inflige al objetivo una cantidad de daño mortal igual a la diferencia entre tu resultado y el de tu oponente.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-6"/>
                    <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                    <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
                  </costs>
                  <modifiers>
                    <modifier type="set" value="true" field="hidden">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="707a-8cf4-af29-3db9" shared="true" includeChildSelections="true"/>
                      </conditions>
