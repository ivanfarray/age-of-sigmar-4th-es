        <profile name="Sangre desbordante" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="7f32-94af-b73d-8879">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga a 6" o menos de esta **^^Manifestation^^**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, tu oponente debe elegir 1 de los siguientes efectos para aplicarlo durante el resto del turno:
***Drink Deep from the Chalice:*** Salvo la habilidad de arma **Companion**, las habilidades de arma de los ataques del objetivo no tienen efecto.
***Turn aside and Suffer the Consequences:*** Los ataques de combate que tengan como objetivo esa unidad enemiga logran impactos críticos con tiradas de impacto sin modificar de 5+.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="DEATH" hidden="false" id="58ef-2e24-f1ab-b8ba" targetId="d484-a2d7-cf4f-c4a0" primary="false"/>
        <categoryLink name="WARD (6+)" hidden="false" id="76ef-f7f2-f440-da61" targetId="70a4-383f-421f-52cd" primary="false"/>
