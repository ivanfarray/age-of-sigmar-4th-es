        <profile name="En corceles alados" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="e681-b2b3-a842-597d">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad **Desolladores de la cripta** amiga que haya usado la habilidad &apos;Por nuestro señor&apos; este turno y esté totalmente a 9" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El objetivo puede moverse inmediatamente D3", pero no puede terminar ese movimiento en combate.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
