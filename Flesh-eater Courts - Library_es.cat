<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue name="Cortes Devoradoras de Carne - Biblioteca" id="a6b3-b9f5-ea34-9c96" battleScribeVersion="2.03" gameSystemId="e51d-b1a3-75fc-dc3g" gameSystemRevision="2" library="true" revision="45" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <sharedProfiles>
    <profile name="El único rey verdadero" id="f935-33a5-da35-3c7c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Delirio^^**</characteristic>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras creas en este **^^Delusion^^**:
• Suma 1 a las tiradas de correr y de carga de las unidades **^^Cortes Devoradoras de Carne^^** amigas.
• Resta 1 a las tiradas de correr y de carga de las unidades enemigas.
• Las armas de combate usadas por unidades **^^Serfs^^** amigas tienen **Anti-charge (+1 Rend)** mientras estén totalmente dentro del territorio amigo y no hayan cargado en el mismo turno.</characteristic>
      </characteristics>
    </profile>
    <profile name="Una colección de fieras majestuosa" id="eaea-c407-37ea-0dd2" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Delirio^^**</characteristic>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras creas en este **^^Delusion^^**, suma 1 a la característica de Attacks de las armas de combate **Compañero** usadas por unidades **^^Cortes Devoradoras de Carne^^** amigas mientras estén totalmente a 12" o menos de cualquier **^^Cortes Devoradoras de Carne Heroes^^** amigo.</characteristic>
      </characteristics>
    </profile>
    <profile name="¡Por el reino!" id="a76d-9719-4405-b0ce" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Delirio^^**</characteristic>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras creas en este **^^Delusion^^**, suma 1 a las tiradas de carga de las unidades **^^Knights^^** amigas y los **^^Cortes Devoradoras de Carne Monsters^^** amigos mientras estén totalmente a 12" o menos de cualquier **^^Cortes Devoradoras de Carne Heroes^^** amigo.
En su lugar, suma 2 a las tiradas de carga de las unidades **^^Knights^^** amigas y los **^^Cortes Devoradoras de Carne Monsters^^** amigos mientras estén totalmente a 12" o menos de cualquier **Abhorrant Ghoul Kings on Royal Zombie Dragons** amigo.</characteristic>
      </characteristics>
    </profile>
    <profile name="Acusaciones de regicidio" id="4922-0ec9-fac1-4b3f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Delirio^^**</characteristic>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras creas en este **^^Delusion^^**, suma 1 a la característica de Damage de las armas de combate usadas por unidades **^^Serfs^^** y **^^Knights^^** amigas mientras estén totalmente a 12" o menos de cualquier **^^Cortes Devoradoras de Carne Heroes^^** amigo al que se hayan asignado puntos de daño en el mismo turno.</characteristic>
      </characteristics>
    </profile>
    <profile name="¡Músicos, tocad!" id="3bf4-5bf0-6739-68ff" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Delirio^^**</characteristic>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras creas en este **^^Delusion^^**, resta 1 a las tiradas de impacto de los ataques de disparo que tengan como objetivo unidades **^^Cortes Devoradoras de Carne^^** amigas mientras estén totalmente a 12" o menos de un **^^Cortes Devoradoras de Carne Hero^^** amigo.</characteristic>
      </characteristics>
    </profile>
    <profile name="¡Sir Felgryn está fuera!" id="0bb1-dd2e-dad0-f89f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Delirio^^**</characteristic>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras creas en este **^^Delusion^^**, resta 10 a las puntuaciones de control de las unidades enemigas mientras estén en combate con cualquier unidad **^^Serfs^^** amiga o con cualquier unidad **^^Cortes Devoradoras de Carne Monster^^** o **^^Bestia^^** amiga que no sea **^^Hero^^**.</characteristic>
      </characteristics>
    </profile>
    <profile name="Código de honor" id="8a5d-ac8-6b1-4248" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Delirio^^**</characteristic>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras creas en este **^^Delusion^^**, suma 1 a la característica de Damage de las armas de combate usadas por **^^Cortes Devoradoras de Carne Heroes^^** amigos que no sean **^^Unique^^** para ataques que tengan como objetivo un **^^Hero^^** enemigo.</characteristic>
      </characteristics>
    </profile>
    <profile name="Defensores del reino" id="6d29-f54b-6066-392c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Delirio^^**</characteristic>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras creas en este **^^Delusion^^** y esta unidad esté en el campo de batalla, suma 1 a las tiradas de carga de las unidades **^^Cortes Devoradoras de Carne^^** amigas mientras estén totalmente a 12" o menos de un **^^Cortes Devoradoras de Carne Hero^^** amigo. Suma 2 a las tiradas de carga en su lugar si fueron colocadas en el mismo turno.
Al usar la habilidad &apos;Un reino delirante&apos;, puedes elegir este **^^Delusion^^** aunque esta unidad esté **patrullando las fronteras**.</characteristic>
      </characteristics>
    </profile>
    <profile name="Liturgia de destierro" id="d5d4-b625-9673-80ba" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
      <attributes>
        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
      </attributes>
      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Delirio^^**</characteristic>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras creas en este **^^Delusion^^**:
• Suma 2 a las tiradas de destierro de las unidades **^^Cortes Devoradoras de Carne^^** amigas.
• Las unidades **^^Cortes Devoradoras de Carne^^** amigas tienen **^^Ward (4+)^^** contra los puntos de daño infligidos por habilidades **^^Hechizo^^**, habilidades **^^Prayer^^** y habilidades usadas por **^^Manifestations^^**.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
