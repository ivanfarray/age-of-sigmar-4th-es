            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Sed mis ojos" id="5771-7434-855d-8d3c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">El **Grype** de esta unidad es un marcador. Si no está junto a una unidad enemiga, elige como objetivo una unidad enemiga a 18" o menos de esta unidad que no esté en combate.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca el **Grype** de esta unidad junto al objetivo. Si el objetivo es destruido mientras el Grype de esta unidad está junto a él, retira el **Grype** de esta unidad del campo de batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Explorador alado" id="4cba-3e08-1919-7290" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras el **Grype** de esta unidad esté junto a una unidad enemiga, no se pueden hacer tiradas de salvaguardia por los puntos de daño infligidos a esa unidad enemiga por los ataques de combate de esta unidad y de unidades **^^Serfs^^** amigas.</characteristic>
          </characteristics>
        </profile>
      </profiles>
