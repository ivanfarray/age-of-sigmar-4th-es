        <profile name="Arrestad a esos malhechores" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="6eb7-28db-b87-d03">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 18" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, hasta el inicio de tu siguiente turno, el objetivo tiene **^^Strike-last^^** mientras esté en combate con cualquier **^^Flesh-eater Courts Heroes^^** amigo y con cualquier unidad **^^Serfs^^** o **^^Knights^^** amiga.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
