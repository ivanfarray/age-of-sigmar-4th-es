        <profile name="Da Final Fling" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="7570-b81c-649e-2d36">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad no esté en combate, cada vez que una miniatura de esta unidad sea abatida por un ataque de disparo y esa miniatura estuviera a 12" o menos de la unidad atacante, tira un dado. Suma 2 al resultado si la unidad atacante era un **^^Monster^^**. Con un 4+, inflige D6 de daño mortal a la unidad atacante después de que se haya resuelto la habilidad de **^^Shoot^^**.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Blue</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Defensive</attribute>
