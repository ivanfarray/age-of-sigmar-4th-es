        <profile name="Primal Hex" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="9155-3ce6-fda1-62aa">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Wizard^^** enemigo a 24" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, hasta el inicio de tu siguiente turno, cada vez que el objetivo use una habilidad de **^^Spell^^** o **^^Unbind^^**, esta unidad gana 1 punto de ritual.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
