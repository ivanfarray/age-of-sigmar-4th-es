        <profile name="Profeta Wurrgog" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="69c8-f5b8-bfb9-387f">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
