        </profile>
        <profile name="Squiggly Curse" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="926c-a869-1e03-6931">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">4</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo un **^^Hero^^** enemigo en combate con el lanzador, y luego haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflige D3 de daño mortal al objetivo. Si el objetivo es destruido por este hechizo, suma 1 al nivel de poder de esta unidad durante el resto de la batalla.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
        </profile>
        <profile name="Wurrgog Mask" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="a8f8-2d5a-5703-2c71">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), tu fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno:
• La característica de Attacks de las *Rayos verdes mortíferos* de esta unidad es 12 en lugar de D6.
• Por cada tirada de impacto sin modificar de 1 en un ataque de disparo realizado por esta unidad, inflige D3 de daño mortal a esta unidad después de que se haya resuelto la habilidad de **^^Shoot^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Blue</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
