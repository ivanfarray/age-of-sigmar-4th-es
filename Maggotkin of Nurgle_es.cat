      </constraints>
      <selectionEntries>
        <selectionEntry name="Quiste de aflicción" id="2988-a12d-acab-ca65" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="aada-ba6a-9a6e-c46" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Flores demoníacas cargadas de inmundicia" id="7469-2877-3da7-2d5f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que hagas una tirada de correr para una unidad amiga que no sea **^^Monster Agusanados de Nurgle Daemon^^**, puedes cambiar ese resultado a un 4.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Banda de Contadores de Nurgle" id="da47-dbe7-6c0d-6cd7" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cd34-5b2f-1a8c-22df" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Progenitor de plagas" id="8824-6855-6594-fb52" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga del campo de batalla para que sea el **progenitor de la plaga** durante el resto de la batalla. No puedes elegir una **^^Manifestation^^** ni un elemento de escenografía.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira 2D3. Con un 6, o si el resultado iguala o supera la característica de Salud del **progenitor de la plaga**, este tiene la palabra clave **^^Diseased^^**.
En la primera ronda de batalla, si una habilidad curaría o devolvería miniaturas abatidas a un **progenitor de la plaga** **^^Diseased^^**, esa habilidad no cura ningún punto de daño ni devuelve ninguna miniatura abatida a él.
Cada vez que el **progenitor de la plaga** sea elegido como objetivo del efecto &apos;Propagar&apos; de la habilidad &apos;Bendecido por el Padre de las Plagas&apos;, inflige D3 de daño mortal a cada otra unidad enemiga dentro de su alcance de combate, excluyendo **^^Manifestations^^** y elementos de escenografía, además del efecto de esa habilidad.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colección de Bestias de Nurgle" id="9439-707a-2faa-81f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dff2-304b-e247-d3b8" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Moradores del jardín" id="e0f8-2573-5a85-5af6" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las armas **Compañero** usadas por unidades amigas **^^Agusanados de Nurgle^^** tienen **Crítico (2 impactos)**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Quiste de Plaga" id="284a-d338-cc10-b040" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="beeb-40fd-ee45-7e46" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
