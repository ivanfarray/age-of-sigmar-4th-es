              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 5 a las puntuaciones de control de las unidades amigas que no sean **^^Hero Rotbringers^^** mientras estén totalmente a 12" o menos de cualquier unidad amiga **^^Agusanados de Nurgle Daemon^^**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
