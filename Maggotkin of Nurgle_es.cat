          <rules>
            <rule name="Restricciones de mejoras" id="2f17-79d7-8d45-812f" hidden="true">
              <description>Pestilencias del Padre de las Plagas son mejoras únicas que se pueden otorgar a unidades **^^Agusanados de Nurgle^^** que no sean **^^Hero^^**. Una unidad solo puede tener 1 Plaguefather&apos;s Pox.</description>
            </rule>
          </rules>
