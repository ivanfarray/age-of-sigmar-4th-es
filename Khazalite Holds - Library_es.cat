          </characteristics>
        </profile>
        <profile name="Sumo sacerdote de los Zharrgrim" id="c6dd-9538-6a32-6caf" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que se responda a una **^^Prayer^^** cantada por esta unidad, esta unidad gana una **ficha de poder mágmico**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Maestro de las runas" id="76ea-5105-5f92-b035" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una habilidad **^^Ur-gold Rune^^**</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira 3 **fichas de poder mágmico** de esta unidad. Si lo haces, aplica el efecto siguiente que corresponda a la habilidad **^^Ur-gold Rune^^** que se usó:
***Runa de furia:*** Durante el resto de la ronda de batalla, suma 1 a las tiradas de herida de los ataques de combate realizados por unidades amigas **^^Matadores Ígneos^^** mientras tengan **^^Strike-first^^**.
***Runa de determinación ígnea:*** Suma 1 a las tiradas de salvación de las unidades amigas **^^Matadores Ígneos^^** durante el resto de la ronda de batalla.
***Runa de fervor implacable:*** Suma 1 a las tiradas de correr y de carga de las unidades amigas **^^Matadores Ígneos^^** durante el resto de la ronda de batalla.
***Runa de calor abrasador:*** Suma 1 a la característica de Rend de las armas de combate cuerpo a cuerpo usadas por unidades amigas **^^Matadores Ígneos^^** durante el resto de la ronda de batalla.
***Runa de visión lejana:*** Aumenta el alcance de la habilidad &apos;Runa de visión lejana&apos; a 16".</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Maestro rúnico áurico" id="8c3e-7976-7ac4-8d95" hidden="false" import="true" type="model">
