            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 2 a las tiradas de runa de llama maestra de esta unidad mientras tenga alguna marca de agravio.</characteristic>
          </characteristics>
        </profile>
        <profile name="Reavivar el fuego" id="62a4-251c-e11e-bbcb" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad es destruida, antes de retirarla del juego, da 1 marca de agravio a cada unidad amiga visible **^^Grimmdron^^** a 6" o menos de ella.</characteristic>
          </characteristics>
        </profile>
        <profile name="Runa de llama maestra" id="248c-6c85-a8b3-f3f0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga visible **^^Grimmdron Infantry^^** totalmente a 12" o menos de esta unidad. Después, haz una tirada de runa de llama maestra tirando un dado.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Con un 1, o si el resultado es igual o inferior al número de unidades amigas **^^Bastiones Khazalitas^^** destruidas durante la batalla, elige 1 de los siguientes efectos para aplicarlo hasta el inicio de tu siguiente turno:

**Tenacidad de Grimnir:** El objetivo tiene **^^Ward (5+)^^**.

**Determinación de Grimnir:** Puedes repetir las tiradas de carga del objetivo.

**Venganza de Grimnir:** Suma 1 al atributo Damage de las armas de combate del objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
