          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a la característica de Damage de las armas de combate cuerpo a cuerpo de esta unidad mientras tenga 1 punto de daño. En su lugar, suma 2 a la característica de Damage de las armas de combate cuerpo a cuerpo de esta unidad mientras tenga 2 o más puntos de daño.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ligado por juramento" id="9ee5-34c9-0bd9-056a" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
