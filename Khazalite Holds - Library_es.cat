        <profile name="Forja de batalla magmática" id="4a63-36c5-61c0-f23c" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Agotar la forja" id="1942-0170-ec96-0dfa" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una **^^Matadores Ígneos Priest^^** amiga dentro del alcance de combate de este elemento de escenografía para gastar el poder de la forja.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** a cada unidad amiga **^^Matadores Ígneos^^** en el campo de batalla. Una vez que se haya usado esta habilidad, este elemento de escenografía no puede usar la habilidad &apos;Bendición fundida&apos; durante el resto de la batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Bendición fundida" id="0358-d77b-3beb-2f85" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Inicio de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una **^^Matadores Ígneos Priest^^** amiga dentro del alcance de combate de este elemento de escenografía.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 1 a las tiradas de cántico del objetivo durante el resto del turno. Además, el objetivo puede usar la habilidad &apos;Desvincular&apos; este turno como si tuviera **^^Wizard (1)^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Forja de batalla magmática" id="ece2-22d7-01cc-d145" hidden="false">
          <description>**Las siguientes habilidades universales de escenografía se aplican a este elemento de escenografía (Terrain, 1.2):
Cobertura, Infranqueable, Ocultación**</description>
        </rule>
        <rule name="Tamaño de peana" id="d210-56d8-b405-2254" hidden="true">
          <description>Usar miniatura</description>
        </rule>
      </rules>
    </selectionEntry>
