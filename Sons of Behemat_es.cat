                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Comehechizos" id="a8fd-473a-0eb2-5f83" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
              <constraints>
                <constraint id="7a49-c857-fe9b-8c5f" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Comehechizos" id="8730-3316-54dc-5c7b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
