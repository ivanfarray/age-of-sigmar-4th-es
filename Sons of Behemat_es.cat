        <selectionEntryGroup name="Embestidas que sacuden el reino" id="bd92-7246-51a4-b33f" hidden="false">
          <rules>
            <rule name="Restricciones de mejoras" id="2f53-ceae-d7d1-abb7" hidden="true">
              <description>Solo unidades **^^Big^^** que no sean **^^Unique^^**. Una unidad solo puede tener 1 Embestida que Sacude el Reino, pero, salvo que se indique lo contrario, una unidad puede usar varias habilidades **^^Rampage^^** en el mismo turno.</description>
            </rule>
          </rules>
          <selectionEntries>
