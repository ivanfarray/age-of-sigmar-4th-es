  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Hijos de Behemat" id="590e-e726-f603-60eb" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="dc92-7bf6-e0f-d4d1" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Golpe colosal" id="8b65-5ca0-d25a-9293" hidden="false" publicationId="b765-4747-cddc-385e" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Mega‑Gargant^^** amigo que no haya usado una habilidad de **^^Rampage^^** este turno para usar esta habilidad, y después elige como objetivo un **^^Monster^^** o **^^War Machine^^** enemigo que tenga un tamaño de unidad de 1 y esté a 1" o menos de él.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, retira el objetivo del campo de batalla y colócalo de nuevo a 1" o menos de la unidad que usa esta habilidad. Después, inflige D3 de daño mortal al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Carga de gigante" id="a7a0-3994-3329-7bb8" hidden="false" publicationId="b765-4747-cddc-385e" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Mega-Gargant^^** o **^^Gargant^^** que haya cargado este turno para usar esta habilidad, y después elige como objetivo una unidad enemiga que no haya sido elegida como objetivo de esta habilidad este turno y que esté en combate con esa unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Inflige D3 de daño mortal al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="¡Árbol vaaaa!" id="a321-5df8-1d34-d7a7" hidden="false" publicationId="b765-4747-cddc-385e" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una miniatura amiga **^^Mega‑Gargant^^** o **^^Gargant^^** quede abatida, antes de retirarla del juego, los jugadores deben hacer una tirada enfrentada. El ganador elige un punto del campo de batalla a 3" o menos de esa miniatura. Inflige D3 de daño mortal a cada unidad (amiga o enemiga) a 3" o menos de ese punto que tenga una característica de Salud inferior a la de esa miniatura.</characteristic>
          </characteristics>
        </profile>
        <profile name="Saltar arriba y abajo" id="40f8-2852-2586-c461" hidden="false" publicationId="b765-4747-cddc-385e" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Mega‑Gargant^^** o **^^Gargant^^** que no haya usado una habilidad de **^^Rampage^^** este turno para usar esta habilidad, y después elige como objetivo una unidad enemiga **^^Infantry^^** en combate con ella.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, tira un dado por cada miniatura de la unidad objetivo. Si la unidad que usa esta habilidad es un **^^Gargant^^**, inflige 1 de daño mortal al objetivo por cada 6. Si es un **^^Mega-Gargant^^**, inflige 1 de daño mortal al objetivo por cada 5+.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Rugido que sacude la tierra" id="2759-3ea9-4bcd-9116" hidden="false" publicationId="b765-4747-cddc-385e" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Mega‑Gargant^^** o **^^Gargant^^** que no haya usado una habilidad de **^^Rampage^^** este turno para usar esta habilidad, y después elige como objetivo una unidad enemiga en combate con ella.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, el objetivo no puede usar órdenes durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
