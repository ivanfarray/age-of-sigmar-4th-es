            </modifier>
          </modifiers>
          <rules>
            <rule name="Restricciones de mejoras" id="30bd-be15-fa94-a24f" hidden="true">
              <description>Los Talones agrietados son mejoras únicas que solo pueden otorgarse a los **^^Mancrusher Gargants^^**. Una unidad solo puede tener 1 Cracked Heel.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Ese chico no está bien" id="0617-416a-104b-9b43" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="73ef-ec1c-a2d8-fc29" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Ese chico no está bien" id="7c58-9367-7e36-a482" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 5+, esta unidad puede usar una habilidad **^^Prayer^^** del saber de plegarias que elegiste durante la composición del ejército como si tuviera **^^Priest (1)^^**. En lugar de hacer una tirada de cántico para esa plegaria, la tirada de cántico es 5 y no puede modificarse.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Dispuesto a todo" id="6e20-3f4d-f8a5-8d47" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="263c-4926-e8d9-e3e1" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Dispuesto a todo" id="07e8-62d9-a9fd-6692" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las armas de combate cuerpo a cuerpo de esta unidad tienen **Carga (+1 Daño)**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Siempre en guardia" id="d327-ae50-b7b0-a632" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b760-1ddd-d7be-24e8" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
