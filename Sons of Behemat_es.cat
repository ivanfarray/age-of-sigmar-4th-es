                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad puede usar habilidades **^^Desvincular^^** y **^^Desterrar^^** como si tuviera **^^Wizard (1)^^**. Además, cada vez que una **^^Manifestation^^** enemiga dentro del alcance de combate de esta unidad sea desterrada, **Heal (D3)** a esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Siempre el primero en entrar" id="6bac-0e5c-a65f-1987" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
