    <selectionEntryGroup name="Formaciones de batalla: Hijos de Behemat" id="4e00-4aeb-ae2-c3d5" flatten="true" hidden="false">
      <constraints>
        <constraint id="fd33-e97a-41a4-8913" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Tribu del Jefe" id="284c-43d1-c99d-9e69" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
          <constraints>
            <constraint id="1d23-5cfc-2e98-227c" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Bocazas" id="d8c6-9ab3-4163-29f3" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), Reacción: Has declarado una habilidad de Combatir para un Mega-Gargant amigo</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige como objetivo una unidad amiga **^^Gargant^^** que no haya usado una habilidad de **^^Combatir^^** este turno y esté totalmente a 12" o menos de esta unidad. El objetivo puede ser elegido para usar una habilidad de **^^Combatir^^** inmediatamente después de que se haya resuelto la habilidad de **^^Combatir^^** usada por esta unidad.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">El **^^Mega-Gargant^^** que use esa habilidad de **^^Combatir^^**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tribu Acaparadora" id="e5bd-6d0e-f80b-3f6a" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
          <constraints>
            <constraint id="70dc-23ac-b9c5-ba75" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Más cosas para mi colección" id="2418-1884-443c-e199" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, fase de despliegue</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Hijos de Behemat Hero^^** amigo que no sea **^^Unique^^** y que no tenga un artefacto de poder.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Otorga a ese **^^Hero^^** 1 artefacto de poder de &apos;Trofeos titánicos&apos;.
**Nota del diseñador:** *Este artefacto de poder se otorga a la unidad durante la fase de despliegue, no durante la composición del ejército.*</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tribu Rompedora" id="b29e-5c59-6291-2ea4" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
          <constraints>
            <constraint id="2f4d-a4c8-a8c6-2bc2" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Masa de asedio" id="f671-6232-47c6-3dc9" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Los **^^Mega-Gargants^^** amigos tienen **^^Ward (6+)^^** mientras estén dentro de los alcances de combate de otros **^^Mega-Gargants^^** amigos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tribu Pisoteadora" id="4be4-db42-f2db-e4" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
          <constraints>
            <constraint id="ae7f-360-32ae-c524" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Deleitarse en la guerra" id="2558-d7e2-3acf-e60c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Puedes elegir 2 unidades amigas **^^Mega‑Gargants^^** o **^^Gargant^^** que no hayan usado una habilidad de **^^Rampage^^** este turno para usar la habilidad &apos;Saltar arriba y abajo&apos; en lugar de 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Horda de Bolos Humanos" id="342d-444a-227c-34c3" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
          <constraints>
            <constraint id="af3d-9d69-757a-41bf" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="78a1-f6c2-71b8-270a" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="f079-501a-2738-6845" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="¡Pleno! ¡Jo, jo!" id="0bef-d9b8-8fe4-f030" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de disparo</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 2 unidades amigas **^^Mega-Gargant^^** que estén a 3" o menos de cualquier elemento de escenografía y cualesquiera unidades amigas **^^Gargant^^** que estén a 3" o menos de cualquier elemento de escenografía.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Duplica la característica de Attacks de las armas a distancia de cada objetivo durante el resto del turno. Si el objetivo no tiene armas a distancia, elige en su lugar una unidad enemiga a 12" o menos del objetivo y tira un D3. Con un 2+, inflige a esa unidad enemiga una cantidad de daño mortal igual al resultado.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dedos gordos" id="e7ee-a697-4858-15f4" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
          <constraints>
            <constraint id="4d81-e460-1f05-80a9" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="78a1-f6c2-71b8-270a" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="f079-501a-2738-6845" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Gamberros altísimos" id="6ae1-01a3-e57f-ee51" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4"/>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **Gigante aplastahombres**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, suma 1 a las tiradas de impacto de los ataques de combate efectuados por unidades amigas **^^Gargant^^** mientras estén totalmente a 12" o menos del objetivo y no estén totalmente a 12" o menos de ninguna unidad amiga **^^Mega-Gargant^^**.</characteristic>
