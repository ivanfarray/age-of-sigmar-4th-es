          <profiles>
            <profile name="Gamberros altísimos" id="6ae1-01a3-e57f-ee51" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4"/>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **Gigante aplastahombres**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, suma 1 a las tiradas de impacto de los ataques de combate efectuados por unidades amigas **^^Gargant^^** mientras estén totalmente a 12" o menos del objetivo y no estén totalmente a 12" o menos de ninguna unidad amiga **^^Mega-Gargant^^**.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
