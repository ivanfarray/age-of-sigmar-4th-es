          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignora el primer punto de daño que se fuera a asignar a las unidades amigas **^^Saurus^^** y **^^Kroxigor^^** en cada fase mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
