        <profile name="Coordinación eslizón" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="9b43-9dee-6ab5-80f5">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si una unidad amiga que no sea **^^Monster Eslizón^^** usa la orden &apos;Redesplegar&apos; mientras está totalmente a 18" o menos de esta unidad, no se gastan puntos de orden.</characteristic>
          </characteristics>
          <attributes>
