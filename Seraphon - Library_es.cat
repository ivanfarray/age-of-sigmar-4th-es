          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 10 o más puntos de daño, la característica de Attacks de sus **Cuernos y mandíbulas de estegadón** es 4.</characteristic>
          </characteristics>
        </profile>
        <profile name="Pisotones aplastantes" id="59ca-546-956d-be61" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
