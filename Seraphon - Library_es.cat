    <selectionEntry name="Máquina modelarreinos" id="dbb9-da98-e92e-b31e" hidden="false" import="true" publicationId="e9d0-a23-6a15-1fcb" type="unit">
      <categoryLinks>
        <categoryLink name="FACTION TERRAIN" id="cd97-4f38-daae-4d8c" hidden="false" primary="true" targetId="cdd6-ffa1-9b32-4cb8"/>
        <categoryLink name="SERAPHON" id="4f50-6578-74c4-bd4e" hidden="false" primary="false" targetId="9554-d069-a0dd-4f2d"/>
        <categoryLink name="ORDER" id="6fb8-550e-ea92-2ac0" hidden="false" primary="false" targetId="ee22-3575-6590-25c"/>
      </categoryLinks>
      <profiles>
        <profile name="Guardianes feroces" id="bf4d-2061-b8d1-193" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de impacto de los ataques de combate hechos por unidades amigas **^^Saurus^^** o **^^Kroxigor^^** que tengan como objetivo una unidad enemiga mientras esa unidad enemiga esté a 9" o menos de este elemento de escenografía.</characteristic>
          </characteristics>
        </profile>
        <profile name="Máquina modelarreinos" id="347-1edf-d040-29eb" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">15</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Poder desatado" id="aa75-204a-4256-8c68" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si hay alguna **^^Seraphon Wizards^^** amiga a 3" o menos de este elemento de escenografía, elige otro elemento de escenografía a 24" o menos de este elemento de escenografía y después elige como objetivos hasta 3 unidades enemigas a 3" o menos de ese elemento de escenografía.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3 por cada objetivo. Con un 2+, inflige al objetivo una cantidad de daño mortal igual al resultado. Si ese elemento de escenografía tiene característica de Salud, inflígele D3 de daño mortal.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
