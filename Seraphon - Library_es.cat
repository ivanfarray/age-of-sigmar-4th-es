            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: has declarado una habilidad de **^^Hechizo^^** para un **^^Seraphon Wizard^^** amigo totalmente a 12" o menos de esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si ese hechizo se lanza con éxito, durante el resto del turno, suma 3 a las puntuaciones de control de las unidades amigas **^^Seraphon^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Energías revitalizantes" id="15e-ebba-9386-bd1a" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las unidades amigas **^^Seraphon Infantry^^** tienen Ward (6+) mientras estén totalmente a 12" o menos de esta unidad. Si una unidad ya tiene **^^Ward (6+)^^**, en su lugar tiene **^^Ward (5+)^^**.</characteristic>
          </characteristics>
        </profile>
      </profiles>
