            <selectionEntry type="upgrade" import="true" name="Glóbulo de ácido flamígero" hidden="false" id="1ad8-ae2-e1a1-7e99">
              <constraints>
                <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="8cb4-60e5-4742-987f"/>
