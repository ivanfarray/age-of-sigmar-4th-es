        <profile name="Cazadores ocultos" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="1a1-4cae-359c-d9d">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad si no ha sido desplegada.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en reserva **en emboscada**. Ya ha sido desplegada.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Black</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Emboscada camaleónica" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="dabd-21de-78-69f9">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad si está **en emboscada**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en cualquier parte del campo de batalla a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
