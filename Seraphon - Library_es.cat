    <selectionEntry type="unit" import="true" name="Máquina modelarreinos" hidden="false" id="dbb9-da98-e92e-b31e" publicationId="e9d0-a23-6a15-1fcb">
      <categoryLinks>
        <categoryLink name="FACTION TERRAIN" hidden="false" id="cd97-4f38-daae-4d8c" targetId="cdd6-ffa1-9b32-4cb8" primary="true"/>
        <categoryLink name="SERAPHON" hidden="false" id="4f50-6578-74c4-bd4e" targetId="9554-d069-a0dd-4f2d" primary="false"/>
        <categoryLink name="ORDER" hidden="false" id="6fb8-550e-ea92-2ac0" targetId="ee22-3575-6590-25c" primary="false"/>
      </categoryLinks>
      <profiles>
        <profile name="Guardianes feroces" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="bf4d-2061-b8d1-193">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de impacto de los ataques de combate hechos por unidades amigas **^^Saurus^^** o **^^Kroxigor^^** que tengan como objetivo una unidad enemiga mientras esa unidad enemiga esté a 9" o menos de este elemento de escenografía.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Red</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Máquina modelarreinos" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="347-1edf-d040-29eb">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">15</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Poder desatado" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="aa75-204a-4256-8c68">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si hay alguna **^^Seraphon Wizards^^** amiga a 3" o menos de este elemento de escenografía, elige otro elemento de escenografía a 24" o menos de este elemento de escenografía y después elige como objetivos hasta 3 unidades enemigas a 3" o menos de ese elemento de escenografía.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3 por cada objetivo. Con un 2+, inflige al objetivo una cantidad de daño mortal igual al resultado. Si ese elemento de escenografía tiene característica de Health, inflígele D3 de daño mortal.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Yellow</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <rules>
        <rule name="Máquina modelarreinos" id="8617-b033-c4bc-82c7" hidden="false">
          <description>**Las siguientes habilidades universales de escenografía se aplican a este elemento de escenografía (Terrain, 1.2):
Cobertura, Inestable**</description>
        </rule>
        <rule name="Tamaño de peana" id="c745-4cd4-dc18-1896" hidden="true">
          <description>Usar miniatura</description>
        </rule>
