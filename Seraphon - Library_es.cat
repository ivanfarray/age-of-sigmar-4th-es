    <selectionEntry name="Engendro de Chotec" id="f663-5cfc-1f0e-690b" hidden="false" import="true" publicationId="e9d0-a23-6a15-1fcb" type="unit">
      <categoryLinks>
        <categoryLink name="ORDER" id="76ad-a204-d9f3-36ed" hidden="false" primary="false" targetId="ee22-3575-6590-25c"/>
        <categoryLink name="SERAPHON" id="280e-fa4c-f58e-2267" hidden="false" primary="false" targetId="9554-d069-a0dd-4f2d"/>
