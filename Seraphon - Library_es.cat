      <profiles>
        <profile name="Maestro estelar slann" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="5148-cb1a-5a40-5b46">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">9</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Maestros del orden" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="a7d5-1ea4-f890-7a84">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de lanzamiento de esta unidad. Además, esta unidad puede usar una habilidad de **^^Desvincular^^** si un **^^Wizard^^** enemigo en cualquier parte del campo de batalla usa una habilidad de **^^Hechizo^^**, en lugar de solo un **^^Wizard^^** enemigo a 30" o menos de esta unidad, y al usar la habilidad &apos;Desterrar manifestación&apos;, esta unidad puede elegir una manifestación en cualquier parte del campo de batalla en lugar de a 30" o menos de ella.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Yellow</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Refuerzos celestiales" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" hidden="false" id="2fa9-8fb2-f984-fa9e">
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga **^^Seraphon^^** que empezara la batalla con 3 o más miniaturas y que haya sido destruida.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de reemplazo con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 12" o menos de esta unidad y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
          <attributes>
            <attribute typeId="5c69-e4b9-19bc-e801" name="Color">Yellow</attribute>
            <attribute typeId="2bd5-08f1-f3d1-86f7" name="Type">Rallying</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
        </profile>
        <profile name="Equilibrio celestial" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="c7df-4c-19b2-6c40">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Durante el resto del turno, suma 1 a las tiradas de lanzamiento hechas por otros **^^Seraphon Wizards^^** amigos mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="16b6-0911-f549-a4bd" name="Color">Yellow</attribute>
            <attribute typeId="da27-8d61-f955-5031" name="Parent Node">Special</attribute>
          </attributes>
        </profile>
        <profile name="Vasallo arcano" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="1dee-3033-449b-90fc">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Eslizón Wizard^^** amigo totalmente a 18" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Mide el alcance y la visibilidad de la siguiente habilidad de **^^Hechizo^^** usada por esta unidad desde el objetivo en lugar de desde esta unidad. El objetivo se considera el lanzador a efectos de otras habilidades o efectos de hechizo, como &apos;Desvincular&apos; o &apos;La tierra tiembla&apos;.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Yellow</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Maestro estelar slann" hidden="false" id="542a-afde-a45d-4100">
