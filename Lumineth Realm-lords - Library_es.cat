                  </constraints>
                  <profiles>
                    <profile name="Icono del valor" id="9d30-c98c-9781-b107" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de carga</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos esta unidad y hasta otras 2 unidades **^^Señores del Reino Lumineth^^** amigas totalmente a 12" o menos de esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, al hacer tiradas de carga para el objetivo o los objetivos, suma 1 al número de dados tirados, hasta un máximo de 3; después, retira 1 dado a tu elección y usa los dados restantes como tirada de carga.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Forma ascendida" id="9c85-b8da-d52b-2a86" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="ddbd-67ba-8ea7-0f26" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Forma ascendida" id="ad8f-37cd-8beb-1931" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La primera vez que esta unidad fuera a ser destruida, antes de retirarla del juego, no es destruida y los puntos de daño restantes infligidos a ella no tienen efecto. Después, aplica **Heal (1)** a esta unidad y, durante el resto de la batalla:
• Ignora los modificadores (positivos y negativos) a las tiradas de salvación y de salvaguardia de esta unidad.
• Esta unidad tiene **^^Ward (4+)^^** y **^^Volar^^**.
• Esta unidad no puede ser curada.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
