                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede usar 2 habilidades **^^Combatir^^** en esta fase. Sin embargo, después de usar la primera, tiene **^^Strike-last^^** durante el resto del turno.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Presencia iluminadora" id="ca94-7f9b-9408-614d" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="0d5f-14cd-982a-c1f8" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Presencia iluminadora" id="df50-5c24-c251-22c8" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
