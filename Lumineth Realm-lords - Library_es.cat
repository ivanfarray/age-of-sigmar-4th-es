        <profile name="Aura de Celennar" id="e528-7901-d649-e45a" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de lanzamiento y de destierro de los **^^Lumineth Realm‑lords Wizards^^** amigos mientras estén totalmente a 12" o menos de esta unidad.
Además, esta unidad puede usar habilidades **^^Hechizo^^** del Saber de Hysh, del Lore of Awakened Realms y de los pergaminos de todos los **^^Señores del Reino Lumineth Wizards^^** amigos del campo de batalla.</characteristic>
          </characteristics>
        </profile>
        <profile name="Archimago" id="29d1-1e69-16f6-d780" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de los siguientes efectos:
***Supremacía mágica:*** En lugar de hacer una tirada de lanzamiento para la próxima habilidad **^^Hechizo^^** que use esta unidad este turno, puedes usar un valor de 12 para la tirada que no puede modificarse.
***Drenar poder***: Elige como objetivo un **^^Wizard^^** o **^^Priest^^** enemigo visible a 18" o menos de esta unidad. Resta 1 al nivel de poder del objetivo, hasta un mínimo de 0, hasta el inicio de tu siguiente turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Discos de los Aelementiri" id="599f-e356-c903-3bf1" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), Inicio de la ronda de batalla</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">No puedes usar esta habilidad en la primera ronda de batalla.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Representa una runa a tu elección en tu **escritura de batalla**.
**Nota del diseñador:** *Esto te permite tener esa runa representada antes en la **escritura de batalla** a efectos de otras habilidades. No resuelvas el efecto de la habilidad &apos;Trazar runa&apos; como parte de esta habilidad.
Hay un rombo más pequeño dentro del rombo de la escritura de batalla de la Referencia de reglas donde puedes anotar esta runa adicional.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="La luz de la verdad" id="70fe-927c-e02c-51c8" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivos cualquier número de unidades enemigas distintas visibles a 18" o menos de esta unidad; después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflige D3 de daño mortal a cada objetivo.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
