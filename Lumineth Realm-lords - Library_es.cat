          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a la característica de Attacks del **Martillo del mundo de Corazón de Piedra** de esta unidad por cada representación de **Alaithi, Rune of the Mountain** en tu **escritura de batalla**.</characteristic>
          </characteristics>
        </profile>
