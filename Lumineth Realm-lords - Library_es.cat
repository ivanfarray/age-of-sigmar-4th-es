                  <profiles>
                    <profile name="Reinos manifestados" id="68d6-0f82-596c-e536" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
