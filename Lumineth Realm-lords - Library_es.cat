        <profile name="Maestro de la espada supremo" id="7aed-7c9e-0257-513b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignora los modificadores negativos a las tiradas de impacto y de herida de los ataques de esta unidad. Además, ignora los modificadores negativos a las características de sus armas de combate.</characteristic>
          </characteristics>
        </profile>
        <profile name="Luz eterna" id="c39e-72bf-59da-8505" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad ha sido destruida y un **^^Señores del Reino Lumineth Wizard^^** amigo lanza con éxito un hechizo **^^Summon^^**, en lugar de resolver el efecto de ese hechizo **^^Summon^^**, puedes colocar una unidad de reemplazo de esta unidad a más de 9" de todas las unidades enemigas y totalmente a 12" o menos de la unidad que usó ese hechizo **^^Summon^^**. Esta habilidad sigue teniendo efecto aunque esta unidad no esté en el campo de batalla.</characteristic>
          </characteristics>
        </profile>
      </profiles>
