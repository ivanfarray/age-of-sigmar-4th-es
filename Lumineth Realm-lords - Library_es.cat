                <selectionEntry name="Foco elemental" id="61af-9f78-2f17-8289" hidden="false" import="true" sortIndex="1" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="Destiny Point Limit" typeId="bc33-05f5-8d3f-af43" value="-2"/>
                    <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                    <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Foco elemental" id="7d85-1871-a021-d1a2" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, Reacción: Has declarado la habilidad &apos;Trazar runa&apos;</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad es **^^Alarith^^**, sustituye cada runa de tu **escritura de batalla** por **Alaithi, Rune of the Mountain**.
Si esta unidad es **^^Hurakan^^**, sustituye cada runa de tu **escritura de batalla** por **Oreali, Rune of the Wind**.
Si esta unidad es **^^Ydrilan^^**, sustituye cada runa de tu **escritura de batalla** por **Ydriliqi, Rune of the River**.
Si esta unidad es **^^Scinari^^** o **^^Vanari^^**, elige 1 de las runas anteriores y sustituye cada runa de tu **escritura de batalla** por esa runa.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
