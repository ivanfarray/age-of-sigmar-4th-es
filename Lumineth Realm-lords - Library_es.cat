                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras las unidades **^^Señores del Reino Lumineth^^** amigas estén totalmente a 12" o menos de esta unidad, suma 1 a sus tiradas de lanzamiento y suma 1 a las tiradas de herida de sus ataques.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
