                  <profiles>
                    <profile name="Daños de batalla" id="79c1-652e-775c-1ec7" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
