            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas visibles **^^Hurakan^^** que estén totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, cada objetivo puede usar una habilidad **^^Correr^^** y seguir usando habilidades **^^Disparar^^** y/o **^^Cargar^^** más adelante en el turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Vórtice transportador" id="91a9-ff0b-2090-d419" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
