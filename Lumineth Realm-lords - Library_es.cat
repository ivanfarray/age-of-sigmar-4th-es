        <profile name="Cefiritas de Thyrielle" id="819f-017f-7436-ac87" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">7&quot;</characteristic>
