        <profile name="Maestros del céfiro" id="7aed-2f34-7736-ff5a" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">El **Tzul** de esta unidad es un marcador. Después de colocar esta unidad en el campo de batalla por primera vez, coloca su **Tzul** junto a ella.
• Mientras el **Tzul** de esta unidad esté junto a ella, esta unidad tiene **^^Volar^^**.
• Mientras la **Thyrielle** de esta unidad esté en el campo de batalla, esta unidad tiene **^^Wizard (1)^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Uno con el viento" id="7f0e-1612-ef0d-39c6" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad **^^Infantry^^** o **^^Cavalry^^** enemiga por encima de la cual haya pasado esta unidad en esta fase.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca el **Tzul** de esta unidad junto al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="El vendaval viviente" id="c870-8a19-5527-46b7" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga que tenga el Tzul de esta unidad junto a ella.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca el **Tzul** de esta unidad junto a esta unidad.
• Puedes mover al objetivo hasta D3".
• Después, si esta unidad está a 6" o menos del objetivo, puedes mover esta unidad hasta D6". No puede terminar ese movimiento en combate.
Suma 2" a la distancia que cada unidad puede moverse por cada representación de **Oreali, Rune of the Wind** en tu escritura de batalla.
**Nota del diseñador:** *Si tu oponente prefiere mover sus propias miniaturas, mide previamente la distancia e indica dónde debe moverlas.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
