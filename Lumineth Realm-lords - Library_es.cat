        </profile>
        <profile name="Eclipse total" id="f3bc-390c-fa13-42f1" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">8</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, la primera vez que una unidad enemiga a 18" o menos de esta unidad use una orden, salvo que tu oponente gaste 1 punto de orden adicional, la orden no tiene efecto, sigue considerándose usada y los puntos de orden gastados para usarla se pierden igualmente.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Prodigios iguales" id="7554-33eb-d12a-df05" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige si lidera Ellania o Ellathor.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si lidera Ellania, hasta el inicio de tu siguiente turno, suma 1 al nivel de poder de esta unidad y esta tiene **^^Ward (4+)^^**.
Si lidera Ellathor, hasta el inicio de tu siguiente turno, suma el número de la ronda de batalla actual a la característica de Damage de **Altairi**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Translocación repentina" id="819c-d248-d0cc-e6fa" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad solo puede usar esta habilidad si sus ataques de combate han abatido alguna miniatura enemiga este turno.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Aplica **Heal (D6)** a esta unidad. Después, retírala del campo de batalla y vuelve a colocarla en el campo de batalla a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
