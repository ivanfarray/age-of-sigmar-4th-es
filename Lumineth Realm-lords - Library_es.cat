            <characteristic name="Banishment" typeId="97a2-d412-9ac-6a37">7+</characteristic>
          </characteristics>
        </profile>
        <profile name="Múltiples partes" id="b3e9-77f2-4a1c-8d05" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cuando se le asigne una cantidad de puntos de daño igual a la característica de Salud de esta **^^Manifestation^^**, esta **^^Manifestation^^** es destruida y todas sus partes se retiran del juego.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sigilo de Yngra" id="124f-cb83-7925-536d" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras una unidad amiga con una característica de Salud de 10 o menos esté totalmente dentro del anillo formado por esta **^^Manifestation^^**:
• Esa unidad no es visible para las unidades enemigas que no estén dentro de su alcance de combate.
• Las habilidades enemigas que fueran a tener como objetivo esta unidad deben tener como objetivo esta **^^Manifestation^^** en su lugar.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Tamaño de peana" id="7953-b134-93e8-8972" hidden="true">
          <description>Usar miniatura</description>
        </rule>
      </rules>
    </selectionEntry>
