      <profiles>
        <profile name="Buscador del saber scinari" id="d390-65fa-28a6-134d" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Anulación arcana" id="92d3-dbc4-c430-6bdd" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hero^^** enemigo visible a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está en combate con el objetivo, el efecto correspondiente de los siguientes se aplica hasta el inicio de tu siguiente turno. En caso contrario, tira un dado. Con un 3+, el efecto correspondiente de los siguientes se aplica hasta el inicio de tu siguiente turno:
***Holder of Forbidden Treasures*:** Si el objetivo tiene un artefacto de poder, ese artefacto de poder no tiene efecto.
***An Insignificant Underling*:** Si el objetivo no tiene un artefacto de poder, salvo la habilidad de arma **Compañero**, las habilidades de arma de los ataques de combate del objetivo no tienen efecto.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Furia contenida" id="c7a9-83a3-a796-8d4c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
