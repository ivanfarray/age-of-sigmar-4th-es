                  </costs>
                  <modifierGroups>
                    <modifierGroup type="and">
                      <conditions>
                        <condition childId="d1f3-921c-b403-1106" field="selections" scope="root-entry" shared="true" type="instanceOf" value="1"/>
                      </conditions>
