        </profile>
        <profile name="Vientos huracanados" id="72a2-7f6c-d0f1-17ab" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
