          </characteristics>
        </profile>
        <profile name="Daños de batalla" id="dc5b-fe73-4964-3e30" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 10 o más puntos de daño, la característica de Attacks de sus **Martillos robafuego** es 4.</characteristic>
          </characteristics>
        </profile>
        <profile name="Llamada de las montañas" id="144b-b2e8-1747-bfb" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras una unidad **^^Alarith^^** amiga visible esté totalmente a 12" o menos de esta unidad:
• Se considera que tienes 1 representación adicional de **Alaithi, Rune of the Mountain** en tu **escritura de batalla** a efectos de las habilidades del pergamino de esa unidad.
• Si esa unidad es elegida como objetivo de la habilidad &apos;Trazar runa&apos;, puedes aplicar los efectos mejorados de esa habilidad a esa unidad como si tuvieras una representación de **Alaithi, Rune of the Mountain** en tu **escritura de batalla**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Baluarte inquebrantable" id="9158-802e-d799-61b6" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad no ha cargado este turno, elige como objetivo una unidad enemiga en combate con ella.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, durante el resto del turno, mientras esa unidad enemiga esté en combate con esta unidad, todos los ataques de las miniaturas de esa unidad que estén dentro del alcance de combate de esta unidad deben tener como objetivo esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Con la fuerza de un desprendimiento" id="8336-535a-b79f-460e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a la característica de Attacks de los **Martillos robafuego** de esta unidad por cada representación de **Alaithi, Rune of the Mountain** en tu **escritura de batalla**.</characteristic>
          </characteristics>
        </profile>
      </profiles>
