    <selectionEntryGroup name="Battle Formations" id="22cc-a0d6-614c-3468" hidden="false" flatten="true">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Depraved Carnival" hidden="false" id="c895-e297-46ec-513f" publicationId="95fc-e96f-a916-bba1">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4c03-e746-b6de-e7dc"/>
          </constraints>
          <profiles>
            <profile name="En busca del pecado" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="8eb3-9739-9570-cf1f">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas **^^Hedonites of Slaanesh Infantry^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada objetivo puede moverse D6". Solo puede terminar ese movimiento en combate con unidades con las que estuviera en combate al inicio del movimiento.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Godseeker Cavalcade" hidden="false" id="f70b-f6ba-d858-22b7" publicationId="95fc-e96f-a916-bba1">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="19a8-8353-c97a-3f00"/>
          </constraints>
          <profiles>
            <profile name="Rastro divino" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="3eca-92ef-f98a-5013">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén totalmente a 9" o menos de un borde del campo de batalla, las unidades amigas **^^Hedonites of Slaanesh^^** pueden usar habilidades de **^^Charge^^** aunque hayan usado una habilidad de **^^Run^^** en el mismo turno.</characteristic>
              </characteristics>
              <attributes>
                <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Gray</attribute>
                <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Artisans Of Torment" hidden="false" id="e170-091c-c496-4b11" publicationId="95fc-e96f-a916-bba1">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="81ba-548-f11a-7248"/>
          </constraints>
          <profiles>
            <profile name="Tendencias sádicas" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" hidden="false" id="3879-87c9-a645-5bcd">
              <characteristics>
                <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de combate</characteristic>
                <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige una unidad amiga **^^Hedonites of Slaanesh^^** para usar esta habilidad y, después, elige como objetivo una unidad enemiga que esté en combate con ella y a la que se le hayan asignado puntos de daño este turno.</characteristic>
                <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Durante el resto del turno:
• Todos los ataques de combate hechos por esa unidad amiga deben tener como objetivo esa unidad enemiga.
• Suma 1 a la característica de Attacks de las armas de cuerpo a cuerpo de esa unidad amiga.</characteristic>
                <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Lurid Dreamers" hidden="false" id="7641-d42e-8050-e611" publicationId="95fc-e96f-a916-bba1">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="bdba-ba0a-8571-f3fa"/>
          </constraints>
          <profiles>
            <profile name="Entre la fantasmagoría" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="bcb9-3cda-ff52-908b">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), fase de disparo enemiga</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Hedonites of Slaanesh^^** a la que se le hayan asignado puntos de daño este turno mediante una habilidad enemiga.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira el objetivo del campo de batalla y, después, vuelve a colocarlo en el campo de batalla a más de 9" de todas las unidades enemigas.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Pretenders" hidden="true" id="9b9b-eb34-8ecc-8054" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2be1-17a7-5b56-996f"/>
          </constraints>
          <profiles>
            <profile name="Prodigio del exceso" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c985-af0b-d9d7-b502">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hedonites of Slaanesh Hero^^** amigo que tenga un artefacto de poder.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Otorga al objetivo un rasgo heroico de las tablas &apos;Figureheads of the Dark Prince&apos; o &apos;Hedonistic Obsessions&apos;.
**Nota del diseñador:** *Este rasgo heroico se otorga al objetivo durante la fase de despliegue, no durante la composición del ejército.*</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Invaders" hidden="true" id="3adc-4841-c235-4584" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="272f-20a3-5321-8ea5"/>
          </constraints>
          <profiles>
            <profile name="Juerguistas extáticos" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="0184-bec1-4f4f-b17e">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a la característica de Rend de las armas de cuerpo a cuerpo usadas por unidades amigas **^^Sybarite Infantry^^** mientras estén totalmente fuera de su territorio</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier type="set" value="0" field="points">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="1bed-ddb5-0c50-16d2" shared="true" includeChildSelections="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="01b1-5112-ab45-1afc" shared="true" includeChildSelections="true"/>
