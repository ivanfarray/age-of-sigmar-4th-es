          <rules>
            <rule name="Restricciones de mejoras" id="35d8-014b-02ed-ce57" hidden="true">
              <description>Las Obsesiones absorbentes son mejoras únicas que solo pueden otorgarse a unidades **^^Hedonistas de Slaanesh^^** **^^Infantry^^** o **^^Cavalry^^** que no sean **^^Hero^^**. Una unidad solo puede tener 1 All-consuming Obsession.</description>
            </rule>
          </rules>
