                <profile name="La Vara del Desgobierno" id="1e95-1a75-154b-6d17" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo otra unidad amiga **^^Hedonistas de Slaanesh^^** visible que esté totalmente a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, cuando el objetivo use la orden &apos;Arrollar&apos;, puedes elegir como objetivo enemigo de esa orden a una unidad que no tenga una característica de Salud inferior a la de la unidad que usa esa orden.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Corona del Ur-Slaanesh" id="a0a8-9c52-81cd-2b80" hidden="false" import="true" publicationId="95fc-e96f-a916-bba1" type="upgrade">
