          </conditions>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Los Amados del Príncipe Oscuro" id="ef5e-07c3-ab53-7dae" hidden="true" publicationId="9e18-bb03-7b60-d4ff">
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="78a1-f6c2-71b8-270a" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="0151-9c5b-2f1e-32d4" childName="✦ General&apos;s Handbook 2026-27" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Restricciones de mejoras" id="fa9a-6d3c-cc24-afee" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Agónicamente escurridizo" id="f52a-ba41-4edd-d76b" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9b16-1a08-ec4e-a6c2" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Agónicamente escurridizo" id="9dc8-ac4b-b5b0-8653" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de movimiento</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga en combate con esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si es tu turno, aplica el efecto siguiente. Si es el turno de tu oponente, tira un dado. Con un 3+, aplica el efecto siguiente:
Inflige D3 de daño mortal al objetivo. Después, esta unidad debe moverse una distancia de hasta su característica de Move. Puede moverse a través de los alcances de combate de unidades enemigas, pero no puede terminar ese movimiento en combate.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Básica^^**, **^^Movimiento^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Enfurecido" id="0b59-46f1-ef87-4775" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b3e3-e38d-b774-afbf" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Enfurecido" id="2311-d091-d797-d3c5" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
                  <attributes>
                    <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Yellow</attribute>
                    <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Defensive</attribute>
                    <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de héroe</characteristic>
                    <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                    <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo un marcador de objetivo que esté a 6" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Hasta el inicio de tu siguiente turno, las unidades amigas **^^Hedonistas de Slaanesh^^** no son visibles para las unidades enemigas que estén a más de 9" de ellas mientras todas las miniaturas de esas unidades amigas estén disputando el marcador de objetivo.</characteristic>
                    <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
            </selectionEntry>
            <selectionEntry name="Magnetismo arcano" id="e350-063f-a193-7ef6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="886c-33ed-889d-4c18" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Magnetismo arcano" id="5e5e-5b33-3f5f-3b5c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad tiene 3 o más puntos de daño, puede usar una habilidad de **^^Hechizo^^** como si fuera tu fase de héroe, como si esa habilidad tuviera la palabra clave **^^Unlimited^^** y como si esta unidad tuviera **^^Wizard^^** (1).</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Los Amados del Príncipe Oscuro" id="224b-2ac6-a2d9-0d81" hidden="false">
          <rules>
            <rule name="Restricciones de mejoras" id="8c81-7a11-2000-2ec2" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Vitalidad indecorosa" id="d49d-5768-8196-d93c" hidden="false" import="true" publicationId="95fc-e96f-a916-bba1" type="upgrade">
              <constraints>
                <constraint id="b20c-5c4-9647-99f" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
