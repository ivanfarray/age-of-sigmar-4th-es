                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por batalla, tu fase de movimiento</characteristic>
                    <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                    <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga que no sea **^^Hero Infantry Hedonistas de Slaanesh^^** y que haya sido destruida.</characteristic>
                    <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de repuesto con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 12" o menos de esta unidad y a más de 9" de todas las unidades enemigas.</characteristic>
                    <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
