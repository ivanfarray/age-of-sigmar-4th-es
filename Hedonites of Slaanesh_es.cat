                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: has declarado la habilidad &apos;Run&apos; para esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Resta 1 a las tiradas de impacto de los ataques que tengan como objetivo esta unidad durante el resto del turno.</characteristic>
