            <selectionEntry type="upgrade" import="true" name="Semblante tímido" hidden="false" id="81c4-3e8a-e7ac-5413" publicationId="95fc-e96f-a916-bba1">
              <profiles>
                <profile name="Semblante tímido" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="4838-b034-28ab-378b">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén totalmente a 6" o menos de esta unidad, las unidades amigas que no sean **^^Monster^^** ni **^^War Machine Hedonites of Slaanesh^^** no son visibles para las unidades enemigas que estén a más de 12" de ellas.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="35b7-c906-49df-edd3" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="La Vara del Desgobierno" hidden="false" id="8b0b-791a-7873-1a61" publicationId="95fc-e96f-a916-bba1">
              <profiles>
                <profile name="La Vara del Desgobierno" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="1e95-1a75-154b-6d17">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo otra unidad amiga **^^Hedonites of Slaanesh^^** visible que esté totalmente a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, cuando el objetivo use la orden &apos;Power Through&apos;, puedes elegir como objetivo enemigo de esa orden a una unidad que no tenga una característica de Health inferior a la de la unidad que usa esa orden.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="53c8-d59c-5a97-eeeb" includeChildSelections="true"/>
              </constraints>
              <modifiers>
                <modifier type="set" value="0" field="points">
