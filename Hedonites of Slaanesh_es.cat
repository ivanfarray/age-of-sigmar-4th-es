      </constraints>
      <selectionEntries>
        <selectionEntry name="Carnaval Depravado" id="c895-e297-46ec-513f" hidden="false" import="true" publicationId="95fc-e96f-a916-bba1" type="upgrade">
          <constraints>
            <constraint id="4c03-e746-b6de-e7dc" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="En busca del pecado" id="8eb3-9739-9570-cf1f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas **^^Hedonistas de Slaanesh Infantry^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada objetivo puede moverse D6". Solo puede terminar ese movimiento en combate con unidades con las que estuviera en combate al inicio del movimiento.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
        </selectionEntry>
        <selectionEntry name="Cabalgata Buscadioses" id="f70b-f6ba-d858-22b7" hidden="false" import="true" publicationId="95fc-e96f-a916-bba1" type="upgrade">
          <constraints>
            <constraint id="19a8-8353-c97a-3f00" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Rastro divino" id="3eca-92ef-f98a-5013" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén totalmente a 9" o menos de un borde del campo de batalla, las unidades amigas **^^Hedonistas de Slaanesh^^** pueden usar habilidades de **^^Cargar^^** aunque hayan usado una habilidad de **^^Correr^^** en el mismo turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Artesanos del tormento" id="e170-091c-c496-4b11" hidden="false" import="true" publicationId="95fc-e96f-a916-bba1" type="upgrade">
          <constraints>
            <constraint id="81ba-548-f11a-7248" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Tendencias sádicas" id="3879-87c9-a645-5bcd" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de combate</characteristic>
                <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige una unidad amiga **^^Hedonistas de Slaanesh^^** para usar esta habilidad y, después, elige como objetivo una unidad enemiga que esté en combate con ella y a la que se le hayan asignado puntos de daño este turno.</characteristic>
                <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Durante el resto del turno:
• Todos los ataques de combate hechos por esa unidad amiga deben tener como objetivo esa unidad enemiga.
• Suma 1 a la característica de Attacks de las armas de cuerpo a cuerpo de esa unidad amiga.</characteristic>
                <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Soñadores Escabrosos" id="7641-d42e-8050-e611" hidden="false" import="true" publicationId="95fc-e96f-a916-bba1" type="upgrade">
          <constraints>
            <constraint id="bdba-ba0a-8571-f3fa" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Entre la fantasmagoría" id="bcb9-3cda-ff52-908b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), fase de disparo enemiga</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Hedonistas de Slaanesh^^** a la que se le hayan asignado puntos de daño este turno mediante una habilidad enemiga.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira el objetivo del campo de batalla y, después, vuelve a colocarlo en el campo de batalla a más de 9" de todas las unidades enemigas.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pretendientes" id="9b9b-eb34-8ecc-8054" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
