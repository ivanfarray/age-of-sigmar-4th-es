            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Corona del Ur-Slaanesh" hidden="false" id="a0a8-9c52-81cd-2b80" publicationId="95fc-e96f-a916-bba1">
              <profiles>
                <profile name="Corona del Ur-Slaanesh" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" hidden="false" id="71a3-a1a5-e731-5c1c">
                  <characteristics>
                    <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por batalla, tu fase de movimiento</characteristic>
                    <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                    <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga que no sea **^^Hero Infantry Hedonites of Slaanesh^^** y que haya sido destruida.</characteristic>
                    <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de repuesto con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 12" o menos de esta unidad y a más de 9" de todas las unidades enemigas.</characteristic>
                    <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Black</attribute>
                    <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rally</attribute>
                    <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
                  </attributes>
                </profile>
              </profiles>
