      </constraints>
    </selectionEntryGroup>
    <selectionEntryGroup name="Heroic Traits" id="c061-56e0-f2c0-af3e" hidden="false">
      <selectionEntryGroups>
        <selectionEntryGroup name="The Dark Prince&apos;s Beloved" id="ef5e-07c3-ab53-7dae" hidden="true" publicationId="9e18-bb03-7b60-d4ff">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Agónicamente escurridizo" hidden="false" id="f52a-ba41-4edd-d76b">
              <profiles>
                <profile name="Agónicamente escurridizo" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="9dc8-ac4b-b5b0-8653">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de movimiento</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga en combate con esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si es tu turno, aplica el efecto siguiente. Si es el turno de tu oponente, tira un dado. Con un 3+, aplica el efecto siguiente:
Inflige D3 de daño mortal al objetivo. Después, esta unidad debe moverse una distancia de hasta su característica de Move. Puede moverse a través de los alcances de combate de unidades enemigas, pero no puede terminar ese movimiento en combate.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Básica^^**, **^^Movimiento^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Gray</attribute>
                    <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="9b16-1a08-ec4e-a6c2" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Enfurecido" hidden="false" id="0b59-46f1-ef87-4775">
              <profiles>
                <profile name="Enfurecido" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" hidden="false" id="2311-d091-d797-d3c5">
                  <characteristics>
                    <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de héroe</characteristic>
                    <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                    <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo un marcador de objetivo que esté a 6" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Hasta el inicio de tu siguiente turno, las unidades amigas **^^Hedonites of Slaanesh^^** no son visibles para las unidades enemigas que estén a más de 9" de ellas mientras todas las miniaturas de esas unidades amigas estén disputando el marcador de objetivo.</characteristic>
                    <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
                  </characteristics>
                  <attributes>
                    <attribute typeId="5c69-e4b9-19bc-e801" name="Color">Yellow</attribute>
                    <attribute typeId="2bd5-08f1-f3d1-86f7" name="Type">Defensive</attribute>
                    <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="b3e3-e38d-b774-afbf" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Magnetismo arcano" hidden="false" id="e350-063f-a193-7ef6">
              <profiles>
                <profile name="Magnetismo arcano" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="5e5e-5b33-3f5f-3b5c">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad tiene 3 o más puntos de daño, puede usar una habilidad de **^^Hechizo^^** como si fuera tu fase de héroe, como si esa habilidad tuviera la palabra clave **^^Unlimited^^** y como si esta unidad tuviera **^^Wizard^^** (1).</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Red</attribute>
                    <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="886c-33ed-889d-4c18" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="0151-9c5b-2f1e-32d4" shared="true" childName="✦ General&apos;s Handbook 2026-27"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Enhancement Restrictions" id="fa9a-6d3c-cc24-afee" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="The Dark Prince&apos;s Beloved" id="224b-2ac6-a2d9-0d81" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Vitalidad indecorosa" hidden="false" id="d49d-5768-8196-d93c" publicationId="95fc-e96f-a916-bba1">
              <profiles>
                <profile name="Vitalidad indecorosa" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="085c-1dcd-d051-1f14">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="b20c-5c4-9647-99f" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Centro de atención" hidden="false" id="1cc1-51fe-a5bb-24a3" publicationId="95fc-e96f-a916-bba1">
              <profiles>
                <profile name="Centro de atención" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="5482-1341-b967-fbc2">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, durante el resto del turno, mientras esta unidad esté totalmente a 12" o menos del centro del campo de batalla y sea visible para el objetivo:


• Resta 1 a las tiradas de impacto de los ataques hechos por esa unidad enemiga que tengan como objetivo otras unidades amigas **^^Hedonites of Slaanesh^^**.
• Suma 1 a las tiradas de impacto de los ataques de combate hechos por otras unidades amigas **^^Hedonites of Slaanesh^^** que tengan como objetivo esa unidad enemiga.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="84f9-a7d7-4d4c-1fd5" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Diletante" hidden="false" id="b64a-4c09-cfc8-fac5" publicationId="95fc-e96f-a916-bba1">
              <profiles>
                <profile name="Diletante" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="7344-d235-48ec-c0c8">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de movimiento</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira esta unidad del campo de batalla y vuelve a colocarla en el campo de batalla a más de 9" de todas las unidades enemigas.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="841e-383-a922-1551" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
          <rules>
            <rule name="Enhancement Restrictions" id="8c81-7a11-2000-2ec2" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Hedonistic Obsessions" id="ddd8-a70f-9706-3bb8" hidden="true" publicationId="f894-7929-f79a-a269">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Maestro de la tentación" hidden="false" id="406b-c168-21e5-f447">
              <profiles>
                <profile name="Maestro de la tentación" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="3ed9-08bc-66d2-6512">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de héroe enemiga</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si tu oponente tiene algún dado de tentación. Elige como objetivo una unidad enemiga visible a 18" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, mientras tu oponente no haya usado ninguno de sus dados de tentación para sustituir una tirada del objetivo este turno, el objetivo solo puede usar habilidades de **^^Core^^**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="3477-c216-8ecd-983c" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Señor de la guerra célebre" hidden="false" id="a759-a125-4840-f353">
              <profiles>
                <profile name="Señor de la guerra célebre" typeId="55ac-f837-dded-5872" typeName="Ability (Command)" hidden="false" id="8d98-f250-278f-6375">
                  <characteristics>
                    <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por batalla, tu fase de movimiento</characteristic>
                    <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                    <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una unidad amiga que no sea **^^Hero Sybarite^^** y que haya sido destruida.</characteristic>
                    <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de repuesto con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 12" o menos de esta unidad y a más de 9" de todas las unidades enemigas.</characteristic>
                    <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Gray</attribute>
                    <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute>
                    <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="d701-f3d7-325b-97a5" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="La necesidad de perfección" hidden="false" id="5a58-c300-cb07-d02f">
              <profiles>
                <profile name="La necesidad de perfección" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="0ed2-3afc-dd9e-7669">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La primera vez cada turno que una tirada de carga, de lanzamiento, de desvinculación o de destierro sin modificar de una unidad amiga que no sea **^^Euphoric^^** y que esté totalmente a 12" o menos de esta unidad sea 5 o menos, esa unidad tiene la palabra clave **^^Euphoric^^** durante el resto del turno.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="c7a4-0536-10f3-63c9" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
