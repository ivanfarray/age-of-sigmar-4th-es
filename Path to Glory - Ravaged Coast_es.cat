                  <profiles>
                    <profile name="Rey de la colina" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="db9e-85a7-9223-99ba">
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad esté disputando un objetivo, las unidades enemigas **^^Infantry^^** y **^^Cavalry^^** no pueden disputar ese objetivo.</characteristic>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
