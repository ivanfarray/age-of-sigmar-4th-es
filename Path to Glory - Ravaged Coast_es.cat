                        <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Coloca una unidad de reemplazo idéntica al objetivo totalmente a 3" o menos de esta unidad.</characteristic>
                        <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
