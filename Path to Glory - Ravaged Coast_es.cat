                  <profiles>
                    <profile name="¡A las armas!" id="9667-e949-1d07-ca17" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
