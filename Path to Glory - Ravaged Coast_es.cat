                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Añade 1 a la característica de Attacks de las armas de esta unidad. Esto también afecta a las armas que tengan la habilidad de arma **Compañero**</characteristic>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
