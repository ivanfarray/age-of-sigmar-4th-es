                  <profiles>
                    <profile name="Destierro total" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="d19d-bf37-3185-c6ce">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), final de la ronda de batalla</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada **^^Manifestation^^** enemiga en el campo de batalla es desterrada y retirada del juego.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
