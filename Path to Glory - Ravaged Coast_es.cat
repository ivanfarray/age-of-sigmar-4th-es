                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Invocador experto" hidden="false" id="0dd1-4aa3-4783-3bb8">
                  <profiles>
                    <profile name="Invocador experto" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="407a-f4d2-c4ae-b9fe">
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Añade 3" a la distancia a la que pueden colocarse totalmente las **^^Manifestations^^** invocadas por esta unidad.</characteristic>
                      </characteristics>
                      <attributes>
