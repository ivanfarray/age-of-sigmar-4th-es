                  <profiles>
                    <profile name="Hechicería concentrada" id="5c79-5c5e-4449-f8de" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La primera vez que esta unidad use una habilidad **^^Hechizo^^** que no sea **^^Summon^^** en cada fase, añade 2 a la tirada de lanzamiento de ese hechizo.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Perturbador de poder" id="e357-63f6-3d42-186c" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="c67c-9e69-8242-3e6e" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Perturbador de poder" id="7041-389a-53da-a296" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Añade 1 a las tiradas de desvinculación de esta unidad. Además, esta unidad puede usar la habilidad &apos;Desvincular&apos; si el **^^Wizard^^** enemigo que lanza el hechizo está en cualquier lugar del campo de batalla en lugar de a 30" o menos de esta unidad.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
