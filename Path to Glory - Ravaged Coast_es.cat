                </selectionEntry>
                <selectionEntry name="Golpe decisivo" id="907c-6f56-7f86-138d" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="b69e-b6b9-0743-e610" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
