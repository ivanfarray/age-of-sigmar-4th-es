                    <profile name="Fuego rápido" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="58e1-43f9-c13a-a7ff">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de disparo</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad está en combate, elige 1 de sus armas a distancia como arma objetivo y elige una unidad enemiga en combate con ella como unidad objetivo.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, el arma objetivo tiene **Disparar in Combat** durante el resto de la fase, pero todos los ataques realizados con esa arma esta fase deben tener como objetivo la unidad objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
