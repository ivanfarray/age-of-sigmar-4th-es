              </constraints>
              <selectionEntries>
                <selectionEntry name="Ejemplo marcial" id="10ad-a07c-f2d2-54fe" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="96f9-c95f-b568-cc91" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Ejemplo marcial" id="3d44-6475-338a-1712" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad destruyó una unidad enemiga este turno, elige como objetivo otra unidad amiga visible totalmente a 12" o menos de esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el final de la siguiente ronda de batalla, añade 1 a la característica de Attacks de las armas de combate del objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
