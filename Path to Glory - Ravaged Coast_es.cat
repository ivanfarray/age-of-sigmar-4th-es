                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga que haya cargado este turno y esté en combate con esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede moverse una distancia de hasta su característica de Move. Puede atravesar los alcances de combate de las unidades enemigas, pero no puede terminar ese movimiento dentro del alcance de combate de una unidad enemiga. Después, tira un dado. Con un 3+, el objetivo no puede hacer un movimiento de aproximación durante el resto de la fase.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
