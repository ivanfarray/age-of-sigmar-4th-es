                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos todos los marcadores de objetivo del campo de batalla.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">
