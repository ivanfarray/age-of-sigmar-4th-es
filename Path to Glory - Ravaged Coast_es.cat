            <selectionEntryGroup name="Mighty" id="311b-de8d-f699-d1cc" hidden="false" sortIndex="3">
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Castigador" hidden="false" id="ad5a-4c24-f361-d248">
                  <profiles>
                    <profile name="Castigador" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="69af-3784-5ea5-3191">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una **^^Manifestation^^** enemiga a 6" o menos de esta unidad y después haz una tirada de destierro de 2D6.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si la tirada de destierro iguala o supera el valor de destierro indicado en el pergamino de la **^^Manifestation^^**, inflige D3 de daño mortal a la unidad que la invocó. Después, el objetivo es desterrado y retirado del juego.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Destierro^^**</characteristic>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
