            <selectionEntry type="upgrade" import="true" name="Impulsivo e iracundo" hidden="false" id="3b4e-e25a-5aaa-7f27">
              <profiles>
                <profile name="Impulsivo e iracundo" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="b9ff-224a-08aa-1920">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, reacción: El oponente declaró una habilidad **^^Cargar^^** para una unidad enemiga a 9" o menos de esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad no está en combate, puede usar inmediatamente una habilidad **^^Cargar^^** como si fuera tu fase de carga, pero debe terminar el movimiento a 1/2" o menos de esa unidad enemiga. Si lo hace, esta unidad ha cargado y la habilidad **^^Cargar^^** de esa unidad enemiga no tiene efecto. Esta unidad tiene **^^Strike-last^^** durante el resto del turno.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
