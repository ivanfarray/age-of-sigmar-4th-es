                  <profiles>
                    <profile name="Predicar con el ejemplo" id="732d-0d5f-2689-5374" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
