            <selectionEntryGroup name="Mighty" id="be99-7e44-fc8d-b68c" hidden="false" sortIndex="3">
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Municiones de pólvora negra" hidden="false" id="f523-0e56-8a99-6dfc">
                  <profiles>
                    <profile name="Municiones de pólvora negra" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="a47c-7424-2845-f45a">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, reacción: has declarado una habilidad de **^^Disparar^^** para esta unidad</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
