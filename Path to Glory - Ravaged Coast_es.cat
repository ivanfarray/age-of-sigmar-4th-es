                <selectionEntry type="upgrade" import="true" name="Carga volcánica" hidden="false" id="8570-149e-7034-9910">
                  <profiles>
                    <profile name="Carga volcánica" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="6e30-ef49-1309-f78e">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de carga</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad no está en combate y no ha usado una habilidad **^^Correr^^** o **^^Retirarse^^** este turno, puede moverse una distancia de 9". Esta unidad puede atravesar los alcances de combate de las unidades enemigas, pero debe terminar ese movimiento a 1/2" o menos de una unidad enemiga visible. Si lo hace, esta unidad ha cargado.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Básica^^**, **^^Movimiento^^**, **^^Carga^^**</characteristic>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e240-da91-8ec7-48ec"/>
                  </constraints>
                </selectionEntry>
              </selectionEntries>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2c87-98ac-dfdc-9d0a"/>
              </constraints>
            </selectionEntryGroup>
            <selectionEntryGroup name="Legendary" id="b291-0443-4ac7-8f1d" hidden="false" sortIndex="4">
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Golpes pulverizadores" hidden="false" id="1089-866c-8faf-96d0">
                  <profiles>
                    <profile name="Golpes pulverizadores" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="eec2-8ab6-456d-0536">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible en combate con esta unidad.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, resta 1 a las tiradas de salvación del objetivo durante el resto de la fase.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
                  </profiles>
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3a7c-5121-49a4-c2a4"/>
                  </constraints>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Impacto aniquilador" hidden="false" id="d173-394c-3e36-56a4">
                  <profiles>
                    <profile name="Impacto aniquilador" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="2795-1bc6-0f5f-4f86">
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad cargó este turno, elige como objetivo una unidad enemiga visible a 1" o menos de ella.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un número de dados igual a la característica de Health de esta unidad menos el número de puntos de daño que tenga. Por cada 4+, inflige 1 de daño mortal al objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                    </profile>
