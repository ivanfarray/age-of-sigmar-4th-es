                                <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="376a-6b97-8699-dd59" shared="true"/>
                              </conditions>
                            </conditionGroup>
                          </conditionGroups>
Roll a D6 for each target. Inflict an amount of mortal damage on each unit contesting the target equal to the roll.                        </characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
