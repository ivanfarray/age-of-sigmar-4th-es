                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: El oponente declaró una habilidad **^^Combatir^^** cuyo objetivo era esta unidad</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad no ha usado una habilidad **^^Combatir^^** esta fase, hasta el final de la fase:
• Cada vez que tu oponente haga una tirada de impacto sin modificar de 1 para un ataque de combate cuyo objetivo sea esta unidad, después de resolver la habilidad **^^Combatir^^**, inflige a la unidad atacante una cantidad de daño mortal igual a la característica de Damage del arma usada para ese ataque.
• Resta 1 a las tiradas de impacto de los ataques de esta unidad.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
