                <selectionEntry name="Hechicería concentrada" id="0416-da23-0f5b-23a7" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="9734-bf83-b202-3cbc" field="selections" scope="parent" shared="true" type="max" value="1"/>
