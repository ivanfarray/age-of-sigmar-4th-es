                  </constraints>
                  <profiles>
                    <profile name="Furia magnífica" id="4258-c2cd-37fc-7a05" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                        <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad esté en combate, añade 1 a las tiradas de herida de los ataques de combate de otras unidades amigas mientras estén dentro del alcance de combate de esta unidad.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Mantenerse firme" id="9678-1822-92c0-1325" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="9c73-a845-3410-1c5a" field="selections" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <profiles>
                    <profile name="Mantenerse firme" id="58e3-906b-6c13-9311" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                      <attributes>
                        <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                        <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                        <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                      </attributes>
                      <characteristics>
                        <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos esta unidad y una unidad amiga que no sea **^^Hero^^** dentro de su alcance de combate.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, si cualquiera de los objetivos usa la orden &apos;Defensa total&apos;, el otro objetivo también puede usar la misma orden en la misma fase y no se gastan puntos de orden para usarla una segunda vez.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
