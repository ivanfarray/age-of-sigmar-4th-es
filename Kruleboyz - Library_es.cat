    <selectionEntry name="Tótem bocaterror" id="8346-0ba5-9740-dc49" hidden="false" import="true" publicationId="8b1b-f2c7-890e-2bbe" type="unit">
      <categoryLinks>
        <categoryLink name="FACTION TERRAIN" id="099a-08e6-1ba6-f20a" hidden="false" primary="true" targetId="cdd6-ffa1-9b32-4cb8"/>
        <categoryLink name="DESTRUCTION" id="ffe5-e638-980d-64e1" hidden="false" primary="false" targetId="9057-5a29-dda5-3c28"/>
        <categoryLink name="KRULEBOYZ" id="cb4f-0268-76a1-1d5e" hidden="false" primary="false" targetId="6e42-3c75-4cb5-337a"/>
      </categoryLinks>
      <profiles>
        <profile name="¡Ocupad la torre!" id="c634-841d-23aa-0f5e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras este elemento de escenografía tenga un Shouty Jefe:
• El Shouty Jefe no puede usar habilidades de **^^Move^^**.
• En lugar de medir el alcance o la visibilidad hasta el Shouty Jefe, mide hasta este elemento de escenografía.
• Todos los ataques que tendrían como objetivo al Shouty Jefe tienen como objetivo este elemento de escenografía en su lugar.
• Si este elemento de escenografía es destruido, antes de retirarlo del campo de batalla, inflige D3 de daño mortal al Shouty Jefe. Después, coloca al Shouty Jefe en el campo de batalla a 3" o menos de este elemento de escenografía y sin estar en combate. Esa unidad deja de ser el Shouty Jefe. Si no es posible colocar al Shouty Jefe, queda abatida.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tótem bocaterror" id="0da3-10a7-73c5-d399" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">12</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic>
          </characteristics>
        </profile>
        <profile name="¡Arriba vamos!" id="3217-c0c2-95d5-ce9b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si este elemento de escenografía no tiene un Shouty Jefe, elige como objetivo un **^^Chikoz Crueles Infantry Hero^^** amigo que no esté en combate y esté a 3" o menos de él.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca el objetivo sobre este elemento de escenografía. El objetivo pasa a ser un Shouty Jefe (ver &apos;¡Ocupad la torre!&apos;).</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Mirada siniestra" id="912f-1155-0af4-2a0b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de dirty trick de las unidades amigas **^^Chikoz Crueles^^** totalmente a 12" o menos de este elemento de escenografía, o de las unidades enemigas a 12" o menos de este elemento de escenografía. Si este elemento de escenografía tiene un Shouty Jefe, suma 1 a las tiradas de dirty trick de las unidades amigas **^^Chikoz Crueles^^** totalmente a 18" o menos de este elemento de escenografía en lugar de a 12" o menos, o de las unidades enemigas a 18" o menos de este elemento de escenografía en lugar de a 12" o menos.</characteristic>
          </characteristics>
        </profile>
        <profile name="¡Me largo!" id="e0d9-25bd-1253-3468" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si este elemento de escenografía tiene un Shouty Jefe que no haya sido colocado sobre él este turno, coloca al Shouty Jefe en el campo de batalla totalmente a 6" o menos de este elemento de escenografía y sin estar en combate. Esa unidad deja de ser el Shouty Jefe.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Tótem bocaterror" id="a061-7873-e16d-1554" hidden="false">
          <description>**Las siguientes habilidades universales de escenografía se aplican a este elemento de escenografía (Terrain, 1.2):
Cobertura, Infranqueable**</description>
        </rule>
        <rule name="Tamaño de peana" id="e440-2698-9c60-3e51" hidden="true">
          <description>100mm</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Jefe rajador hobgrot" id="3bd7-2a9f-9356-b454" hidden="false" import="true" publicationId="8b1b-f2c7-890e-2bbe" type="unit">
