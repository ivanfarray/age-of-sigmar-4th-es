        <profile name="Skumdrekk, Jefe del Pantano" id="0320-c85a-7033-f510" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
