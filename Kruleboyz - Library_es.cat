                      </attributes>
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de impacto y de herida de los ataques de disparo que tengan como objetivo unidades amigas **^^Chikoz Crueles^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
