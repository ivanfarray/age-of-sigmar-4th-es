        <profile name="Skumdrekk, Jefe del Pantano" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="0320-c85a-7033-f510">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
