        <profile name="Eso es nuestro, tipejos" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="82eb-4034-2f5f-7e38">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad esté disputando un marcador de objetivo que no controles, suma 1 a las tiradas de impacto de los ataques de combate hechos por unidades amigas **^^Kruleboyz^^** totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Red</attribute>
