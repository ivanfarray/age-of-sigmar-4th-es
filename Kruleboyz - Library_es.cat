        <profile name="Todo forma parte del plan" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="302a-3890-a15-933f">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo otra unidad amiga **^^Kruleboyz^^** totalmente a 9" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 3 a la puntuación de control del objetivo hasta el inicio de tu siguiente turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
