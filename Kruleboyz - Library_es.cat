        <profile name="Merodeando por los flancos" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="d9b0-7c66-0260-c4f5">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está totalmente a 6" o menos del borde del campo de batalla, retírala del campo de batalla y vuelve a colocarla totalmente a 6" o menos del borde del campo de batalla y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
