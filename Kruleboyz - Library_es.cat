      <profiles>
        <profile name="Matamonstruos de los Chikoz Krueles" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="ec9b-83b8-8858-c83c">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Grot aferrador" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="c0eb-bb8b-e980-51da">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">El **Grot aferrador** de esta unidad es una ficha. Si se retira del campo de batalla, esta unidad no puede usar la habilidad &apos;Un grot difícil de tragar&apos;.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Cebo y trampa" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="e436-a009-b0b4-d00c">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Monster^^** enemigo en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Suma 1 al resultado si el objetivo está dañado. Con un 3+, el objetivo tiene **^^Strike-last^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Red</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Un grot difícil de tragar" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="6eef-d172-7702-69c1">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, reacción: el oponente ha declarado una habilidad de **^^Rampage^^** para un **^^Monster^^** enemigo a 6" o menos de esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 2+, esa habilidad de **^^Rampage^^** no tiene efecto. Con un 1, retira del campo de batalla el **Grot aferrador** de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
