            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Alijo tóxico" id="4eff-2023-8e44-9886" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Infantry Hero^^** enemigo en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira 2D6. Si el resultado supera la característica de Salud del objetivo, este queda destruido automáticamente.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Tácticas de compañía" id="f234-2bbf-4307-20f9" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una habilidad de **^^Combatir^^** para esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige como objetivo una unidad amiga **Rajadores hobgrot** que no haya usado una habilidad de **^^Combatir^^** este turno y esté dentro del alcance de combate de esta unidad. Se puede elegir al objetivo para usar una habilidad de **^^Combatir^^** inmediatamente después de que se resuelva la habilidad de **^^Combatir^^** usada por esta unidad. Si se elige hacerlo, suma 1 a las tiradas de herida de los ataques del objetivo durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Jefe rajador hobgrot" id="0860-c5b3-1781-e55d" hidden="false" import="true" type="model">
