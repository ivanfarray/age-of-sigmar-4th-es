                    <rule name="Filos Sonrientez" id="76db-098e-075f-a5cf" hidden="true">
                      <description>Tu héroe tiene **^^Wizard (1)^^**, la habilidad &apos;De entre las brumas&apos; y las siguientes opciones de regimiento:
Cualquier unidad **^^Chikoz Crueles^^**</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Grandes Gritonez" id="7b66-56cd-d332-daca" hidden="false" import="true" sortIndex="2" type="upgrade">
