            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Daños de batalla" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="ada7-b28b-85bc-63f0">
          <characteristics>
