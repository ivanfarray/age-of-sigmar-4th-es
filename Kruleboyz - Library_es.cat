          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">El **Grot aferrador** de esta unidad es una ficha. Si se retira del campo de batalla, esta unidad no puede usar la habilidad &apos;Un grot difícil de tragar&apos;.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cebo y trampa" id="e436-a009-b0b4-d00c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
