          </attributes>
        </profile>
        <profile name="Peña contadora" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="4fd8-d39b-7cf6-52cf">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **Rajadores hobgrot** dentro del alcance de combate de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, las **Cuchillos rajadores** del objetivo tienen **Crit (Mortal)** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
