          </attributes>
        </profile>
        <profile name="Agravamiento de heridas" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="bdd3-1da1-2cd9-4cd6">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Monster^^** enemigo en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un número de dados igual al número de puntos de daño que tenga el objetivo. Por cada 5+, inflige 1 de daño mortal al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Purple</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Maestro de apuestas" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="d047-3e65-3f04-ee19">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga en el campo de batalla para que sea **la apuesta**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 1 a las tiradas de herida de los ataques hechos por esta unidad y por las unidades amigas **Rajadores hobgrot** que tengan como objetivo **la apuesta**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
