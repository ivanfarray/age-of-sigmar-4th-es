    <selectionEntryGroup name="Heroic Traits" id="ddb4-90b1-b359-dd63" hidden="false">
      <selectionEntryGroups>
        <selectionEntryGroup name="Rasgos heroicos: Puesto Avanzado Pionero" id="5472-2133-d3d8-14e2" hidden="false" publicationId="d4a9-b568-9525-d6ac">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Dedos de cobre" hidden="false" id="851f-dd80-3cc2-dffb">
              <profiles>
                <profile name="Dedos de cobre" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="76ab-0028-250a-8d4d">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, reacción: has declarado la habilidad &apos;Puesto avanzado de ingeniería endrín&apos; para un Muelle endrín Zontari</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está totalmente a 9" o menos de ese **Muelle endrín Zontari**, en lugar de resolver el efecto de esa habilidad &apos;Puesto avanzado de ingeniería endrín&apos;, coloca un **^^Autoendrín^^** de repuesto en el campo de batalla, totalmente a 6" o menos de ese **Muelle endrín Zontari** y a más de 3" de todas las unidades enemigas.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1400-3325-627c-7de0" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Explorador territorial" hidden="false" id="4461-f332-e9e7-4f38">
              <profiles>
                <profile name="Explorador territorial" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="7a5d-f254-a803-770c">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 3 a las puntuaciones de control de las unidades enemigas mientras estén en combate con esta unidad.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
