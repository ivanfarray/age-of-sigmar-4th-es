  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Rasgos de batalla: Puesto Avanzado Pionero" hidden="false" id="fb0b-81f2-5beb-64b4" publicationId="d4a9-b568-9525-d6ac">
      <profiles>
        <profile name="Ajustar cuentas" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="49b4-9185-15a0-b2f3">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si no has usado ninguna habilidad de **^^Code^^** este turno y un **^^Autoendrín^^** amigo ha sido destruido este turno por una unidad enemiga.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, cada vez que un **^^Autoendrín^^** amigo sea retirado del campo de batalla, antes de retirarlo, inflige D3 de daño mortal a cada unidad enemiga a 3" o menos de ese **^^Autoendrín^^**</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Código^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Inversión inicial" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="69a0-4914-30a5-a5fb">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada **^^Autoendrín^^** amigo puede moverse 2D6", pero no puede terminar ese movimiento en combate.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Adquisiciones agresivas" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="d069-ddad-37be-a1be">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si no has usado ninguna habilidad de **^^Code^^** este turno y hay una unidad amiga **^^Pioneer^^** en cada cuarto grande del campo de batalla. Cada una de esas unidades debe estar a más de 6" de todos los demás cuartos grandes del campo de batalla y no estar en combate.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, las unidades enemigas no pueden colocarse dentro de tu territorio ni a 9" o menos de un marcador de objetivo que controles.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Código^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Inversiones seguras" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="e768-c713-a5f2-39e8">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si no has usado ninguna habilidad de **^^Code^^** este turno y alguna unidad enemiga que estuviera a 3" o menos de tu **Muelle endrín Zontari** este turno ha sido destruida este turno.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, ignora la característica de Rend de los ataques de combate que tengan como objetivo unidades amigas que no sean **^^Infantry Pioneer^^** o elementos de escenografía de facción amigos.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Código^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Dominio del mercado" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="14f1-7d23-a900-1231">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si no has usado ninguna habilidad de **^^Code^^** este turno y controlas todos los marcadores de objetivo que no estén totalmente dentro del territorio enemigo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, cada vez que uses la habilidad &apos;Puesto avanzado de ingeniería endrín&apos; de tu **Muelle endrín Zontari**, puedes colocar un **^^Autoendrín^^** de repuesto con una tirada de fabricación de 3+ en lugar de 4+.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Código^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Adquisición hostil" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="993a-2275-a5fd-4a0c">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Solo puedes usar esta habilidad si no has usado ninguna habilidad de **^^Code^^** este turno y un **^^Hero^^** enemigo ha sido destruido este turno por ataques de disparo hechos por una unidad amiga **^^Pioneer^^**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, resta 1 a las tiradas de impacto de los ataques de disparo que tengan como objetivo unidades amigas **^^Pioneer^^** o elementos de escenografía de facción amigos.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Código^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="Reference" hidden="false" id="62c1-ab10-d772-941d" targetId="3360-1158-e879-9606" primary="true"/>
      </categoryLinks>
    </selectionEntry>
