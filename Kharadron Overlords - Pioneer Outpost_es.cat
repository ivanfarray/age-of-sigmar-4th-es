                <constraint id="1400-3325-627c-7de0" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Dedos de cobre" id="76ab-0028-250a-8d4d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, reacción: has declarado la habilidad &apos;Puesto avanzado de ingeniería endrín&apos; para un Muelle endrín Zontari</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está totalmente a 9" o menos de ese **Muelle endrín Zontari**, en lugar de resolver el efecto de esa habilidad &apos;Puesto avanzado de ingeniería endrín&apos;, coloca un **^^Autoendrín^^** de repuesto en el campo de batalla, totalmente a 6" o menos de ese **Muelle endrín Zontari** y a más de 3" de todas las unidades enemigas.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
