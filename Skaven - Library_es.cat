        <profile name="More-more Warpstone Bullets!" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="5bf4-da9b-f1d6-e2a8">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está dentro del alcance de combate de un **^^Skryre Hero^^** amigo, su **Lluvia de balas de piedra bruja** tiene un atributo Attacks de 6D6+3 en lugar de 3D6+3 durante el resto del turno. Sin embargo, por cada tirada de impacto sin modificar de 1 de un ataque hecho con el **Lluvia de balas de piedra bruja** de esta unidad, inflige 1 daño mortal a esta unidad después de resolver la habilidad **^^Shoot^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Blue</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Overwhelming Fire" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="d11-9a61-13d0-4d8d">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de impacto de los ataques de disparo de esta unidad que tengan como blanco a una unidad enemiga con 10 o más miniaturas.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Blue</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Shooting</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
