        <profile name="Sneaky Infiltrators" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="706f-dcdc-3eaa-c3d7">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras todas las miniaturas de esta unidad estén a 1" o menos de un elemento de terreno, esta unidad no puede ser blanco de ataques de disparo a menos que la miniatura atacante esté a 9" o menos de ella.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Green</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Shadowy Killers" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="45a2-ffd2-8f3b-a068">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si la tirada de impacto sin modificar de un ataque que tenga como objetivo esta unidad es 1-4, el ataque falla y la secuencia de ataque termina.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Green</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
