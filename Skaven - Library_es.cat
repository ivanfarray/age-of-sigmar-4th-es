      <categoryLinks>
        <categoryLink name="SKAVEN" hidden="false" id="50db-c7cc-e6a3-14c0" targetId="cce6-9e5a-dd33-a755" primary="false"/>
        <categoryLink name="CHAOS" hidden="false" id="f884-67d3-3ba-480d" targetId="319b-38ee-d10d-e800" primary="false"/>
        <categoryLink name="WAR MACHINE" hidden="false" id="abb1-87e7-50f1-bfa1" targetId="f7bc-b618-4b5d-2bae" primary="true"/>
        <categoryLink name="SKRYRE" hidden="false" id="31c6-232a-ccd2-8c1a" targetId="da36-ed81-79fe-ca75" primary="false"/>
      </categoryLinks>
      <profiles>
        <profile name="Cañón de relámpagos disformes" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="450c-6744-b657-bdd7">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">3&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">8</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="More-more Warp Lightning!" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="1b71-65b9-467b-6e29">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está dentro del alcance de combate de un **^^Skryre Hero^^** amigo, suma 6 al atributo Attacks de su **Ráfaga de relámpagos disformes** durante el resto del turno.
Sin embargo, por cada tirada de impacto sin modificar de 1 de un ataque hecho con el **Ráfaga de relámpagos disformes** de esta unidad, inflige D3 de daño mortal a esta unidad después de resolver la habilidad **^^Shoot^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Blue</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Ráfaga de relámpagos disformes" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="7df7-d366-bd68-a0d3">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Todos los ataques hechos con esta arma en una misma fase deben tener como blanco a la misma unidad enemiga. Cada impacto inflige 1 daño mortal al blanco y la secuencia de ataque termina.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Blue</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Shooting</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Cañón de relámpagos disformes" hidden="false" id="d4eb-8213-9f6b-18c3">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Ráfaga de relámpagos disformes" hidden="false" id="76bf-d9ef-3e8c-6314">
