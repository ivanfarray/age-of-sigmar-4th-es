    <selectionEntry name="Agujero roedor" id="a177-dc85-8fd5-3509" hidden="false" import="true" publicationId="ff83-b049-91b9-ed05" type="unit">
      <categoryLinks>
        <categoryLink name="FACTION TERRAIN" id="e637-8c4d-e59a-2e3c" hidden="false" primary="true" targetId="cdd6-ffa1-9b32-4cb8"/>
