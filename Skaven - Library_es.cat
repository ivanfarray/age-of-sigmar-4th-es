          </characteristics>
          <attributes>
            <attribute name="Base Size" typeId="50db-066e-a3e7-696f"/>
          </attributes>
        </profile>
        <profile name="Múltiples partes" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="52c7-e5b8-e2b0-1bfd">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cuando se asigne a esta **^^Manifestation^^** una cantidad de puntos de daño igual a su atributo Health, esta **^^Manifestation^^** queda destruida y todas sus partes se retiran del juego.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Warp Lightning Bolts" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="97e8-cfdc-d93a-532e">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta **^^Manifestation^^** no se ha colocado en este turno, elige todas las unidades enemigas a 6" o menos de esta **^^Manifestation^^** como blancos.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado por cada blanco. Con un 4+, inflige D3 de daño mortal al blanco.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Yellow</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Warp Vortex" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="708a-34ba-c0f-6ca3">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 2 a las tiradas de carrera y de carga de las unidades enemigas mientras estén a 6" o menos de esta **^^Manifestation^^**. Además, si una unidad enemiga atraviesa esta **^^Manifestation^^** y/o el triángulo de esquinas redondeadas formado al trazar una línea alrededor de todas las peanas de las partes de la **^^Manifestation^^**, inflige D3 de daño mortal a esa unidad enemiga después de resolver la habilidad **^^Move^^**.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
