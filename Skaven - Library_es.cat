        <profile name="¡Roed-roed sus huesos!" id="e5f7-94a5-380c-1f1b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
