            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Assassins" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="62ff-c41a-bd1-65b7">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado la orden &apos;Redeploy&apos; para una unidad **^^Eshin Infantry^^** amiga totalmente a 13" o menos de esta unidad.</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si obtienes un 1-3 al determinar la distancia que esa unidad puede moverse, puedes usar un valor de 4 en su lugar.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Gray</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Burst From the Shadows" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="2576-5d86-146d-89f5">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está en combate, tira un dado. Con un 4+, puedes elegir un punto del campo de batalla a 13" o menos de esta unidad y a 1" o menos de alguna unidad enemiga. Retira esta unidad del campo de batalla y vuelve a colocarla a 1" o menos de ese punto.
**Nota del diseñador:** *Esta habilidad permite colocar a la unidad en combate con una nueva unidad enemiga.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Red</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
