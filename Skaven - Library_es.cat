        </profile>
        <profile name="Lightning Master" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f887-323e-a55a-5302">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), tu fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad **Azotadores de voltaje disforme** amiga dentro del alcance de combate de esta unidad como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 2+, establece el atributo Attacks de los **Azotadores de voltaje disforme** del blanco en 10 durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
