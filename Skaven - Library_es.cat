        <profile name="The Bell Tolls" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="a074-1628-9623-e759">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si el número de la ronda de batalla actual es impar, suma 2" al atributo Move de las unidades **^^Skaven^^** amigas mientras estén totalmente a 13" o menos de esta unidad. Si el número de la ronda de batalla actual es par, resta 1 a las tiradas de impacto de los ataques de unidades enemigas que tengan como blanco a una unidad **^^Skaven^^** amiga mientras esté totalmente a 13" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Echoes of the Vermindoom" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="0bd0-f3db-8eac-1f63">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas visibles **^^Skaven^^** que estén totalmente a 13" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** cada objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Purple</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
