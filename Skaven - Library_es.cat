          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras todas las miniaturas de esta unidad estén a 1" o menos de un elemento de terreno, esta unidad no puede ser blanco de ataques de disparo a menos que la miniatura atacante esté a 9" o menos de ella.</characteristic>
          </characteristics>
        </profile>
        <profile name="Asesinos sombríos" id="45a2-ffd2-8f3b-a068" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
