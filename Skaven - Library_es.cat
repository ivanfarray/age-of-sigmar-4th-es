            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Terrible Madness" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="9be5-4bff-d155-d2b3">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige una unidad enemiga visible a 13" o menos de esta unidad como blanco y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">El blanco no puede usar órdenes hasta el inicio de tu próximo turno. Además, tira tantos dados como miniaturas tenga la unidad blanco. Por cada 6, inflige 1 daño mortal al blanco.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="16b6-0911-f549-a4bd" name="Color">Yellow</attribute>
            <attribute typeId="da27-8d61-f955-5031" name="Parent Node">Special</attribute>
          </attributes>
        </profile>
