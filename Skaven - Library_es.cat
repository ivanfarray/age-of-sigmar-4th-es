            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Avalanche of Flesh" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="3c12-8517-ab19-918c">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga **^^Infantry^^** en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, tira un dado por cada miniatura de la unidad objetivo. Por cada 5+, inflige 1 punto de daño mortal al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Red</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Regenerating Monstrosity" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="4564-ffd9-bca8-a9b">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Aplica **Heal (D6)** a esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Purple</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Too Horrible to Die" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="a747-2706-e6a2-5d71">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La primera vez que esta unidad fuera a ser destruida, antes de retirarla del campo de batalla, tira un dado y aplica el efecto correspondiente:
**1 *Dead:*** Esta unidad queda destruida.
**2-4 *The Rats Emerge:*** Tira un D3 por cada unidad enemiga en combate con esta unidad. Con un 2+, inflige a esa unidad una cantidad de daño mortal igual a la tirada. Después, esta unidad queda destruida.
**5-6 *It&apos;s Alive!:*** Esta unidad no queda destruida y cualquier punto de daño restante infligido a ella no tiene efecto. Después, aplica **Heal (D6)** a esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Abominación del pozo infernal" hidden="false" id="304-f997-d8f0-b86a">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Dientes rechinantes y puños azotadores" hidden="false" id="e953-422f-e97e-ef3e">
