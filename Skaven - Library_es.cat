        <profile name="Señor de las alimañas embaucador" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="e9e2-3dd0-1f1-f699">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic>
