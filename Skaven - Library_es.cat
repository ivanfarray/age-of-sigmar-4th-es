      <characteristics>
        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad esté dentro del alcance de combate de una unidad **Guerreros del clan** amiga con 5 o más miniaturas y no haya otras unidades **^^Weapon Team^^** amigas dentro del alcance de combate de esa unidad, esta unidad no es visible para unidades enemigas a más de 13".</characteristic>
      </characteristics>
    </profile>
