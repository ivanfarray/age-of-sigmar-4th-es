      <profiles>
        <profile name="Manada de los Túneles de Zikkit" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="7c51-5b3d-5560-9d16">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">2</characteristic>
