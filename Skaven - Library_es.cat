        <categoryLink name="SKAVEN" id="171b-2488-73db-7ae3" hidden="false" primary="false" targetId="cce6-9e5a-dd33-a755"/>
      </categoryLinks>
      <profiles>
        <profile name="Terreno volátil" id="6fab-6d2e-bb4f-7588" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las miniaturas pueden atravesar este elemento de escenografía, pero no se pueden colocar sobre él ni terminar movimientos sobre ninguna parte de él.
Cada vez que una unidad enemiga termine un movimiento que haya pasado a través de o por este elemento de escenografía, tira un D3. Con un 2+, inflige a esa unidad una cantidad de daño mortal igual al resultado.</characteristic>
          </characteristics>
        </profile>
        <profile name="Agujero roedor" id="507e-2e1a-b28-78b5" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Túneles a través de la realidad" id="a81b-3802-2d67-c5a7" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad **^^Skaven^^** amiga que no esté en combate y esté totalmente a 6" o menos de este elemento de terreno como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira al blanco del campo de batalla y vuelve a colocarlo totalmente a 6" o menos de otro **Agujero roedor** amigo y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="La marea de alimañas interminable" id="9d13-1e94-8089-8cac" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Purple</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por turno (ejército), final de tu turno</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige una unidad **^^Skaven Infantry^^** amiga que no sea **^^Hero^^** y que haya sido destruida como blanco.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de reemplazo con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 6" o menos de un **Agujero roedor** amigo y a más de 3" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Agujero roedor" id="a2f0-cc51-6f93-f81e" hidden="false">
          <description>**Las siguientes habilidades universales de terreno se aplican a este elemento de terreno (Terreno, 1.2):
Cobertura**</description>
        </rule>
        <rule name="Tamaño de peana" id="3699-4b05-e0bd-6e05" hidden="true">
          <description>Usar miniatura</description>
        </rule>
      </rules>
    </selectionEntry>
