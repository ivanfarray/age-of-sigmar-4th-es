        <profile name="Tyrant of Battle" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="49ba-f669-bd46-9894">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 2 unidades amigas **^^Verminus Infantry^^** totalmente a 13" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada objetivo puede usar la orden &apos;All-out Attack&apos; o &apos;All-out Defence&apos; esta fase, incluso si esa orden ya ha sido usada por una unidad amiga esta fase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
