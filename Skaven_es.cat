            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Foulhide" hidden="false" id="4bd9-bbdb-f47f-7e6">
              <profiles>
                <profile name="Foulhide" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="579d-efc4-10e0-cd55">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Purple</attribute>
