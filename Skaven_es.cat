                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de correr y de carga de las unidades amigas **^^Skaven^^** mientras estén totalmente a 13" o menos de esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Escabullirse" id="95cd-5940-b2d7-dd24" hidden="false" import="true" type="upgrade">
