              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Skavenbrew" hidden="false" id="63e2-3c50-7ec7-4371">
              <profiles>
                <profile name="Skavenbrew" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="8112-aca3-d4b5-58c0">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga que no sea **^^Hero Skaven Infantry^^** que esté totalmente a 13" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Inflige D3 de daño mortal al objetivo. Después, durante el resto del turno, suma 1 a la característica de Attacks de las armas de cuerpo a cuerpo del objetivo.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
