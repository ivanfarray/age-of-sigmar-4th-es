    <selectionEntryGroup name="Battle Formations: Skaven" id="90d0-dc0b-7138-4804" hidden="false" flatten="true" publicationId="40f6-9b64-7daa-d1c8">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Warpcog Convocation" hidden="false" id="e3c0-b5f2-7916-a668" publicationId="ff83-b049-91b9-ed05">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ed32-b095-99cf-cf36"/>
          </constraints>
          <profiles>
            <profile name="Skryre Prototypes" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="ccee-7c9-ed41-890b">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de disparo</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas **^^Skryre^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado por cada objetivo y aplica el efecto correspondiente:
**1 *Kaboom!:*** Inflige D3 de daño mortal al objetivo.
**2-5 *More Power!:*** Durante el resto del turno, suma 1 a las tiradas de herida de los ataques de disparo del objetivo.
**6 *More-more Power!:*** Además del efecto de &apos;More Power!&apos;, durante el resto del turno, suma 1 a la característica de Rend de las armas de disparo del objetivo.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Blue</attribute>
                <attribute typeId="6d16-c86b-2698-85a4" name="Type">Shooting</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Fleshmeld Menagerie" hidden="false" id="5fa8-3412-cbc2-bcdc" publicationId="ff83-b049-91b9-ed05">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="98f6-ef44-8a4e-c840"/>
          </constraints>
          <profiles>
            <profile name="Prized Creations" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="119d-1845-ad65-74ed">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas que no sean **^^Hero Moulder^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado por cada objetivo y aplica el efecto correspondiente:
**1-2 *Self-destructive Fury:*** Inflige D3 de daño mortal al objetivo.
**3-4 *Rabid Infusion:*** Hasta el inicio de tu siguiente turno, suma 1 a la característica de Attacks de las armas de cuerpo a cuerpo del objetivo.
**5-6 *Blinded by Frenzy:*** Además del efecto de &apos;Rabid Infusion&apos;, el objetivo tiene **^^Ward (5+)^^** hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Yellow</attribute>
                <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Virulent Procession" hidden="false" id="998f-b0e7-ee-6f58" publicationId="ff83-b049-91b9-ed05">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8c79-1cbf-6037-1eef"/>
          </constraints>
          <profiles>
            <profile name="Corrupted Earth" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="e1b7-b541-de6e-ab41">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas **^^Pestilens^^** que estén en combate.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Por cada objetivo:
• Haz un movimiento de aproximación.
• Después, elige una unidad enemiga en combate con el objetivo y tira un D3. Con un 2+, inflige a esa unidad enemiga una cantidad de daño mortal igual al resultado.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Purple</attribute>
                <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Claw-horde" hidden="false" id="e82a-516-f411-8eaa" publicationId="ff83-b049-91b9-ed05">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="aeb1-c2ee-2866-8f9e"/>
          </constraints>
          <profiles>
            <profile name="Claw-picked" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="ed84-8b06-6ddb-8e45">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de combate</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas **^^Verminus^^** que hayan cargado este turno.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, suma 1 a la característica de Rend de las armas de cuerpo a cuerpo de los objetivos.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Red</attribute>
                <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Envoys of the Deepengnaw" hidden="true" id="97be-93c7-5592-d0db" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9f10-9ec9-50e3-ea35"/>
          </constraints>
          <profiles>
            <profile name="Will of the Horned Rat" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="a36c-88c6-9cd2-f203">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras un **^^Skaven Daemon^^** amigo esté dentro del alcance de combate de una unidad amiga que no sea **^^Hero Skaven Infantry^^**:
• Ese **^^Skaven Daemon^^** tiene **^^Ward (4+)^^**.
• Cada vez que hagas una tirada de salvaguardia con éxito para ese **^^Skaven Daemon^^**, inflige 1 de daño mortal a una unidad amiga que no sea **^^Hero Skaven Infantry^^** dentro del alcance de combate de esa unidad después de resolver la secuencia de daño de esa unidad (no se pueden hacer tiradas de salvaguardia por esos puntos de daño).</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Gathering of the Clans" hidden="true" id="2de7-893c-2d1e-52d1" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7f61-0d2c-d1bc-fa3e"/>
          </constraints>
          <profiles>
            <profile name="Backstabbing Allies" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="562e-1e07-49b8-be00">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), reacción: has declarado la orden &apos;Redeploy&apos; para una unidad amiga **^^Skaven^^**</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige como objetivos hasta 2 unidades amigas **^^Skaven^^** más que no estén en combate y que estén totalmente a 13" o menos de la unidad que usa la orden &apos;Redeploy&apos;. Cada objetivo debe tener al menos una de las siguientes palabras clave: **^^Verminus^^**, **^^Skryre^^**, **^^Moulder^^**, **^^Pestilens^^**, **^^Eshin^^**. Después de resolver esa orden &apos;Redeploy&apos;, cada uno de los objetivos puede usar de inmediato la orden &apos;Redeploy&apos; en el orden que elijas, sin gastar puntos de orden.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Kill-pack" hidden="false" id="d694-d5d3-198a-b02c" publicationId="2a78-9788-7ea8-cd74">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a1e4-9755-01e9-1d8d"/>
          </constraints>
          <profiles>
            <profile name="Scurry-flee!" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="8062-32e4-d117-ee57">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), fase de despliegue</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hero^^** enemigo.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla, si el objetivo ha sido destruido, suma 2" a la característica de Move de las unidades amigas **^^Eshin^^**.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
