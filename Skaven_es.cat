              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Restricciones de mejoras" id="f6cc-5bf0-5669-4c91" hidden="true">
              <description>Las Mutaciones Moulder son mejoras únicas que solo se pueden otorgar a unidades **^^Skaven^^** que no sean **^^Hero^^** ni **^^War Machine^^**. Una unidad solo puede tener 1 Moulder Mutation.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Cerebros trasplantados" id="924a-ff8e-9122-3fa8" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1587-4f35-07e9-73df" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
