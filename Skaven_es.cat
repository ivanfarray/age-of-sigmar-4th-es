          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Transplanted Brains" hidden="false" id="924a-ff8e-9122-3fa8">
              <profiles>
                <profile name="Transplanted Brains" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="812f-2cbc-160d-7ff6">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de los siguientes cerebros. Sus efectos se aplican durante el resto del turno:
**Warpstone Addict&apos;s Brain:**
• Suma 1 a las tiradas de impacto de los ataques de combate de esta unidad.
• Esta unidad tiene una puntuación de control máxima de 1.
**Warlock Whelp&apos;s Brain:** Suma 10 a la puntuación de control de esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
