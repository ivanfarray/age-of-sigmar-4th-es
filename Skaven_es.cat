                    <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="b4ec-7bc2-e8b7-c24d" includeChildSelections="true"/>
