            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Master of the Swarm" hidden="false" id="dc9a-3a24-be3e-dd7c">
              <profiles>
                <profile name="Master of the Swarm" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="2076-18aa-9ff6-f906">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una habilidad devuelva 1 o más miniaturas abatidas a una unidad amiga **^^Skaven^^** que esté totalmente a 13" o menos de esta unidad, después de resolver esa habilidad, puedes devolverle 1 miniatura abatida adicional.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
