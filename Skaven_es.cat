                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="0"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <modifiers>
                <modifier field="points" type="set" value="0">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="1bed-ddb5-0c50-16d2" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                        <condition childId="01b1-5112-ab45-1afc" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                        <condition childId="f079-501a-2738-6844" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                        <condition childId="8e6f-2dd7-a7ed-489e" field="selections" includeChildSelections="true" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Esencia de la Roedura" id="24a0-cc95-691b-c3d2" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo otra unidad amiga **^^Skaven^^** visible que esté totalmente a 13" o menos de esta unidad y en combate.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, esta unidad tiene **^^Strike-first^^** y el objetivo tiene **^^Strike-last^^**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Maquinadores retorcidos" id="1371-6ee2-7325-2f1c" hidden="false" publicationId="40f6-9b64-7daa-d1c8">
          <rules>
            <rule name="Restricciones de mejoras" id="4709-a6c2-1d32-25e0" hidden="true">
