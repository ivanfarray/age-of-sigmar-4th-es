                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Moulder^^** que esté totalmente a 13" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de las armas de cuerpo a cuerpo del objetivo. Durante el resto del turno, suma 1 a la característica de Rend de esa arma.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Subalterno taimado" id="5270-9f80-e9b3-7de6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b37d-b013-02fa-5a04" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Subalterno taimado" id="1190-e784-d8cd-f20a" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo a otro **^^Skaven Hero^^** amigo en el campo de batalla cuya característica de Salud sea igual o superior a la característica de Salud de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la batalla:
• Mientras el objetivo no haya sido abatido, las unidades amigas **^^Skaven Infantry^^** tienen **^^Ward (6+)^^** mientras estén totalmente a 13" o menos de esta unidad.
• Una vez que el objetivo haya sido abatido, suma 2 a las tiradas de carga de las unidades amigas **^^Skaven Infantry^^** mientras estén totalmente a 13" o menos de esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Cacharrero del pozo" id="9187-3b0d-c30d-c407" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fced-deab-3976-d8b3" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Cacharrero del pozo" id="cb57-1034-1ace-00c7" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Puedes volver a tirar las tiradas de característica aleatoria para la característica de Move de las **^^Skryre War Machines^^** amigas mientras estén totalmente a 13" o menos de esta unidad. Además, cada vez que una **^^Skryre War Machine^^** amiga que esté totalmente a 18" o menos de esta unidad use la habilidad &apos;Perdición rodante&apos; o &apos;Perdición giratoria&apos;, suma 1 a la cantidad de daño mortal infligido, si lo hay.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
