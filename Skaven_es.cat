                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: has declarado una habilidad de **^^Hechizo^^** o **^^Desvincular^^** para una unidad **^^Skaven^^** visible que esté totalmente a 13" o menos de esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
