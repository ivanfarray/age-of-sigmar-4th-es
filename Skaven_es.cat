  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Skaven" id="8205-6284-a94b-5c93" hidden="false" import="true" publicationId="40f6-9b64-7daa-d1c8" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="29ff-b39c-51ba-cb7a" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Demasiado rápido para golpear-golpear" id="43a0-6a45-2db6-e6b7" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las habilidades de **^^Retirarse^^** no infligen daño mortal a las unidades amigas **^^Skaven Infantry^^** y **^^Cavalry^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="La marea de alimañas acechante" id="7bc0-81f8-517-8512" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Skaven^^** que no haya sido desplegada.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esa unidad en reserva **en los túneles subterráneos**. Ahora se considera desplegada.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Astillas de la Ruina de las Alimañas" id="4afc-1984-267c-d0e6" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por ronda de batalla (ejército), inicio de la ronda de batalla</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Puedes usar esta habilidad si hay menos de 3 **Gnawholes** amigas en el campo de batalla.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca una **Agujero roedor** en el campo de batalla a más de 9" de todas las unidades enemigas, a más de 3" de todos los marcadores de objetivo y a más de 1" de cualquier otro elemento de escenografía.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Siempre tres pasos de garra por delante" id="7666-f02d-f4bb-b6df" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), fase de héroe enemiga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga que no sea **^^Monster Skaven^^**, que no esté en combate y que no haya sido colocada este turno, para usar esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esa unidad puede usar la habilidad &apos;Movimiento normal&apos; como si fuera tu fase de movimiento.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Emboscada de agujero roedor" id="ecef-dcaf-c3d8-a942" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Skaven^^** que esté **en los túneles subterráneos** para usar esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esa unidad totalmente a 6" o menos de una **Agujero roedor** amiga y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
