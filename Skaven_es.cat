              <profiles>
                <profile name="Escabullirse" id="14bc-86d5-f0e9-f56e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
