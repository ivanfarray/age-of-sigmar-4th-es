            <selectionEntry type="upgrade" import="true" name="Dazzling Phalanx" hidden="false" id="dba5-d64f-18be-266d" publicationId="9e18-bb03-7b60-d4ff">
              <profiles>
                <profile name="Dazzling Phalanx" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="643b-c2ac-cf89-82bc">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: El oponente ha declarado una habilidad de **^^Charge^^** para una unidad a 9" o menos de esta unidad y visible para ella</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Gasta 1 dado de ira. Si el nivel de furia de tu oponente es inferior al tuyo, debe aumentar su nivel de furia en 1, hasta un máximo de 7. Después, durante el resto del turno, suma 1 a las tiradas de herida de los ataques de combate de esta unidad que tengan como objetivo la unidad enemiga que use esa habilidad de **^^Charge^^**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="679f-a6d7-4868-5648" includeChildSelections="true"/>
              </constraints>
              <modifiers>
