        <selectionEntryGroup name="Aspects of Enlightenment" id="e04a-7a3c-fcd1-ba5d" hidden="true" publicationId="f894-7929-f79a-a269">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Aetherquartz Requisitioner" hidden="false" id="b6ad-6ae2-f5da-81c7">
              <profiles>
                <profile name="Aetherquartz Requisitioner" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c83e-72e0-0149-7886">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, reacción: Has declarado una habilidad de **^^Spell^^** para un **^^Lumineth Realm-lords Wizard^^** dentro del alcance de combate de esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 3 a la tirada de lanzamiento de ese hechizo.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="90a3-3793-1eda-32c2" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Martial Perfectionist" hidden="false" id="e4db-e9c3-5c41-cf56">
              <profiles>
                <profile name="Martial Perfectionist" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="1d13-5cd9-fe0f-f6d8">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad que esté dañada o que haya tenido alguna miniatura abatida este turno.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, suma 1 a las tiradas de herida de los ataques de combate realizados por unidades amigas **^^Lumineth Realm-lords Infantry^^** que tengan como objetivo esa unidad enemiga durante el resto del turno.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="4021-de61-6601-401f" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Flawless Commander" hidden="false" id="de7a-3534-8d52-7949">
              <profiles>
                <profile name="Flawless Commander" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="c450-d8ce-40e4-ed3b">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 2" a la característica de Move de las unidades amigas **^^Lumineth Realm-lords Infantry^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute>
