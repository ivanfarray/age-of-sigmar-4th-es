            <profile name="Arcane Focus" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="4593-d3fc-f5bb-b4e3">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las habilidades de **^^Spell^^** del Lore of Hysh o del Lore of the Awakened Realms usadas por **^^Lumineth Realm-lords Wizards^^** amigos tienen la palabra clave **^^Unlimited^^**. Sin embargo, no puedes elegir la misma unidad como objetivo de la misma habilidad de **^^Spell^^** en el mismo turno.</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
