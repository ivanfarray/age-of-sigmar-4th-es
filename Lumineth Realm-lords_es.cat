    <selectionEntryGroup name="Heroic Traits" id="a340-462e-ac27-73f8" hidden="false">
      <selectionEntryGroups>
        <selectionEntryGroup name="Facets of Brilliance" id="4d3f-ebb6-2595-b0fc" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Flawless Commander" hidden="false" id="5c02-bbe6-5614-e08c" publicationId="9ed1-cf74-eb97-dee2">
              <profiles>
                <profile name="Flawless Commander" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="424f-ecb-4817-2eb5">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas visibles **^^Lumineth Realm-lords Infantry^^** que estén totalmente a 18" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada objetivo puede usar la habilidad &apos;Normal Move&apos; como si fuera tu fase de movimiento.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="ced5-6a3e-44dd-ba9a" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Masterful Tactician" hidden="false" id="b529-e265-113b-6bbe" publicationId="9ed1-cf74-eb97-dee2">
              <profiles>
                <profile name="Masterful Tactician" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c2ad-fd41-13a4-5261">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado la orden &apos;Redeploy&apos; para una unidad amiga **^^Lumineth Realm‑lords^^** que esté totalmente a 12" o menos de esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si al determinar la distancia que esa unidad puede mover obtienes un resultado de 1-3, puedes usar un valor de 4 en su lugar.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Gray</attribute>
                    <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="4f5c-81a9-b615-5cb7" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Acolyte of the Runes" hidden="false" id="5378-7875-43c4-4eb1" publicationId="9ed1-cf74-eb97-dee2">
              <profiles>
                <profile name="Acolyte of the Runes" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="2bcf-44e6-e1e8-a4ff">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Inicio de la ronda de batalla</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Lumineth Realm-lords Hero^^** amigo que esté totalmente a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Ese **^^Hero^^** puede ser elegido como objetivo adicional la próxima vez que uses la habilidad &apos;Depict Rune&apos;.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="cb04-fb03-5507-69ca" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
