  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Mandíbulas de Hierro" id="d8ca-c367-a211-97b3" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="8ac4-c6f3-90a2-b82e" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="¡Waaagh! de los Mandíbulas de Hierro" id="618e-f241-f5d4-a04b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Mandíbulas de Hierro Hero^^** amigo. No puedes elegir el mismo **^^Hero^^** como objetivo de esta habilidad más de una vez por batalla.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, se aplican los siguientes efectos a las unidades amigas **^^Mandíbulas de Hierro^^** mientras estén totalmente a 18" o menos del objetivo:
• Suma 1 a las tiradas de carga de esas unidades.
• Suma 1 a la característica de Attacks de las armas de cuerpo a cuerpo de esas unidades.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Waaagh!^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Poderosos destructores" id="a85a-85d4-514a-44a3" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Mandíbulas de Hierro^^** que no haya sido colocada este turno.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El objetivo puede moverse hasta 3". Puede moverse hacia el combate. Si estaba en combate al inicio del movimiento, debe terminar ese movimiento en combate.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
