              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Gray</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma el número de unidades enemigas destruidas esta batalla a la característica de Move de las unidades amigas **Gruñesangres** y **^^Maw-grunta^^**, hasta un máximo de +4.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puño de Hierro" id="5327-56c8-288a-e5c6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="65bb-1be0-cf9e-9cd1" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Aplastar y aporrear" id="f09a-2ca5-3a3c-3cc0" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La primera vez cada turno que una unidad enemiga sea destruida por una habilidad de **^^Combatir^^** usada por una unidad amiga **^^Mandíbulas de Hierro^^**, suma 1 a las tiradas de impacto de los ataques de combate realizados por la siguiente unidad amiga **^^Mandíbulas de Hierro^^** que sea elegida para usar una habilidad de **^^Combatir^^** durante el resto del turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puño Brutal" id="dffe-0ce5-0355-59ae" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
