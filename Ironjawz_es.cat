                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por ronda de batalla (ejército), cualquier fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si hay alguna **Megabosses** amiga en el campo de batalla, durante el resto del turno, puedes elegir otra unidad elegible para que sea un segundo objetivo al usar la habilidad &apos;Poderosos destructores&apos;.
Si no hay ninguna **Megabosses** amiga en el campo de batalla, tira un dado. Con un 3+, durante el resto del turno, puedes elegir otra unidad elegible para que sea un segundo objetivo al usar la habilidad &apos;Poderosos destructores&apos;.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Grandes Rajadorez" id="82c0-4f14-0619-0bf1" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
