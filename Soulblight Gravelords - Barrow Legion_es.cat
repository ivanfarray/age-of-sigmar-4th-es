  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Battle Traits: Barrow Legion" hidden="false" id="bd82-8424-ed1b-1373" publicationId="e3a0-cfae-cbb3-0215">
      <profiles>
        <profile name="All to Dust" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="10e6-f36d-ff98-6686">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">En la tercera ronda de batalla y las siguientes, mientras haya un **Cursed Sepulchre** amigo en el campo de batalla, resta 1 a las tiradas de salvación de las unidades enemigas.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="The Royal Crypt" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="6571-97d9-bc62-f950">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta habilidad debe usarse en lugar de la habilidad &apos;Deploy Faction Terrain Feature&apos;.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca 3 **Cursed Sepulchres** totalmente dentro de tu territorio, cada uno a 1/2" o menos de cualquiera de los otros y a más de 3" de todos los marcadores de objetivo y demás elementos de escenografía. Después de hacerlo, se consideran desplegados y se tratan como un único elemento de escenografía **Cursed Sepulchre** con una característica de Health de 24 en lugar de 8.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Deploy Terrain^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Gifts to the Petty Kingdoms" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="ec89-8708-1461-c669">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 2 unidades amigas que no sean **^^Unique Barrow Legion Heroes^^** y que no tengan un artefacto de poder (puedes elegir unidades en reserva).</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Da a cada objetivo 1 artefacto de poder de las reglas de Army of Renown &apos;Barrow Legion&apos;.
**Nota del diseñador:** *Estos artefactos de poder se entregan a los* **^^Heroes^^** *durante la fase de despliegue, no durante la construcción de listas.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Endless Legions of Bone" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="b2b0-890e-55bb-2034">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por ronda de batalla (ejército), cualquier fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga que no sea **^^Unique Barrow Legion^^** y que haya sido destruida.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca una unidad de reemplazo con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 12" o menos de un **^^Barrow Legion Hero^^** amigo, o totalmente a 6" o menos de un **Cursed Sepulchre** amigo. Debe colocarse a más de 9" de todas las unidades enemigas.
Si es tu fase de movimiento, puedes colocar la unidad de reemplazo a más de 3" de todas las unidades enemigas en lugar de a más de 9", pero si la colocas a 9" o menos de cualquier unidad enemiga, no podrá usar habilidades de **^^Charge^^** este turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Grave Sentinels" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="2225-77c1-05c7-77f9">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las armas de cuerpo a cuerpo usadas por unidades amigas **^^Barrow Legion^^** tienen **Anti-charge (+1 Rend)** mientras estén totalmente a 9" o menos de un **Cursed Sepulchre** amigo.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="Reference" hidden="false" id="c7c7-2932-3085-4595" targetId="3360-1158-e879-9606" primary="true"/>
      </categoryLinks>
    </selectionEntry>
  </sharedSelectionEntries>
