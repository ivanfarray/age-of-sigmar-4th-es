                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="05d5-0564-2389-2fa1" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Grave-sand Pendant" hidden="false" id="8817-c8c9-520d-41bb">
              <profiles>
                <profile name="Grave-sand Pendant" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="01e8-887f-3600-6fc2">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad fuera a ser destruida, antes de retirarla del juego, tira un dado. Con un 3+, esta unidad no es destruida y cualquier punto de daño restante que se le hubiera infligido no tiene efecto. Después, **Heal (1)** esta unidad. Esta unidad no puede volver a usar esta habilidad durante el resto de la batalla.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="7098-c1c6-9583-3253" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Crypt Dagger" hidden="false" id="a6b7-2ef3-b392-0b95">
              <profiles>
                <profile name="Crypt Dagger" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="24ba-bd57-ab07-3614">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hero^^** enemigo en combate con esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Inflige D6 de daño mortal al objetivo.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
