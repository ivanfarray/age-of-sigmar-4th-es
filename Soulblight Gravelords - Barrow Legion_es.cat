        <entryLink import="true" name="Heroic Traits" hidden="false" id="5fc7-2be4-f6f8-fd3f" type="selectionEntryGroup" targetId="c437-e34c-5e1c-95e6" flatten="true"/>
        <entryLink import="true" name="Heroic Traits" hidden="false" id="a8ed-0c19-87c7-f2d7" type="selectionEntryGroup" targetId="59df-5a5c-f4ee-ab6e"/>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Heroic Traits: Barrow Legion" id="eae5-f7ca-f83a-64e2" hidden="false" publicationId="e3a0-cfae-cbb3-0215">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Lord of the Arcane Aegis" hidden="false" id="6246-5709-3bcc-af58">
              <profiles>
                <profile name="Lord of the Arcane Aegis" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="581e-feb7-027d-47fc">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de las siguientes palabras clave:
• **^^Infantry^^**
• **^^Cavalry^^**
• **^^Monster^^**
• **^^Beast^^**
Durante el resto de la batalla, cada vez que un ataque tenga como objetivo esta unidad, si la unidad atacante tiene la palabra clave elegida, una tirada de salvación sin modificar de 4+ para ese ataque siempre tiene éxito.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="ab96-b869-ef88-b6d0" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Spirit-eater" hidden="false" id="4e7d-9ed9-475e-3b11">
              <profiles>
                <profile name="Spirit-eater" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f2f4-e321-52df-9466">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si tu general ha abatido alguna miniatura este turno, **Heal (D6)** tu general.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
