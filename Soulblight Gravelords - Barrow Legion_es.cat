            <selectionEntry type="upgrade" import="true" name="Crown of Cold Command" hidden="false" id="8e1e-1cbb-177b-2031">
              <profiles>
                <profile name="Crown of Cold Command" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="7ddb-760c-248c-b68d">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, cualquier fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Barrow Legion^^** que esté totalmente a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+:
• Si el objetivo está dañado, **Heal (3)** el objetivo.
• Si el objetivo no está dañado, devuélvele un número de miniaturas abatidas con una característica de Health combinada de hasta 3.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="8304-6230-b2fb-c7c3" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Amulet of Nightmares" hidden="false" id="6e3e-7ea2-43b1-d2ea">
              <profiles>
                <profile name="Amulet of Nightmares" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="2acc-3b1f-eef3-699a">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga a 9" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 2+, el objetivo tiene **^^Strike-last^^** esta fase.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
