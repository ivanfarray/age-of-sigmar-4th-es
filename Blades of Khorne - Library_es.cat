        <profile name="Deathbringer" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="ea1c-2571-0103-2bc4">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
