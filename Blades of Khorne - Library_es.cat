      <profiles>
        <profile name="Wrathmongers" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="28ac-632d-11cb-9d31">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
