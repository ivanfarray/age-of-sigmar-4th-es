        <profile name="The Eternal Duel" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="7e2-dae2-3133-1640">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si se asignaron puntos de daño a un **^^Hero^^** enemigo mediante los ataques de combate de esta unidad este turno y ese **^^Hero^^** fue destruido este turno, aplica **Heal (X)** a esta unidad, donde **X** es el número de puntos de daño que tenga esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
