            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Bloodfury" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="b2c9-c7f6-dea1-637f">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una miniatura enemiga visible a 3" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Ambos jugadores hacen una tirada enfrentada. Si ganas la tirada enfrentada, elige un arma de combate con la que esté armado el objetivo. Tu oponente debe elegir una unidad visible de su ejército a 3" o menos del objetivo (puede elegir la propia unidad del objetivo, incluso si es una unidad de una sola miniatura).
Tu oponente debe resolver los ataques de combate del objetivo con el arma de combate que elegiste contra la unidad que haya elegido.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Crimson Haze" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="96b0-b748-91d7-118d">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad esté en combate, añade 1 a la característica de Attacks de las armas de combate usadas por unidades amigas **^^Bloodbound^^**, excluyendo las unidades de **Wrathmongers**, mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
