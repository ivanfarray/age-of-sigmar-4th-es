          </attributes>
        </profile>
        <profile name="Hexgorgers" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="fa7b-78ca-975e-58d3">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Por cada parte de esta **^^Manifestation^^** que esté a 8" o menos de un **^^Wizard^^** (amigo o enemigo), resta 1 a las tiradas de lanzamiento de ese **^^Wizard^^**.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Multiple Parts" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="2885-e482-ada4-9ce2">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cuando se asigne a esta **^^Manifestation^^** un número de puntos de daño igual a su característica de Health, esta **^^Manifestation^^** es destruida y sus dos partes se retiran del juego.
Cada vez que esta **^^Manifestation^^** se mueva, sus dos partes deben terminar a 8" o menos entre sí. Cada parte de esta **^^Manifestation^^** está armada con un **Stream of Molten Blood**.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="WARD (6+)" hidden="false" id="df68-5222-e873-b26f" targetId="70a4-383f-421f-52cd" primary="false"/>
        <categoryLink name="MANIFESTATION" hidden="false" id="e640-6ee8-215e-8dda" targetId="bff0-8be9-719f-4afc" primary="true"/>
