      <profiles>
        <profile name="Khul Ascended" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="fce5-f220-823f-71ae">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">10&quot;</characteristic>
