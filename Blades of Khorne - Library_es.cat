            <attribute typeId="50db-066e-a3e7-696f" name="Base Size"/>
          </attributes>
        </profile>
        <profile name="Sigil of Doom" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="ad16-c968-9563-c280">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga visible **^^Blades of Khorne^^** totalmente a 8" o menos de esta **^^Manifestation^^**. Después, elige una habilidad pasiva **^^Blood Tithe^^** que no hayas desbloqueado esta batalla.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Si el resultado iguala o supera el coste en **puntos de diezmo de sangre** de la habilidad elegida, hasta el inicio de tu siguiente turno se aplican al objetivo los efectos de esa habilidad como si se hubiera desbloqueado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="WARD (6+)" hidden="false" id="8761-9c2d-a91e-a32b" targetId="70a4-383f-421f-52cd" primary="false"/>
        <categoryLink name="MANIFESTATION" hidden="false" id="6277-c7fa-2133-1992" targetId="bff0-8be9-719f-4afc" primary="true"/>
