          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 10 o más puntos de daño, o si no usó una habilidad **^^Fight^^** el turno anterior, se le aplican los efectos de la habilidad &apos;Blood-drenched&apos;.</characteristic>
          </characteristics>
