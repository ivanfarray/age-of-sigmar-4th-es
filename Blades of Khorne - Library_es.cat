      <entryLinks>
        <entryLink import="true" name="General" hidden="false" id="e53b-6916-cd59-189e" type="selectionEntry" targetId="a56b-952e-ad15-7868"/>
      </entryLinks>
      <profiles>
        <profile name="Valkia the Bloody" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="3c83-d8ea-6965-4d60">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">3+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Borne on Wings of Blood" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f15c-3565-7b54-5c3b">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad si no ha sido desplegada.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en reserva **sobrevolando el campo de batalla**. Ahora ya se ha desplegado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="The Red Angel of Slaughter" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="0015-1e5f-9e5b-d311">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad si está **sobrevolando el campo de batalla**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en cualquier lugar del campo de batalla a más de 9" de todas las unidades enemigas. Después, elige una unidad enemiga visible a 10" o menos de esta unidad y tira un dado. Con un 2+, inflige a esa unidad una cantidad de daño mortal igual al resultado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="The Gaze of Khorne" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="902d-90cb-7d38-6c06">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si una unidad amiga **^^Bloodbound^^** totalmente a 12" o menos de esta unidad usa la orden &apos;Rally&apos;, puedes hacer 3 tiradas de reagrupamiento adicionales de D6. Sin embargo, las unidades amigas **^^Bloodbound^^** no pueden usar habilidades **^^Retreat^^** mientras estén a 12" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="HERO" hidden="false" id="71ef-01e9-af86-22d9" targetId="6e72-1656-d554-528a" primary="true"/>
