        <profile name="Gather the Skulls" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="2047-b9b2-3dfc-ca0f">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3. Si el resultado supera la característica de Health del objetivo, 1 miniatura de la unidad objetivo es abatida y obtienes 1 punto de diezmo de sangre.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
