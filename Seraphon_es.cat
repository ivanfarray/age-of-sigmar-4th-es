  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Seraphon" id="3ac6-526e-bb2b-edd8" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="8f1c-9239-3eea-75f" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Itzl el Domador" id="360d-fd80-f153-269f" hidden="false" publicationId="e9d0-a23-6a15-1fcb" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Asterismo^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las armas **Compañero** usadas por unidades amigas **^^Seraphon^^** tienen **Crítico (2 impactos)**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Impulsar el Gran Plan" id="4d17-ddf6-7d2a-9889" hidden="false" publicationId="e9d0-a23-6a15-1fcb" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por ronda de batalla, inicio de la ronda de batalla</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">No puedes usar esta habilidad en la primera ronda de batalla. Elige un
**^^Asterism^^** que hayas profetizado. No puedes elegir un **^^Asterism^^** que ya hayas elegido antes en esta batalla. Si no cumples la condición indicada abajo que corresponde a ese **^^Asterism^^**, esta habilidad no tiene efecto.
***Itzl el Domador:*** se han destruido 3 o más unidades enemigas.
***Quetzl el Preservador:*** no hay ninguna unidad enemiga totalmente dentro de territorio amigo.
***Sotek el Libertador:*** el general enemigo está en combate o ha sido destruido.
***Tepok el Vidente:*** hay alguna unidad amiga **^^Slann^^** en el campo de batalla y ninguna unidad amiga **^^Slann^^** está en combate ni ha sido destruida.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige una habilidad de **^^Asterism^^** para profetizarla. Sus efectos se aplican además de los de todas las demás habilidades de **^^Asterism^^** profetizadas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="El Gran Plan" id="9db2-50c6-6181-fc51" hidden="false" publicationId="e9d0-a23-6a15-1fcb" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Debes usar esta habilidad. Elige una habilidad de **^^Asterism^^** para profetizarla.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esa habilidad de **^^Asterism^^** puede usarse durante el resto de la batalla, pero las demás no, a menos que hayan sido profetizadas por la habilidad &apos;Impulsar el Gran Plan&apos;</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Quetzl el Preservador" id="5089-fe1e-4dd7-5eb4" hidden="false" publicationId="e9d0-a23-6a15-1fcb" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Asterismo^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a la característica de Rend de las armas de cuerpo a cuerpo de los ataques que tengan como objetivo unidades amigas **^^Seraphon^^** que estén totalmente dentro de territorio amigo.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sotek el Libertador" id="6960-effd-2a46-d7d4" hidden="false" publicationId="e9d0-a23-6a15-1fcb" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Asterismo^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 2 a la característica de Move de las unidades amigas **^^Seraphon^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tepok el Vidente" id="90ae-3432-b3f3-4727" hidden="false" publicationId="e9d0-a23-6a15-1fcb" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Asterismo^^**</characteristic>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de lanzamiento de las unidades amigas **^^Seraphon^^**.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
