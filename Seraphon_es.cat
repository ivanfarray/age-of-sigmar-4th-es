              </constraints>
              <profiles>
                <profile name="Hijo de las estrellas" id="e915-c0db-e390-8a3a" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad fuera a ser destruida, antes de retirarla de la partida, tira un dado. Con un 3+, esta unidad no es destruida y los puntos de daño restantes que se le hayan infligido no tienen efecto. Después, Heal (D3) esta unidad. Esta unidad no puede volver a usar esta habilidad durante el resto de la batalla.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Guardián de las antiguas costumbres" id="4ecd-3b70-2c8b-45b4" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a756-1e47-cf5e-42d7" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Guardián de las antiguas costumbres" id="424e-49c7-8e78-8ea0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, reacción: has declarado la habilidad &apos;Impulsar el Gran Plan&apos;</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Puedes elegir 2 habilidades de Asterism distintas en lugar de 1. Ambas se usan además de la que elegiste en la fase de despliegue.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Elegido de Quetzl" id="a455-fecd-67f1-38cb" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="35f7-2fa9-522a-472e" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Elegido de Quetzl" id="8d70-1383-edb2-9fcb" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
