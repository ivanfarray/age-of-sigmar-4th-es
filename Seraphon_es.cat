                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sereno y tranquilo" id="e372-c01e-297e-2deb" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8295-0d8c-c493-c2ec" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Sereno y tranquilo" id="c80c-5bca-cd5b-a7e7" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, final de tu turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Reduce tus **niveles de furia** y los de tu oponente hasta 3, con un mínimo de 0. Debes reducir los **niveles de furia** de ambos jugadores en la misma cantidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
