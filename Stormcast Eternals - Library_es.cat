        <profile name="Exigencias del Testigo" id="9ec7-c460-fa05-307f" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
          <attributes>
            <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
            <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
            <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
            <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
            <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige una unidad **^^Cámara de la Ruina^^** amiga visible totalmente a 12" o menos de esta unidad como blanco y, después, haz una tirada de cántico de D6.</characteristic>
            <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu próximo turno, suma 1 al atributo Rend de las armas de combate del blanco. Si la tirada de cántico ha sido de 7+, puedes elegir otra unidad válida como segundo blanco.</characteristic>
            <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Sobre alas de muerte" id="06c8-84cc-0df1-eb6c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+:
• Puedes retirar esta unidad del campo de batalla y volver a colocarla en el campo de batalla a 1" o menos del blanco.
• Si el blanco ha cargado en este turno, resta 1 a las tiradas de impacto de sus ataques durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Las llamas de la esperanza" id="704e-719d-c89b-a21e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Puedes repetir las tiradas de resistencia de las unidades **^^Cámara de la Ruina^^** amigas mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
        </profile>
        <profile name="Guardián del umbral final" id="e08c-6346-adec-fa9c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Green</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, Reacción: Esta unidad ha sido elegida como blanco de una habilidad que no sea **^^Core^^**.</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Haz una tirada de resistencia de D6. Con un 3+, esa habilidad no tiene efecto sobre esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
