        <profile name="Taros" id="41a6-e8e5-cc40-f88f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">El **Taros** de esta unidad es una ficha. Después de colocar esta unidad en el campo de batalla por primera vez, coloca a **Taros** junto a ella.</characteristic>
          </characteristics>
        </profile>
        <profile name="Aléter hostigador" id="d99a-4999-1d07-80b0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si algún ataque hecho con el **Arco invocatormentas** de esta unidad ha obtenido un impacto crítico en esta fase, elige una unidad enemiga que haya sido blanco de esos ataques como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu próximo turno, coloca a **Taros** junto al blanco. Mientras **Taros** esté colocado junto a una unidad enemiga, esa unidad enemiga no puede usar órdenes.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
