            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad **Perseguidores** amiga totalmente a 12" o menos de esta unidad como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, elige 1 de los siguientes efectos:
• Si el blanco está en combate, puede usar inmediatamente la habilidad &apos;Retirarse&apos; como si fuera tu fase de movimiento sin que se le inflija daño mortal.
• Si el blanco no está en combate, puede usar inmediatamente la habilidad &apos;Movimiento normal&apos; como si fuera tu fase de movimiento.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="La luz de Sigmar" id="0ad6-49cd-60bf-0f64" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, elige 1 de los siguientes efectos:
• Durante el resto del turno, resta 1 a las tiradas de impacto de los ataques de las unidades enemigas mientras estén en combate con esta unidad.
• Aplica Heal (D3) a cada unidad **^^Forjados en la Tormenta^^** amiga dentro del alcance de combate de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
