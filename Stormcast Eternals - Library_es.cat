          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si una unidad **^^Cámara de la Ruina^^** amiga totalmente a 12" o menos de esta unidad usa la orden &apos;Reagrupamiento&apos;, recibes 3 puntos de reagrupamiento adicionales.</characteristic>
          </characteristics>
        </profile>
