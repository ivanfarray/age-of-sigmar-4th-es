          </characteristics>
        </profile>
        <profile name="Ganarse una muerte honorable" id="7262-1ae3-c75e-ec9b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una habilidad **^^Combatir^^** para esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige una unidad **^^Cámara de la Ruina Infantry^^** amiga que no sea **^^Hero^^**, que no haya usado una habilidad **^^Combatir^^** en este turno y esté dentro del alcance de combate de esta unidad, como blanco. Se puede elegir al blanco para usar una habilidad **^^Combatir^^** inmediatamente después de resolver la habilidad **^^Combatir^^** usada por esta unidad. Si se elige para hacerlo, suma 1 a las tiradas de impacto de los ataques del blanco durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Memoriano" id="8102-5932-9171-68ab" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">El **Memoriano** de esta unidad es una ficha. Suma 3 a las puntuaciones de control de las unidades **^^Cámara de la Ruina^^** amigas totalmente a 12" o menos de esta unidad mientras su **Memoriano** esté en el campo de batalla. Si haces una tirada de salvación sin modificar de 1 para esta unidad, retira su **Memoriano** del campo de batalla después de resolver la habilidad Attack (el punto de daño se inflige igualmente).</characteristic>
          </characteristics>
        </profile>
      </profiles>
