        <profile name="Caballero justiciario con grifomastines" id="e20c-d725-267b-f7fb" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
