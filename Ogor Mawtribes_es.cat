                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad use la habilidad &apos;Erupción de furia&apos;, después de resolver esa habilidad, **Heal (D3)** esta unidad.</characteristic>
                  </characteristics>
