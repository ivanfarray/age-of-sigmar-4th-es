    <selectionEntryGroup name="Rasgos heroicos" id="b31d-aee-8d55-5892" hidden="false">
      <constraints>
        <constraint id="f9c6-dff6-1e07-bb82" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
        <constraint id="ed77-977e-8ef9-2187" field="selections" scope="root-entry" shared="true" type="max" value="1"/>
      </constraints>
      <entryLinks>
        <entryLink name="Rasgos heroicos" id="0bbd-c7d6-fd70-66a3" flatten="true" hidden="false" import="true" targetId="c437-e34c-5e1c-95e6" type="selectionEntryGroup"/>
        <entryLink name="Rasgos heroicos" id="01aa-e35d-938c-cc9c" hidden="false" import="true" targetId="59df-5a5c-f4ee-ab6e" type="selectionEntryGroup"/>
      </entryLinks>
      <modifiers>
        <modifier field="f9c6-dff6-1e07-bb82" type="set" value="-1">
          <conditions>
            <condition childId="any" field="e63c-79ff-93ba-c5eb" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Rasgos de hambre interminable" id="a5a-92de-7f93-c15e" hidden="false">
          <rules>
            <rule name="Restricciones de mejoras" id="dd0d-50f6-fec1-113b" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="No dejar ni un bocado" id="b279-4201-e5bd-8ef3" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
              <constraints>
                <constraint id="7465-5a09-028c-6354" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="No dejar ni un bocado" id="aeac-1f3f-e463-c025" hidden="false" publicationId="1ac6-e227-a186-12" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén a 6" o menos de esta unidad y sean visibles para ella, las unidades enemigas no pueden ser curadas ni recuperar miniaturas abatidas.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Temido por doquier" id="b63a-a9f5-1f8b-5cbc" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
              <constraints>
                <constraint id="80f1-b758-d285-17ff" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Temido por doquier" id="ebcf-81b7-f136-b6db" hidden="false" publicationId="1ac6-e227-a186-12" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignora los modificadores negativos a:
• La puntuación de control de esta unidad.
• Las tiradas de impacto y de herida de los ataques de esta unidad que no sean **Compañero**.
• Las tiradas de carga de esta unidad.
• El número de dados que se tiran al hacer tiradas de carga para esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Los Trituratripas" id="b6f3-c71d-0335-9c2b" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
              <constraints>
                <constraint id="6f9c-8497-e34c-d607" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
