          <profiles>
            <profile name="Guerra tras la comida" id="f8db-35d8-e72f-d693" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta D3 unidades amigas **^^Ogor Infantry^^** que este turno hayan estado en combate con una unidad enemiga destruida este turno.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Devuelve 1 miniatura abatida a cada unidad objetivo.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
