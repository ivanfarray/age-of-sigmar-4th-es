          <rules>
            <rule name="Restricciones de mejoras" id="42f6-8509-d409-fb5f" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Soporte de trofeos" id="83c8-3774-9488-0c4b" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
              <constraints>
                <constraint id="86e2-93ca-e345-55da" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Soporte de trofeos" id="f96f-c778-c701-56eb" hidden="false" publicationId="1ac6-e227-a186-12" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de los siguientes trofeos. Durante el resto de la batalla, las armas de cuerpo a cuerpo usadas por otras unidades amigas **^^Tribus Tragonas Ogor^^** tienen la habilidad de arma correspondiente mientras estén totalmente a 6" o menos de esta unidad y sean visibles para ella:

• ***Cabeza estrujada***: **^^Anti-Monster (+1 Rend)^^**
• ***Escombros de ciudad arrasada***: **^^Anti-War Machine (+1 Rend)^^**
• ***Apéndices arrancados***: **^^Anti-Cavalry (+1 Rend)^^**</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Piel de carvalox" id="2193-1dd2-2471-649b" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
              <constraints>
                <constraint id="920f-a51a-b2a4-ed54" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Piel de carvalox" id="0137-ba57-4ee0-7ae0" hidden="false" publicationId="1ac6-e227-a186-12" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad tiene **^^Ward (6+)^^**. También tiene **^^Ward (4+)^^** contra los puntos de daño infligidos por habilidades de **^^Hechizo^^**, habilidades de **^^Prayer^^** y habilidades usadas por **^^Manifestations^^**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Manto de entrañas" id="8310-9dcb-6401-6d7a" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
              <constraints>
                <constraint id="db91-f6fa-cf4c-f47d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Manto de entrañas" id="935a-8605-77e6-9a0f" hidden="false" publicationId="1ac6-e227-a186-12" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), cualquier fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno, cada vez que el objetivo use una orden, tira un dado como reacción. Con un 3+, esa orden no tiene efecto, sigue contando como usada y los puntos de orden gastados en usarla se pierden igualmente.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntryGroup>
    <selectionEntryGroup name="Formaciones de batalla: Tribus Tragonas Ogor" id="3b1e-9d81-77cb-328d" flatten="true" hidden="false">
      <constraints>
        <constraint id="6591-ae07-b217-f60f" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Tribu Hambrienta" id="3cad-0dd7-2887-3d79" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
          <constraints>
            <constraint id="0b9e-2335-b828-113e" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Festín de derramamiento de sangre" id="3c5d-5de4-0320-8913" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Por cada unidad enemiga destruida este turno, elige como objetivo una unidad amiga **^^Tribus Tragonas Ogor^^** que no esté en combate y no haya usado la orden &apos;Arrollar&apos; este turno.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada objetivo puede moverse hasta 3". Puede moverse a través de los alcances de combate de unidades enemigas y puede terminar ese movimiento en combate.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Movimiento^^**</characteristic>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vanguardia del Sendero de las Fauces" id="e71d-2ecb-2f7b-9978" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
          <constraints>
            <constraint id="fe39-933c-38f5-4dd9" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Aplastar y saquear" id="c4de-f11d-f9ab-0f61" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de carga</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos todas las unidades amigas **^^Tribus Tragonas Ogor^^** que hayan cargado este turno y cuya tirada de carga sin modificar haya sido 8+.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada objetivo puede moverse hasta 3". Puede moverse a través de los alcances de combate de unidades enemigas, pero debe terminar ese movimiento en combate con las unidades con las que estaba en combate al inicio del movimiento.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cazadores de las Tierras Interiores" id="3b05-60c4-9f6f-dea7" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
          <constraints>
            <constraint id="8b37-7089-5e45-6288" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Depredadores al acecho" id="d82f-10d6-702a-eadc" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de impacto de los ataques que tengan como objetivo unidades amigas **^^Tribus Tragonas Ogor^^** mientras estén totalmente a 9" o menos de un borde del campo de batalla y no hayan cargado este turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fanáticos del Culto de las Fauces" id="ae26-07a1-9b69-4549" hidden="false" import="true" publicationId="1ac6-e227-a186-12" type="upgrade">
          <constraints>
            <constraint id="8c70-3c27-c55a-1c0c" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="¡La comida está lista, camaradas!" id="eb4f-7ba2-6a2d-988d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos todas las unidades amigas **^^Tribus Tragonas Ogor^^** que hayan usado la habilidad &apos;Comérselos vivos&apos; durante esta batalla.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Heal (D3) cada objetivo.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
        </selectionEntry>
        <selectionEntry name="Amenazas del Sendero de las Fauces" id="8e62-4d0b-5197-67bd" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
