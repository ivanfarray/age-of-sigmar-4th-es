          <profiles>
            <profile name="Obsesionado con alimentarse" id="61b5-bcbd-74a9-c95d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), fase de carga enemiga</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Ogor Infantry^^** que no esté en combate.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, el objetivo puede moverse un número de pulgadas igual al resultado. Puede moverse a través de los alcances de combate de unidades enemigas y puede terminar ese movimiento en combate. Si termina ese movimiento en combate, el objetivo cuenta como que ha cargado.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Básica^^**, **^^Movimiento^^**, **^^Carga^^**</characteristic>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Comedores Voraces" id="318d-268c-fa78-ebeb" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
