              </modifiers>
              <profiles>
                <profile name="Líder cosmopolita" id="94a8-f024-6476-93ae" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Ciudades de Sigmar Infantry^^** o **^^Cavalry^^** que esté totalmente a 12" o menos de esta unidad. Si esta unidad es **^^Human^^**, en su lugar elige como objetivos hasta 3 unidades aptas.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, hasta el inicio de tu siguiente turno:
• Si el objetivo es **^^Human^^**, suma 1 a las tiradas de herida de los ataques de combate del objetivo.
• Si el objetivo es **^^Duardin^^**, suma 1 a las tiradas de carga del objetivo.
• Si el objetivo es **^^Aelf^^**, suma 3 a la puntuación de control del objetivo.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="¡Desenvainad el acero!" id="c2f7-e525-d69d-2403" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fe54-d3c5-971b-610c" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="¡Desenvainad el acero!" id="595f-bee7-a9c6-a759" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad ha cargado este turno, elige como objetivo una unidad amiga **^^Ciudades de Sigmar Human^^** que haya cargado este turno y esté totalmente a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 1 a la característica de Attacks de las armas de cuerpo a cuerpo del objetivo durante el resto del turno.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Estratega perspicaz" id="0b83-ed62-ae41-a335" hidden="false" import="true" type="upgrade">
              <constraints>
