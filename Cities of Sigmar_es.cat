          </rules>
          <selectionEntries>
            <selectionEntry name="La última espada de Embergard" id="58c1-61c4-2be2-cf30" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7c66-6d5f-823-57f4" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="La última espada de Embergard" id="96b7-38d0-c137-856" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede usar esta habilidad mientras esté en reserva. Elige 1 de las armas de cuerpo a cuerpo de esta unidad que no sea **Compañero**. Suma 2 a la característica de Attacks y a la característica de Rend de esa arma durante el resto de la batalla.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Huesos de san Ignifus" id="98dc-9f8e-95e1-fc8e" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a79e-82e8-960-8755" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Huesos de san Ignifus" id="ff-fea1-9cae-7fdf" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: has declarado una habilidad de **^^Hechizo^^** o **^^Prayer^^** para una unidad visible que esté totalmente a 12" o menos de esta unidad y **bajo órdenes**</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 1 a la tirada de lanzamiento o de cántico de esa habilidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="La esfera celestial" id="c244-fb99-a193-4a8d" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6ca7-a3fe-87fb-8fcb" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="0"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="La esfera celestial" id="d4cf-cc63-c61c-4f4d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad no está en combate, elige como punto objetivo un punto del campo de batalla a 1" o menos de esta unidad y a más de 3" de todas las demás unidades (amigas y enemigas) y elementos de escenografía. Después, elige como unidad objetivo otro **^^Ciudades de Sigmar Infantry^^** o ^^**Cavalry Hero^^** amigo visible que esté totalmente a 18" o menos de esta unidad y no esté en combate.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira esta unidad del campo de batalla y colócala de nuevo a 1" o menos de la unidad objetivo y sin estar en combate. Después, retira el objetivo del campo de batalla y colócalo de nuevo a 1" o menos del punto objetivo y sin estar en combate. Esta unidad y la unidad objetivo pueden usar habilidades de **^^Move^^** en la siguiente fase de movimiento (esto es una excepción a las Reglas Básicas, 24.0).</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntryGroup>
    <selectionEntryGroup name="Formaciones de batalla: Ciudades de Sigmar" id="bb8f-ca64-b083-4c7b" flatten="true" hidden="false">
      <constraints>
        <constraint id="30fd-77cb-aa65-bbb4" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Guardianes Firmes" id="a769-683a-19c8-5f98" hidden="false" import="true" publicationId="a746-732d-1a22-460" type="upgrade">
          <constraints>
            <constraint id="e165-684-2253-9673" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Hasta el final" id="b49a-35fc-1cf5-7848" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una unidad amiga que esté **bajo órdenes** use la orden &apos;Reagrupamiento&apos;, puedes hacer 3 tiradas de reagrupamiento de D6 adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ejemplares Colegiados" id="225e-a217-d55-2cb0" hidden="false" import="true" publicationId="a746-732d-1a22-460" type="upgrade">
          <constraints>
            <constraint id="454b-b9bd-5593-11f0" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Maestros de lo arcano" id="df89-8c5c-57fa-fd29" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de manipulación arcana y a las tiradas de destierro de los **^^Wizards^^** amigos que estén **bajo órdenes**.
**Nota del diseñador:** *Los Wizards de este libro de batallas usan tiradas de manipulación arcana para gran variedad de efectos poderosos.*</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hordas Fanáticas" id="9cd5-6e01-a51e-4b41" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4ab6-3bb3-274f-210e" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Multitudes de fieles" id="f184-caa1-5d57-f9be" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), reacción: tu oponente ha declarado una habilidad de **^^Combatir^^**.</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, suma 1 a las tiradas de herida de los ataques de combate hechos por unidades amigas **^^Sigmarite^^** que tengan como objetivo la unidad enemiga que use esa habilidad de **^^Combatir^^**.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Refuerzos veloces" id="7022-54db-fb73-5d95" hidden="false" import="true" publicationId="a746-732d-1a22-460" type="upgrade">
          <constraints>
            <constraint id="9bcd-9628-36a2-a090" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Cruzada Portamanecer" id="f462-cd42-adfd-a4ac" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga que no sea **^^Hero Ciudades de Sigmar Infantry^^** y que esté totalmente dentro de tu territorio para usar esta habilidad.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esa unidad está en combate, puede moverse 6". Puede moverse a través de los alcances de combate de unidades enemigas, pero solo puede terminar ese movimiento en combate con unidades con las que estuviera en combate al inicio del movimiento. No tiene que terminar el movimiento en combate.
Si esa unidad no está en combate, puede moverse 6". No puede entrar en combate durante ninguna parte de ese movimiento.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Movimiento^^**</characteristic>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Artilleros veteranos" id="a574-28e2-35a2-5378" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
          <constraints>
            <constraint id="9780-c139-0ee6-1bfd" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="0"/>
            <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
            <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
