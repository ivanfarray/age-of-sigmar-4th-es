          <profiles>
            <profile name="Tripulaciones astutas" id="dc6e-50ac-e432-4f94" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de disparo</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas **Gran cañón del Arsenal de Hierro**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, cada vez que el objetivo use una habilidad de **^^Disparar^^**, puedes volver a tirar 1 tirada de impacto, 1 tirada de herida o 1 tirada de característica aleatoria para la característica de Damage</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ejemplares Intrépidos" id="f461-6e4c-945a-d252" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
          <constraints>
            <constraint id="11d0-98fb-a420-e622" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="78a1-f6c2-71b8-270a" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="f079-501a-2738-6845" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Líder de primera línea" id="4d8e-c223-eecd-eaca" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Ciudades de Sigmar Human Infantry Hero^^** amigo para usar esta habilidad. Después, puedes elegir como objetivos hasta 1 unidad amiga que no sea **^^Hero Human Infantry^^** y hasta 1 unidad amiga **^^Human War Machine^^** que estén totalmente a 12" o menos de ese **^^Hero^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Mientras los objetivos estén totalmente a 12" o menos de ese **^^Hero^^**, suma 1 a la característica de Rend de las armas de cuerpo a cuerpo de la unidad objetivo **^^Infantry^^** y de las armas a distancia de la unidad objetivo **^^War Machine^^** hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hueste de Guerra de Siervos" id="a84c-75af-aa84-54d4" hidden="false" import="true" publicationId="7454-bbda-d2b6-0747" type="upgrade">
          <constraints>
            <constraint id="d894-d5ab-e2c3-3f2e" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Sin piedad" id="c28c-0093-550a-d7d0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), inicio de la ronda de batalla</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de la siguiente ronda de batalla, suma 1 a las tiradas de herida de los ataques de combate hechos por unidades amigas **^^Ciudades de Sigmar Aelf^^** que tengan como objetivo esa unidad enemiga mientras esté dañada o haya tenido alguna miniatura abatida en el mismo turno.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hueste de Guerra de los Agravios" id="6c05-ce03-fc9a-5f87" hidden="false" import="true" publicationId="7454-bbda-d2b6-0747" type="upgrade">
          <constraints>
            <constraint id="ae80-9134-6c1b-be87" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="He visto cosas peores y matado otras mejores" id="f1d5-c4b2-abe2-7a7c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), fase de combate enemiga</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga que haya cargado este turno y esté en combate con alguna unidad amiga **^^Ciudades de Sigmar Duardin^^** que no haya cargado este turno.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 4+, salvo la habilidad de arma **Compañero**, las habilidades de arma de los ataques de combate del objetivo no tienen efecto durante el resto del turno.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Rasgos heroicos" id="1589-62bd-6587-f183" hidden="false">
      <constraints>
        <constraint id="0a32-3135-4e2e-51da" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
        <constraint id="f19e-8b0f-95c6-570e" field="selections" scope="root-entry" shared="true" type="max" value="1"/>
      </constraints>
      <entryLinks>
        <entryLink name="Rasgos heroicos" id="11d4-b718-3b1e-b51a" flatten="true" hidden="false" import="true" targetId="c437-e34c-5e1c-95e6" type="selectionEntryGroup"/>
        <entryLink name="Rasgos heroicos" id="1701-44c2-368a-a782" hidden="false" import="true" targetId="59df-5a5c-f4ee-ab6e" type="selectionEntryGroup"/>
      </entryLinks>
      <modifiers>
        <modifier field="0a32-3135-4e2e-51da" type="set" value="-1">
          <conditions>
            <condition childId="any" field="e63c-79ff-93ba-c5eb" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Centinelas del Orden" id="be90-b077-70e3-47e0" hidden="false" publicationId="a746-732d-1a22-460">
          <rules>
            <rule name="Restricciones de mejoras" id="f340-592a-3611-a408" hidden="true">
              <description>solo **^^Hero^^**, excluyendo **Fortaleza mecánica cañonera** y **Fortaleza mecánica conquistadora**</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="General de voz atronadora" id="5469-10c8-8b60-dfc6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b51-4a25-1406-a03d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="General de voz atronadora" id="4959-5ede-1b79-3ce1" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de salvaguardia de las unidades enemigas mientras estén en combate con cualquier unidad amiga visible que esté totalmente a 12" o menos de esta unidad y **bajo órdenes**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Líder querido" id="75b5-4219-e6f3-e89b" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9d6-a51f-cd81-76e7" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Líder querido" id="50bc-2de2-fd14-7f25" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignora los modificadores negativos a las tiradas de impacto y de herida aplicados por habilidades enemigas a los ataques hechos por unidades amigas visibles que estén totalmente a 12" o menos de esta unidad y **bajo órdenes**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Veterano instructor" id="b922-2043-5ced-e0b1" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7496-fe48-7f36-c8ef" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Veterano instructor" id="64bf-6ab8-2a48-192" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Otras unidades amigas visibles tienen **^^Ward (6+)^^** mientras estén totalmente a 12" o menos de esta unidad y **bajo órdenes**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
