          <selectionEntries>
            <selectionEntry name="La corona del conquistador" id="89ca-29f-2a98-ee0d" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="b4e-ea8a-35c-505d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="La corona del conquistador" id="7c05-283b-b519-d307" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6"/>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4"/>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 5 a las puntuaciones de control de las unidades enemigas **^^Infantry^^** mientras estén en combate con esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Runa retorcida del Deformarreinos" id="4cdc-7124-9db7-72f3" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a59d-33c9-8f84-de90" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Runa retorcida del Deformarreinos" id="5b5d-2bc6-ae4-2ede" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un elemento de escenografía a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si el objetivo no tiene la habilidad de escenografía &apos;Ocultación&apos;, la obtiene hasta el inicio de tu siguiente turno. Después, tira un dado por cada miniatura (amiga y enemiga) a 1" o menos del objetivo. Por cada 5+, inflige 1 de daño mortal a la unidad de esa miniatura.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Marioneta infernal" id="e71c-c9f0-5cd-f497" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ab1d-fa13-bdbe-64" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Marioneta infernal" id="4435-e57c-8e8a-508b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, inicio de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Wizard^^** enemigo visible a 24" o menos de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, cada vez que el objetivo sea elegido para usar una habilidad de **^^Hechizo^^**, inflígele D3 de daño mortal como reacción. Si el objetivo es destruido por esta habilidad, no resuelvas el efecto de esa habilidad de **^^Hechizo^^**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Artefactos funestos" id="7a3f-cf1d-9728-b43f" hidden="true" publicationId="f894-7929-f79a-a269">
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="78a1-f6c2-71b8-270a" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="f079-501a-2738-6845" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Restricciones de mejoras" id="91f7-6e4f-b4af-8e49" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="El grillete de varanita" id="fa3a-e2f8-5de5-bed3" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="087d-5856-a569-1eac" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="El grillete de varanita" id="aa1f-d50c-9239-ca9a" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las unidades amigas no-**^^Warriors of Chaos Esclavos de la Oscuridad^^** tienen **^^Ward (6+)^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Amuleto del Caos" id="9c8e-9032-e90b-4296" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0950-4e7f-9474-da49" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Amuleto del Caos" id="f1e0-2a1d-7dc6-46fd" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo enemigo una unidad enemiga visible a 12" o menos de esta unidad. Después, puedes elegir como objetivo amigo una unidad amiga **^^Darkoath Infantry^^** en combate con esa unidad enemiga.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3. Con un 2+:
• Inflige al objetivo enemigo una cantidad de daño mortal igual al resultado.
• Si hay un objetivo amigo, devuélvele un número de miniaturas abatidas igual al resultado.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Cabeza del indigno" id="07d3-c4ca-40bc-41e6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c5d4-c78c-92b6-6adb" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Cabeza del indigno" id="561b-d18d-81a8-1198" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si un **^^Esclavos de la Oscuridad Hero^^** amigo con algún punto de **Apoteosis oscura** es destruido, otorga a esta unidad 8 puntos de **Apoteosis oscura**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntryGroup>
    <selectionEntryGroup name="Formaciones de batalla: Esclavos de la Oscuridad" id="88d1-56d6-5bb-b9f9" flatten="true" hidden="false" publicationId="6357-5d77-a2b2-f86b">
      <constraints>
        <constraint id="87f8-4322-c629-51cc" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Horda Juramento Oscuro" id="4c0d-4c04-67b9-96ca" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="912c-5a2d-ef5e-c2fe" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Reunir a las tribus" id="3193-b65d-8968-4112" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
              <attributes>
                <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Gray</attribute>
                <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute>
                <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por turno (ejército), tu fase de movimiento</characteristic>
                <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
                <characteristic name="Declare" typeId="b77f-7548-840e-c086">Si hay un **^^Darkoath Hero^^** amigo en el campo de batalla, elige como objetivo una unidad amiga no-**^^Hero^^** no-**^^Unique Darkoath^^** que haya sido destruida.</characteristic>
                <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca en el campo de batalla una unidad de reemplazo con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba), totalmente a 6" o menos de un borde del campo de batalla y a más de 3" de todas las unidades enemigas.</characteristic>
                <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Legión del Caos" id="8439-3857-4c34-b965" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="51f1-baf8-7d27-d346" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Unidos en la oscuridad" id="b97d-35db-2dd1-de8a" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Control</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">
While there is at least 1 friendly **^^Warriors of Chaos Hero^^** and 1 other friendly **^^Daemon Hero^^** or **^^Darkoath Hero^^** on the battlefield, add 2 to the control scores of friendly **^^Slaves to Darkness^^** units while they are contesting an objective that is wholly outside friendly territory.                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="d1f3-921c-b403-1106" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1"/>
                        <condition childId="376a-6b97-8699-dd59" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Saqueadores" id="7123-e80f-6ab5-a002" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="52bd-2ce1-5283-e969" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="¡Servirás!" id="5a7a-7cee-99a3-c62b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de tu turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Pick a friendly **Príncipe demonio** to use this ability. Then, pick a visible friendly non-**^^Daemon^^** non-**^^Unique Esclavos de la Oscuridad^^** unit that does not have an Ensorcelled Banner wholly within 12" of this unit to be the target.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elimina cualquier palabra clave de **Juramento al Caos** que tenga el objetivo. Después, el objetivo obtiene cualquier palabra clave de **Juramento al Caos** que tenga esta unidad.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Banda de la Ira de los Dioses" id="756c-d9af-32e5-e075" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a767-9b5a-7a-3dee" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Asalto acorazado" id="e6b2-68dc-1bca-fc7c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de tu turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un marcador de objetivo disputado por alguna unidad amiga.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca una **ficha de profanación** junto al objetivo elegido. Después, tira un D3 por cada unidad enemiga que dispute un objetivo que tenga una **ficha de profanación** amiga. Con un 2+, inflige a esa unidad enemiga una cantidad de daño mortal igual al resultado.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Horda del Caos" id="0662-366c-6c73-8cf2" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
          <constraints>
            <constraint id="d453-2e61-9db5-abc0" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="78a1-f6c2-71b8-270a" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="f079-501a-2738-6845" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Devotos de la ruina" id="19fd-0701-ec9e-c542" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Warriors of Chaos^^**. Después, elige como objetivos hasta 2 unidades amigas **^^Darkoath^^** visibles que no tengan una palabra clave de **Juramento al Caos** y que estén totalmente a 12" o menos de esa unidad **^^Warriors of Chaos^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno, los objetivos tienen la misma palabra clave de **Juramento al Caos** que esa unidad **^^Warriors of Chaos^^**.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Campeones del Caos" id="5521-eb00-1f3b-5a59" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
          <constraints>
            <constraint id="3ad6-dd9e-e245-add2" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="78a1-f6c2-71b8-270a" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                    <condition childId="f079-501a-2738-6845" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Paladines de la oscuridad" id="c211-67db-4b56-a418" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 2 a la característica de Attacks de las armas de cuerpo a cuerpo usadas por unidades amigas no-**^^Monster Esclavos de la Oscuridad Heroes^^**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Rasgos heroicos" id="a1ac-1337-7d66-251b" hidden="false">
