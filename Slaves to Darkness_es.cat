          <rules>
            <rule name="Restricciones de mejoras" id="cea3-ef65-5b41-c572" hidden="true">
              <description>Un Ensorcelled Banner es una mejora única que puede otorgarse a unidades **^^Esclavos de la Oscuridad Infantry^^** y **^^Cavalry^^** con la palabra clave **^^Portaestandarte^^**. Una unidad solo puede tener 1 Ensorcelled Banner.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="El icono erosionador" id="1e1e-2f3b-dd4f-e415" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7ce7-b4e9-66ca-e405" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="El icono erosionador" id="5922-08d7-b341-1a62" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e">**^^Estandarte hechizado^^**</characteristic>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad tiene la palabra clave **^^Juramentado a Nurgle^^**.
Además, mientras esta unidad incluya algún portaestandarte, los ataques que tengan como objetivo esta unidad no pueden lograr impactos críticos (trátalos como impactos normales en su lugar).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="El estandarte de la furia" id="7f7e-9500-4b32-ff64" hidden="false" import="true" type="upgrade">
