          <selectionEntries>
            <selectionEntry name="Pergamino de piel aélfica" id="4043-02c7-07b0-f659" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3159-2823-1fa3-e4c4" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Pergamino de piel aélfica" id="d6a7-0b3b-da75-b942" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, reacción: el oponente declaró una habilidad de **^^Hechizo^^** para un **^^Wizard^^** a 18" o menos de esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige un **^^Wizard^^** **^^Esclavos de la Oscuridad^^** amigo visible a 18" o menos de esta unidad. Después de que se resuelva esa habilidad de **^^Hechizo^^**, ese **^^Wizard^^** amigo puede usar una habilidad de **^^Hechizo^^** como si fuera tu fase de héroe, y la tirada de lanzamiento de ese hechizo es igual a la tirada de lanzamiento del hechizo enemigo. No cuentes ese hechizo para el número de habilidades de **^^Hechizo^^** que ese **^^Wizard^^** amigo puede usar esta fase.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Runa de asesinato" id="a75f-ad70-53ae-5f15" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ea19-2f27-5b3a-ee06" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Runa de asesinato" id="4820-9486-55af-a4f9" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una de las armas de cuerpo a cuerpo de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de los siguientes efectos:
• Inflige 3 de daño mortal a esta unidad. Después, duplica la característica de Attacks del arma objetivo durante el resto del turno.
• Suma D6 a la característica de Attacks del arma objetivo durante el resto del turno.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Colgante de llama oscura" id="3b46-4a16-41b6-77ab" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="60e0-0c53-791a-473f" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Colgante de llama oscura" id="e04f-d6fa-d3c2-0eab" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las armas usadas para los ataques que tengan como objetivo esta unidad tienen un máximo de 1 en la característica de Damage.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Tesoros infernales" id="4c2-96a0-7dd9-ca99" hidden="false" publicationId="6357-5d77-a2b2-f86b">
