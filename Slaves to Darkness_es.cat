          <rules>
            <rule name="Restricciones de mejoras" id="3108-48e0-6c08-7c8b" hidden="true">
              <description>Una Brand of the Dark Gods es una mejora única que solo puede otorgarse a unidades no-**^^Hero^^** **^^Esclavos de la Oscuridad^^** **^^Infantry^^**. Una unidad solo puede tener 1 Brand of the Dark Gods.</description>
            </rule>
          </rules>
          <selectionEntries>
