          </conditions>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Señores Supremos ruinosos" id="4167-5633-f12d-9877" hidden="false" publicationId="6357-5d77-a2b2-f86b">
          <rules>
            <rule name="Restricciones de mejoras" id="71f5-64da-d3b7-3b26" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Favorecido del panteón" id="5255-a844-c9a0-5607" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8ec1-1569-d359-864" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Favorecido del panteón" id="5208-fec9-503-8492" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad es elegida como objetivo de la habilidad &apos;Ojo de los dioses&apos;, gana 3 puntos de **Apoteosis oscura**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Instigador de muerte" id="d3c6-1b7c-3e62-3136" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1fbb-fadd-cfaa-a9b2" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Instigador de muerte" id="e106-320c-f17f-473d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
