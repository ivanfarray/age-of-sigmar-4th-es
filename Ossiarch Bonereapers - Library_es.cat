      <profiles>
        <profile name="Vokmortian, Maestro del Diezmo Óseo" id="8951-b9bb-0b05-6e03" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
