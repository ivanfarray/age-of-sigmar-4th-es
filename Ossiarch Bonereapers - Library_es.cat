                  </modifierGroups>
                  <modifiers>
                    <modifier field="category" scope="root-entry" type="add" value="f7bc-b618-4b5d-2bae"/>
                    <modifier field="category" scope="root-entry" type="add" value="7f9b-0dda-ac91-6b5f"/>
                    <modifier field="category" scope="root-entry" type="remove" value="4d3b-23e7-f8f0-9780"/>
