                        <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                        <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad amiga visible **^^Cosechahuesos Ossiarch^^** totalmente a 12" o menos del lanzador y después haz una tirada de lanzamiento de 2D6.</characteristic>
                        <characteristic name="Effect" typeId="1cb9-a-1345-907f">El objetivo tiene **^^Strike-first^^** durante el resto del turno.</characteristic>
                        <characteristic name="Keywords" typeId="353f-565e-c351-1cf2"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Artífice de almas" id="b132-c4aa-88b8-cb88" hidden="true">
                      <description>Cambia la característica de Salud de tu héroe a 6 y su característica de Move a 6".
Tu héroe tiene la palabra clave **^^Wizard (2)^^**, la habilidad &apos;Guía de almas&apos; y las siguientes opciones de regimiento:
Cualquier unidad **^^Cosechahuesos Ossiarch^^**
También puedes elegir una forma de guerra para tu héroe.</description>
                    </rule>
                  </rules>
                </selectionEntry>
