          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Yellow</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de héroe</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Si esta unidad no está en combate, elige como objetivo una unidad amiga de **Guardia mortek** que haya sido destruida.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de repuesto con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 12" o menos de esta unidad y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Intendente de la legión" id="bdfa-2886-2a0d-6c4e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una unidad amiga **^^Cosechahuesos Ossiarch^^** que no sea **^^Hero^^** totalmente a 12" o menos de esta unidad use la orden &apos;Reagrupamiento&apos;, puedes hacer 3 tiradas de reagrupamiento adicionales de D6.</characteristic>
          </characteristics>
        </profile>
      </profiles>
