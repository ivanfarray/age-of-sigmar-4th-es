            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la fase, resta 1 a la característica de Rend de las armas usadas para ataques cuyo objetivo sea esa unidad amiga.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
