  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Señores de la Tumba Pudrealmas" id="894b-7a76-6846-9994" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="6aa-c057-ea10-6344" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="El hambre" id="6c49-49c9-3718-6384" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" id="f886-1089-3844-71d3" hidden="false" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" id="9490-fca0-4624-84a3" hidden="false" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos todas las unidades amigas **^^Vampire^^** que hayan usado una habilidad de **^^Combatir^^** este turno.</characteristic>
            <characteristic name="Effect" id="65fc-a725-9885-c35d" hidden="false" typeId="b6f1-ba36-6cd-3b03">**Heal (D3)** cada objetivo. En su lugar, **Heal (2D3)** el objetivo si ha destruido una unidad enemiga este turno usando una habilidad de **^^Combatir^^**</characteristic>
            <characteristic name="Keywords" id="f247-e13-133c-a404" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Los muertos intranquilos" id="3c95-939d-c8b0-7ff9" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" id="6949-5672-ef6b-46dd" hidden="false" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" id="6374-946-1933-524b" hidden="false" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Deathrattle^^** o **^^Deadwalkers^^** que no haya sido desplegada.</characteristic>
            <characteristic name="Effect" id="5c4e-ec58-8e64-97d0" hidden="false" typeId="b6f1-ba36-6cd-3b03">Coloca esa unidad en reserva **en la tumba**. Ahora se considera desplegada. No puedes colocar más unidades amigas **en la tumba** que las que haya en el campo de batalla.</characteristic>
            <characteristic name="Keywords" id="6de8-f953-12ad-eb24" hidden="false" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Legiones interminables" id="d5ec-ff29-e8fa-1a2b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por ronda de batalla (ejército), cualquier fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga que no sea **^^Unique Deathrattle^^** o **^^Deadwalkers^^**, que empezara la batalla con 2 o más miniaturas y que haya sido destruida.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca una unidad de reemplazo con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 12" o menos de un **^^Señores de la Tumba Pudrealmas Hero^^** amigo, o totalmente a 6" o menos de un **Sepulcro maldito** amigo. Debe colocarse a más de 9" de todas las unidades enemigas.
Si es tu fase de movimiento, puedes colocar la unidad de reemplazo a más de 3" de todas las unidades enemigas en lugar de a más de 9", pero si la colocas a 9" o menos de cualquier unidad enemiga, no podrá usar habilidades de **^^Cargar^^** este turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Invocación mortal" id="d5bb-fc32-706e-4107" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" id="80d8-9afa-540-8524" hidden="false" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de héroe</characteristic>
            <characteristic name="Declare" id="55a4-8e1f-4890-199" hidden="false" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Señores de la Tumba Pudrealmas Hero^^** amigo para usar esta habilidad y, después, elige como objetivos hasta 3 unidades amigas **^^Deathrattle^^** o **^^Deadwalkers^^** que estén totalmente a 12" o menos de ese Hero.</characteristic>
            <characteristic name="Effect" id="b2bc-bdae-6b2e-1a75" hidden="false" typeId="b6f1-ba36-6cd-3b03">Por cada objetivo:
• Si el objetivo está dañado, **Heal (3)** el objetivo.
• Si el objetivo no está dañado, devuélvele un número de miniaturas abatidas con una característica de Salud combinada de hasta 3.</characteristic>
            <characteristic name="Keywords" id="82d-7d28-7e6d-8098" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Los muertos que se alzan" id="4ef2-ed4f-e2ae-4bb7" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga que esté **en la tumba**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esa unidad totalmente a 6" o menos de un **Sepulcro maldito** amigo y a más de 9" de todas las unidades enemigas, o totalmente a 6" o menos del borde del campo de batalla, totalmente dentro de tu territorio y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Antiguos lugares de enterramiento" id="a602-ebe9-75e6-e228" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si hay un **Sepulcro maldito** amigo en el campo de batalla, puedes colocar hasta 2 **Cursed Sepulchres** amigos adicionales en el campo de batalla. El primero debe colocarse a más de 3" de todas las unidades, marcadores de objetivo y demás elementos de escenografía. El segundo debe colocarse totalmente fuera del territorio enemigo y a más de 3" de todas las unidades, marcadores de objetivo y demás elementos de escenografía.
**Nota del diseñador:** *El* **Sepulcro maldito** *original se coloca en el Paso 1 de la fase de despliegue mediante la habilidad &apos;Desplegar escenografía de facción&apos;. Esta habilidad te permite colocar un segundo y un tercer elemento de escenografía de este tipo, y se usa en el Paso 3 de la fase de despliegue, después de que los ejércitos hayan sido desplegados.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
