    <selectionEntryGroup name="Formaciones de batalla: Señores de la Tumba Pudrealmas" id="2fae-2a47-65d2-991d" flatten="true" hidden="false">
      <constraints>
        <constraint id="3703-dd99-6f1d-3432" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Manada de Hedor Mortal" id="ca36-2549-97d8-741e" hidden="false" import="true" publicationId="05a6-726c-4748-8360" type="upgrade">
          <constraints>
            <constraint id="17b7-4d59-f769-18a2" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Derribado y despedazado" id="c6a5-8271-2030-35cc" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" id="8cb4-6db3-4958-8894" hidden="false" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
                <characteristic name="Declare" id="de5c-bf9a-68ea-3c7b" hidden="false" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas **^^Deadwalkers^^** que estén en combate.</characteristic>
                <characteristic name="Effect" id="c1c4-c5f-cb21-f459" hidden="false" typeId="b6f1-ba36-6cd-3b03">Por cada objetivo:
• Haz un movimiento de aproximación.
• Después, elige una unidad enemiga en combate con el objetivo y tira un D3. Con un 2+, inflige a esa unidad enemiga una cantidad de daño mortal igual al resultado.</characteristic>
                <characteristic name="Keywords" id="28bd-c972-981a-6d00" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
