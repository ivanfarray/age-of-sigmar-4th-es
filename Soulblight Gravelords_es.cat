        <selectionEntryGroup name="Reliquias mortuorias" id="378b-1988-a609-6773" hidden="false" publicationId="e3a0-cfae-cbb3-0215">
          <rules>
            <rule name="Restricciones de mejoras" id="e7c1-751b-f669-376c" hidden="true">
              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Reloj términus" id="19f7-f0af-681d-a848" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c12b-7caa-bb99-ff93" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Reloj términus" id="43e-53da-1de1-e1b9" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, hasta el inicio de tu siguiente turno, resta 1 a las tiradas de lanzamiento de los **^^Wizards^^** enemigos mientras estén a 18" o menos de esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Amuleto de tumbas" id="3b86-b6df-742c-b938" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ddb7-1cc3-cf61-fedc" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Amuleto de tumbas" id="ed48-d04f-77c7-9c1c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si hay menos de 3 **Cursed Sepulchres** amigos en el campo de batalla, coloca un **Sepulcro maldito** en el campo de batalla a más de 9" de todas las unidades enemigas, a más de 1" de todas las unidades amigas y a más de 3" de todos los marcadores de objetivo y demás elementos de escenografía.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Fragmento de noche" id="e458-a2b9-9888-6bbe" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2db0-1828-e1db-a45b" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Fragmento de noche" id="56a6-4e88-8d98-84ea" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" id="9808-2d68-687c-e29e" hidden="false" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" id="3800-28aa-a343-8aed" hidden="false" typeId="fd7f-888d-3257-a12b">Ignora los modificadores (positivos y negativos) a las tiradas de salvación de los ataques a distancia que tengan como objetivo esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
