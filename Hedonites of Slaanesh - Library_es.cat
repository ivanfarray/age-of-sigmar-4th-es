          </characteristics>
        </profile>
        <profile name="Celebrantes de la matanza" id="a1da-99a4-9f4a-826b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén totalmente a 12" o menos de esta unidad y sean visibles para ella, las armas de combate usadas por unidades **^^Hedonistas de Slaanesh Infantry^^** amigas tienen **Anti-charge (+1 Rend)**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Maestro de los festejos" id="761b-b083-2a1b-3dc8" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad no ha usado una habilidad **^^Temptation^^** este turno, elige como objetivo una unidad **^^Sybarite^^** amiga visible totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si el objetivo es un **^^Paragon^^**, aplica el siguiente efecto al objetivo. En caso contrario, tira un dado. Con un 3+, aplica el siguiente efecto al objetivo:
• Durante el resto del turno, mientras el objetivo esté totalmente a 12" o menos de esta unidad, suma 1 a la característica de Attacks de sus armas de combate.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Tentación^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Señor de la histeria" id="3110-a9a9-94fe-f5d5" hidden="false" import="true" type="model">
