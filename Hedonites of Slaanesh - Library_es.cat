        <profile name="Slaughterous Celebrants" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="a1da-99a4-9f4a-826b">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén totalmente a 12" o menos de esta unidad y sean visibles para ella, las armas de combate usadas por unidades **^^Hedonites of Slaanesh Infantry^^** amigas tienen **Anti-charge (+1 Rend)**.</characteristic>
          </characteristics>
          <attributes>
