        <profile name="Glutos Orscollion, Señor de la Gula" id="2356-acea-ac09-3a24" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
