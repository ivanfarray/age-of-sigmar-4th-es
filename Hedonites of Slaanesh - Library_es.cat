    <selectionEntry type="unit" import="true" name="Thricefold Discord" hidden="false" id="2496-8747-e770-79da" publicationId="95fc-e96f-a916-bba1">
      <categoryLinks>
        <categoryLink name="INFANTRY" hidden="false" id="7768-7c93-c67b-b0de" targetId="75d6-6995-dfcc-3898" primary="false"/>
        <categoryLink name="HEDONITES OF SLAANESH" hidden="false" id="e66a-cb6a-21b2-5a0f" targetId="67df-cdfb-d83f-3197" primary="false"/>
