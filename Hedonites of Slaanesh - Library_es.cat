    <selectionEntry type="unit" import="true" name="Synessa, the Voice of Slaanesh" hidden="false" id="eb63-b209-7932-2b43" publicationId="95fc-e96f-a916-bba1">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="e698-b794-efe6-234c" includeChildSelections="true"/>
      </constraints>
      <entryLinks>
        <entryLink import="true" name="General" hidden="false" id="2248-d1ea-38d0-fbdc" type="selectionEntry" targetId="a56b-952e-ad15-7868"/>
      </entryLinks>
      <profiles>
        <profile name="Arcane Seductor" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="8209-3644-0b7c-c1b2">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Inicio de la ronda de batalla</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Wizard^^** o **^^Priest^^** enemigo visible a 18" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Si el resultado es mayor que el nivel de poder del objetivo, durante el resto de la ronda de batalla, mientras el objetivo esté a 18" o menos de esta unidad:
• Resta 1 a las tiradas de lanzamiento y de cántico de las unidades enemigas mientras estén a 18" o menos de esta unidad.
• Suma 1 al nivel de poder de esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Synessa, the Voice of Slaanesh" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="e97e-9533-7134-6317">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">10</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Enthralling Splendour" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f9b8-cb9-1d14-9e4f">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga con una característica de Control menor que la de esta unidad, que haya cargado este turno y esté en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Resta 1 a las tiradas de herida de los ataques del objetivo durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Rampage^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Whispers of Desire" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="7a9a-5e84-438c-46f0">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad enemiga visible a 18" o menos de esta unidad; después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Durante el resto del turno, resta 1 a la característica de Attacks de las armas de combate del objetivo.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="16b6-0911-f549-a4bd" name="Color">Yellow</attribute>
            <attribute typeId="da27-8d61-f955-5031" name="Parent Node">Offensive</attribute>
          </attributes>
        </profile>
      </profiles>
