            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Shardslash" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="c741-a37c-d1dd-2922">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de salvaguardia de los puntos de daño infligidos por los ataques de combate de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Red</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Gaze Upon My Magnificence And Weep" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="0f9e-aa28-ddcc-c359">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad no ha usado una habilidad **^^Temptation^^** este turno, elige como objetivo una unidad enemiga en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tu oponente debe decidir si el objetivo **adula** o **rechaza** a Sigvald.
***Adulate:*** Hasta el inicio de tu siguiente turno, mientras el objetivo esté en combate con esta unidad, debe elegir esta unidad como objetivo de sus movimientos de aproximación.
***Reject:*** Inflige D3+3 daño mortal al objetivo; después, aplica ***Heal (X)*** a esta unidad, donde X es el número de puntos de daño infligidos al objetivo este turno por esta habilidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Temptation^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Paragon Of Vainglory" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="1a8a-2c96-ca53-2664">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad ha cargado este turno y la tirada de carga sin modificar fue de 6+, durante el resto del turno:
• Esta unidad tiene **^^Strike-first^^**.
• La característica de Attacks de su **Shardslash** es igual a la tirada de carga sin modificar.
• Las armas de combate, incluidas las armas **Companion**, usadas por otras unidades **^^Hedonites of Slaanesh^^** amigas tienen **Crit (2 Hits)** mientras estén totalmente a 12" o menos de esta unidad y sean visibles para ella.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Red</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
