        </profile>
        <profile name="Threshing Doom" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="eeee-9aa0-8466-5b42">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cuando esta unidad se mueva, puede atravesar miniaturas de unidades enemigas **^^Infantry^^** y puede atravesar los alcances de combate de unidades enemigas **^^Infantry^^**, pero no puede terminar un movimiento en combate a menos que se especifique en la habilidad usada.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Gray</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
