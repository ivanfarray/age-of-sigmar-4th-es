    <selectionEntry type="unit" import="true" name="Exalted Chariot" hidden="false" id="08e6-7dfb-f60e-6fc0" publicationId="9dee-a6b2-4b42-bfee">
      <profiles>
        <profile name="Exalted Chariot" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="aac7-799b-b28e-2190">
