          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad tiene **^^Strike-first^^** mientras esté en combate con una unidad **marcada por el deleite**.</characteristic>
