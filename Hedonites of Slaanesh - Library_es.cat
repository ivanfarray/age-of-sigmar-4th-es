            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Compartir el dolor" id="4dbb-5331-8d9-71f0" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad tiene **^^Ward (5+)^^** mientras esté en combate. Además, cada vez que hagas una tirada de salvaguardia con éxito para esta unidad por un punto de daño infligido por un ataque de combate, inflige 1 daño mortal a la unidad atacante después de resolver la habilidad **^^Combatir^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Atenciones atroces" id="ef7f-7fa7-1503-045c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad **^^Hedonistas de Slaanesh Infantry^^** amiga visible totalmente a 12" o menos de esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Puedes asignar 1 punto de daño al objetivo (no se pueden hacer tiradas de salvaguardia por ese punto de daño). Después, tira un dado. Con un 3+, hasta el inicio de tu siguiente turno, el objetivo puede usar habilidades **^^Cargar^^** aunque haya usado una habilidad **^^Correr^^** o **^^Retirarse^^** en el mismo turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Señor del dolor" id="71c5-c6d1-dded-66b1" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="44e2-f5ae-e26d-7de" field="selections" scope="parent" shared="false" type="min" value="1"/>
