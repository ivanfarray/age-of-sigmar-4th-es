      <profiles>
        <profile name="Damned Conduit" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="c0aa-df5e-6df8-f65d">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible a 18" o menos de este elemento de escenografía.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, hasta el inicio de tu siguiente turno, mientras el objetivo esté a x" o menos de este elemento de escenografía, sus armas tienen la habilidad de arma **Companion**, donde X se determina según la ronda de batalla actual de la siguiente manera:
**Ronda de batalla 1:** 9"
**Ronda de batalla 2:** 12"
**Ronda de batalla 3:** 15"
**Ronda de batalla 4:** 18"
**Ronda de batalla 5:** 21"</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Yellow</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Fane of Slaanesh" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="6f47-50f1-1e37-8e67">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">10</characteristic>
