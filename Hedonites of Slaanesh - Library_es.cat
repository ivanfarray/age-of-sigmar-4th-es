    <selectionEntry type="unit" import="true" name="Infernal Enrapturess, Herald of Slaanesh (Scourge of Aqshy)" hidden="false" id="53d4-7622-559f-b128" publicationId="9e18-bb03-7b60-d4ff">
      <entryLinks>
        <entryLink import="true" name="General" hidden="false" id="c36d-ea1d-1b48-505b" type="selectionEntry" targetId="a56b-952e-ad15-7868"/>
      </entryLinks>
      <profiles>
        <profile name="Infernal Enrapturess, Herald of Slaanesh" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="7c41-157a-feaf-61d6">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
