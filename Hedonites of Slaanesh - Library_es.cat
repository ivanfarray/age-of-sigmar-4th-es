        <profile name="Arcane Disruption" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="9c5d-e9c9-ee11-d335">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de lanzamiento y de disipación de los **^^Wizards^^** enemigos mientras estén a 12" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
