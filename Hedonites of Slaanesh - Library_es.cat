      <profiles>
        <profile name="Glutos Orscollion, Lord of Gluttony" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="2356-acea-ac09-3a24">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">18</characteristic>
