    <selectionEntry type="unit" import="true" name="The Masque" hidden="false" id="19fa-187-b059-ffce" publicationId="95fc-e96f-a916-bba1">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="d112-e427-943d-48df" includeChildSelections="true"/>
      </constraints>
      <entryLinks>
        <entryLink import="true" name="General" hidden="false" id="a512-21ff-e264-219d" type="selectionEntry" targetId="a56b-952e-ad15-7868"/>
      </entryLinks>
      <profiles>
        <profile name="The Endless Dance" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="4be4-1dbc-986c-28f2">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de los siguientes efectos:
***The Dance of Dreaming:*** Elige como objetivo una unidad enemiga visible a 6" o menos de esta unidad. Durante el resto del turno, si la tirada de impacto sin modificar de un ataque efectuado por esa unidad enemiga que tenga como objetivo esta unidad es de 1-4, el ataque falla y termina la secuencia de ataque.
***The Pavane of Slaanesh:*** Esta unidad puede moverse 2D3". Puede atravesar los alcances de combate de las unidades enemigas y terminar ese movimiento en combate.
***The Waltz of Lethargy:*** Elige como objetivo una unidad enemiga visible a 6" o menos de esta unidad. Durante el resto del turno, el objetivo no puede usar órdenes mientras esté en combate con esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="The Masque" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="aabd-e28e-1fbb-609a">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">8&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Captive Audience" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="9e17-8dc9-b594-543b">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las unidades enemigas no pueden usar habilidades **^^Retreat^^** mientras estén en combate con esta unidad.</characteristic>
          </characteristics>
