          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad si no ha sido desplegada.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en reserva esperando en emboscada. Ahora se considera desplegada.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Asalto bestial" id="aa8e-3cbb-0c5b-6eef" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige esta unidad si está **esperando en emboscada**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en el campo de batalla totalmente a 9" o menos de un borde del campo de batalla y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Avance instintivo" id="e585-f2f2-5809-5a1b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por fase (ejército), Reacción: El oponente ha declarado una orden para una unidad a 12" o menos de esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede moverse hasta 3" inmediatamente después de resolver esa orden, salvo que la orden sea una reacción, en cuyo caso esta unidad puede moverse después de resolver la habilidad a la que reaccionaba. Ese movimiento puede atravesar los alcances de combate de las unidades enemigas y terminar en combate.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
