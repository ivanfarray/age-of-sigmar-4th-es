        <profile name="Señor de la soberbia" id="3f88-1bd6-66c1-5c5d" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="«Tú primero, insisto...»" id="803d-7041-688b-7465" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad no ha usado una habilidad **^^Temptation^^** este turno, elige como objetivo una unidad enemiga en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tu oponente debe decidir si el objetivo **acepta** o **rechaza** el desafío de esta unidad.
Si lo **acepta**, durante el resto del turno, si esta unidad está en combate con el objetivo cuando este sea elegido para usar una habilidad **^^Combatir^^**, resta 1 a las tiradas de impacto de sus ataques y todos los ataques del objetivo deben tener como objetivo esta unidad.
Si lo **rechaza**, durante el resto del turno:
• El objetivo tiene **^^Strike-last^^**.
• Suma 1 a la característica de Damage de las armas de combate de esta unidad para ataques que tengan como objetivo esa unidad enemiga.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Tentación^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Permitidme demostrarlo" id="3e43-f999-e8a0-ecd0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), reacción: has declarado una habilidad de **^^Combatir^^** para esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige como objetivo una unidad **^^Sybarite^^** amiga que no sea **^^Hero^^**, no haya usado una habilidad **^^Combatir^^** este turno y esté dentro del alcance de combate de esta unidad. El objetivo puede ser elegido para usar una habilidad **^^Combatir^^** inmediatamente después de resolver la habilidad **^^Combatir^^** usada por esta unidad. Suma 1 a las tiradas de impacto de los ataques de esta unidad y del objetivo durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
