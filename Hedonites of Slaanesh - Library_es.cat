                  <profiles>
                    <profile name="An Endless Festival" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="d286-8a93-60d6-4194">
                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una unidad enemiga a 12" o menos de esta unidad use una habilidad que le devuelva miniaturas abatidas, después de resolver esa habilidad, devuelve 1 miniatura abatida a esta unidad.</characteristic>
                      </characteristics>
                      <attributes>
                        <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
