      </categoryLinks>
      <profiles>
        <profile name="Arqueros de púas del éxtasis" id="839-fd59-615-613" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">1</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">6+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Homúnculo del brebaje del éxtasis" id="4e44-7769-baad-8488" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Los **Blissbrew Homonculi** de esta unidad son marcadores. Hay 1 **Homúnculo del brebaje del éxtasis** por cada 10 miniaturas de esta unidad.
Esta unidad tiene **Ward (6+)** mientras tenga algún **Blissbrew Homonculi**. Si haces una tirada de salvaguardia sin modificar de 1 para esta unidad, retira 1 de sus **Blissbrew Hoomonculi** del campo de batalla (el punto de daño se inflige igualmente).</characteristic>
          </characteristics>
        </profile>
        <profile name="La emoción del combate" id="6ea8-0747-9ff8-42fb" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga visible que esté en combate.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, las armas a distancia de esta unidad tienen **Disparar en combate** y también tienen **Crítico (herida automática)** para ataques que tengan como objetivo esa unidad enemiga.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
