        </profile>
        <profile name="Sublime Harmonies" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="ded0-5f05-9f9c-9940">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras la **Vashtiss** de esta unidad esté en el campo de batalla, esta unidad tiene **^^Wizard (1)^^**. Además, cada vez que hagas una tirada de lanzamiento para esta unidad, puedes gastar cualquier número de **puntos de indulgencia** que tenga. Por cada punto gastado, suma 1 a la tirada de lanzamiento.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Yellow</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
