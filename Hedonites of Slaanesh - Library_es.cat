                        <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad no está en combate, elige como objetivo la unidad enemiga visible más cercana a 12" o menos de ella.</characteristic>
                        <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Inflige D6 de daño mortal al objetivo.</characteristic>
                        <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                        <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
