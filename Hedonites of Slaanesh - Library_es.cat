    <selectionEntry type="unit" import="true" name="Shalaxi Helbane" hidden="false" id="288-b306-7776-96b5" publicationId="95fc-e96f-a916-bba1">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="aaea-c838-9204-f622" includeChildSelections="true"/>
      </constraints>
      <entryLinks>
        <entryLink import="true" name="General" hidden="false" id="3784-1991-71a8-3943" type="selectionEntry" targetId="a56b-952e-ad15-7868"/>
      </entryLinks>
      <profiles>
        <profile name="An Exquisite Trophy" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="91a1-6acf-c30f-7da0">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Hero^^** o **^^Monster^^** enemigo en combate con esta unidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la fase, se aplican los siguientes efectos:
• Los ataques de combate de esta unidad que tengan como objetivo esa unidad enemiga tienen **Crit (2 Hits)** y logran impactos críticos con tiradas de impacto sin modificar de 5+.
• Si los ataques de combate de esta unidad destruyen al objetivo en esta fase, suma 1 a la característica de Attacks de las armas de combate usadas por otras unidades **^^Hedonites of Slaanesh Daemon^^** amigas mientras estén totalmente a 12" o menos de esta unidad y sean visibles para ella.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Red</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Shalaxi Helbane" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="9d6c-f084-7381-a9a7">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">12&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">16</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">5</characteristic>
          </characteristics>
        </profile>
        <profile name="Paramount Hunter" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="67ca-3436-910-c622">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), Reacción: El oponente ha declarado una habilidad **^^Charge^^** para un **^^Hero^^** a 12" o menos de esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad no está en combate, puede moverse inmediatamente 2D6". Puede atravesar los alcances de combate de las unidades enemigas, pero debe terminar ese movimiento a 1/2" o menos de ese **^^Hero^^**. Si lo hace, esta unidad ha cargado y la habilidad **^^Charge^^** de ese **^^Hero^^** no tiene efecto.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Core^^**, **^^Move^^**, **^^Charge^^**, **^^Rampage^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Orange</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Supernatural Grace" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="bbd0-62b7-cb3a-68a9">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad puede usar habilidades de **^^Charge^^** aunque haya usado una habilidad de **^^Retreat^^** en el mismo turno. Además, esta unidad no recibe daño mortal por habilidades de **^^Retreat^^**.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Refine Senses" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="5ce3-79b1-1338-f8ec">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">8</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad **^^Hedonites of Slaanesh^^** amiga visible totalmente a 12" o menos de esta unidad; después, haz una tirada de lanzamiento de 2D6. Suma 1 a la tirada de lanzamiento si esta unidad es el objetivo.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">El objetivo tiene **^^Strike-first^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Spell^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="16b6-0911-f549-a4bd" name="Color">Yellow</attribute>
            <attribute typeId="da27-8d61-f955-5031" name="Parent Node">Special</attribute>
          </attributes>
        </profile>
        <profile name="Battle Damaged" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="bbd4-a864-c34-9fe6">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad tenga 10 o más puntos de daño, la característica de Attacks de su **Soulpiercer** es 4.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Damage</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
