        <profile name="Indulgence Given Form" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="c6bc-678a-009d-f24f">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una unidad enemiga use una orden mientras esté a 12" o menos de esta unidad, otorga 1 **punto de indulgencia** a esta unidad, hasta un máximo de 6.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Black</attribute>
