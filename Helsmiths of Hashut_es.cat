    <selectionEntryGroup name="Formaciones de batalla: Herreros Infernales de Hashut" id="a7e2-ba88-9ea3-eddb" flatten="true" hidden="false">
      <constraints>
        <constraint id="d768-02ca-f0cd-fd02" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Hueste de Hashut" id="0adf-5c49-e0f5-7ec1" hidden="false" import="true" publicationId="487d-9798-0633-8040" type="upgrade">
          <constraints>
            <constraint id="a1a6-fc1f-45cd-df36" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Legiones reunidas" id="37de-91f1-7eab-b6b3" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una unidad amiga **^^Herreros Infernales de Hashut^^** dentro del alcance de combate de una unidad amiga **^^Herreros Infernales de Hashut Infantry^^** con 1 o más **puntos de poder demoníaco** use la orden &apos;Reagrupamiento&apos;, puedes hacer 3 tiradas de reagrupamiento adicionales de D6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Batería de Castigo" id="3588-87cf-b645-97b4" hidden="false" import="true" publicationId="487d-9798-0633-8040" type="upgrade">
          <constraints>
            <constraint id="620a-3060-b857-8eeb" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Municiones experimentales" id="c8f1-c122-c0de-a1c9" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las armas a distancia de las unidades amigas **^^Herreros Infernales de Hashut^^** tienen **Crítico (2 impactos)** mientras dichas unidades tengan 2 o más **puntos de poder demoníaco**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Los Cuernos del Padre Toro" id="4f34-00b0-01a8-a65d" hidden="false" import="true" publicationId="487d-9798-0633-8040" type="upgrade">
          <constraints>
            <constraint id="e418-ae88-b0f3-d9be" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Toros del zigurat" id="970b-f305-5905-125f" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1" a la característica de Move de las unidades amigas **^^Herreros Infernales de Hashut^^** por cada **punto de poder demoníaco** que tenga esa unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cábala de Herreros Demoníacos" id="518e-6140-2970-4c13" hidden="false" import="true" publicationId="487d-9798-0633-8040" type="upgrade">
          <constraints>
            <constraint id="d216-3b78-0212-6e40" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Dominio arcano" id="9189-b459-189d-f9b2" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de lanzamiento, cántico, desvinculación y destierro de los **^^Herreros Infernales de Hashut Wizards^^** y **^^Priests^^** amigos mientras estén totalmente a 12" o menos de otro **^^Herreros Infernales de Hashut Wizard^^** o **^^Priest^^** amigo con 1 o más **puntos de poder demoníaco**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fuerza de Dominación" id="5e90-8471-5fd1-bbd4" hidden="true" import="true" publicationId="f894-7929-f79a-a269" type="upgrade">
