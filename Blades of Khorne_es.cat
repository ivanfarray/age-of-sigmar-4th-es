      <selectionEntries>
        <selectionEntry name="Estampida de latón" id="e3e6-6005-7085-ec66" hidden="false" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
          <constraints>
            <constraint id="6bfd-8807-5ede-537c" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Carga aniquiladora" id="d6d0-b1cf-2231-15b9" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma **X** a las tiradas de carga de las unidades amigas **^^Filos de Khorne^^**, donde **X** es el número de unidades amigas **^^Filos de Khorne Cavalry^^** o **^^Monster^^** que ya hayan cargado esta fase y que estén totalmente a 12" o menos de la unidad por la que se tira.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Legión de Khorne" id="1437-4357-25cb-fc23" hidden="false" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
          <constraints>
            <constraint id="f9bd-6d93-2ad9-3052" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Carniceros de naciones" id="bc8a-d722-6a86-4161" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), Reacción: Has declarado una habilidad **^^Combatir^^** para una unidad amiga **^^Filos de Khorne Daemon^^**</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige como objetivo una unidad amiga **^^Bloodbound^^** que no haya usado una habilidad **^^Combatir^^** este turno y que esté totalmente a 12" o menos de la unidad que use esta habilidad. El objetivo puede ser elegido para usar una habilidad **^^Combatir^^** inmediatamente después de resolver la habilidad **^^Combatir^^** usada por esta unidad.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">La unidad que use esa habilidad **^^Combatir^^**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hueste Asesina" id="5ccf-b9a-18d6-e621" hidden="false" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
          <constraints>
            <constraint id="f1d0-4637-461e-c661" field="selections" scope="parent" shared="true" type="max" value="1"/>
