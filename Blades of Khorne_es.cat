              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de tu turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada unidad amiga **^^Filos de Khorne Daemon^^** que haya usado una habilidad **^^Combatir^^** este turno y que no esté en combate puede mover D6". No puede terminar ese movimiento en combate.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Horda de Guerra de los Juramentados de Sangre" id="43b-c649-d523-c32d" hidden="false" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
