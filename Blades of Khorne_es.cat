              </constraints>
              <profiles>
                <profile name="Hoja de carnicero" id="3a4f-9b6b-b406-e3da" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
