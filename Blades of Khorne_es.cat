    <selectionEntryGroup name="Formaciones de batalla: Filos de Khorne" id="a398-8e2f-f1f1-fe26" hidden="false" flatten="true">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Estampida de latón" hidden="false" id="e3e6-6005-7085-ec66" publicationId="81a9-3dbf-dbc5-672e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6bfd-8807-5ede-537c"/>
          </constraints>
          <profiles>
            <profile name="Carga aniquiladora" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="d6d0-b1cf-2231-15b9">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma **X** a las tiradas de carga de las unidades amigas **^^Filos de Khorne^^**, donde **X** es el número de unidades amigas **^^Filos de Khorne Cavalry^^** o **^^Monster^^** que ya hayan cargado esta fase y que estén totalmente a 12" o menos de la unidad por la que se tira.</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute typeId="e2e1-15ca-d345-22b8" name="Parent Node"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Legión de Khorne" hidden="false" id="1437-4357-25cb-fc23" publicationId="81a9-3dbf-dbc5-672e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f9bd-6d93-2ad9-3052"/>
          </constraints>
          <profiles>
            <profile name="Carniceros de naciones" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="bc8a-d722-6a86-4161">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), Reacción: Has declarado una habilidad **^^Combatir^^** para una unidad amiga **^^Filos de Khorne Daemon^^**</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige como objetivo una unidad amiga **^^Bloodbound^^** que no haya usado una habilidad **^^Combatir^^** este turno y que esté totalmente a 12" o menos de la unidad que use esta habilidad. El objetivo puede ser elegido para usar una habilidad **^^Combatir^^** inmediatamente después de resolver la habilidad **^^Combatir^^** usada por esta unidad.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">La unidad que use esa habilidad **^^Combatir^^**.</characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute typeId="2d74-4dcd-8468-87fa" name="Parent Node"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hueste Asesina" hidden="false" id="5ccf-b9a-18d6-e621" publicationId="81a9-3dbf-dbc5-672e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f1d0-4637-461e-c661"/>
          </constraints>
          <profiles>
            <profile name="Asesinos impacientes" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="989c-d958-d667-7b15">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de tu turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada unidad amiga **^^Filos de Khorne Daemon^^** que haya usado una habilidad **^^Combatir^^** este turno y que no esté en combate puede mover D6". No puede terminar ese movimiento en combate.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute typeId="2d74-4dcd-8468-87fa" name="Parent Node"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Horda de Guerra de los Juramentados de Sangre" hidden="false" id="43b-c649-d523-c32d" publicationId="81a9-3dbf-dbc5-672e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1fe6-998a-1877-9c94"/>
          </constraints>
          <profiles>
            <profile name="Conquistadores incansables" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="8dab-6df3-1e4-5b29">
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="force" childId="d1f3-921c-b403-1106" shared="true" includeChildSelections="true" includeChildForces="true"/>
                        <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="376a-6b97-8699-dd59" shared="true"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
Add 1 to hit rolls for combat attacks made by friendly **^^Bloodbound^^** units that target an enemy unit that is contesting an objective you do not control.                </characteristic>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                <attribute typeId="e2e1-15ca-d345-22b8" name="Parent Node"/>
              </attributes>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Torneo de Cráneos" hidden="true" id="b17c-c220-7a3d-69c8" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5913-8f62-de56-a610"/>
          </constraints>
          <profiles>
            <profile name="Competidores sangrientos" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="9473-82ed-fc5f-f420">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos una unidad amiga que no sea **^^Hero Bloodbound^^** y una unidad amiga que no sea **^^Hero Filos de Khorne Daemon^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno, mientras los objetivos estén totalmente a 12" o menos entre sí, suma 1 a las tiradas de herida de los ataques de combate de los objetivos.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                <attribute typeId="2d74-4dcd-8468-87fa" name="Parent Node"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="La Marea Sangrienta" hidden="true" id="5ead-660f-ba1b-f290" publicationId="f894-7929-f79a-a269">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="03f2-c6e4-ebc1-b759"/>
          </constraints>
          <profiles>
            <profile name="Marea de salvajismo" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="1285-134e-e185-fc95">
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos una **^^Bloodbound Hero^^** amiga y hasta 2 unidades amigas **^^Bloodbound^^** adicionales totalmente a 12" o menos de esa **^^Hero^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 2" a la característica de Move de los objetivos durante el resto del turno.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute typeId="2d74-4dcd-8468-87fa" name="Parent Node"/>
              </attributes>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="78a1-f6c2-71b8-270a" shared="true"/>
                    <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="f079-501a-2738-6845" shared="true"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
