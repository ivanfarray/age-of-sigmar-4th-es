  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Artefacts of Power" id="1ede-f90-a661-b6c2" hidden="false">
      <selectionEntryGroups>
        <selectionEntryGroup name="Artefactos asesinos" id="fd3f-1eb4-fee3-c802" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Collar de desprecio" hidden="false" id="b53d-220d-dc3a-13ac">
              <profiles>
                <profile name="Collar de desprecio" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="defa-ab8a-3572-9d77">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad puede usar habilidades **^^Desvincular^^** como si tuviera **^^Wizard (1)^^**. Cada vez que esta unidad desvincule con éxito un hechizo, inflige D3 de daño mortal al lanzador.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute typeId="e2e1-15ca-d345-22b8" name="Parent Node"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="2439-e9a6-9bb2-c34" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hoja de carnicero" hidden="false" id="7ec3-3828-3c35-bccf">
              <profiles>
                <profile name="Hoja de carnicero" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="3a4f-9b6b-b406-e3da">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de tu turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos cada unidad enemiga que haya recibido algún punto de daño este turno de los ataques de combate de esta unidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un D3 por cada objetivo. Con un 2+, inflige al objetivo una cantidad de daño mortal igual al resultado.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute typeId="2d74-4dcd-8468-87fa" name="Parent Node"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="d0a3-af13-6de5-e1c3" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ar&apos;gath, el Rey de las Hojas" hidden="false" id="4e60-c59e-a6eb-2766">
              <profiles>
                <profile name="Ar&apos;gath, el Rey de las Hojas" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="6511-6823-aee9-e30c">
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">No se pueden hacer tiradas de salvaguardia para las **^^Heroes^^** enemigas mientras estén en combate con esta unidad.</characteristic>
                  </characteristics>
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                    <attribute typeId="e2e1-15ca-d345-22b8" name="Parent Node"/>
                  </attributes>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="790c-aa6e-7162-7ec9" includeChildSelections="true"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
          <rules>
