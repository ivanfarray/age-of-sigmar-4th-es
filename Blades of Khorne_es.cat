                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad puede usar habilidades **^^Desvincular^^** como si tuviera **^^Wizard (1)^^**. Cada vez que esta unidad desvincule con éxito un hechizo, inflige D3 de daño mortal al lanzador.</characteristic>
