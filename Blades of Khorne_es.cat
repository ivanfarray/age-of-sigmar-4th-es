          <selectionEntries>
            <selectionEntry name="Desdén por la magia" id="7c75-846e-f3f9-a551" hidden="false" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
              <constraints>
                <constraint id="4728-7cbe-831d-cd17" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Desdén por la magia" id="5b7-2469-41a5-fdd6" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de lanzamiento de las **^^Wizards^^** mientras estén a 12" o menos de esta unidad.
Resta 1 a las tiradas de cántico de las **^^Priests^^** enemigas mientras estén a 12" o menos de esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Coleccionista de cráneos" id="e92f-179d-6fac-e594" hidden="false" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
              <constraints>
                <constraint id="4e9c-aeda-c3ca-9c2d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Coleccionista de cráneos" id="e2dc-52bb-fc82-1e9d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si algún punto de daño fue asignado a una **^^Hero^^** enemiga por los ataques de combate de esta unidad este turno y esa **^^Hero^^** enemiga ha sido destruida, suma 1 a la característica de Attacks de las armas de combate cuerpo a cuerpo de esta unidad durante el resto de la batalla.
Esta unidad puede verse afectada por esta habilidad varias veces y los efectos son acumulativos.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Capataz frenético" id="4c69-c9fd-b060-aff8" hidden="false" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
              <constraints>
                <constraint id="8594-1ab8-e131-7211" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Capataz frenético" id="5f0a-7fd8-8235-9604" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Filos de Khorne Infantry^^** o **^^Cavalry^^** dentro del alcance de combate de esta unidad que no esté en combate.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El objetivo puede mover D6" pero no puede terminar ese movimiento en combate. Si el objetivo termina ese movimiento dentro del alcance de combate de esta unidad, inflige al objetivo una cantidad de daño mortal igual al resultado.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
