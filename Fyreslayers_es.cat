            <selectionEntry type="upgrade" import="true" name="Torrente ígneo intenso" hidden="false" id="a1eb-1f56-070d-3fb6">
              <profiles>
                <profile name="Torrente ígneo intenso" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="df4e-fcb2-9e6d-6373">
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de disparo</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Gasta 1 **dado de ira**. Si el **nivel de furia** de tu oponente es inferior al tuyo, debe subir su **nivel de furia** en 1, hasta un máximo de 7. Después, durante el resto del turno:
• Suma **X**" a la característica de Alcance y **X** a la característica de Attacks de las armas a distancia **Compañero** de esta unidad, donde **X** es igual a tu **nivel de furia**.
• Las armas a distancia **Compañero** de esta unidad tienen **Disparar in Combat**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                  <attributes>
