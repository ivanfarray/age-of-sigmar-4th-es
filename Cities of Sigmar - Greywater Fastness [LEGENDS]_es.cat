                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga visible **^^Greywater Fastness^^** que esté totalmente a 12" o menos de esta unidad, que esté bajo órdenes y que tenga un **Firing Drill**.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El objetivo puede usar su habilidad **Firing Drill** este turno aunque ya la haya usado esta batalla.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntryGroup>
    <selectionEntryGroup name="Ejercicios de tiro" id="3ab0-b0f6-a64d-6d1e" hidden="false">
      <constraints>
        <constraint id="40f3-884c-f79b-2cbe" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
        <constraint id="a67b-2272-bc48-be5d" field="selections" scope="root-entry" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="40f3-884c-f79b-2cbe" type="set" value="-1">
          <conditions>
            <condition childId="any" field="e63c-79ff-93ba-c5eb" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Ejercicios de tiro: Fortaleza de Aguas Grises" id="3d5e-1a3a-cf1e-a067" hidden="false" publicationId="dadd-06f0-3f38-c6f3">
          <rules>
            <rule name="Restricciones de mejoras" id="0ae8-14ff-955a-ac5d" hidden="true">
              <description>Un Firing Drill es una mejora única que puede otorgarse a unidades que no sean **^^Hero Greywater Fastness^^**. Una unidad solo puede tener 1 **Firing Drill**.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="¡Salva a corta distancia!" id="862d-e724-7d16-7a8e" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="038a-a92b-0a37-4ba7" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="¡Salva a corta distancia!" id="ef34-0a0e-6ef8-ec5e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de disparo</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esta unidad está **bajo órdenes**, durante el resto de la fase, las armas a distancia de esta unidad tienen **Disparar en combate**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="¡Ensordecedlos con fuego!" id="3275-1756-4e6c-c0d6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="bf41-62dd-5b33-7770" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="¡Ensordecedlos con fuego!" id="53fa-4835-0a4f-0717" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de disparo</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si esta unidad está **bajo órdenes**, elige como objetivo una unidad enemiga **pinned** que haya sido objetivo de todos los ataques de disparo de esta unidad este turno.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno, cada vez que tu oponente declare una orden para el objetivo, a menos que gaste 1 punto de orden adicional para usar esa orden, la orden no tiene efecto, sigue contando como usada y los puntos de orden gastados en usarla se pierden igualmente.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="¡Contenedlos!" id="b71c-5513-0851-0776" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c3e5-9ab3-086f-9771" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="¡Contenedlos!" id="ec45-0693-a75f-472e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de disparo</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga **pinned**.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno, tu oponente debe restar 1 al número de dados tirados al hacer tiradas de carga para el objetivo, hasta un mínimo de 1.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="¡Repelid al enemigo!" id="92ce-7441-1f6c-ace9" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7c25-89fd-5ea7-f73c" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="¡Repelid al enemigo!" id="cfce-e8bc-f335-9977" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de combate</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, suma 1 a las tiradas de herida de los ataques de combate hechos por esta unidad que tengan como objetivo una unidad enemiga **pinned**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="¡A cubierto!" id="4613-6302-8f29-165f" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5bfe-7980-5777-6dc0" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="¡A cubierto!" id="8b5c-a1f7-2164-84c4" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, fase de movimiento enemiga</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno:
• Resta 1 a la característica de Rend de las armas usadas para los ataques hechos por unidades enemigas **pinned** que tengan como objetivo esta unidad.
• Esta unidad no puede usar habilidades de **^^Cargar^^** a menos que esté **bajo órdenes**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="¡Cargad munición de humo!" id="e1f5-4228-4d01-dc25" hidden="false" import="true" type="upgrade">
              <constraints>
