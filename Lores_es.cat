              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Pyrofane Wizard^^** amigo para lanzar este hechizo, elige como objetivo una unidad enemiga visible a 18" o menos de él a la que la habilidad &apos;Inmolación de los reinos&apos; haya asignado puntos de daño en esta ronda de batalla y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">El objetivo no puede usar órdenes durante el resto de la ronda de batalla.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
