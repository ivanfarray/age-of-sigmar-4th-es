              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Golpe auspicioso" id="306e-2d2b-e52e-909c" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Shooting</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Croneseer&apos;s Pariahs Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Croneseer&apos;s Pariahs^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, cada vez que la tirada de impacto sin modificar de un ataque contra el objetivo sea de 1, inflige 1 daño mortal a la unidad atacante después de resolver la habilidad Combatir. Si la tirada de cántico fue de 10+, inflige 1 daño mortal por cada tirada de impacto sin modificar de 1-2 en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Augurio de batalla" id="8200-6a76-57e6-f64f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8a64-7369-94bf-df89" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="80b6-36e5-97df-628d" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
