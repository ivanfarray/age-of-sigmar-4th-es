      <selectionEntries>
        <selectionEntry name="Invocar: Pie de Gork" id="485e-b60d-7af3-32f2" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="787f-90eb-db80-87f2" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
