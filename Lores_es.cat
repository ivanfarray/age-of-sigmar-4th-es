          <profiles>
            <profile name="Milagro cuerpo a cuerpo de Mork" id="bda3-72ab-1913-b82f" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
