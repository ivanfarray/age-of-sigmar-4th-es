    <selectionEntryGroup name="Bendiciones de sangre de Khorne" id="7761-af98-de90-44d8" hidden="false" publicationId="81a9-3dbf-dbc5-672e">
      <selectionEntries>
        <selectionEntry name="Hervir la sangre" id="ae0d-8932-1358-f9c4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a1c0-3e29-7ca0-60d1" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="9352-1ffa-1a2e-056e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="a1c0-3e29-7ca0-60d1" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Hervir la sangre" id="7110-35e0-803b-2487" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Filos de Khorne Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad enemiga visible a 18" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Tira tantos dados como miniaturas tenga la unidad objetivo. Por cada 5+, inflige 1 daño mortal al objetivo. Además, si la tirada de cántico fue de 8+, resta 1 a las tiradas de herida del objetivo hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ira incontrolable" id="461b-664a-6005-b2b2" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="15bd-f4f3-d3ef-4cf2" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="4a23-293c-c2ea-e45f" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="15bd-f4f3-d3ef-4cf2" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Ira incontrolable" id="ce16-4ab0-2908-305f" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Filos de Khorne Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, los efectos de la habilidad &apos;Empapado de sangre&apos; (consulta &apos;Rasgos de batalla&apos;) se aplican al objetivo. Además, si la tirada de cántico fue de 8+, ignora el efecto de &apos;Brutalidad de mirada salvaje&apos; sobre el objetivo.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Último acto de violencia" id="6062-ef2a-d346-dc58" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f58e-e229-0be9-fa9e" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="ab0a-c56a-42ad-5c53" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="f58e-e229-0be9-fa9e" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Último acto de violencia" id="3951-df2c-1c3a-2943" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Filos de Khorne Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Filos de Khorne^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, cada vez que una miniatura de la unidad objetivo sea abatida por un ataque de combate y esa miniatura estuviera en combate con la unidad atacante, tira un dado. Si la tirada de cántico fue de 8+, tira 2 dados en su lugar. Por cada 5+, inflige 1 daño mortal a la unidad atacante después de resolver la habilidad **^^Combatir^^**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de las bestias salvajes" id="24a5-b6bc-ec3d-0079" hidden="false" publicationId="06c5-6322-e810-7967">
      <selectionEntries>
        <selectionEntry name="Frenesí verde resplandeciente" id="0972-c1fb-421c-2ec4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fc7d-fc6d-927e-a03b" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="91fd-4656-baef-5321" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="fc7d-fc6d-927e-a03b" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Frenesí verde resplandeciente" id="fa6e-6f79-58fe-3e18" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Bonesplitterz Wizard^^** amigo para lanzar este hechizo; elige como objetivo una unidad amiga visible totalmente a 12" o menos de él; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Suma 1 a la característica de Rend de las armas de combate del objetivo, incluidas las armas **Compañero**, hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
