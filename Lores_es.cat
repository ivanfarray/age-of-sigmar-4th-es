              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Gitz del Rencor Crepuscular Wizard^^** amigo para lanzar este hechizo; elige como objetivo un objetivo a 18" o menos de esta unidad; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, resta 1 a las tiradas de herida de los ataques de las unidades enemigas mientras disputen el objetivo elegido.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Resplandor del Santuario Lunático" id="40ef-33d6-bb29-41dc" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3c78-8d40-153c-5388" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="92c6-c099-ed76-25e5" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
