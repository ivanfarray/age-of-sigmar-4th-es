                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Gitz del Rencor Crepuscular Wizard^^** amigo para lanzar este hechizo; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Durante el resto del turno, si un **Santuario lunático de la Mala Luna** amigo usa la habilidad &apos;Guaridas del clan lunar&apos;, puedes colocar la unidad de reemplazo totalmente a 6" o menos de esta unidad y a más de 3" de todas las unidades enemigas en lugar de totalmente a 12" o menos de ese **Santuario lunático de la Mala Luna**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
