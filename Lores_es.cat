                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Ciudades de Sigmar Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Ciudades de Sigmar^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Si la tirada de cántico fue de 7+, puedes elegir otra unidad válida como segundo objetivo. Hasta el inicio de tu siguiente turno, ignora el primer punto de daño que se fuera a asignar a cada objetivo en cada fase.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bendición de los altos cielos" id="0c9f-d4c4-f482-5ca0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="630e-13a4-f120-33a7" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="fecb-a3e9-3a19-2000" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
