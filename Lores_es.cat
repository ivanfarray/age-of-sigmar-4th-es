          <profiles>
            <profile name="Invocar: Pie de Gork" id="47e8-a2b7-7c09-dd3f" hidden="false" publicationId="8b1b-f2c7-890e-2bbe" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
