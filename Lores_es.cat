                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Terrores del hielo antiguo" id="8dc8-2048-ad2e-4aed" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Control</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Alfrostun Priest^^** amigo para entonar esta plegaria; elige como objetivo un objetivo o elemento de escenografía totalmente a 18" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, resta 10 a las puntuaciones de control de las unidades enemigas mientras disputen el objetivo. Si la tirada de cántico fue de 8+, hasta el inicio de tu siguiente turno, las unidades enemigas tienen una puntuación de control máxima de 1 mientras disputen el objetivo.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Voz de avalancha" id="6286-ea54-990c-0d66" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1676-b094-476c-d2da" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="a22d-a5f8-9d8c-fb6a" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
