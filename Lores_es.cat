          </modifiers>
          <profiles>
            <profile name="Giro perpetuo" id="aeb1-34fd-2204-83dc" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Ciclo de Corrupción Priest^^** amigo para entonar esta plegaria; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">La siguiente habilidad **^^Cycle^^** de la secuencia está madura durante el resto de la ronda de batalla en lugar de la habilidad **^^Cycle^^** actual. Si la tirada de cántico fue de 12+, puedes elegir qué habilidad **^^Cycle^^** está madura.</characteristic>
