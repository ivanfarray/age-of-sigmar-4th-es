              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Gitz del Rencor Crepuscular Wizard^^** amigo para lanzar este hechizo; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, suma 2" a la característica de Move de las unidades **^^Gitz del Rencor Crepuscular^^** amigas que no sean **^^Troggoth^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Susto luminoso" id="6043-9f44-b4af-8920" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f8aa-00c3-0ad1-b55e" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="ce65-b84f-f78d-2a17" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
