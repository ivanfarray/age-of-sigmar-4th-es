                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^New Summercourt Wizard^^** amigo para lanzar este hechizo, elige como objetivo una unidad **^^New Summercourt Infantry^^** o **^^Cavalry^^** amiga visible totalmente a 12" o menos de él y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno:
• Suma 2" a la característica de Move del objetivo.
• Suma 1 a las tiradas de herida de los ataques de combate del objetivo.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Miasma de locura" id="1180-eeb6-4c76-86d4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d648-cc33-410b-5f92" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
