          <profiles>
            <profile name="Ríos de sangre y tumbas poco profundas" id="f18f-49f7-529f-54f6" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
