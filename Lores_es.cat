          </modifiers>
          <profiles>
            <profile name="Ritual reverberante" id="db5a-bb1e-6e27-7171" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">7</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Gnawhorde Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Gnawhorde Infantry^^** amiga totalmente a 13" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, el objetivo puede moverse 3" adicionales al hacer un movimiento de aproximación. Además, si la tirada de cántico fue de 8+, suma 1 a su puntuación de control hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
