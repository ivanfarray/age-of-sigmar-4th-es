        <selectionEntry name="Invocar: Estrado Arcano" id="32ce-8c92-7606-313f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5b21-73b2-9013-6e6e" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
