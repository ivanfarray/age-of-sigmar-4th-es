        <selectionEntry name="Pacto del Corazón de Hierro" id="7668-15c3-ce85-2700" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5eaf-c743-4ea9-c99c" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="7af1-8493-7335-06d3" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="5eaf-c743-4ea9-c99c" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Pacto del Corazón de Hierro" id="53de-3171-59b5-71ac" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Control</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Hijas de Khaine Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Hijas de Khaine^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Suma 10 a la puntuación de control del objetivo hasta el inicio de tu siguiente turno. Además, si la tirada de cántico fue de 6+, ignora el primer punto de daño que se fuera a asignar al objetivo en cada fase hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Catecismo del asesinato" id="cdc9-0d5d-5fab-4eb1" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="943b-cc15-1261-55f4" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="e688-d915-053a-f420" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="943b-cc15-1261-55f4" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Catecismo del asesinato" id="a2fe-655d-a868-0f44" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Hijas de Khaine Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Hijas de Khaine^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Las armas de combate del objetivo tienen **Crítico (herida automática)** hasta el inicio de tu siguiente turno. Además, si la tirada de cántico fue de 7+, sus ataques de combate logran impactos críticos con tiradas de impacto sin modificar de 5+ hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Danza de la perdición" id="bfec-2e5d-9071-60d6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="229d-e2fb-bd68-7814" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="1645-fceb-7417-1ddf" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="229d-e2fb-bd68-7814" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Danza de la perdición" id="e7bd-f4e3-ed88-24b6" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Hijas de Khaine Priest^^** amigo para entonar esta plegaria, elige como objetivo una unidad **^^Hijas de Khaine^^** amiga visible que no sea **^^Unique^^** totalmente a 12" o menos de él y, después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Suma 1 a la característica de Attacks de las armas de combate del objetivo durante el resto del turno. Además, si la tirada de cántico fue de 10+, el objetivo puede usar 2 habilidades **^^Combatir^^** este turno. Sin embargo, después de usar la primera, tiene **^^Strike-Last^^** durante el resto del turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
