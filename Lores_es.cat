                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Agusanados de Nurgle Priest^^** amigo para entonar esta plegaria, elige como objetivo una unidad **^^Agusanados de Nurgle^^** amiga visible que no sea **^^Monster^^** totalmente a 12" o menos de quien entona la plegaria y, después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, ignora el primer punto de daño que se fuera a asignar al objetivo en cada fase. Si la tirada de cántico fue de 10+, puedes elegir otra unidad válida como segundo objetivo.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Don de enfermedad" id="9075-6fd4-b752-adfc" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="77b0-e81e-7ef8-d482" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="ddd4-ee65-07d0-f428" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="77b0-e81e-7ef8-d482" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Don de enfermedad" id="b513-30b2-8c37-7cdd" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Agusanados de Nurgle Priest^^** amigo para entonar esta plegaria; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, resta 1 a las tiradas de herida de los ataques de las unidades enemigas mientras estén en combate con quien entona la plegaria. Además, si la tirada de cántico fue de 10+, cada unidad enemiga en combate con quien entona la plegaria, excluidas las **^^Manifestations^^** y los elementos de escenografía, tiene la palabra clave **^^Diseased^^**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pestilencias predilectas" id="c6d5-3d5c-af97-d068" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d3c3-7cb7-2549-a66c" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="5c5d-a14a-33a9-9637" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="d3c3-7cb7-2549-a66c" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Pestilencias predilectas" id="d3cc-7d13-9877-5a3b" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Agusanados de Nurgle Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad enemiga visible a 18" o menos de quien entona la plegaria; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, resta 2 a las tiradas de carga del objetivo. Si la tirada de cántico fue de 10+, resta 1 al número de dados tirados al hacer tiradas de carga para el objetivo, hasta un mínimo de 1, en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de hechizos: Ciclo de Corrupción" id="4a33-ee57-b73f-c585" hidden="false" publicationId="9c71-86cb-e1d0-ec8d">
      <selectionEntries>
        <selectionEntry name="Costritis epidérmica" id="7e59-7236-2c72-8d82" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1b9d-fb89-ac2f-3e36" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="2de4-7ddf-a68f-bd77" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="2de4-7ddf-a68f-bd77" type="set" value="1">
