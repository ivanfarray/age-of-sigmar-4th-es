                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Señores del Reino Lumineth Wizard^^** amigo para lanzar este hechizo, elige como objetivo una unidad enemiga visible a 18" o menos de él que no haya sido elegida como objetivo de esta habilidad en esta ronda de batalla y, después, haz una tirada de lanzamiento de 2D6. Suma 1 al valor de lanzamiento de este hechizo por cada vez que un **^^Wizard^^** amigo lo haya lanzado con éxito este turno.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflige D3+X daño mortal al objetivo, donde X es el número de veces, hasta un máximo de 3, que un **^^Wizard^^** amigo haya lanzado con éxito este hechizo anteriormente en este turno.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fuerza invisible" id="904c-7c6a-4946-00c4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c61e-9375-16f6-595a" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="90e7-1435-e8be-d07f" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="c61e-9375-16f6-595a" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Fuerza invisible" id="f2dd-f10e-a39b-4e26" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Señores del Reino Lumineth Wizard^^** amigo para lanzar este hechizo; elige como objetivo una unidad enemiga visible a 18" o menos de él; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, el objetivo no puede usar habilidades **^^Correr^^**. Además, si esa unidad enemiga ya ha sido elegida como objetivo de esta habilidad en esta ronda de batalla, resta 1 a las tiradas de impacto de los ataques de combate del objetivo.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
