                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Si no hay un **Grieta demoníaca de fuego oscuro** amigo en el campo de batalla, elige un **^^Esclavos de la Oscuridad Wizard^^** amigo para lanzar este hechizo; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Coloca un **^^Grieta demoníaca de fuego oscuro^^** totalmente a 12" o menos del lanzador, visible para el lanzador y a más de 9" de todas las unidades enemigas.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Invocación^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
