                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Potenciar armas de nadirita" id="a532-2fb6-7eae-b011" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Cosechahuesos Ossiarch Wizard^^** amigo para lanzar este hechizo; elige como objetivo una unidad **^^Cosechahuesos Ossiarch^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Las armas de combate del objetivo tienen **Crítico (2 impactos)** hasta el inicio de tu siguiente turno. Si todas sus armas de combate que no sean **Compañero** tenían **Crítico (2 impactos)** cuando fue elegido como objetivo de esta habilidad, en su lugar, sus ataques de combate logran impactos críticos con tiradas de impacto sin modificar de 5+ hasta el inicio de tu siguiente turno.

Las unidades **^^Cosechahuesos Ossiarch^^** amigas pueden verse afectadas por esta habilidad varias veces.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Llamas inmoladoras" id="7fc2-08f6-c71e-742f" defaultAmount="0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="060f-a2d1-243b-8108" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="db85-7c2f-7c6b-1a5e" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
