    <selectionEntryGroup name="Ritos de delirio" id="d14c-ce62-ba51-e8de" hidden="false" publicationId="6281-1a88-8f4-946">
      <selectionEntries>
        <selectionEntry name="Excomunión" id="cb1a-d226-4f9a-155b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="aa89-19bb-1fb2-3a46" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="add6-01de-952c-8597" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="aa89-19bb-1fb2-3a46" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Excomunión" id="c515-4f1c-c283-d27c" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Cortes Devoradoras de Carne Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad enemiga visible a 18" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, ignora los modificadores positivos a las tiradas de salvación del objetivo. Además, si la tirada de cántico fue de 10+, no se pueden hacer tiradas de salvaguardia por el objetivo hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Convicción del osario" id="ec7b-d603-1ff9-4961" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0b21-d922-e92e-761b" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="b816-7fe3-3f2c-6cd2" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="0b21-d922-e92e-761b" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Convicción del osario" id="a24f-fea1-66c8-3df" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Cortes Devoradoras de Carne Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Cortes Devoradoras de Carne^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, el objetivo tiene **^^Ward (5+)^^**. Si la tirada de cántico fue de 10+, puedes elegir otra unidad válida como segundo objetivo.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El favor del Rey del Verano" id="fb2a-6063-372f-c671" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a4b9-1cd9-d22a-772f" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="f229-a6d8-e03a-5a47" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="a4b9-1cd9-d22a-772f" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="El favor del Rey del Verano" id="a51c-6b0e-b9d6-e4ab" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Cortes Devoradoras de Carne Priest^^** amigo para entonar esta plegaria, elige como objetivo un **^^Cortes Devoradoras de Carne Hero^^** amigo visible totalmente a 12" o menos de él y, después, haz una tirada de cántico de D6. No puedes elegir a **Nagash** como objetivo de esta plegaria.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Resuelve el efecto de &apos;Poderío célebre&apos; que se indica a continuación. Si la tirada de cántico fue de 10+, resuelve el efecto de &apos;Poderío célebre&apos; o de &apos;Tenacidad justa&apos; en su lugar.
***Poderío célebre:*** Suma 1 a la característica de Damage de las armas de combate del objetivo durante el resto del turno.
***Tenacidad justa:*** El objetivo puede usar 2 habilidades **^^fight^^** este turno. Sin embargo, después de usar la primera, tiene **^^Strike-last^^** durante el resto del turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de hechizos: Gran Waaagh!" id="e7a8-5ba7-6c72-52dc" hidden="false" publicationId="8b1b-f2c7-890e-2bbe">
      <selectionEntries>
        <selectionEntry name="Doz cabezaz como una" id="b451-8a8d-8a77-5d0b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d2fc-31fe-eb61-2d28" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="8afc-acd4-d366-41f2" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="d2fc-31fe-eb61-2d28" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Doz cabezaz como una" id="ef26-0a4b-aebe-b123" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Big Waaagh! Wizard^^** amigo para lanzar este hechizo; elige como objetivo una unidad **^^Big Waaagh! Infantry^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Si el objetivo es una unidad **^^Mandíbulas de Hierro^^**, hasta el inicio de tu siguiente turno, suma 3 a su puntuación de control mientras esté totalmente a 12" o menos de cualquier unidad **^^Chikoz Crueles^^** amiga.
Si el objetivo es una unidad **^^Chikoz Crueles^^**, hasta el inicio del siguiente turno, suma 2" a su característica de Move mientras esté totalmente a 12" o menos de cualquier unidad **^^Mandíbulas de Hierro^^** amiga.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de plegarias: Gran Waaagh!" id="a740-bab1-1295-299a" hidden="false" publicationId="8b1b-f2c7-890e-2bbe">
      <selectionEntries>
        <selectionEntry name="Ritmos de Waaagh! imparables" id="7493-b55c-08b7-15f3" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="aad1-ee1e-04f0-d9e0" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="bf87-2ed5-3389-d690" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="aad1-ee1e-04f0-d9e0" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Ritmos de Waaagh! imparables" id="5f04-dbbf-46b5-d948" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Big Waaagh! Priest^^** amigo para entonar esta plegaria, elige como objetivo una unidad **^^Big Waaagh! Infantry^^** amiga visible que no sea **^^Hero^^**, esté en combate y esté totalmente a 12" o menos de él y, después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">El objetivo puede usar 2 habilidades **^^Combatir^^** este turno. Sin embargo, después de usar la primera, tiene **^^Strike-last^^** durante el resto del turno. Si la tirada de cántico fue de 10+, puedes elegir otra unidad válida como segundo objetivo.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de manifestaciones: Gran Waaagh!" id="5ba8-6290-d9f6-b4ec" hidden="false" publicationId="8b1b-f2c7-890e-2bbe">
      <entryLinks>
        <entryLink name="Pie de Gork" id="ed28-6582-482f-ed2c" hidden="false" import="true" targetId="6cc6-3227-bf8d-1a1d" type="selectionEntry">
