      <selectionEntries>
        <selectionEntry name="Insistencia ardiente" id="5d85-847f-5ac4-2601" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="49d2-9fed-2e2d-c2aa" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Insistencia ardiente" id="b12a-ebfb-398c-0d7d" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Control</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Suma 3 a la puntuación de control del objetivo hasta el inicio de tu siguiente turno. Si la tirada de cántico fue de 8+, suma 10 a su puntuación de control hasta el inicio de tu siguiente turno en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
