          <profiles>
            <profile name="Llamada de la arena" id="c361-cba7-ac7e-de66" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Champions of the Arena Priest^^** amigo para entonar esta plegaria; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Durante el resto del turno, suma 1 a las tiradas de correr de las unidades **^^Champions of the Arena^^** amigas mientras estén totalmente a 12" o menos de quien entona la plegaria. Además, si la tirada de cántico fue de 6+, durante el resto del turno, suma 1 a las tiradas de carga de las unidades **^^Champions of the Arena^^** amigas mientras estén totalmente a 12" o menos de quien entona la plegaria.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Escudo de sangre" id="0299-597c-47a1-32e7" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="842d-c4d4-a0be-bbc6" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="c6b6-f95d-d4c6-168b" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
