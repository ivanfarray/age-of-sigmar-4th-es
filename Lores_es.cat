                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" id="dfdf-429e-92b5-82d2" hidden="false" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" id="3cca-7862-d93f-aa7" hidden="false" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" id="59-84b3-f3e4-babb" hidden="false" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Cosechahuesos Ossiarch Wizard^^** amigo para lanzar este hechizo; elige como objetivo una unidad enemiga visible a 12" o menos de él; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" id="8b1b-90b6-4ae-f92" hidden="false" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, resta 1 a las tiradas de impacto de los ataques del objetivo y resta 1 a sus tiradas de salvación.</characteristic>
                <characteristic name="Keywords" id="65e0-be4c-ac0b-6473" hidden="false" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Potenciar armas de nadirita" id="66fb-b286-fea5-6ded" defaultAmount="0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e7c9-7192-8827-25c7" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4c27-bbe9-ee2f-70a3" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
