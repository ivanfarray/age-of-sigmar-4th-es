              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Mandíbulas de Hierro Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Mandíbulas de Hierro^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Aplica **Heal (D6)** al objetivo. Si la tirada de cántico fue de 8+, aplica **Heal (D3+3)** al objetivo en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ritmo de a por elloz" id="2929-c9d5-1e9e-1d3e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c056-f6cb-e7c8-564c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4787-d162-d28e-dbde" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
