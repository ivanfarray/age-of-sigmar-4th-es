              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Invocar: Bandada siniestra voraz" id="2def-3027-a439-1734" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Si no hay un **Bandada siniestra voraz** amigo en el campo de batalla, elige un **^^Beasts of Chaos Wizard^^** amigo para lanzar este hechizo; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Coloca un **Bandada siniestra voraz** totalmente a 18" o menos del lanzador y a más de 9" de todas las unidades enemigas. Un **Bandada siniestra voraz** tiene 3 partes; cada una debe colocarse a 1" o menos de al menos 1 de las otras partes.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Invocación^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Invocar: Toro de fuego salvaje" id="4cd0-194a-6c6d-bf72" hidden="false" import="true" type="upgrade">
