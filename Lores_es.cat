        <selectionEntry name="Paso brioso" id="16b0-44a2-8e10-7dcb" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a356-8cb0-6f7b-9cfd" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Paso brioso" id="d0d1-abb1-6be2-9405" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Priest^^** amigo para entonar esta plegaria; elige como objetivo un elemento de escenografía visible a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, suma 1 a las tiradas de carga de las unidades amigas mientras estén a 3" o menos del objetivo. Si la tirada de cántico fue de 6+, suma 2 a las tiradas de carga de esas unidades en lugar de 1.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Delirio arraigado" id="076a-47b0-a4fa-c6b6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="36d5-46bc-5be0-9928" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Delirio arraigado" id="12d4-825c-30a6-65b3" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Control</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad enemiga visible a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, el objetivo tiene **^^Strike-last^^**. Además, si la tirada de cántico fue de 6+, resta 1 a las tiradas de herida de sus ataques hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Renacimiento de jade" id="9097-17c0-3f80-772c" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a165-4119-83ca-f9b6" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Renacimiento de jade" id="2437-7c0b-239a-3971" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Rallying</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Priest^^** amigo para entonar esta plegaria, elige como objetivo una unidad amiga visible que no esté en combate y esté totalmente a 12" o menos de él y, después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Devuelve a la unidad objetivo miniaturas abatidas cuya característica de Salud combinada sea de hasta 4. Si la tirada de cántico fue de 8+, devuelve al objetivo miniaturas abatidas cuya característica de Salud combinada sea de hasta 8 en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Floración regeneradora" id="bfdb-d7e3-3767-b4d9" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="47cc-b878-8aba-b1eb" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Floración regeneradora" id="d058-1ad4-ee9a-0a4c" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Priest^^** amigo para entonar esta plegaria; elige como objetivo un elemento de escenografía visible a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Aplica **Heal (D3)** a cada unidad (amiga y enemiga) a 3" o menos del objetivo. Si la tirada de cántico fue de 8+, aplica **Heal (3)** a cada unidad (amiga y enemiga) a 3" o menos del objetivo en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Las tierras salvajes enfurecidas" id="d5c8-5e36-c7c1-0dd8" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="587b-b2af-b8b9-de0b" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Las tierras salvajes enfurecidas" id="bab2-2dbf-a871-97ac" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad enemiga visible a 18" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, cada vez que tu oponente declare una orden para el objetivo, salvo que gaste 1 punto de orden adicional para usarla, la orden no tiene efecto, sigue considerándose usada y los puntos de orden gastados para usarla se pierden igualmente. Si la tirada de cántico fue de 10+, el objetivo no puede usar órdenes hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Calma soporífera" id="5ee0-a9a9-3a61-4e66" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="38dc-a8fb-548a-e567" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Calma soporífera" id="9bdd-71ab-4f78-7955" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad enemiga visible a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, los ataques del objetivo no pueden lograr impactos críticos (trátalos como impactos normales). Además, si la tirada de cántico fue de 9+, los ataques de combate que tengan como objetivo esa unidad enemiga logran impactos críticos con tiradas de impacto sin modificar de 5+.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de la virulencia" id="242a-210c-e7cd-fae0" hidden="false" publicationId="9c71-86cb-e1d0-ec8d">
      <selectionEntries>
        <selectionEntry name="Hinchado de enfermedad" id="a034-d984-8d81-6e20" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ca7b-c4db-f7d4-84a6" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="259c-08e3-554d-a28e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
