        </selectionEntry>
        <selectionEntry name="Terrores del hielo antiguo" id="3554-8b55-77cb-23d5" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cef3-ee31-c88d-9911" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="5c5d-0e72-52cb-9a94" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
