          <profiles>
            <profile name="Paso sombrío" id="65a9-c142-1d30-89da" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
