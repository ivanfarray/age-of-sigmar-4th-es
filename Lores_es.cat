    <selectionEntryGroup name="Saber de la humedad pegajosa" id="7f10-0d15-3224-2e7c" hidden="false" publicationId="a395-7bc4-71eb-46df">
      <selectionEntries>
        <selectionEntry name="La mano de Gork" id="281d-17a3-060f-c8af" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="893f-c0e5-d0fa-17a1" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="eeb8-cd7a-d350-f7c7" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="893f-c0e5-d0fa-17a1" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="La mano de Gork" id="f229-4219-194e-a66" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Gitz del Rencor Crepuscular Wizard^^** amigo para lanzar este hechizo; elige como objetivo una unidad amiga visible totalmente a 12" o menos de él que no esté en combate; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Retira el objetivo del campo de batalla y vuelve a colocarlo en el campo de batalla totalmente a 24" o menos del lanzador y a más de 9" de todas las unidades enemigas.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fauces de esporas" id="3fd0-934d-3b20-432a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e855-5cbb-dfbd-3ee3" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="94be-3a5c-894c-2427" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="e855-5cbb-dfbd-3ee3" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Fauces de esporas" id="f564-e7df-919f-cfdd" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Gitz del Rencor Crepuscular Wizard^^** amigo para lanzar este hechizo, elige como objetivos hasta 3 unidades enemigas visibles a 12" o menos de él y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Tira un D3 por cada objetivo. Con un 2+, inflige al objetivo una cantidad de daño mortal igual al resultado.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Malos presagios" id="5b7d-8746-4c93-7587" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5282-8e3d-c4e4-5a3b" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="772e-37e3-72cd-498c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="5282-8e3d-c4e4-5a3b" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Malos presagios" id="630-a4bd-6736-6558" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Gitz del Rencor Crepuscular Wizard^^** amigo para lanzar este hechizo; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Tira un dado. Con un 1-2, no ocurre nada. Con un 3-5, la cara de la Bad Moon pasa a la siguiente. Con un 6, elige una nueva cara de la Bad Moon para esta ronda de batalla.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
