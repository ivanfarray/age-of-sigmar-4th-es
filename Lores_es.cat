          <profiles>
            <profile name="Runas de aborrecimiento" id="5b20-39ce-5c8a-6e48" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Filos de Khorne Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Filos de Khorne^^** amiga totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, el objetivo tiene **^^Ward (3+)^^** contra el daño infligido por habilidades **^^Hechizo^^**, habilidades **^^Prayer^^** y habilidades usadas por **^^Manifestations^^** (incluidas las habilidades **^^Combatir^^**). Si la tirada de cántico fue de 8+, puedes elegir otra unidad válida como segundo objetivo.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Carne sanguinolenta" id="02f8-8bd2-bd33-bc48" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="676a-9268-6f2a-8eb0" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
