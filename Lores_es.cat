              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Filos de Khorne Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Filos de Khorne^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, ignora el primer punto de daño asignado al objetivo en cada fase. Si la tirada de cántico fue de 8+, puedes elegir otra unidad válida como segundo objetivo.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Don de apoplejía" id="6853-70c6-9cd9-6971" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d609-d801-f2b8-1fe9" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="5c44-e684-7a4e-649e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
