                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Hijas de Khaine Priest^^** amigo para entonar esta plegaria, elige como objetivo una unidad **^^Hijas de Khaine Aelf Infantry^^** amiga visible totalmente a 12" o menos de él que no haya sido elegida como objetivo de esta plegaria este turno y, después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">El objetivo puede moverse hasta 6". Puede atravesar los alcances de combate de las unidades enemigas, pero no puede terminar ese movimiento en combate. Si la tirada de cántico fue de 8+, puedes elegir otra unidad válida como segundo objetivo.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
