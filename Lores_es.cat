          <profiles>
            <profile name="Canción de venganza" id="e64b-c4d6-0f67-e520" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Soulpod Guardians Priest^^** amigo para entonar esta plegaria, elige como objetivo un **^^Soulpod Guardians^^** amigo visible que esté totalmente a 12" o menos de él y fuera de combate, o que esté totalmente a 12" o menos de tu **Soulpod Grove**, y, después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Si la tirada de cántico fue de 8+, puedes elegir otra unidad válida como segundo objetivo. El objetivo o cada uno de los objetivos puede moverse hasta 5" y puede terminar ese movimiento en combate.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
