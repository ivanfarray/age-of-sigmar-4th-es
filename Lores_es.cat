      </modifiers>
      <selectionEntries>
        <selectionEntry name="Tocar fondo" id="9edb-a935-0862-990b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="66a5-3b77-6e3c-0103" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="903b-85f2-2323-237c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="66a5-3b77-6e3c-0103" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Tocar fondo" id="f182-c3ff-e45b-7576" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Hijos de Behemat Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Hijos de Behemat^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Si la tirada de cántico fue de 6+, puedes elegir otra unidad válida como segundo objetivo. Hasta el inicio de tu siguiente turno:
• Ignora los efectos de la habilidad &apos;Daños de batalla&apos; sobre cada objetivo.
• Cada objetivo tiene **^^Ward (6+)^^**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Los dedos terribles" id="82b8-6a63-e254-f7d3" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ac4d-7f54-4a16-cd86" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="003b-7572-0a78-579a" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="ac4d-7f54-4a16-cd86" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Los dedos terribles" id="ede1-eb32-af01-d1c0" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Hijos de Behemat Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad enemiga visible a 18" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Tira un dado por cada miniatura de la unidad objetivo. Si la tirada de cántico fue de 8+, suma 1 a la tirada. Por cada 6+, inflige 1 daño mortal al objetivo. Después, si esta habilidad abate alguna miniatura enemiga, reduce a la mitad la característica de Move del objetivo hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tectónica vocal" id="e241-a12c-439e-d140" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7238-7101-ca18-1bcc" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="355c-070b-7017-b26e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="7238-7101-ca18-1bcc" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Tectónica vocal" id="8316-9ff7-5e3d-278f" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Hijos de Behemat Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad enemiga visible a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Si la tirada de cántico fue de 10+, puedes elegir otra unidad válida como segundo objetivo. Hasta el inicio de tu siguiente turno, cada objetivo tiene **^^Strike-last^^**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
