          </constraints>
          <modifiers>
            <modifier field="787f-90eb-db80-87f2" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Invocar: Pie de Gork" id="6bfb-eaca-dca6-259b" hidden="false" publicationId="8b1b-f2c7-890e-2bbe" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Si no hay un **Pie de Gork** amigo en el campo de batalla, elige un **^^Chikoz Crueles Wizard^^** amigo para lanzar este hechizo; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Coloca un **Pie de Gork** totalmente a 12" o menos del lanzador, visible para él y a más de 9" de todas las unidades enemigas. Un **Pie de Gork** tiene 2 partes que deben colocarse a 9" o menos entre sí.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Invocación^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de plegarias: Los Duardin Ascendentes" id="53aa-2e28-4daa-9e3e" hidden="false" publicationId="e47d-cde6-bbd2-9db9">
      <selectionEntries>
        <selectionEntry name="Juramento de restauración" id="fbc3-eeaf-d98d-53b0" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bb48-9eb8-c372-e313" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="0242-8301-7e62-c936" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="bb48-9eb8-c372-e313" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Juramento de restauración" id="e850-96a2-4b32-ff02" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143"/>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3"/>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">
Pick a friendly **^^Duardin Ascendant Priest^^** to chant this prayer, pick a visible objective within 18&quot; of them that is coned by 2 or more friendly **unified** units to be the target, then make a chanting roll of D6.                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="d1f3-921c-b403-1106" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="lessThan" value="1"/>
                        <condition childId="376a-6b97-8699-dd59" field="selections" scope="ancestor" shared="true" type="instanceOf" value="1"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, las unidades **^^Duardin Ascendant^^** amigas tienen **^^Ward (6+)^^** mientras tengan alguna miniatura disputando el objetivo. Si la tirada de cántico fue de 7+, las miniaturas **^^Duardin Ascendant^^** amigas tienen **^^Ward (5+)^^** mientras tengan alguna miniatura disputando el objetivo en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espíritu del Enano Blanco" id="3190-b938-acdb-f988" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d2c2-9370-e632-96e8" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="d3e6-ee94-c3ea-3c70" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="d2c2-9370-e632-96e8" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Espíritu del Enano Blanco" id="c992-4e49-7af2-4bf9" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143"/>
