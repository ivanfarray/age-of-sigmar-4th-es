          <modifiers>
            <modifier field="1f16-f2a8-7335-34b7" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Bandada asesina" id="df09-e608-83fd-60de" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Ruination Brotherhood Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad enemiga visible a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Tira un dado por cada miniatura de la unidad objetivo. Por cada 5+, inflige 1 daño mortal a la unidad objetivo. Si la tirada de cántico fue de 10+, inflige 1 daño mortal a la unidad objetivo por cada 4+ en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vuelo del cuervo" id="5683-619f-250b-6f39" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="028c-865f-08af-81a3" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="7130-824f-7bd1-e710" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
