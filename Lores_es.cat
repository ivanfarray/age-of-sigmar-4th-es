            <modifier field="cef1-1d81-61d8-d2d9" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Choque de trueno" id="614c-a95c-49a9-a0bc" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
