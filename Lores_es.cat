          <profiles>
            <profile name="Mucosidad espumosa" id="a190-77f8-671f-826b" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Agusanados de Nurgle Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Agusanados de Nurgle^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, la habilidad de arma **Carga (+1 Daño)** no tiene efecto en los ataques de combate que tengan como objetivo al objetivo. Si la tirada de cántico fue de 6+, las habilidades de arma distintas de **Compañero** no tienen efecto en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Oleada infecciosa" id="cc91-7cba-82e7-105b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c521-9f5e-86b0-b571" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
