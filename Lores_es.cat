          </modifiers>
          <profiles>
            <profile name="Mutación latente" id="f836-f59b-bbfc-5e4e" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Control</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Mutated Menagerie Wizard^^** amigo para lanzar este hechizo, elige como objetivos hasta 3 unidades **^^Mutated Menagerie^^** amigas visibles totalmente a 13" o menos de él que estén afectadas por la habilidad &apos;¡Más-más mutación!&apos; y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Por cada punto de daño asignado al objetivo al final de este turno por la habilidad &apos;¡Más-más mutación!&apos;, suma 1 a su puntuación de control hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
