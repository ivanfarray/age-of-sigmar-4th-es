            <constraint id="1f16-f2a8-7335-34b7" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="84c8-873d-b524-00db" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
