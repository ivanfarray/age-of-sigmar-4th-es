            </modifier>
          </modifiers>
          <profiles>
            <profile name="Resplandor del Santuario Lunático" id="b001-ea9f-eba7-d549" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Rallying</attribute>
