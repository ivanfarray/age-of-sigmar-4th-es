        <selectionEntry name="Invocar: Luna malévola" id="0233-6e15-c200-c0f3" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c600-b844-66e8-1875" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="1a79-5f46-b366-3ca5" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="c600-b844-66e8-1875" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Invocar: Luna malévola" id="7f2f-4ab7-76a4-1d06" hidden="false" publicationId="a395-7bc4-71eb-46df" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Si no hay un **Luna malévola** amigo en el campo de batalla, elige un **^^Gitz del Rencor Crepuscular Wizard^^** amigo para lanzar este hechizo; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Coloca un **Luna malévola** totalmente a 12" o menos del lanzador, visible para el lanzador y a más de 9" de todas las unidades enemigas.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Invocación^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
