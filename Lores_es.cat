          <profiles>
            <profile name="Susto luminoso" id="0583-216a-7f53-0693" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Gitz del Rencor Crepuscular Wizard^^** amigo para lanzar este hechizo, elige como objetivos hasta 3 unidades **^^Gitz del Rencor Crepuscular^^** amigas visibles totalmente a 12" o menos de él y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Cada objetivo puede usar inmediatamente una habilidad **^^Retirarse^^** como si fuera tu fase de movimiento. Esas habilidades **^^Retirarse^^** no infligen daño mortal a los objetivos.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Mirada de Karabrillante" id="38be-0d0c-bff4-d65e" hidden="false" import="true" type="upgrade">
