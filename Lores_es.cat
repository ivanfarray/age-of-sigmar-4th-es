      <selectionEntries>
        <selectionEntry name="Transfusión de esencia" id="1bf7-b799-8a3e-c3aa" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1464-b2db-1d0c-5a48" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="9147-7441-ae5c-509f" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="9147-7441-ae5c-509f" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Transfusión de esencia" id="e11e-e859-e3e5-8504" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
                <attribute name="Type" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Court of the Godlings Wizard^^** amigo para lanzar este hechizo, elige como donante un **Twin** amigo visible, elige como objetivo otro **^^Twin^^** amigo visible y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Asigna cualquier número de puntos de daño al donante (no se pueden hacer tiradas de salvaguardia por esos puntos de daño). Después, aplica **Curar (X)** al objetivo, donde **X** es el doble del número de puntos de daño asignados al donante por el uso de esta habilidad.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Susurros sibilantes" id="0ebb-8ae1-d037-9e99" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4e81-8461-0c17-c26c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="841b-ee23-1a4c-2787" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="841b-ee23-1a4c-2787" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Susurros sibilantes" id="a812-2174-abf4-99b5" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
                <attribute name="Type" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Court of the Godlings Wizard^^** amigo para lanzar este hechizo; elige como objetivo una unidad enemiga visible a 12" o menos de él; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, mientras un **^^Twin^^** amigo sea visible para el objetivo, reduce a la mitad la característica de Move del objetivo. Además, mientras 2 **^^Twins^^** amigos sean visibles para el objetivo, tu oponente debe tirar 1 dado menos, hasta un mínimo de 1, al hacer tiradas de carga para él.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Furor extático" id="bd62-98f7-e8e6-8d23" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2f1e-b352-0f09-f5a3" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="1915-ad4a-6c5c-5c53" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
