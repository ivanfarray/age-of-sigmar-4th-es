                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Si no hay un **Rugidor de Gork** amigo en el campo de batalla, elige un **^^Chikoz Crueles Wizard^^** amigo para lanzar este hechizo; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Coloca un **Rugidor de Gork** totalmente a 12" o menos del lanzador, visible para el lanzador y a más de 9" de todas las unidades enemigas.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Invocación^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
