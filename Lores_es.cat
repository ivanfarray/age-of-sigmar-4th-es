            <profile name="Vientos de jade" id="fb60-7cbe-8014-2941" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Soulpod Guardians Wizard^^** amigo para lanzar este hechizo, elige 1 de las siguientes **^^Manifestations^^** amigas que no esté en el campo de batalla y, después, haz una tirada de lanzamiento de 2D6.
• **Sierpe del claro**
• **Colmena de enjambre de duendes**
• **Raíz de cráneos vengativa**</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Si has elegido un **Sierpe del claro** o **Raíz de cráneos vengativa**, colócalo totalmente a 12" o menos del lanzador, visible para él y a más de 9" de todas las unidades enemigas. Si has elegido un **Colmena de enjambre de duendes**, colócalo totalmente a 12" o menos del lanzador y visible para él.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Invocación^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
