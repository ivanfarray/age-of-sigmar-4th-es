                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Discípulos de Tzeentch Wizard^^** amigo para lanzar este hechizo; después, puedes elegir como objetivo una unidad **^^Discípulos de Tzeentch^^** amiga que no sea **^^Monster^^** totalmente a 12" o menos del lanzador. Después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Coloca el objetivo en reserva **enmascarado por ilusión**. Después, puedes elegir una unidad amiga que esté **enmascarada por ilusión** y colocarla totalmente a 12" o menos del lanzador o de un **Fragmento argénteo** amigo y a más de 9" de todas las unidades enemigas.
**Nota del diseñador**: *Ambas partes del efecto son opcionales; puedes realizar cualquiera de ellas o ambas.*</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Transformado en engendro" id="88dc-534c-630b-8e6b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6cf1-205f-070a-e335" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="267d-669d-a188-86d5" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
