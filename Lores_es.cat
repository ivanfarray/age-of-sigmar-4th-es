          <profiles>
            <profile name="Furia de Vulcatrix" id="2520-66ce-f625-a48d" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
