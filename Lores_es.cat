          </modifiers>
          <profiles>
            <profile name="Furia de Vulcatrix" id="c658-f8c4-2b8b-80cf" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Matadores Ígneos Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Matadores Ígneos^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Suma 1 a las tiradas de impacto de los ataques de combate del objetivo, incluidos los efectuados con armas **Compañero**, hasta el inicio de tu siguiente turno.
Además, si la tirada de cántico fue de 8+, suma 1 a la característica de Attacks de sus armas de combate, incluidas las armas **Compañero**, hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ícor de la Ur-Salamandra" id="1bbf-95dc-b7a4-2eab" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="626f-9f69-ae17-275e" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="971e-ae2d-1e48-2bfa" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="626f-9f69-ae17-275e" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Ícor de la Ur-Salamandra" id="55c3-be96-fd2d-d801" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Matadores Ígneos Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Matadores Ígneos ^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Si la tirada de cántico fue de 6+, puedes elegir otra unidad válida como segundo objetivo. Hasta el inicio de tu siguiente turno:
• Si el objetivo es un **^^Magmadroth^^**, cada vez que su habilidad &apos;Sangre volcánica&apos; fuera a infligir 1 daño mortal a una unidad enemiga, inflige D3 daño mortal en su lugar.
• Si el objetivo es una unidad que no sea **^^Magmadroth^^**, cada vez que hagas una tirada de salvación sin modificar de 1 para un ataque de combate que tenga como objetivo esa unidad, inflige 1 daño mortal a la unidad atacante después de resolver la habilidad **^^Combatir^^**.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ímpetu ardiente" id="bc64-dd1d-5cf3-05e2" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3cf1-42f7-d73b-2da8" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="dcd3-3008-c601-9fdc" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="3cf1-42f7-d73b-2da8" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Ímpetu ardiente" id="53d6-9419-fff1-4e76" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">5</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Matadores Ígneos Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Matadores Ígneos^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Si la tirada de cántico fue de 10+, puedes elegir otra unidad válida como segundo objetivo. Cada objetivo puede usar la habilidad &apos;Movimiento normal&apos; o &apos;Retirarse&apos; como si fuera tu fase de movimiento.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
