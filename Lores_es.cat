            <profile name="Invocar: Infernoth fundido" id="777c-9276-8de9-7164" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Special</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">6</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Si no hay un **Infernoth fundido** amigo en el campo de batalla, elige un **^^Matadores Ígneos Priest^^** amigo para entonar esta plegaria; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Coloca un **Infernoth fundido** totalmente a 12" o menos de quien entona la plegaria, visible para quien entona la plegaria y a más de 9" de todas las unidades enemigas.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Invocación^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de plegarias: Guardianes de Droths de Lofnir" id="5e46-2959-ea2a-fb4d" hidden="false" publicationId="0578-e89b-7163-86c5">
      <selectionEntries>
        <selectionEntry name="Aliento de Vulcatrix" id="0094-4241-2950-3a76" hidden="false" import="true" type="upgrade">
