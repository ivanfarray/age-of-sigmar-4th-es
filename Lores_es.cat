          <profiles>
            <profile name="Velocidad del tipejo" id="221e-54a2-3619-5748" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
