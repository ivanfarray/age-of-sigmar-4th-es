          <profiles>
            <profile name="Ímpetu divino" id="c67b-eb8b-269a-f71d" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Champions of the Arena Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Champions of the Arena^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Si la tirada de cántico fue de 6+, puedes elegir otra unidad válida como segundo objetivo. Por cada objetivo:
• Si no está en combate, puede moverse D6". No puede terminar ese movimiento en combate.
• Si está en combate, puede hacer un movimiento de aproximación.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Llamada de la arena" id="3b4d-619e-d99a-e484" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8444-ed30-a45c-7706" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="ce69-92bd-f873-b49d" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
