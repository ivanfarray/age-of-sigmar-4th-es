          <modifiers>
            <modifier field="b19f-5db3-29f7-3edf" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Plegaria de ceniza" id="9e1e-fc0-553-ccab" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Matadores Ígneos Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Matadores Ígneos^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Resta 1 a las tiradas de herida de los ataques que tengan como objetivo esa unidad amiga hasta el inicio de tu siguiente turno.
Si la tirada de cántico fue de 8+, resta también 1 a la característica de Rend de los ataques que tengan como objetivo esa unidad amiga hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Plegaria de la furia de Grimnir" id="e204-0c0b-2395-dd81" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e8ff-14b2-f618-0381" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="a54f-0dc5-5745-69fd" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="e8ff-14b2-f618-0381" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Plegaria de la furia de Grimnir" id="9f97-127b-8728-2c9a" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Matadores Ígneos Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Matadores Ígneos Infantry Hero^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">El objetivo puede usar 2 habilidades **^^Combatir^^** este turno. Sin embargo, después de usar la primera, tiene **^^Strike-last^^** durante el resto del turno.
Si la tirada de cántico fue de 8+, suma también 1 a las tiradas de herida de sus ataques de combate durante el resto del turno.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ira de Vulcatrix" id="df73-605f-1bd1-620d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="efa7-35aa-3256-547a" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="f7a1-ddb6-e8fe-d0e4" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="efa7-35aa-3256-547a" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Ira de Vulcatrix" id="cccf-b44c-6ff6-3e0" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Matadores Ígneos Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Magmadroth^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Durante el resto del turno, la habilidad &apos;Daños de batalla&apos; no tiene efecto sobre el objetivo y suma 1 a la característica de Attacks de sus armas **Compañero**.
Si la tirada de cántico fue de 8+, suma 1 a la característica de Attacks de sus armas **Compañero** por cada 4 puntos de daño que tenga el objetivo en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
