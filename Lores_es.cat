            <constraint id="7404-b577-5f26-7e31" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="6acc-15a7-89aa-ceeb" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
