          </modifiers>
          <profiles>
            <profile name="Invocar: Estrado Arcano" id="2b3b-682-5bae-a94a" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Si no hay un **Estrado Arcano** amigo en el campo de batalla, elige un **^^Forjados en la Tormenta Wizard^^** amigo para lanzar este hechizo, elige como objetivo un Stormcast **^^Eternals Infantry Hero^^** amigo que no tenga **^^Volar^^** y esté totalmente a 12" o menos de él y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Coloca un **Estrado Arcano** a 1/2" o menos del objetivo, visible para el lanzador y fuera de combate. Después, retira el objetivo del campo de batalla y colócalo sobre la plataforma de ese **Estrado Arcano**.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Invocación^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
