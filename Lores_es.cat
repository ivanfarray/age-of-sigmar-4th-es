        <selectionEntry name="Rompeespinillas" id="4cb4-d093-a9be-a74e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ec7d-67f3-4f89-7eea" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="6a10-c796-0b02-dfe3" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
