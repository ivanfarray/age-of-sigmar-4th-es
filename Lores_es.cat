          </modifiers>
          <profiles>
            <profile name="Carne sanguinolenta" id="bf6f-cb72-b7e8-4598" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
