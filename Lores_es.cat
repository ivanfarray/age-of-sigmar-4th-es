                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">3</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Ciudades de Sigmar Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Ciudades de Sigmar^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Aplica **Heal (D3)** al objetivo y a quien entona la plegaria. Si la tirada de cántico fue de 7+, aplica **Heal (D3)** a cada unidad **^^Ciudades de Sigmar^^** amiga visible totalmente a 12" o menos de quien entona la plegaria en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Juicio de los pecadores" id="b3d7-65f5-c04d-02af" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8b16-efca-bdd8-49bc" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
