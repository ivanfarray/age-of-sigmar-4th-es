    <selectionEntryGroup name="Saber de hechizos: Los Jardineros de Nurgle" id="2f4b-b1ad-bb4e-16ed" hidden="false" publicationId="9c71-86cb-e1d0-ec8d">
      <selectionEntries>
        <selectionEntry name="Plagas munificentes" id="1f86-5be8-ae74-d09d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="122d-6227-1eb9-144b" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="733f-2014-c3e0-2b49" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="733f-2014-c3e0-2b49" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Plagas munificentes" id="2541-76c8-f713-3af6" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Gardeners of Nurgle Wizard^^** amigo para lanzar este hechizo; elige como objetivo una unidad enemiga visible a 18" o menos de él; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, suma 1 a la cantidad de daño mortal infligido al objetivo por la habilidad &apos;Savia putrescente&apos;.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Lluvia de inmundicia" id="7e61-840a-79c7-af60" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="be80-4806-5b78-5030" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="7d92-66bf-fe2a-64d8" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
          </constraints>
          <modifiers>
            <modifier field="7d92-66bf-fe2a-64d8" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Lluvia de inmundicia" id="e20a-a289-51e5-eb20" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Gardeners of Nurgle Wizard^^** amigo para lanzar este hechizo; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, las unidades **^^Gardeners of Nurgle^^** amigas que estén totalmente a 12" o menos de un **Fauces retorcidas feculentas** amigo no son visibles para las unidades a más de 9" de ellas.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dosel de virulencia" id="281b-f643-0794-8ce6" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bd71-c92a-bda6-3c6f" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
