    <selectionEntryGroup name="Plegarias de las Huestes de la Tormenta" id="fd49-a817-9a05-0fed" hidden="false" publicationId="43cd-e9ef-5d4d-87c4">
      <selectionEntries>
        <selectionEntry name="Bendecir armas" id="5e2c-6f44-b2bb-2056" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3ff9-edef-4490-5863" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="32f8-f970-efe2-6640" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="3ff9-edef-4490-5863" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Bendecir armas" id="a212-6778-13b7-6956" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">6</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Forjados en la Tormenta Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Forjados en la Tormenta Infantry^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Suma 1 a la característica de Attacks de las armas de combate del objetivo hasta el inicio de tu siguiente turno. Si la tirada de cántico fue de 12+, esta habilidad afecta a todas las unidades **^^Forjados en la Tormenta^^** amigas visibles totalmente a 12" o menos de quien entona la plegaria.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Translocación" id="3957-710b-63c7-a195" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c330-a123-9bb4-acff" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="c638-b49a-358d-b91c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="c330-a123-9bb4-acff" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Translocación" id="7a2f-7e4f-f4dd-ad5a" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Movement</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Forjados en la Tormenta Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Forjados en la Tormenta^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Retira el objetivo del campo de batalla y vuelve a colocarlo en el campo de batalla a más de 9" de todas las unidades enemigas. Además, si la tirada de cántico fue de 8+, resta 1 a las tiradas de impacto de los ataques que tengan como objetivo esa unidad durante el resto de la ronda de batalla.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tormenta sanadora" id="890a-eb2e-4b2b-3b9b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5973-71d6-2f9f-43d2" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="7a01-62f4-c96c-44f9" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="5973-71d6-2f9f-43d2" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Tormenta sanadora" id="fd50-2bf5-d357-963b" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Forjados en la Tormenta Priest^^** amigo para entonar esta plegaria; elige como objetivo una unidad **^^Forjados en la Tormenta^^** amiga visible totalmente a 12" o menos de él; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Aplica Heal (D3) al objetivo. Si la tirada de cántico fue de 8+, aplica **Heal (D3)** a cada unidad **^^Forjados en la Tormenta^^** amiga visible totalmente a 12" o menos de quien entona la plegaria en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de la tormenta" id="b054-bd72-a5bf-1319" hidden="false" publicationId="43cd-e9ef-5d4d-87c4">
      <selectionEntries>
        <selectionEntry name="Explosión de relámpagos" id="dbe3-971c-d2ac-e4c8" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="70b1-b557-c998-ae95" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="9f3c-f5d6-59ea-6328" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="70b1-b557-c998-ae95" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Explosión de relámpagos" id="b918-ea95-5c6e-1dd5" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Forjados en la Tormenta Wizard^^** amigo para lanzar este hechizo; después, elige como objetivo la unidad enemiga visible más cercana a él que no haya sido elegida como objetivo de esta habilidad este turno. Si 2 o más unidades enemigas visibles están empatadas como las más cercanas, puedes elegir cuál es el objetivo. Después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflige D3 de daño mortal al objetivo.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Lluvia de estrellas" id="87d1-0549-f5ed-810f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="984c-be0b-c850-b8c9" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="367c-ad8b-9a24-c01e" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="984c-be0b-c850-b8c9" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Lluvia de estrellas" id="c012-a1f9-fc99-fc24" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Movement</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Forjados en la Tormenta Wizard^^** amigo para lanzar este hechizo, elige como objetivo una unidad **^^Infantry^^** o **^^Cavalry^^** enemiga visible a 18" o menos de él y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, resta 1 al número de dados tirados al hacer tiradas de carga para el objetivo, hasta un mínimo de 1.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Choque de trueno" id="0493-27db-365f-1927" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cef1-1d81-61d8-d2d9" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="4da0-fac9-63ab-dd9f" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
