          <profiles>
            <profile name="Reducir a cenizas" id="773a-5814-cbcf-55c8" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">8</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Ziggurat Stampede Wizard^^** amigo para lanzar este hechizo; elige como objetivo un elemento de escenografía a 18" o menos de él; después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Si el objetivo tiene una característica de Salud, inflígele 2D3 daño mortal. Después, si el objetivo no fue destruido o no tiene una característica de Salud:
• El objetivo obtiene la habilidad de escenografía &apos;Ocultación&apos; durante el resto de la batalla.
• Si el objetivo es **^^Faction Terrain^^**, hasta el inicio de tu siguiente turno, las habilidades del pergamino de ese elemento de escenografía no tienen efecto.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de plegarias: Pisoteadores del Rey Brodd" id="2c32-ac4f-c099-9603" hidden="false" publicationId="0578-e89b-7163-86c5">
      <selectionEntries>
        <selectionEntry name="Grandes expectativas" id="a229-1fbd-5608-7609" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="819b-2db4-b832-c106" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="655c-d628-1c4e-f46f" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="819b-2db4-b832-c106" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Grandes expectativas" id="68a5-edea-f505-c2f0" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
              <attributes>
                <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
                <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
                <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
                <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
                <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige un **^^Brodd&apos;s Stomp Priest^^** amigo para entonar esta plegaria; después, haz una tirada de cántico de D6.</characteristic>
                <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu siguiente turno, suma 1 a la característica de Attacks de las armas de combate usadas por unidades **^^Brodd&apos;s Stomp^^** amigas mientras estén totalmente a 12" o menos de quien entona la plegaria. Si la tirada de cántico fue de 9+, suma 2 a la característica de Attacks en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
