        <selectionEntry name="Escudo de matorrales" id="5cf6-3520-badf-ebeb" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a45a-39b5-1bed-0364" field="selections" includeChildSelections="true" scope="parent" shared="true" type="max" value="1"/>
