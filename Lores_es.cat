      <selectionEntries>
        <selectionEntry name="Fulguraciones de solarita" id="3c24-c8fd-444a-525c" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6ab3-f7dc-e1e8-9485" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="c33e-490e-7f61-ecee" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
            <modifier field="6ab3-f7dc-e1e8-9485" type="set" value="1">
              <conditions>
                <condition childId="707c-1c04-9af6-2307" field="selections" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Fulguraciones de solarita" id="e637-8651-a76d-4ee2" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
              <attributes>
                <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
                <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
                <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
                <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige un **^^Equinox Feast Wizard^^** amigo para lanzar este hechizo, elige un punto del campo de batalla visible para él y, después, elige como objetivos todas las unidades (amigas y enemigas) a 3" o menos de ese punto. Después, haz una tirada de lanzamiento de 2D6.</characteristic>
                <characteristic name="Effect" typeId="1cb9-a-1345-907f">Tira un dado por cada objetivo. Con un 3+, resta 1 a las tiradas de impacto de sus ataques hasta el inicio de tu siguiente turno.</characteristic>
                <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Saber de plegarias: El Festín del Equinoccio" id="d5b8-da16-e99a-ed07" hidden="false" publicationId="6281-1a88-8f4-946">
      <selectionEntries>
        <selectionEntry name="Manía de una noche de verano" id="f68f-1a01-d32a-ae5a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dab0-a5b6-3f3a-2cb7" automatic="true" field="selections" scope="parent" shared="true" type="min" value="0"/>
            <constraint id="7c47-0ec0-64ea-040c" automatic="true" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <modifiers>
