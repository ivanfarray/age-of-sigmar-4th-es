              </constraints>
              <profiles>
                <profile name="Heroína de los juegos mortales" id="577e-8687-8656-9716" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Durante el resto del turno, mientras esta unidad esté en combate con alguna **^^Heroes^^** enemiga:
• Suma 1 a las características de Attacks, Rend y Damage de las armas de combate cuerpo a cuerpo de esta unidad.
• Todos sus ataques de combate deben tener como objetivo a la misma **^^Hero^^** enemiga.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
