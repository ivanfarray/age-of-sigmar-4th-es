  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Campeones de la Arena" id="2996-5894-31ae-7a45" hidden="false" import="true" publicationId="df1f-ba81-775f-acfd" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="8771-31af-ddb0-5fb8" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Arena de la matanza" id="ca3a-a27b-c946-b51d" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si el número de unidades (amigas o enemigas) destruidas en esta batalla iguala o supera alguno de los números de abajo, el efecto correspondiente se aplica a las unidades amigas **^^Champions of the Arena^^** durante el resto de la batalla. Más de 1 efecto puede aplicarse a una unidad al mismo tiempo.
**1** Suma 1 a las tiradas de correr de esas unidades.
**2** Suma 1 a las tiradas de carga de esas unidades.
**3** Suma 1 a las tiradas de impacto de los ataques de combate de esas unidades.
**4** Suma 1 a las tiradas de herida de los ataques de combate de esas unidades.
**5** Suma 1 a la característica de Attacks de las armas de combate cuerpo a cuerpo de esas unidades.</characteristic>
          </characteristics>
        </profile>
        <profile name="Que fluya la sangre" id="e03a-cbf1-039e-ad03" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Todos los efectos de la habilidad &apos;Arena de la matanza&apos; se aplican a las unidades amigas **^^Champions of the Arena^^** mientras estén totalmente a **X**" o menos de un **Santuario del tributo oscuro** amigo, donde **X** viene determinado por la ronda de batalla actual, de la siguiente forma:
1   9"
2   12"
3   15"
4   18"
5   21"</characteristic>
          </characteristics>
        </profile>
        <profile name="Restauración frenética" id="4ffb-995b-332a-0318" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Purple</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Rallying</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Final de cualquier turno</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige como objetivo una **^^Champions of the Arena Hero^^** amiga que haya sido destruida.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Coloca una unidad de reemplazo idéntica al objetivo totalmente a 12" o menos de un **Santuario del tributo oscuro** amigo y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Furia explosiva" id="e134-6827-eac2-eae4" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una **Reina de la matanza** amiga para usar esta habilidad, después elige como objetivos cada unidad amiga **Brujas de sangre** en el campo de batalla y cada unidad amiga visible **^^Champions of the Arena^^** totalmente a 12" o menos de esa **Reina de la matanza**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, cada vez que un objetivo haga un movimiento de aproximación, suma 3" a la distancia que puede mover.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
