                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede usar una habilidad de **^^Hechizo^^** que no sea **^^Summon^^** de un saber de hechizos que hayas elegido durante la composición del ejército, como si tuviera **^^Wizard (1)^^**. En lugar de hacer una tirada de lanzamiento para ese hechizo, la tirada de lanzamiento es 9 y no se puede modificar. Ese hechizo no puede ser anulado.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Palo de ciénaga tambaleante" id="ace7-3717-82cc-dcf4" hidden="false" import="true" type="upgrade">
              <constraints>
