          <selectionEntries>
            <selectionEntry name="Canalla escurridizo" id="600f-eb3b-4263-d4" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="439-3c66-691a-64f" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
