              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), inicio del turno enemigo</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo un **^^Wizard^^** o **^^Priest^^** enemigo que esté en el campo de batalla.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado por cada objetivo que controles. Por cada 3+, resta 1 a las tiradas de lanzamiento y de cántico del objetivo durante el resto del turno.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
