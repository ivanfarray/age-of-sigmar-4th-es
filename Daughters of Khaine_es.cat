          <rules>
            <rule name="Restricciones de mejoras" id="9472-35b3-edd4-0c49" hidden="true">
              <description>Los Dones de sombra son mejoras únicas que solo pueden otorgarse a unidades que no sean **^^Hero Hijas de Khaine^^**. Una unidad solo puede tener 1 Boon of Shadow.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Reflejos ulguanos" id="4300-3fe7-fa76-fa09" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4b1c-a032-faeb-1da7" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="0"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Reflejos ulguanos" id="b477-f5f7-e023-5f86" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que hagas una tirada de salvación sin modificar de 6 para un ataque de combate que tenga como objetivo esta unidad, inflige 1 de daño mortal a la unidad atacante después de resolver la habilidad de **^^Combatir^^**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Talismanes de sombra" id="57f7-ac63-cfe1-25ad" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1ec2-1f39-de2a-ff83" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
