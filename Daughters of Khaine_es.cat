          <profiles>
            <profile name="El aliento de Khaine" id="0dbf-063e-65b5-3879" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras cada miniatura de una unidad amiga **^^Hijas de Khaine^^** esté disputando un objetivo que controles, esas miniaturas no son visibles para las miniaturas enemigas que estén a más de 9" de distancia.</characteristic>
              </characteristics>
            </profile>
