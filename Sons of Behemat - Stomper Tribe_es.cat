                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad puede ser elegida para usar la habilidad &apos;Pisoteando por ahí&apos; aunque no esté totalmente a 12" o menos y visible para una unidad amiga **^^Big^^**.</characteristic>
                  </characteristics>
