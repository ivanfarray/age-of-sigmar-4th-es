          <rules>
            <rule name="Restricciones de mejoras" id="9f55-a12e-a9bf-dc7b" hidden="true">
              <description>Los Deditos son mejoras únicas que se pueden dar a los **Mancrusher Gargants**. Una unidad solo puede tener 1 Dedito.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Futuro pisoteador" id="323a-d625-14ab-517c" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
              <constraints>
                <constraint id="7f42-9695-d01d-5a2f" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Futuro pisoteador" id="75bb-7d9e-3539-2c4e" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Esta unidad puede usar la orden &apos;Arrollar&apos; aunque no haya cargado este turno.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Cuidadosamente vigilado" id="6851-4600-6db3-6f77" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
              <constraints>
                <constraint id="5a27-acc1-8f2e-f59a" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Cuidadosamente vigilado" id="b4ae-45d1-2f0b-943f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una habilidad de Combatir para esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige como objetivo una unidad amiga **^^Big^^** que no haya usado una habilidad **^^Combatir^^** este turno y esté totalmente a 12" o menos de esta unidad. El objetivo puede ser elegido para usar una habilidad **^^Combatir^^** inmediatamente después de que se haya resuelto la habilidad **^^Combatir^^** usada por esta unidad. Suma 1 a las tiradas para impactar de los ataques hechos por esta unidad y por el objetivo durante el resto del turno.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Saltarín pequeño" id="7220-1f25-6922-ed94" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
