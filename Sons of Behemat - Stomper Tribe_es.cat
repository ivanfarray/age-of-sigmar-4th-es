  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Tribu de Pisoteadores" id="147f-4dbf-fdf9-9820" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="9551-d4ac-0f21-dd3f" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="¡Pisa! ¡Pisa! ¡Pisa! ¡Pisa!" id="29f8-59d7-4d51-c9c8" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga en combate con una unidad amiga **^^Tribu Pisoteadora^^**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Suma 1 a la tirada por cada miniatura amiga **^^Tribu Pisoteadora^^** en combate con el objetivo. Con un 5+:
• El objetivo tiene **^^Strike-last^^** durante el resto del turno.
• Inflige 3 de daño mortal al objetivo.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="¡Meteos ahí, renacuajos!" id="3851-a368-65b1-e986" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Little^^** que esté dentro del alcance de combate de una unidad amiga **^^Big^^**, sea visible para ella y no esté en combate.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Puedes volver a tirar las tiradas de carga del objetivo durante el resto del turno, y el objetivo tiene **^^Volar^^** durante el resto de la fase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="¡Coged esas rocas y tiradlas!" id="f91d-674f-4dce-f834" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), cualquier fase de disparo</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo cada unidad amiga **^^Little^^** totalmente a 18" o menos y visible para una unidad amiga **^^Big^^** y que no esté en combate.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Suma 1 al atributo Attacks de las armas de disparo de cada objetivo durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Metiéndose en faena" id="b0ac-a791-cff2-cc44" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Tribu Pisoteadora^^** en combate.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si el objetivo es **^^Little^^**, elige una miniatura de la unidad objetivo. Suma 1 al atributo Damage de las armas de combate cuerpo a cuerpo de esa miniatura durante el resto del turno.

Si el objetivo es **^^Big^^**, suma 1 al atributo Rend de sus armas de combate cuerpo a cuerpo durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Pisoteando por ahí" id="04ff-6e84-a9f1-8d01" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Little^^** totalmente a 12" o menos y visible para una unidad amiga **^^Big^^** para usar esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esa unidad **^^Little^^** puede mover D6+3". Puede atravesar el alcance de combate de unidades enemigas pero no puede terminar ese movimiento en combate. Después, puedes infligir D3 de daño mortal a cada unidad enemiga que tenga un atributo Salud menor que el de esa unidad **^^Little^^** y que haya atravesado durante ese movimiento.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Básica^^**, **^^Movimiento^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
