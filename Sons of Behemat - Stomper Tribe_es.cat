                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 2 al atributo Attacks del **Pisotón todopoderoso** de esta unidad si no usó una habilidad **^^Combatir^^** en el turno anterior.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Ansioso por pelear" id="0621-e509-0df5-637b" hidden="false" import="true" publicationId="b765-4747-cddc-385e" type="upgrade">
              <constraints>
                <constraint id="2ac7-a85d-b072-2e15" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Ansioso por pelear" id="51fa-4470-8b06-6e9b" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Al hacer tiradas de carga para esta unidad, suma 1 al número de dados tirados, hasta un máximo de 3, y después retira 1 dado a tu elección y usa los dados restantes como la tirada de carga.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
