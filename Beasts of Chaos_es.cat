              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Manada de Guerra Hambrienta" id="ce64-e8cd-1689-d0ea" hidden="false" import="true" publicationId="3cc2-31d3-9dd2-f858" type="upgrade">
          <constraints>
            <constraint id="211c-c09d-2840-1aae" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Ansia de sangre" id="6e4d-7865-37cb-bd15" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos cada unidad amiga **^^Warherd^^** que haya usado una habilidad **^^Combatir^^** este turno.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (3)** a cada objetivo.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Manada de Tormenta de los Despreciatormentas" id="2fe8-224b-0326-c58a" hidden="false" import="true" publicationId="3cc2-31d3-9dd2-f858" type="upgrade">
          <constraints>
            <constraint id="a4b2-5b9b-180e-f66f" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Tormenta furiosa" id="4a45-bfc6-e244-5c5f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos amigos cada unidad amiga **^^Thunderscorn^^** en el campo de batalla, después elige como objetivos enemigos cada unidad enemiga en combate con alguna unidad amiga **^^Thunderscorn^^**.</characteristic>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">**Heal (1)** a cada objetivo amigo. Después, tira un D3 por cada objetivo enemigo, si hay alguno. Con un 2+, inflige al objetivo enemigo una cantidad de daño mortal igual al resultado.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Manada de Bray Saqueadora" id="52ec-3be5-3c7a-c709" hidden="false" import="true" publicationId="3cc2-31d3-9dd2-f858" type="upgrade">
          <constraints>
            <constraint id="d766-097d-d934-7319" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Demonios de las tierras salvajes" id="8414-9a30-feac-8fe4" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), Reacción: Has declarado una habilidad **^^Cargar^^** para una unidad amiga **^^Brayherd^^**</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cambia uno de los dados de la tirada de carga a un 4.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
