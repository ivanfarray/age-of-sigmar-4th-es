              <description>solo **^^Hero^^**</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Astucia bestial" id="d48d-a730-b981-b286" hidden="false" import="true" publicationId="3cc2-31d3-9dd2-f858" type="upgrade">
              <constraints>
                <constraint id="d339-ea98-643d-dbf4" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Astucia bestial" id="a2e1-0e26-b76b-e5a3" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas **^^Beasts of Chaos^^** totalmente a 12" o menos de esta unidad que hayan sido colocadas este turno usando la habilidad &apos;Emboscada del rebaño de bestias&apos;.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada objetivo puede mover inmediatamente D3". Los objetivos no pueden mover hacia el combate durante ninguna parte de ese movimiento.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Presa mortal" id="fb35-1d70-7034-0a05" hidden="false" import="true" publicationId="3cc2-31d3-9dd2-f858" type="upgrade">
              <constraints>
                <constraint id="03a1-547b-c106-200f" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Presa mortal" id="897c-e6ce-ca89-9774" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, Reacción: El oponente ha declarado una habilidad **^^Disparar^^** que tenía como objetivo a una unidad amiga **^^Beasts of Chaos^^**</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esa unidad amiga **^^Beasts of Chaos^^** no está en combate y está totalmente a 18" o menos de esta unidad, después de resolver la habilidad **^^Disparar^^**, esa unidad amiga puede mover 2D6". Puede mover hacia el combate.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Propagador de ruina" id="e978-e01f-eafc-48a3" hidden="false" import="true" publicationId="3cc2-31d3-9dd2-f858" type="upgrade">
              <constraints>
                <constraint id="d1c5-4b8c-9a7a-ec6d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Propagador de ruina" id="9a85-8b68-6049-71fa" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras esta unidad esté en el campo de batalla, puedes usar la habilidad &apos;Rituales de ruina&apos; dos veces por turno en tu fase de héroe en lugar de una vez por turno. No puedes elegir el mismo efecto más de una vez por turno.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
