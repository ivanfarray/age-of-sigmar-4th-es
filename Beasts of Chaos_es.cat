      <selectionEntries>
        <selectionEntry name="Manada todopoderosa" id="1fd1-026f-82ae-3054" hidden="false" import="true" publicationId="3cc2-31d3-9dd2-f858" type="upgrade">
          <constraints>
            <constraint id="8289-66ea-507b-b70c" field="selections" scope="parent" shared="true" type="max" value="1"/>
