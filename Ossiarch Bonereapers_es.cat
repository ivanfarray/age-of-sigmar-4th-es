              </constraints>
              <profiles>
                <profile name="Mente fabricada" id="cbc3-e6ce-e5d4-f082" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, inicio de la ronda de batalla</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Al elegir un **^^Cosechahuesos Ossiarch Hero^^** amigo como objetivo de la habilidad &apos;Élite inmortal&apos; esta ronda de batalla, puedes elegir un **^^Cosechahuesos Ossiarch Hero^^** amigo que haya sido destruido.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Defensor inmaculado" id="64ae-5389-561-9414" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d3d-efc-67-efd2" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Defensor inmaculado" id="9011-b06-df15-b4c7" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignora el primer punto de daño asignado a cada unidad amiga **^^Cosechahuesos Ossiarch Infantry^^** en la fase de combate mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Voluntad imperiosa" id="f36c-2546-c3cb-b23a" hidden="false" import="true" type="upgrade">
