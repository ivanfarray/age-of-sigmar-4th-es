                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una habilidad de **^^Correr^^** para una unidad amiga **^^Cosechahuesos Ossiarch^^**.</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si sacas un 1-3 al determinar la distancia que puede mover esa unidad, puedes usar un valor de 4 en su lugar.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">La unidad que usa esa habilidad de **^^Correr^^**.</characteristic>
              </characteristics>
            </profile>
