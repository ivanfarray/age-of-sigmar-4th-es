                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de las armas de cuerpo a cuerpo de esta unidad que no sean **Compañero**. Durante el resto de la batalla, cada vez que hagas una tirada de herida sin modificar de 6 para un ataque de combate hecho con esa arma, inflige D3 de daño mortal al objetivo del ataque después de resolver la habilidad de **^^Combatir^^**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Amuleto de gnosis" id="6f1-2042-1baa-9d85" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f2d8-25d3-bf64-3e4e" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
