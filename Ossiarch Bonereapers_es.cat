  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Cosechahuesos Ossiarch" id="bc5f-6169-d1c-e4af" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="ed9f-3b9a-516e-87f0" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Élite inmortal" id="ff4e-8de5-35f5-5a29" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por ronda de batalla (ejército), inicio de la ronda de batalla</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Debes usar esta habilidad si hay algún **^^Cosechahuesos Ossiarch Heroes^^** en el campo de batalla. Elige como objetivo un **^^Cosechahuesos Ossiarch Hero^^** amigo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Ganas un número de **puntos de disciplina implacable** igual al número que acompaña a la palabra clave **^^Relentless Discipline^^** del objetivo. Al final de la ronda de batalla, se pierden todos los **puntos de disciplina implacable** no gastados.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Retirada impasible" id="a676-243e-ce91-fbcf" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Cosechahuesos Ossiarch^^** que no haya usado una habilidad de **^^Relentless Discipline^^** esta fase para usar esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Spend 1 **relentless discipline** point. For the rest of the turn, that unit can use **^^Cargar^^** abilities even if it used a **^^Retirarse^^** ability in the same turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Exterminio despiadado" id="b0bd-96e3-ff9e-46a0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Shooting</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), reacción: Has declarado una habilidad de **^^Disparar^^** para una unidad que no haya usado una habilidad de **^^Relentless Discipline^^** esta fase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Spend 1 **relentless discipline** point. Subtract 1 from ward rolls for damage points inflicted by attacks made as part of that **^^Disparar^^** ability.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">La unidad que usa esa habilidad de **^^Disparar^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Asalto despiadado" id="d313-7858-8093-a6a0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una habilidad de **^^Combatir^^** para una unidad que no haya usado una habilidad de **^^Relentless Discipline^^** esta fase.</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Spend 1 **relentless discipline** point. Añadir 1 to wound rolls for attacks made as part of that **^^Combatir^^** ability.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">La unidad que usa esa habilidad de **^^Combatir^^**.</characteristic>
          </characteristics>
        </profile>
        <profile name="Marcha inexorable" id="d7c-9c10-b15d-e67c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Cosechahuesos Ossiarch^^** que no haya usado una habilidad de **^^Relentless Discipline^^** esta fase para usar esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Spend 1 **relentless discipline** point. Add 3&quot; to the Move characteristic of that unit for the rest of the phase. That unit cannot use **^^run^^** abilities for the rest of the turn.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Legiones inviolables" id="e274-c75d-abf2-df6d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Green</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: El oponente ha declarado una habilidad de **^^Attack^^**.</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Spend 1 **relentless discipline** point. That unit has **^^Ward (5+)^^** against damage points inflicted by attacks made as part of that **^^Attack^^** ability.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">Una unidad amiga **^^Cosechahuesos Ossiarch^^** que sea el objetivo de esa habilidad de **^^Attack^^**. Las unidades amigas **^^Cosechahuesos Ossiarch^^** pueden usar esta habilidad más de una vez por fase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
