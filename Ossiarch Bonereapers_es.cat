              </constraints>
              <profiles>
                <profile name="Estandarte de la Antigua Ossia" id="f11a-04c1-253d-dd7c" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado la orden &apos;Reagrupamiento&apos; para una unidad **^^Cosechahuesos Ossiarch^^** visible totalmente a 12" o menos de esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Al resolver esa orden, puedes gastar puntos de reagrupación de las siguientes formas adicionales:
• Por cada punto de reagrupación gastado, aplica **Heal (1)** a otra unidad amiga **^^Cosechahuesos Ossiarch^^** visible que no sea **^^Hero^^** y que esté totalmente a 12" o menos de esta unidad.
• Puedes gastar un número de puntos de reagrupación igual a la característica de Salud de esa unidad para devolver una miniatura abatida a una unidad amiga **^^Cosechahuesos Ossiarch^^** visible totalmente a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Capa escarabea" id="1120-f183-c969-8b35" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="648a-ca1a-884f-cd4c" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Capa escarabea" id="ebfc-6be4-6a31-92eb" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
