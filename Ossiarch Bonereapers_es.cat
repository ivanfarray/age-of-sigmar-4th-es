              <profiles>
                <profile name="Gema de red de almas" id="ead2-9940-157b-4980" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad solo puede usar esta habilidad si ha sido destruida este turno.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca una unidad de reemplazo idéntica a esta unidad en el campo de batalla, totalmente dentro de tu territorio y que no esté en combate. Después, asigna a la unidad de reemplazo un número de puntos de daño igual a su característica de Salud menos 1 (no se pueden hacer tiradas de salvaguardia por esos puntos de daño).</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
