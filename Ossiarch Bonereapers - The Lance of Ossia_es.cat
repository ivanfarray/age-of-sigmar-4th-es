  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Rasgos de batalla: La Lanza de Ossia" hidden="false" id="a987-96c5-65b1-342e" publicationId="2f1e-fdf-1ac2-fa38">
      <profiles>
        <profile name="Élite pretoriana" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="4892-83f4-d662-2284">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por ronda de batalla (ejército), inicio de la ronda de batalla</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Debes usar esta habilidad si hay alguna unidad amiga **^^Lance of Ossia Heroes^^** en el campo de batalla. Elige como objetivo una unidad amiga **^^Lance of Ossia Hero^^**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Ganas un número de **puntos de disciplina implacable** igual al número que se muestra tras la palabra clave **^^Relentless Discipline^^** del objetivo. Al final de la ronda de batalla, se pierden todos los **puntos de disciplina implacable** no gastados.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Batidores vengativos" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="7018-6d8e-0e8f-b50e">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Lance of Ossia^^** que no haya usado una habilidad de **^^Relentless Discipline^^** esta fase.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Gasta 1 **punto de disciplina implacable**. Si el objetivo está reforzado y tiene más de la mitad de sus miniaturas iniciales, gasta 2 **puntos de disciplina implacable** en su lugar. Suma 2" a la característica de Move del objetivo durante el resto de la fase.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Lanza kavalos" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="0caf-d071-267a-bdfd">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cuando una unidad amiga **^^Lance of Ossia^^** use la orden &apos;Arrollar&apos;, el objetivo no necesita tener una característica de Salud inferior a la de esa unidad amiga.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Amenaza silenciosa" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f7e7-b67a-e92a-062a">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Lance of Ossia^^** que no haya usado una habilidad de **^^Relentless Discipline^^** esta fase para usar esta habilidad, y después elige como objetivo una unidad enemiga visible a 12" o menos de ella.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Gasta 1 **punto de disciplina implacable**. Si el objetivo está reforzado y tiene más de la mitad de sus miniaturas iniciales, gasta 2 **puntos de disciplina implacable** en su lugar. El objetivo no puede usar la orden &apos;Redesplegar&apos; durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Furia de Zandtos" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="232d-175f-ca7c-4711">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Lance of Ossia^^** que no haya usado una habilidad de **^^Relentless Discipline^^** esta fase.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Gasta 1 **punto de disciplina implacable**. Si el objetivo está reforzado y tiene más de la mitad de sus miniaturas iniciales, gasta 2 **puntos de disciplina implacable** en su lugar. Las armas de cuerpo a cuerpo del objetivo, incluidas las armas **Compañero**, tienen **Crítico (2 impactos)** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Cascos manchados de sangre" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="1e54-2f7a-a09c-3831">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad amiga **^^Lance of Ossia^^** que haya cargado este turno y no haya usado una habilidad de **^^Relentless Discipline^^** esta fase.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Gasta 1 **punto de disciplina implacable**. Si el objetivo está reforzado y tiene más de la mitad de sus miniaturas iniciales, gasta 2 **puntos de disciplina implacable** en su lugar. Suma 1 a la característica de Rend de las armas del objetivo, incluidas las armas **Comapnion**, durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Disciplina implacable^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="Reference" hidden="false" id="cafa-ac0e-d290-ac19" targetId="3360-1158-e879-9606" primary="true"/>
        <categoryLink name="Legends" hidden="false" id="4595-9041-7e5d-6a11" targetId="acaf-8bb6-d6f-3e2a" primary="false"/>
