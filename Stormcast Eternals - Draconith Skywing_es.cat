            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Draconith Skywing Monster^^** amigo que no haya usado ninguna habilidad de Rampage este turno para usar esta habilidad. Después, elige como objetivo una unidad enemiga en combate con él.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 3+, resta 1 a las tiradas de herida de los ataques del objetivo durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Rugido atronador" id="fdfa-780c-9690-a18d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Draconith Skywing Monster^^** amigo que no haya usado ninguna habilidad de **^^Rampage^^** este turno para usar esta habilidad. Después, elige como objetivos hasta 3 unidades enemigas en combate con él.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado por cada objetivo. Con un 3+, resta 5 a la puntuación de control de ese objetivo durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desenfreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Escudos del Guardián" id="014c-31e4-be4b-4db9" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras cualquier unidad amiga **Guardia de dracos de tormenta** esté dentro del alcance de combate de un **Ionus Cryptborn** amigo:
• Ese **Ionus Cryptborn** amigo tiene **^^Ward (4+)^^**.
• Cada vez que hagas una tirada de salvaguardia superada para ese **Ionus Cryptborn** amigo, asigna 1 punto de daño a una unidad amiga **Guardia de dracos de tormenta** dentro de su alcance de combate después de resolver la secuencia de daño de ese **Ionus Cryptborn** amigo (no se pueden hacer tiradas de salvaguardia por esos puntos de daño).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
