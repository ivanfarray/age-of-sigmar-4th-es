          <selectionEntries>
            <selectionEntry name="De larga barba o trenza" id="57c9-6e21-90cf-1e59" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ad16-f33b-5c5e-d472" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="De larga barba o trenza" id="b449-d615-518a-afb7" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Rallying</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una unidad amiga visible **^^Bastiones Khazalitas^^** totalmente a 12" o menos de esta unidad use la orden &apos;Reagrupamiento&apos;, puedes hacer 3 tiradas de reagrupamiento de D6 adicionales.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Resonancia innata" id="ad49-87c5-0e09-e690" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d608-b7c2-d155-5771" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="0"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Resonancia innata" id="98bd-6af7-c6e7-6157" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si esta unidad no es **^^Priest^^**, tiene **^^Wizard (1)^^**. Si ya tiene **^^Wizard (1)^^**, tiene **^^Wizard (2)^^** en su lugar. Además, las **^^Manifestations^^** enemigas tienen **^^Strike-last^^** mientras estén a 12" o menos de esta unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Juramentados a la venganza" id="ae02-399c-9670-0473" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7160-01bc-15ff-4e2c" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Juramentados a la venganza" id="baad-d0fc-fc6a-e941" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si los ataques de las armas de esta unidad que no sean Compañero han asignado algún punto de daño a una unidad enemiga este turno y esa unidad enemiga ha sido destruida, da a esta unidad una ficha de venganza, hasta un máximo de 3. Hasta el final del siguiente turno, suma 1 al atributo Attacks de las armas de combate de esta unidad que no sean Compañero por cada ficha de venganza que tenga.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
