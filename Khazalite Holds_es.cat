        <modifier field="92bc-5d7b-2986-15d4" type="set" value="-1">
          <conditions>
            <condition childId="any" field="e63c-79ff-93ba-c5eb" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup name="Reliquias de los karaks" id="c9f8-a2a4-0ea6-26a9" hidden="false" publicationId="f98d-040f-7b3e-eaf1">
          <rules>
            <rule name="Restricciones de mejoras" id="6644-2ce2-9974-17e3" hidden="true">
