                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un objetivo a 12" o menos de esta unidad como blanco.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu siguiente turno, suma 5 a las puntuaciones de control de las unidades amigas **^^Bastiones Khazalitas^^** mientras estén disputando el objetivo elegido.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Capa rúnica de escamas ígneas" id="6d41-4079-e788-9b05" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9888-e437-91fc-60ce" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Capa rúnica de escamas ígneas" id="e8ad-3ee8-2a8c-0ec8" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
