                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Declaraste una habilidad **^^Combatir^^** para esta unidad</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Después de resolver esa habilidad **^^Combatir^^**, si ha abatido alguna miniatura enemiga, puedes elegir un **^^Bastiones Khazalitas Priest^^** amigo visible totalmente a 12" o menos de esta unidad. Da a ese **^^Priest^^** D3 puntos de ritual.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
