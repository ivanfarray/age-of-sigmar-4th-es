              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 3 a las puntuaciones de control de las unidades enemigas mientras estén en combate con alguna unidad amiga **^^Bastiones Khazalitas^^**.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Defensores juramentados del hogar" id="7336-8d9b-9600-2741" hidden="false" import="true" publicationId="f98d-040f-7b3e-eaf1" type="upgrade">
          <constraints>
            <constraint id="9401-9cd7-af9f-d744" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="¡Cerrad escudos!" id="45b1-a9bd-3c27-6dfb" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas para impactar de los ataques de disparo dirigidos contra unidades amigas **^^Bastiones Khazalitas^^** mientras estén totalmente dentro del territorio amigo o mientras todas las miniaturas de la unidad estén disputando un objetivo que controles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Yunque inflexible" id="e70d-9962-d0da-8f1b" hidden="false" import="true" publicationId="f98d-040f-7b3e-eaf1" type="upgrade">
          <constraints>
            <constraint id="37bc-cf3e-7afe-69de" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Determinación inquebrantable" id="3617-7d31-0b4d-1cd2" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
              <attributes>
                <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
                <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
                <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
              </attributes>
              <characteristics>
                <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras una unidad enemiga esté en combate con una unidad amiga **^^Bastiones Khazalitas^^**, resta 1 al número de pulgadas que puede mover esa unidad enemiga al hacer un movimiento de aproximación, hasta un mínimo de 1".</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Nómadas caminantes" id="25d7-f6ef-5418-333c" hidden="false" import="true" publicationId="f98d-040f-7b3e-eaf1" type="upgrade">
          <constraints>
            <constraint id="9406-7dee-f45b-8b4e" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Errantes experimentados" id="9b46-b6ab-5dc9-379a" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
              <attributes>
                <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
                <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
              </attributes>
              <characteristics>
                <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), Reacción: Has declarado una habilidad **^^Correr^^** o **^^Cargar^^** para una unidad **^^Bastiones Khazalitas^^**</characteristic>
                <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si esa unidad está a más de 6" de todas las demás unidades amigas, puedes repetir la tirada que determina cuánto puede mover.</characteristic>
                <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
