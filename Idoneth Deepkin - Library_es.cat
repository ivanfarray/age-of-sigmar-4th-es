            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Fuente de voluntad" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="9b53-a348-d9e3-1988">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, reacción: has declarado una habilidad de **^^Hechizo^^** para una unidad amiga **^^Isharann^^** totalmente a 12" o menos de esta unidad</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira 1 de los **soul-quota tokens** de esta unidad. Después, puedes volver a tirar la tirada de lanzamiento.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Yellow</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Catálogo de almas" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="2bdb-3ae0-8d10-2ab0">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una unidad enemiga sea destruida, dale a esta unidad un **soul-quota token**.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Fortalecido por el recuerdo" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="8df6-a78f-8299-c7c6">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad amiga **^^Idoneth de las Profundidades^^** visible totalmente a 18" o menos de esta unidad y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Las armas de cuerpo a cuerpo del objetivo tienen **Crítico (herida automática)** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
          </attributes>
        </profile>
      </profiles>
