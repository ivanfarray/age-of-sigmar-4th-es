        <profile name="Lotann, Guardián de los Registros de Almas" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="7694-b095-a0b8-b4ac">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
