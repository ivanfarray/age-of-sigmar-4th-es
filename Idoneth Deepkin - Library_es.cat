    <selectionEntry type="unit" import="true" name="Naufragio de la marea sombría" hidden="false" id="cdd1-4012-45ab-ed95" publicationId="9866-239b-07f0-d92b">
      <categoryLinks>
        <categoryLink name="FACTION TERRAIN" hidden="false" id="4730-ccc7-9abf-8a7b" targetId="cdd6-ffa1-9b32-4cb8" primary="true"/>
        <categoryLink name="ORDER" hidden="false" id="8f6b-313f-e1c-794d" targetId="ee22-3575-6590-25c" primary="false"/>
        <categoryLink name="IDONETH DEEPKIN" hidden="false" id="9681-f184-e452-304" targetId="c8fc-7a72-6665-2f34" primary="false"/>
      </categoryLinks>
      <profiles>
        <profile name="Alzarse de las profundidades" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="85e9-b38c-d016-840b">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta habilidad debe usarse en lugar de la habilidad &apos;Desplegar escenografía de facción&apos;.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta escenografía de facción como 1 elemento de escenografía formado por 2 piezas de escenografía (que deben colocarse a 3" o menos una de otra) o como 2 elementos de escenografía separados. Coloca cada elemento de escenografía totalmente dentro de tu territorio y a más de 3" de todos los marcadores de objetivo y otros elementos de escenografía. Una vez hecho esto, se considera desplegada.
Si esta escenografía de facción se coloca como 1 elemento de escenografía formado por 2 piezas de escenografía, tiene una característica de Salud de 14 en lugar de 7.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Desplegar terreno^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Black</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Naufragio de la marea sombría" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="3bab-4909-2439-abf3">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">7</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">4+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Guardianes de las profundidades" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="f97b-a741-5349-16e4">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de salvación de las unidades amigas **^^Idoneth de las Profundidades Infantry^^** y **^^Cavalry^^** mientras estén totalmente a 6" o menos de este elemento de escenografía.</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="50fe-4f29-6bc3-dcc6" name="Color">Green</attribute>
            <attribute typeId="bf11-4e10-3ab1-06f4" name="Type">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
        <profile name="Ruina fantasmal" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="e135-2afc-f787-00c9">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las miniaturas pueden atravesar este elemento de escenografía, pero no se pueden colocar sobre él ni terminar movimientos sobre ninguna parte de él.
Cada vez que una unidad enemiga termine un movimiento que haya pasado a través de o por este elemento de escenografía, tira un D3. Con un 2+, inflige a esa unidad una cantidad de daño mortal igual al resultado.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
      <rules>
        <rule name="Naufragio de la marea sombría" id="c642-2873-3610-8709" hidden="false">
          <description>**Las siguientes habilidades universales de escenografía se aplican a este elemento de escenografía (Terrain, 1.2):
Cobertura, Ocultación**</description>
        </rule>
        <rule name="Tamaño de peana" id="66e5-43ae-6c4c-e8b1" hidden="true">
          <description>Usar miniatura</description>
        </rule>
      </rules>
    </selectionEntry>
