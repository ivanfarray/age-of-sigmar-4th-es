      <profiles>
        <profile name="Icono de la Tormenta" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="cff4-df93-1538-fa5d">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">7&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">6</characteristic>
