        <profile name="Encarnación de las Profundidades" id="93ea-b16d-77bd-28de" hidden="false" typeId="1287-3a-9799-7e40" typeName="Manifestation">
          <attributes>
            <attribute name="Base Size" typeId="50db-066e-a3e7-696f"/>
          </attributes>
          <characteristics>
            <characteristic name="Move" typeId="c28a-6000-2a0b-e7cf">10&quot;</characteristic>
            <characteristic name="Health" typeId="d1b9-3068-515-131e">12</characteristic>
            <characteristic name="Save" typeId="80c7-7691-b6ed-d6a6">4+</characteristic>
            <characteristic name="Banishment" typeId="97a2-d412-9ac-6a37">9+</characteristic>
          </characteristics>
        </profile>
        <profile name="Rendirse al mar" id="32a1-55c0-e4b3-fe71" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cuando esta **^^Manifestation^^** se retire de la partida, cada **Zarcillo abisal** amiga que esté en el campo de batalla se retira automáticamente de la partida.</characteristic>
          </characteristics>
        </profile>
        <profile name="Zarcillos prensiles" id="7496-ba44-98bd-da2f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Suma 1 al resultado si es tu turno.
Con un 4+:
• Puedes retirar 1 **Zarcillo abisal** amiga del campo de batalla.
• Si hay menos de 2 Abyssal Tendrils amigas en el campo de batalla, puedes colocar una **Zarcillo abisal** totalmente a 9" o menos de esta **^^Manifestation^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Forma salvaje" id="cf59-e609-1520-5a5c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" id="3c5e-7c0a-e6da-c4b3" hidden="false" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" id="8b19-9c71-98d7-d2ae" hidden="false" typeId="fd7f-888d-3257-a12b">Cada vez que esta **^^Manifestation^^** sea el objetivo de la habilidad &apos;Desterrar manifestación&apos;, si fuera a ser desterrada, no lo es. En su lugar, asígnale 6 puntos de daño (no se pueden hacer tiradas de salvaguardia para esos puntos de daño).</characteristic>
          </characteristics>
