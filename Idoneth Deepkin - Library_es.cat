        <profile name="Luz señuelo" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="6822-231b-cd10-d7f0">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 3 unidades amigas **^^Namarti^^** distintas totalmente a 12" o menos de esta unidad. No puedes elegir la misma unidad como objetivo de esta habilidad más de una vez por turno.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Haz una tirada de lurelight de D3 por cada unidad objetivo. Con un 2+, devuelve a la unidad objetivo un número de miniaturas abatidas igual al resultado.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
