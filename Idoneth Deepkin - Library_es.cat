            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Tormenta de hojas" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="20f6-1028-da75-9e2b">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esta unidad puede usar 2 habilidades de **^^Combatir^^** esta fase. Sin embargo, después de usar la primera, esta unidad tiene **^^Strike-last^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Furia del remolino" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)" hidden="false" id="2ebc-7312-3b2a-5b80">
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las unidades enemigas no pueden usar habilidades de **^^Retirarse^^** mientras estén en combate con esta unidad.
Las unidades amigas que usen una habilidad de **^^Retirarse^^** mientras estén totalmente a 12" o menos de esta unidad pueden seguir usando habilidades de **^^Disparar^^** y/o **^^Cargar^^** más tarde en el turno.
Las unidades amigas **^^Idoneth de las Profundidades^^** no reciben daño mortal por habilidades de **^^Retirarse^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
        </profile>
      </profiles>
