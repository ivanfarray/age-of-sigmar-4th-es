                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">El **Cefalópodo abisal** de esta unidad es una ficha. Si se retira del campo de batalla, esta unidad no puede usar la habilidad &apos;Defensor pelágico&apos;.</characteristic>
                      </characteristics>
