            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
        <profile name="Tsunami de terror" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)" hidden="false" id="d4b3-bede-2080-6771">
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivos hasta 3 unidades enemigas visibles distintas a 12" o menos de esta unidad y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Resta 1 a las tiradas de salvación de los ataques de combate que tengan como objetivo esas unidades hasta el inicio de tu siguiente turno.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
          <attributes>
            <attribute typeId="16b6-0911-f549-a4bd" name="Color">Yellow</attribute>
            <attribute typeId="da27-8d61-f955-5031" name="Parent Node">Offensive</attribute>
          </attributes>
