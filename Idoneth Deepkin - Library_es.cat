        <profile name="Invocamareas isharann" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="6e0d-dcfb-9478-a308">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
            <characteristic name="Health" typeId="96be-54ae-ce7b-10b7">5</characteristic>
            <characteristic name="Save" typeId="1981-ef09-96f6-7aa9">5+</characteristic>
            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Maestro del mar etéreo" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)" hidden="false" id="f8b2-2fb-40e5-2523">
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Haz una tirada de ritual Isharann de D6.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Con un 3+, elige 1 de los siguientes efectos para aplicarlo hasta el inicio de tu siguiente turno:
***Niebla reptante:*** Las unidades amigas **^^Idoneth de las Profundidades^^** no pueden ser objetivo de ataques de disparo a menos que la miniatura atacante esté a 12" o menos de ellas.
***Corriente impetuosa:*** Suma 1 a las tiradas de correr y de carga de las unidades amigas **^^Idoneth de las Profundidades^^**.
***Resaca maliciosa:*** Cada vez que una unidad enemiga use una habilidad de **^^Retirarse^^**, después de resolver el efecto de esa habilidad, inflige D3 de daño mortal a esa unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
          <attributes>
            <attribute typeId="5a11-eab3-180c-ddf5" name="Color">Orange</attribute>
            <attribute typeId="6d16-c86b-2698-85a4" name="Type">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
        </profile>
      </profiles>
