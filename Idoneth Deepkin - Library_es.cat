      <profiles>
        <profile name="Siervos namarti" typeId="ff03-376e-972f-8ab2" typeName="Unit" hidden="false" id="299b-340d-a98f-733f">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
