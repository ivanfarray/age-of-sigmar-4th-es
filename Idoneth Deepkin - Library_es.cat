                      <characteristics>
                        <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                        <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que esta unidad sea el objetivo de un ataque, si tienes algún punto de orden y ninguna unidad amiga ha usado ya la orden &apos;Defensa total&apos; esta fase, esta unidad debe usar la orden &apos;Defensa total&apos;.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
