          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignora los modificadores negativos a las puntuaciones de control de las unidades amigas **^^Idoneth de las Profundidades^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
          </characteristics>
          <attributes>
