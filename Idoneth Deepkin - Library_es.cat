          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de impacto de los ataques hechos por **^^Idoneth de las Profundidades Manifestations^^** amigas que tengan como objetivo una unidad enemiga **ensnared**.</characteristic>
          </characteristics>
