      <profiles>
        <profile name="Invocamareas isharann" id="9000-a922-3abc-36af" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">6&quot;</characteristic>
