      <profiles>
        <profile name="Piedra imán entrópica" id="620d-c0ca-509c-b486" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">A partir de la segunda ronda de batalla, suma 1 a la característica de Rend de las armas de cuerpo a cuerpo usadas por unidades amigas **^^Beasts of Chaos^^** mientras estén totalmente a 24" o menos de este elemento de escenografía.
Si este elemento de escenografía está totalmente a 18" o menos del centro del campo de batalla, esta habilidad afecta a todas las unidades amigas **^^Beasts of Chaos^^** del campo de batalla en lugar de solo a las que estén totalmente a 24" o menos de él.</characteristic>
          </characteristics>
        </profile>
        <profile name="Piedra del rebaño" id="b63f-a5f8-6a7d-2965" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">-</characteristic>
