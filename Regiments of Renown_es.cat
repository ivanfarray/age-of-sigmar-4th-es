            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivo una unidad enemiga.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El objetivo tiene la palabra clave **^^Enemy of the Everchosen^^**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Una misión bien cumplida" id="bc1d-932d-e613-c095" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si una unidad de este Regimiento de Renombre destruye a la unidad enemiga **^^Enemy of the Everchosen^^**, suma 10 a la puntuación de control de cada unidad de este Regimiento de Renombre durante el resto de la batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Los Espíritus de la Canción Perdida" id="e900-fc9b-8fc3-1641" defaultAmount="0" hidden="true" import="true" publicationId="fdea-639c-1111-eecc" type="upgrade">
