            <characteristic name="Control" typeId="6c6f-8510-9ce1-fc6e">2</characteristic>
          </characteristics>
        </profile>
        <profile name="Furia de batalla imparable" id="8e9a-26f0-33a5-50e9" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Offensive</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige como objetivo una unidad amiga visible totalmente a 12" o menos de esta unidad; después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu próximo turno:
• El blanco no puede usar habilidades **^^Move^^**.
• Las armas de combate del blanco tienen **Anti-charge (+1 Rend)**.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2"/>
          </characteristics>
        </profile>
        <profile name="Oculto a plena vista" id="686a-26db-a4b9-23ca" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad debe desplegarse mediante esta habilidad.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esta unidad en reserva **de incógnito**. Ahora se considera desplegada.
Las unidades amigas **de incógnito** son destruidas al final de la quinta ronda de batalla y no al inicio de la cuarta ronda de batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Señuelo y engaño" id="47b1-d96e-211f-04c4" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Esta unidad puede usar esta habilidad si está **de incógnito**. Elige esta unidad y un **^^Infantry Hero^^** amigo como blancos. Un blanco debe estar **de incógnito** y el otro debe estar en el campo de batalla.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca al blanco de incógnito totalmente a 6" o menos del otro blanco y sin estar en combate. Después, retira al otro blanco del campo de batalla y colócalo en reserva **de incógnito**.
Si esta unidad es destruida, antes de retirarla del juego, coloca la unidad amiga **de incógnito** totalmente a 6" o menos de un borde del campo de batalla y sin estar en combate.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Máscara del Embaucador" id="db67-bae1-f2d2-75aa" hidden="false" import="true" type="model">
