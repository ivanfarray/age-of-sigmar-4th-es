                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="-3"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Tramperos del bosque" id="327d-5730-65e0-7834" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de héroe enemiga</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un elemento de terreno a 6" o menos de una unidad de este Regimiento de Ghyran y, después, elige todas las unidades enemigas a 6" o menos de ese elemento de terreno como blancos.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado por cada blanco y aplica el efecto correspondiente de abajo hasta el inicio de tu próximo turno.
**1-2** El blanco no puede usar órdenes.
**3-4** Reduce a la mitad el atributo Move del blanco.
**5-6** Resta 1 a la cantidad de dados que se tiran al hacer tiradas de carga para el blanco, hasta un mínimo de 1.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Rompehechizos" id="1d9f-a8a3-b37f-9e88" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="085d-de5e-6c6d-e978" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="-4"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Rompehechizos" id="050e-5e7c-7c37-dd31" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una **^^Manifestation^^** enemiga a 12" o menos de una unidad de este Regimiento de Ghyran como blanco y, después, haz una tirada de destierro de 2D6.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si la tirada de destierro iguala o supera el valor de destierro indicado en la hoja de unidad de la **^^Manifestation^^**, elige 1 de los siguientes efectos.
***Desterrar:*** Inflige D3 de daño mortal a la unidad que haya invocado al blanco. Después, el blanco queda desterrado y se retira del juego.
***Tomar el control:*** Durante el resto del turno, tu ejército trata al blanco como una **^^Manifestation^^** amiga y el ejército de tu oponente lo trata como una **^^Manifestation^^** enemiga.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Saboteadores siniestros" id="649d-ed3e-2444-28de" hidden="false" import="true" type="upgrade">
              <constraints>
