                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Saboteadores siniestros" id="1a9f-d2eb-f2b4-aaf5" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 2 a las tiradas de remediación de las unidades enemigas mientras estén a 9" o menos de 2 o más unidades de este Regimiento de Ghyran.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
