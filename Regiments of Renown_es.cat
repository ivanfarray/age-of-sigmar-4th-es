        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="3706-08ed-3870-450d" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Resurrección oscura" id="576a-6c05-673d-2ce0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno.</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si los ataques de combate de esta unidad han asignado algún punto de daño a una unidad enemiga en este turno y esa unidad enemiga ha sido destruida en este turno, elige un **^^Death Infantry Hero^^** amigo que no sea **^^Unique^^** y que haya sido destruido como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca una unidad de reemplazo idéntica al blanco totalmente a 12" o menos de esta unidad. La unidad de reemplazo solo puede colocarse en combate con unidades enemigas que estén en combate con esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Etéreo" id="83de-29d4-bc34-8f08" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignora los modificadores negativos a las tiradas de salvación de las unidades de este Regimiento de Renombre.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: El Horror de la Vigilia Sagrada" id="d1f8-df86-e984-c34d" defaultAmount="0" hidden="true" import="true" publicationId="6281-1a88-8f4-946" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="6a0d-5127-48e3-f60b" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
