                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de combate enemiga.</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, cuando los jugadores se alternen para elegir unidades que usen una habilidad **^^Combatir^^**, cuando te toque elegir una unidad, puedes elegir todas las unidades de este Regimiento de Ghyran en lugar de 1. Resuelve las habilidades **^^Combatir^^** de una en una, inmediatamente una después de otra.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Atraídos por la corrupción" id="85e7-8464-8729-3d9a" hidden="false" import="true" type="upgrade">
              <constraints>
