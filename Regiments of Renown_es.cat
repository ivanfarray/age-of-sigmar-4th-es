    <selectionEntry name="Regimiento de Renombre: Escalón Real de Neferata" id="b0be-ce3a-82e7-83d0" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
