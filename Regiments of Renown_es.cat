      <profiles>
        <profile name="Se hará justicia" id="5037-4f43-c3bd-abcd" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige a la **Neave Garra Negra** de este Regimiento de Renombre como blanco si está en combate con un **^^Hero^^** enemigo.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">El blanco puede usar 2 habilidades **^^Combatir^^** en esta fase. Cada vez que lo haga, si está en combate con un **^^Hero^^** enemigo, todos sus ataques deben tener como blanco a un **^^Hero^^** enemigo. Además, después de usar la primera habilidad **^^Combatir^^**, el blanco tiene **^^Strike-last^^** durante el resto del turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Tambaleantes de Veremord" id="f74-33b3-d9a8-3e46" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="b4f5-1c23-9572-bb83" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="b697-d8a3-aac0-b4dd" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
