    <selectionEntry name="Regimiento de Renombre: Ascendente Marcado por los Dioses" id="d944-cad1-cdbd-f4ad" defaultAmount="0" hidden="true" import="true" publicationId="6357-5d77-a2b2-f86b" type="upgrade">
