          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Estaremos allí, si la paga es buena" id="1d1f-61f0-cda2-1c4f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige todas las unidades de este Regimiento de Renombre como blancos si ninguna de ellas se ha desplegado.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca a los blancos en reserva **preparando un ataque de flanco**. Ahora se consideran desplegados.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Los cuernos dan en el blanco" id="1731-588a-8ef0-8aab" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
