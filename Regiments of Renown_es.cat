        <constraint id="c544-66f8-7ede-25e0" field="selections" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="a305-c205-8cff-9744" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Alternar manifestación" id="14aa-d926-ad81-bd64" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige al **Calígrafo scinari** de este Regimiento de Renombre para lanzar este hechizo, elige 1 de las siguientes **^^Manifestations^^** amigas que no esté en el campo de batalla y, después, haz una tirada de lanzamiento de 2D6.
• **Santuario de Amyntok**
• **Piedras gemelas de Hysh**
• **Runa de petrificación**</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Si ya hay una **^^Manifestation^^** amiga de la lista anterior en el campo de batalla, es desterrada inmediatamente y retirada del juego. Después, coloca la **^^Manifestation^^** que has elegido a 1" o menos del lanzador y visible para él. Si esa **^^Manifestation^^** es un **Santuario de Amyntok**, debe colocarse en su lugar totalmente a 12" o menos del lanzador, a más de 3" de todas las unidades enemigas y con sus 3 partes tocándose entre sí de modo que formen un anillo.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Invocación^^**, **^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Eliminación veloz" id="2565-3a6c-71c4-b08d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: El oponente ha declarado una habilidad **^^Hechizo^^**</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado por cada unidad amiga que haya sido elegida como blanco de esa habilidad **^^Hechizo^^** y esté totalmente a 12" o menos del **Calígrafo scinari** de este Regimiento de Renombre. Con un 4+, esa habilidad **^^Hechizo^^** no tiene efecto sobre esa unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Taxonomía arcana" id="9ef7-4b8d-eda6-94e5" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira al **Calígrafo scinari** de este Regimiento de Renombre del campo de batalla y vuelve a colocarlo en el campo de batalla totalmente a 3" o menos de una **^^Manifestation^^** amiga y a más de 7" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Heraldos del Diezmo Óseo" id="05e8-8122-ce28-a098" defaultAmount="0" hidden="true" import="true" publicationId="2f1e-fdf-1ac2-fa38" type="upgrade">
