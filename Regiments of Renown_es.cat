              </costs>
              <profiles>
                <profile name="Hasta el final" id="de5a-de40-5db6-d6dc" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Grey</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Damage</attribute>
