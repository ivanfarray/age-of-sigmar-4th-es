      <profiles>
        <profile name="Zancada titánica" id="d1b2-293f-69d2-e568" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La unidad de este Regimiento de Renombre puede usar habilidades **^^Cargar^^** aunque haya usado una habilidad **^^Retirarse^^** en el mismo turno. Además, las habilidades **^^Retirarse^^** no infligen daño mortal a la unidad de este Regimiento de Renombre.</characteristic>
          </characteristics>
        </profile>
        <profile name="Pisotón que sacude la tierra" id="426a-41c7-4506-6e09" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas para impactar de los ataques de combate hechos por unidades enemigas **^^Infantry^^** y **^^Cavalry^^** mientras estén en combate con la unidad de este Regimiento de Renombre.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Robabotellaz de Braggit" id="e614-f029-2fce-26ce" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
