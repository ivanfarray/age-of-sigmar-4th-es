      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="c43c-4ed-d97a-b72" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
