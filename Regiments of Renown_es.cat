            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige al **Mannfred von Carstein** de este Regimiento de Renombre para lanzar este hechizo, elige una unidad enemiga visible a 12" o menos de él como blanco y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Inflige 1 daño mortal al blanco por cada otra unidad enemiga a 3" o menos del blanco.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Al amparo de la noche" id="ddcd-a852-8659-de7f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
