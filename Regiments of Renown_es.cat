                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: Has declarado una orden para una unidad de este Regimiento de Ghyran.</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Debes usar esta habilidad.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 6+, esa orden no tiene efecto, sigue contando como usada y los puntos de orden gastados para usarla se pierden igualmente.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
