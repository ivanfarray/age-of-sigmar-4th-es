      </modifiers>
      <profiles>
        <profile name="El decreto de Nagash" id="eafc-0515-043f-b23a" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige al **Vokmortian** amigo de este Regimiento de Renombre para lanzar este hechizo, elige una unidad enemiga visible a 12" o menos de él como blanco y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Durante el resto del turno, cada vez que tu oponente declare una habilidad **^^Combatir^^** para el blanco, a menos que gaste 1 punto de orden como reacción, esa habilidad **^^Combatir^^** no tiene efecto.
**Nota del diseñador:** *Esa habilidad* **^^Combatir^^** *no cuenta como una orden.*</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Maestros de todos los terrenos" id="c8fb-5f31-0ea8-cc6c" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Ignora los modificadores negativos a las tiradas de correr y de carga de las unidades de este Regimiento de Renombre y a su atributo Move.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
