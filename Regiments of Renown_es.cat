      </modifiers>
      <profiles>
        <profile name="Cacería oscura" id="62a6-ca70-dffd-46fd" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Orange</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">En tu fase de carga, si esta unidad no está en combate y no ha usado una habilidad **^^Correr^^** o **^^Retirarse^^** en el mismo turno, debe usar la habilidad &apos;Cargar&apos; y, si la tirada de carga le permite terminar el movimiento a 1/2" o menos de una unidad enemiga visible, debe hacerlo.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chillidos voraces" id="4e1a-5e34-b503-75c9" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que los ataques de disparo de esta unidad destruyan una unidad enemiga, suma 1 al atributo Attacks de su **Alarido de muerte** durante el resto de la batalla (este efecto es acumulativo).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
