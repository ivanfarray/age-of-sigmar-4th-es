              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="-5"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Atraídos por la corrupción" id="7448-3635-1490-29b0" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de movimiento</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad de este Regimiento de Renombre que no esté en combate como blanco.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira al blanco del campo de batalla y vuelve a colocarlo totalmente a 6" o menos de un elemento de terreno **contaminado** y a más de 9" de todas las unidades enemigas.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Juntos en esto" id="b56d-e99b-b160-5b92" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9b16-6b69-5998-f61a" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="-5"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Juntos en esto" id="0822-ebbd-bd7a-5567" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de carga</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si un **^^Hero^^** de este Regimiento de Ghyran no está en combate y no ha usado ninguna habilidad **^^Correr^^** o **^^Retirarse^^** en este turno, elige a ese **^^Hero^^** y a 1 unidad de este Regimiento de Ghyran dentro de su alcance de combate que no esté en combate y no haya usado ninguna habilidad **^^Correr^^** o **^^Retirarse^^** en este turno como blancos. Después, haz una tirada de carga de 2D6.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Cada blanco puede moverse una distancia de hasta el valor de la tirada de carga. Pueden atravesar los alcances de combate de las unidades enemigas y deben terminar ese movimiento a 1/2" o menos de una unidad enemiga visible. El **^^Hero^^** debe moverse primero y el otro blanco debe terminar ese movimiento dentro del alcance de combate del **^^Hero^^**. Si el **^^Hero^^** no puede terminar ese movimiento a 1/2" o menos de una unidad enemiga visible, ninguno de los blancos puede moverse. Si se mueven, los blancos han cargado.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Espíritus vigorosos" id="64ff-035d-f892-4bb8" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="029c-1f8b-d9af-c58e" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="-5"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Espíritus vigorosos" id="b059-5a6a-0f0d-7602" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), fase de movimiento enemiga</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad de este Regimiento de Renombre que no esté en combate como blanco.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira **X**D3, donde **X** es la cantidad de unidades enemigas a 12" o menos del blanco que hayan usado una habilidad **^^Move^^** en esta fase. El blanco puede moverse una cantidad de pulgadas igual a la tirada.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Instintos de conservación" id="a11e-bf05-58d4-72ac" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9cf1-681c-2727-53f6" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="-5"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Instintos de conservación" id="06c3-85a9-a4e3-cfb6" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), fase de combate enemiga</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad de este Regimiento de Renombre que esté en combate con una unidad enemiga que haya cargado en este turno como blanco.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira 2D6. Con un 6+, el blanco puede moverse una cantidad de pulgadas igual a la tirada. Puede atravesar los alcances de combate de las unidades enemigas, pero no puede terminar ese movimiento en combate.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Bendiciones de corteza" id="eba4-2809-039a-42cf" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="482e-4795-d11c-cc08" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="-5"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Bendiciones de corteza" id="6eec-de5f-0e85-52e8" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Green</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), Reacción: El oponente ha declarado una habilidad **^^Attack^^**.</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Esa unidad tiene **^^Ward (3+)^^** durante el resto de la fase. Por cada tirada de salvaguardia sin modificar de 1 de esa unidad en esta fase, después de resolver la habilidad **^^Attack^^**:
• Si esa unidad tiene un atributo Salud de 1, 2 miniaturas de esa unidad son abatidas.
• Si esa unidad tiene un atributo Salud de 2 o más, 1 miniatura de esa unidad es abatida.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b">Una unidad de este Regimiento de Ghyran que sea blanco de esa habilidad **^^Attack^^**.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Maestros purificadores" id="4af3-8930-f781-821c" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9f2f-8222-80aa-22da" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="-5"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Maestros purificadores" id="08b7-8ace-405f-e25d" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
                  <attributes>
                    <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Purple</attribute>
                    <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
                    <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
                    <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Puedes repetir las tiradas de remediación de las unidades de este Regimiento de Ghyran.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Conocedor de los senderos" id="b4a6-5196-fbaf-178a" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0018-ec43-1802-7954" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="Destiny Points" typeId="bc33-05f5-8d3f-af43" value="-10"/>
                <cost name="Force Category - PTG" typeId="e63c-79ff-93ba-c5eb" value="0"/>
                <cost name="Force Category - GHB" typeId="de92-2099-fbf7-a156" value="0"/>
              </costs>
              <profiles>
                <profile name="Conocedor de los senderos" id="f2c6-9cc6-be13-071f" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), final de tu turno</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad de este Regimiento de Ghyran como **blanco orientado** y, después, elige un punto del campo de batalla bajo la peana de 1 de sus miniaturas como **ubicación desconocida**. A continuación, elige una unidad enemiga visible a 18" o menos del blanco como **blanco desconcertado** y, después, elige un punto del campo de batalla bajo la peana de 1 de sus miniaturas como **destino previsto**.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Retira a los blancos del campo de batalla. Coloca al **blanco orientado** totalmente a 6" o menos del **destino previsto**. Solo puede colocarse en combate con unidades del ejército de tu oponente que estuvieran a 3" o menos del blanco desconcertado antes de que este fuera retirado del campo de batalla.
Después, tu oponente debe colocar al **blanco desconcertado** totalmente a 6" o menos de la **ubicación desconocida**. Solo puede colocarse en combate con unidades de tu ejército que estuvieran a 3" o menos del blanco orientado antes de que este fuera retirado del campo de batalla.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
