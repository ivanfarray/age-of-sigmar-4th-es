      <profiles>
        <profile name="Competencia feroz" id="c933-47c3-45c1-8511" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Movement</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Cada vez que una unidad de este Regimiento de Renombre use una habilidad y esa habilidad abata alguna miniatura enemiga, después de resolver esa habilidad, la unidad que la haya usado es **preeminente** y la otra unidad de este Regimiento de Renombre queda **relegada**.
Las armas usadas por una unidad **relegada** de este Regimiento de Renombre tienen **Crítico (herida automática)**.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
