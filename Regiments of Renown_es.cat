          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Legión marcada por los dioses" id="f72a-3484-977a-68d3" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">La unidad de este Regimiento de Renombre obtiene la habilidad &apos;Dones del Caos&apos; y una de las siguientes claves de facción que coincida con la facción de tu ejército.
• **^^Filos de Khorne^^**
• **^^Discípulos de Tzeentch^^**
• **^^Agusanados de Nurgle^^**
• **^^Hedonistas de Slaanesh^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Recaudadores del Diezmo" id="658d-08d4-eceb-91d1" defaultAmount="0" hidden="true" import="true" publicationId="fdea-639c-1111-eecc" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="1bc9-ab23-f3b4-3ba2" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="9090-543d-1b10-ae2c" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="162a-f77e-f5f8-041b" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Recaudar el diezmo" id="98b9-c09f-66d7-3561" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige al **Cosechador Gothizzar** de este Regimiento de Renombre para usar esta habilidad y, después, elige una unidad Infantry que no sea **^^Hero^^** (amiga o enemiga) dentro de su alcance de combate como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Si la tirada iguala o supera el atributo Salud del blanco, 1 miniatura de la unidad blanco es abatida y, después, otorga a la unidad que use esta habilidad 1 punto de diezmo de huesos.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Impuesto de almas" id="8aaf-d2d0-f87b-a0b1" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige al **Osifector mortisano** de este Regimiento de Renombre para lanzar este hechizo y, después:
• Elige una unidad amiga, excluidas las unidades de este Regimiento de Renombre, como blanco.
• Elige una unidad de este Regimiento de Renombre como **receptor**.
El blanco y el **receptor** deben estar totalmente a 12" o menos del lanzador y ser visibles para él. Después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu próximo turno:
• El blanco tiene una puntuación de control máxima de 1.
• Suma 1 a las tiradas de impacto y para herir de los ataques de combate del **receptor**.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Reconstruir sobre la marcha" id="39d2-f0ed-25d8-910d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige al **Cosechador Gothizzar** de este Regimiento de Renombre para usar esta habilidad si tiene 6 puntos de diezmo de huesos. Después, elige otra unidad de este Regimiento de Renombre que haya sido destruida como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Restablece los puntos de diezmo de huesos del **Cosechador Gothizzar** a 0. Después, coloca una unidad de reemplazo de la unidad blanco con la mitad de miniaturas (redondeando hacia arriba) totalmente a 9" o menos del **Cosechador Gothizzar** y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Carroñeros Exiliados" id="4e54-20b5-25aa-5192" defaultAmount="0" hidden="true" import="true" publicationId="fdea-639c-1111-eecc" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="1e06-0ada-e1be-8468" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="aedd-fda0-776c-b609" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="c09c-6726-db25-549b" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Buen ojo para el botín" id="557c-577e-b7ea-e1fc" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Debe usarse esta habilidad para desplegar este Regimiento de Renombre.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca las unidades de este Regimiento de Renombre en reserva estudiando el campo de batalla. Ahora se consideran desplegadas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Lanzarse en picado" id="ce0b-2299-2aa2-80b4" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige al **Cañonera Grundstok** de este Regimiento de Renombre para usar esta habilidad si está estudiando el campo de batalla.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca al **Cañonera Grundstok** en el campo de batalla a más de 6" de todas las unidades enemigas que tengan un artefacto de poder y a más de 9" de todas las demás unidades enemigas. Después, coloca todas las demás unidades de este Regimiento de Renombre totalmente a 3" o menos del **Cañonera Grundstok** y a más de 6" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Lo tuyo es mío" id="4f7f-18fb-3cef-0ae7" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad enemiga en combate con una unidad de este Regimiento de Renombre como blanco. Después, elige un artefacto de poder que tenga el blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Suma 1 a la tirada por cada unidad de este Regimiento de Renombre que esté en combate con el blanco. Con un 6+, el blanco deja de tener ese artefacto de poder.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
