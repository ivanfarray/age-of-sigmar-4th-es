        <constraint id="7bd3-b8db-c0de-3e41" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="d7f8-513c-ea3d-bc9e" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Bramido de Gorkamorka" id="e2fe-78ea-af88-ca9f" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige al **Taumaturgo ogroide** de este Regimiento de Renombre para lanzar este hechizo, elige una unidad enemiga visible a 12" o menos de él como blanco y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">El blanco tiene **^^Strike-last^^** hasta el inicio de tu próximo turno. Además, mientras el blanco tenga la clave **^^Burning^^**, resta 1 a sus tiradas de impacto hasta el inicio de tu próximo turno.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Arte de forja goroano" id="6aff-1885-41f1-51b7" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige un **^^Destruction Hero^^** amigo dentro del alcance de combate de un **^^Hero^^** de este Regimiento de Renombre como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Con un 3+, suma 1 al atributo Rend de las armas de combate del blanco hasta el inicio de tu próximo turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Trogg de Alquiler de Snerk" id="bfa8-623c-3614-11ae" defaultAmount="0" hidden="true" import="true" publicationId="fdea-639c-1111-eecc" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="6ef6-dc46-febb-686e" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
