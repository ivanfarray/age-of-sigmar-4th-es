          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), cualquier fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad de este Regimiento de Renombre que haya cargado en este turno. Después, elige una unidad **^^Infantry^^** enemiga a 1" o menos de esa unidad como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, ignora los modificadores positivos a las tiradas de salvación del blanco.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
