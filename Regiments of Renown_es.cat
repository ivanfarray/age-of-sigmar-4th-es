    <selectionEntry name="Regimiento de Renombre: Loz Cerdoz Lanzadoz" id="0a1b-4e4d-ca7b-f5cc" defaultAmount="0" hidden="true" import="true" publicationId="8b1b-f2c7-890e-2bbe" type="upgrade">
      <categoryLinks>
