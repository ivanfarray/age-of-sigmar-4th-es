        <profile name="Modificaciones de campaña" id="b2bf-9f05-0ad9-c820" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5"/>
