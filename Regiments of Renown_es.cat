            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras una unidad de este Regimiento de Renombre que no sea **^^Hero^^** esté dentro del alcance de combate del **^^Hero^^** de este Regimiento de Renombre y sea visible para él, esas unidades están **bajo órdenes**.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
