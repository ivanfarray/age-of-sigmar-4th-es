              </costs>
              <profiles>
                <profile name="Ponerse a cubierto" id="84f2-0011-9692-7521" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), Reacción: El oponente ha declarado una habilidad **^^Disparar^^**</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige una unidad de este Regimiento de Ghyran como blanco. Durante el resto del turno:
• Si la tirada de impacto sin modificar de un ataque de disparo que tenga como blanco a esta unidad es de 1-5, el ataque falla y la secuencia de ataque termina.
• El blanco no puede usar habilidades **^^Cargar^^**.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Tramperos del bosque" id="b617-8ead-3ce5-8bc6" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f7cb-dd07-742f-5e3e" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
