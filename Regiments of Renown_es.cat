          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de impacto de los ataques de disparo de las unidades de este Regimiento de Renombre que no sean **^^Hero^^** si los ataques de disparo de unidades de este Regimiento de Renombre que no sean **^^Hero^^** han abatido alguna miniatura enemiga en el mismo turno.</characteristic>
          </characteristics>
        </profile>
        <profile name="¡Atrincheraos!" id="7442-f0bb-b9e0-f291" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
