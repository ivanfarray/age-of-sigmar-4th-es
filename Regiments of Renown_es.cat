      </modifiers>
      <profiles>
        <profile name="Vapores debilitantes" id="962e-b633-f289-3773" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Red</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Offensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de salvaguardia de las unidades enemigas mientras estén a 12" o menos del **Carro de cadáveres** de este Regimiento de Renombre.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leyenda entre los saqueadores de tumbas" id="e0e6-a80a-b028-1961" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige el **Carro de cadáveres** de este Regimiento de Renombre para usar esta habilidad si está a 3" o menos de la unidad **Zombis muertos andantes** de este Regimiento de Renombre. Después, elige todas las unidades **^^Infantry^^**, **^^Cavalry^^** y **^^Bestia^^** enemigas a 12" o menos del **Carro de cadáveres** como blancos.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Por cada blanco que haya sufrido alguna miniatura abatida en este turno, puedes devolver D3 miniaturas abatidas a la unidad **Zombis muertos andantes** de este Regimiento de Renombre.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Hueste Rúnica de Norgrimm" id="3ba7-9116-5c72-d24" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
