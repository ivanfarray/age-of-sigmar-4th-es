    <selectionEntry name="Regimiento de Renombre: Las Pústulas" id="0982-9af2-7c15-402d" defaultAmount="0" hidden="true" import="true" publicationId="9c71-86cb-e1d0-ec8d" type="upgrade">
      <categoryLinks>
