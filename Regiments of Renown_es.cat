  <sharedSelectionEntries>
    <selectionEntry name="Regimiento de Renombre: La Mano del Liche" id="d63f-7194-a3af-7a00" defaultAmount="0" hidden="true" import="true" publicationId="27d9-b0c5-1ecc-ba2f" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="be73-c15d-207c-2246" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="3287-c571-e12d-ef2" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="9136-a422-571c-c77c" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Astillamiento esquelético" id="473c-ac82-5506-6548" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">8</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">El mismo **^^Wizard^^** puede lanzar este hechizo más de una vez por fase. Elige al **Arkhan the Black** de este Regimiento de Renombre para lanzar este hechizo, elige una unidad enemiga visible a 18" o menos de él que no haya sido elegida como blanco de este hechizo en este turno como blanco y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Tira tantos dados como miniaturas tenga la unidad blanco. Por cada 5+, inflige 1 daño mortal a esa unidad.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Sacramentos impíos" id="e4dc-f3d4-388-7fb8" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
