          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Odio hacia todos" id="edf7-7af8-5f57-88f2" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Cualquier fase de combate</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Debes usar esta habilidad si esta unidad no está en combate y hay otras unidades amigas visibles dentro de su alcance de combate. Debes elegir 1 de esas unidades amigas como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Resuelve los ataques de combate de esta unidad contra el blanco.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Arca de Resurrecciones" id="fdc3-9b98-d03c-abfe" defaultAmount="0" hidden="true" import="true" publicationId="67f7-aa7f-294f-880d" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="5c71-d5bc-44a8-2bbf" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
