          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Si no tienen ya uno por otro motivo, los elementos de terreno tienen un **marcador de maleza** amigo mientras estén disputados por una unidad **Renacidos rencorosos** de este Regimiento de Renombre.</characteristic>
          </characteristics>
        </profile>
        <profile name="Oculto en las sombras" id="be47-4339-b923-a590" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Yellow</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras estén totalmente a 3" o menos de un elemento de terreno, las unidades **Renacidos rencorosos** de este Regimiento de Renombre no son visibles para unidades enemigas a más de 12" de ellas.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
