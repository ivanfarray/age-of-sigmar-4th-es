      </modifiers>
      <profiles>
        <profile name="¡Atrapadloz!" id="c10c-a243-fe38-89d5" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por fase (ejército), fase de héroe enemiga.</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad enemiga en combate con el **Skumdrekk, Jefe del Pantano** de este Regimiento de Renombre como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Si el resultado es al menos el doble de la característica de Salud del objetivo, 1 miniatura de la unidad objetivo queda abatida.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="¡Soltad laz bombaz, muchachoz!" id="db2e-7b63-7d38-1a76" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Las unidades amigas de este Regimiento de Renombre pueden usar habilidades **^^Correr^^** y seguir usando habilidades **^^Disparar^^** más adelante en el turno mientras estén totalmente a 12" o menos del **Skumdrekk, Jefe del Pantano** de este Regimiento de Renombre.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Loz Robabrilloz" id="b373-c42b-e807-e48d" defaultAmount="0" hidden="true" import="true" publicationId="a395-7bc4-71eb-46df" type="upgrade">
