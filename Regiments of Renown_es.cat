          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Resta 1 a las tiradas de impacto de los ataques que tengan como blanco a unidades de este Regimiento de Renombre mientras estén totalmente a 9" o menos del **Heraldo de la descomposición** de este Regimiento de Renombre.</characteristic>
          </characteristics>
        </profile>
        <profile name="Convalecencia nauseabunda" id="ad95-2ba0-078c-db3d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5"/>
