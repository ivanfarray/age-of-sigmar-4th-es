      <profiles>
        <profile name="Máscara del Embaucador" id="815f-4e14-5629-915e" hidden="false" typeId="ff03-376e-972f-8ab2" typeName="Unit">
          <characteristics>
            <characteristic name="Move" typeId="fed0-d1b3-1bb8-c501">5&quot;</characteristic>
