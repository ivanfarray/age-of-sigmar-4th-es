      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: La Batería de Acero Maldito" id="2684-cf24-87e3-50bf" defaultAmount="0" hidden="true" import="true" publicationId="487d-9798-0633-8040" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="0594-f280-e71d-0700" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="1643-6f5b-0f64-a5d0" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="1d6a-1d48-9173-d651" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Demostración de poder absoluto" id="d3eb-0e03-dd20-2373" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Blue</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Shooting</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Una vez por turno (ejército), tu fase de disparo</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Si ninguna de las dos unidades **^^War Machine^^** de este Regimiento de Renombre ha usado alguna habilidad **^^shoot^^** en este turno, elige una unidad enemiga como blanco.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Durante el resto del turno:
• Mientras esa unidad enemiga esté en el campo de batalla, las unidades **^^War Machine^^** de este **^^Regimiento of Renombre^^** solo pueden elegir a esa unidad enemiga como blanco de sus ataques de disparo.
• Cada una de esas unidades **^^War Machine^^** cuenta como si tuviera 3 **puntos de poder demoníaco**.
La primera vez que uses esta habilidad, puedes usarla sin gastar puntos de orden.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Reforzar el acero demoníaco" id="0d69-1925-fcb2-f1ec" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige al **Herrero demoníaco** de este Regimiento de Renombre para lanzar este hechizo y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu siguiente turno, ignora el primer punto de daño asignado en cada fase a cada unidad **^^Herreros Infernales de Hashut^^** amiga mientras esté totalmente a 12" o menos del lanzador.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Buscador de la Elegía del Terror" id="cf84-3994-808d-1928" defaultAmount="0" hidden="true" import="true" publicationId="487d-9798-0633-8040" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="ca81-fdd5-1cad-14cd" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="bacb-fedf-ca2b-b499" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="3ebb-d680-3249-76ed" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Elegía de desolación" id="5853-2f6c-d6d1-c5a3" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
          <attributes>
            <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
            <attribute name="Type" typeId="c63c-196d-34a7-cec3">Offensive</attribute>
            <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
            <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">6</characteristic>
            <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige al **Anciano ceniciento** de este Regimiento de Renombre para entonar esta plegaria, elige un elemento de terreno del campo de batalla como blanco y, después, haz una tirada de cántico de D6.</characteristic>
            <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Tira un D3 por cada unidad enemiga que dispute el blanco. Con un 2+, inflige a esa unidad enemiga una cantidad de daño mortal igual a la tirada. Si la tirada de cántico ha sido de 10+, puedes elegir otro elemento de terreno como segundo blanco.</characteristic>
            <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d">**^^Plegaria^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Búsqueda absorbente" id="0651-424c-f99b-6cc8" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige al **Anciano ceniciento** de este Regimiento de Renombre para usar esta habilidad. Después, elige un objetivo o **Lugar de poder** que esté disputando y que no haya sido elegido como blanco de esta habilidad en esta batalla como blanco.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Tira 6 dados. Por cada 3+, otorga 1 punto de ritual a esta unidad.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
