      </modifiers>
      <profiles>
        <profile name="Pica del alma" id="12aa-3a8f-f201-1b23" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">7</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige a la **Neferata** de este Regimiento de Renombre para lanzar este hechizo, elige una unidad enemiga visible a 18" o menos de ella como blanco y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu próximo turno, cada vez que el blanco use una habilidad **^^Cargar^^**, inmediatamente después de resolver esa habilidad, tira tantos dados como la tirada de carga sin modificar de esa habilidad. Por cada 4+, inflige 1 daño mortal al blanco.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Ilimitada^^**</characteristic>
          </characteristics>
        </profile>
        <profile name="Muerte premeditada" id="786f-bfa7-56e0-d89b" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" id="e5c3-df70-c6fd-3c52" hidden="false" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), tu fase de héroe</characteristic>
            <characteristic name="Declare" id="2393-4888-f08b-4839" hidden="false" typeId="bad3-f9c5-ba46-18cb">Elige una unidad enemiga a 12" o menos de la **Neferata** de este Regimiento de Renombre como blanco.</characteristic>
            <characteristic name="Effect" id="248a-9d6f-9d20-3f41" hidden="false" typeId="b6f1-ba36-6cd-3b03">Hasta el inicio de tu próximo turno, no pueden hacerse tiradas de salvaguardia para los puntos de daño infligidos al blanco por ataques de unidades de este Regimiento de Renombre.</characteristic>
            <characteristic name="Keywords" id="7642-7129-873d-8e75" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="La voluntad de la Reina de Sangre" id="b117-92cb-72b0-da64" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Control</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" id="cfa-cb85-915c-4a3c" hidden="false" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" id="cdc7-c48a-279e-ad71" hidden="false" typeId="bad3-f9c5-ba46-18cb">Elige una unidad enemiga que esté disputando un objetivo que la **Neferata** de este Regimiento de Renombre esté disputando como blanco.</characteristic>
            <characteristic name="Effect" id="4a5c-c51f-4907-8e01" hidden="false" typeId="b6f1-ba36-6cd-3b03">Tira un dado. Con un 2-5, resta 10 a la puntuación de control del blanco durante el resto del turno. Con un 6, el blanco tiene una puntuación de control máxima de 1 durante el resto del turno.</characteristic>
            <characteristic name="Keywords" id="4c57-23b7-e9a1-8519" hidden="false" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
