          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Verdugos del Trono Cobarde" id="db2d-db0f-2a08-3810" defaultAmount="0" hidden="true" import="true" publicationId="67f7-aa7f-294f-880d" type="upgrade">
