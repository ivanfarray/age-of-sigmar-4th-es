        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="9d39-ae0e-afc9-f982" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
