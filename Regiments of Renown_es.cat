      </modifiers>
      <profiles>
        <profile name="Acobardamiento táktiko" id="e142-67d6-cd34-f770" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras el **Jefe lunático** de este Regimiento de Renombre esté dentro del alcance de combate del **Troggoth de la gruta húmeda** de este Regimiento de Renombre:
• Ese **Jefe lunático** tiene **^^Ward (4+)^^**.
• Cada vez que hagas una tirada de salvaguardia exitosa para ese **Jefe lunático**, asigna 1 punto de daño a ese **Troggoth de la gruta húmeda** después de resolver la secuencia de daño de ese **Jefe lunático** (no pueden hacerse tiradas de salvaguardia para esos puntos de daño).</characteristic>
          </characteristics>
        </profile>
        <profile name="¡Id por ahí!" id="d4a3-193b-55c8-1aa4" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Orange</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de carga</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige al **Troggoth de la gruta húmeda** de este Regimiento de Renombre como blanco si está a 12" o menos del **Jefe lunático** de este Regimiento de Renombre.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto del turno, el blanco puede seguir usando habilidades **^^Cargar^^** incluso si ha usado una habilidad **^^Retirarse^^** en el mismo turno.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
