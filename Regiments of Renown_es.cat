                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Reacción: El oponente ha declarado la orden &apos;Reagrupamiento&apos; para una unidad a 12" o menos de una unidad de este Regimiento de Ghyran y visible para ella.</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Después de resolver esa habilidad, esa unidad amiga puede usar inmediatamente la orden &apos;Reagrupamiento&apos;. No se gastan puntos de orden para usar esa orden.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
