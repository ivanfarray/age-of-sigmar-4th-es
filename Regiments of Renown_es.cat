      <profiles>
        <profile name="Lugar de la matanza" id="1b4e-5fdb-bd34-6084" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige un objetivo totalmente fuera del territorio amigo. Consideras que ese objetivo es el **anfiteatro**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Golpes finales" id="a12b-170d-c784-7f81" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras todas las miniaturas de una unidad de este Regimiento de Renombre estén disputando el anfiteatro:
• Las armas de combate de esa unidad tienen **Crítico (mortal)**.
• Si controlas el anfiteatro, si la tirada de impacto o para herir sin modificar de un ataque que tenga como blanco a esa unidad es de 1-4, el ataque falla y la secuencia de ataque termina.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
