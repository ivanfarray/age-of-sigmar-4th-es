        <constraint id="5dd9-7ce2-357a-0000" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="fd9c-4b58-82d1-d251" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Violencia frenética" id="723b-b218-6d41-5ca4" hidden="false" typeId="5946-234-d7b4-6195" typeName="Ability (Prayer)">
          <attributes>
            <attribute name="Color" typeId="7564-4bf0-b34a-b143">Yellow</attribute>
            <attribute name="Type" typeId="c63c-196d-34a7-cec3">Defensive</attribute>
            <attribute name="Parent Node" typeId="5d25-63d6-3935-9312"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="76bf-8126-64d4-c709">Tu fase de héroe</characteristic>
            <characteristic name="Chanting Value" typeId="f192-6780-8138-9cef">4</characteristic>
            <characteristic name="Declare" typeId="284c-90b2-245b-adf3">Elige al **Sacerdote de la matanza** de este Regimiento de Renombre para entonar esta plegaria, elige una unidad visible de este Regimiento de Renombre totalmente a 12" o menos de él como blanco y, después, haz una tirada de cántico de D6.</characteristic>
            <characteristic name="Effect" typeId="6219-6fcc-5ae2-a6b7">Hasta el inicio de tu próximo turno, la unidad blanco tiene **^^Ward (5+)^^** mientras todas las miniaturas de esa unidad estén totalmente dentro del alcance de combate de una unidad enemiga. Si la tirada de cántico ha sido de 10+, puedes elegir otra unidad válida como segundo blanco.</characteristic>
            <characteristic name="Keywords" typeId="e3d8-f58b-e4e0-8e9d"/>
          </characteristics>
        </profile>
        <profile name="Vislumbrar al dios" id="1e6d-b2e8-693d-6fe5" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Purple</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), final de cualquier turno</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige todas las unidades de este Regimiento de Renombre que hayan usado una habilidad **^^Combatir^^** en este turno como blancos.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si los ataques de combate del blanco han asignado algún punto de daño a una unidad enemiga en este turno, esa unidad enemiga ha sido destruida en este turno y no se ha asignado ningún punto de daño a esa unidad enemiga en este turno mediante ataques de combate de una unidad amiga que no forme parte de este Regimiento de Renombre, durante el resto de la batalla, suma 2 al atributo Attacks de las armas **Blood-hungry** del blanco.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: El Exiliado" id="b8df-953c-bb7d-7f40" defaultAmount="0" hidden="true" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
