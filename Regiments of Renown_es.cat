      <profiles>
        <profile name="Vomitar pecado" id="8706-ddad-8c2c-bd0e" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031"/>
            <attribute name="Type" typeId="da27-8d61-f955-5031">Special</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">6</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Elige al **Epítome contorsionado** de este Regimiento de Renombre para lanzar este hechizo y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Elige una **^^Hedonistas de Slaanesh Manifestation^^** amiga que no esté en el campo de batalla y que no haya sido retirada del juego anteriormente en el mismo turno.

Si has elegido un **Semblante aterrador** o **Ruedas del tormento**, colócalo totalmente a 12" o menos del lanzador, visible para él y a más de 9" de todas las unidades enemigas. Si has elegido un **Espejo hipnótico**, colócalo totalmente a 12" o menos del lanzador y visible para él.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**, **^^Invocación^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Juerguistas Envueltos en Niebla" id="e460-16bd-e80a-e749" defaultAmount="0" hidden="true" import="true" publicationId="95fc-e96f-a916-bba1" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="d772-50c2-8df5-dc7d" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
