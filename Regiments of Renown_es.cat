      </modifiers>
      <profiles>
        <profile name="A la sombra del Mar Etérico" id="3ff3-dcca-b18f-e2ed" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Debe usarse esta habilidad para desplegar este Regimiento de Renombre en lugar de la habilidad &apos;Desplegar unidad&apos; o &apos;Desplegar regimiento&apos;.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca las unidades de este Regimiento de Renombre en reserva **en el mar etérico**. Ahora se consideran desplegadas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Cacería de la manada sanguinaria" id="71ff-7dd2-47f4-19a3" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige todas las unidades de este Regimiento de Renombre que estén **en el mar etérico**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca cada unidad en el campo de batalla totalmente a 7" o menos de un borde del campo de batalla, a más de 9" de todas las unidades enemigas y dentro del alcance de combate de otra unidad de este Regimiento de Renombre. Después, cada unidad puede moverse inmediatamente D3". Las unidades no pueden entrar en combate en ningún momento de ese movimiento.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Manada Sanguinaria" id="8500-684f-a524-938e" defaultAmount="0" hidden="true" import="true" publicationId="9866-239b-07f0-d92b" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="3ec4-f493-7092-05a6" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="ea2e-3d6e-c643-3550" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="0bd1-a3d9-9fa6-87a1" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Cacería de la manada sanguinaria" id="9714-6f4d-c579-dd4e" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Si ambas unidades de este Regimiento de Renombre están dentro del alcance de combate de la otra, elige 1 de los siguientes efectos para aplicarlo hasta el inicio de tu próximo turno:
***Aproximación evasiva:*** Mientras ambas unidades de este Regimiento de Renombre estén dentro del alcance de combate de la otra, resta 1 a las tiradas de impacto de los ataques que las tengan como blanco.
***Ataque feroz:*** Mientras ambas unidades de este Regimiento de Renombre estén dentro del alcance de combate de la otra, sus **Allopex&apos;s Ferocious Bites** tienen **Crítico (2 impactos)**.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Especuladores del Puerto Celeste" id="a943-789a-6314-e52a" defaultAmount="0" hidden="true" import="true" publicationId="d4a9-b568-9525-d6ac" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="365b-321e-2077-1ef7" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="1759-f0d7-3592-7300" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="5b4a-c0d3-7f5f-3794" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Los suministros no son baratos" id="eac9-8538-12b8-cd3d" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Yellow</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Special</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de héroe</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige un elemento de terreno visible a 18" o menos del **Escriba del Código** de este Regimiento de Renombre. Cada unidad amiga totalmente a 3" o menos de ese elemento de terreno es un blanco.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Tira un D3 por cada blanco. Con un 2+, aplica **Curar (X)** al blanco, donde **X** es una cantidad igual a la tirada.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Nadie viaja gratis" id="11d8-845f-681f-c892" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Grey</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Movement</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de movimiento</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige una unidad **^^Infantry^^** amiga con hasta 10 miniaturas, totalmente a 9" o menos del **Escriba del Código** de este Regimiento de Renombre y que no esté en combate, como blanco.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Retira el objetivo del campo de batalla y, después, vuelve a colocarlo en el campo de batalla a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
        <profile name="Apoyo a larga distancia" id="561d-0b91-0584-15a0" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Blue</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Shooting</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Tu fase de disparo</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Elige un objetivo a 15" o menos del **Escriba del Código** de este Regimiento de Renombre que no esté siendo disputado por ninguna unidad amiga. Cada unidad que dispute ese objetivo es un blanco.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">Tira un dado por cada blanco. Si la tirada supera el atributo Salud del blanco, inflige al blanco una cantidad de daño mortal igual a la tirada.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: Corsarios de Drekki" id="3352-9420-e4d4-6cc7" defaultAmount="0" hidden="true" import="true" publicationId="d4a9-b568-9525-d6ac" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="10fe-e148-e749-5b57" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <constraints>
        <constraint id="3a8d-5c0c-94a7-dd20" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="accf-873b-ebe8-1d1c" field="selections" includeChildForces="true" includeChildSelections="true" scope="force" shared="true" type="instanceOf" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Navegar hasta la posición" id="4ee5-31aa-e217-5c3d" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige todas las unidades de este Regimiento de Renombre que no se hayan desplegado.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca todas esas unidades en reserva **surcando los vientos**. Ahora se consideran desplegadas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Despliegue temerario" id="52d6-bfa9-b256-74fa" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Grey</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige la **Fragata arkanauta** de este Regimiento de Renombre para usar esta habilidad si está **surcando los vientos**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca la **Fragata arkanauta** en cualquier lugar del campo de batalla a más de 9" de todas las unidades enemigas. Después, coloca todas las demás unidades de este Regimiento de Renombre totalmente a 6" o menos de la **Fragata arkanauta** y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Tú lo llamas tuyo; yo lo llamo mío" id="c949-5cf3-8d50-77a4" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Blue</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Shooting</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Suma 1 a las tiradas de impacto y para herir de los ataques de disparo de las unidades de este Regimiento de Renombre que tengan como blanco a una unidad enemiga a 6" o menos de una unidad enemiga que tenga una mejora.</characteristic>
          </characteristics>
        </profile>
        <profile name="El buen navío Aelsling" id="4b45-554a-5420-f049" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Green</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Defensive</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">El **^^Aelsling^^** tiene un atributo Salud de 17 en lugar de 14.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: La Revelación Roja" id="7d32-c8fe-5e9f-09a5" defaultAmount="0" hidden="true" import="true" publicationId="81a9-3dbf-dbc5-672e" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="5e29-c28a-7dbe-6783" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
