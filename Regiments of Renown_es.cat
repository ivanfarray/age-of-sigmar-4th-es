      <profiles>
        <profile name="Reforzar el pavés" id="d924-5987-224d-7b61" hidden="false" typeId="7312-8367-c171-f2ef" typeName="Ability (Spell)">
          <attributes>
            <attribute name="Color" typeId="16b6-0911-f549-a4bd">Yellow</attribute>
            <attribute name="Parent Node" typeId="da27-8d61-f955-5031">Defensive</attribute>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="de6f-d57b-248a-83be">Tu fase de héroe</characteristic>
            <characteristic name="Casting Value" typeId="9fc7-b0f6-d018-a608">5</characteristic>
            <characteristic name="Declare" typeId="24f8-3803-4ab1-3b6c">Si el **Reptador mortek** de este Regimiento de Renombre está totalmente a 12" o menos del **Osifector mortisano** amigo de este Regimiento de Renombre y es visible para él, elige a ese **Osifector mortisano** para lanzar este hechizo, elige a ese **Reptador mortek** como blanco y, después, haz una tirada de lanzamiento de 2D6.</characteristic>
            <characteristic name="Effect" typeId="1cb9-a-1345-907f">Hasta el inicio de tu próximo turno, el blanco tiene **^^Ward (5+)^^**.</characteristic>
            <characteristic name="Keywords" typeId="353f-565e-c351-1cf2">**^^Hechizo^^**</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Regimiento de Renombre: La Rama Retorcida" id="6c2e-331c-67a9-4143" defaultAmount="0" hidden="true" import="true" publicationId="61ee-fae0-f1da-2591" type="upgrade">
