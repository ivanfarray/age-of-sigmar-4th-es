  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Las Espadas del Caos" id="558c-1f27-9f35-4213" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="2cc3-2da-77a8-7b20" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Exigencias de los Dioses Oscuros" id="ec34-a892-caf7-cdcf" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno (ejército), inicio de la ronda de batalla</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Elige 1 de los siguientes efectos:
***Exigencia de Khorne:*** Durante el resto de la ronda de batalla, suma 1 a la característica de Rend de las armas de cuerpo a cuerpo usadas por unidades amigas **^^Swords of Chaos^^**.
***Exigencia de Tzeentch:*** Elige 1 unidad enemiga visible a 9" o menos de una unidad amiga **^^Swords of Chaos^^** que no esté en combate y tira un D6. Con un 3+, inflige a esa unidad enemiga una cantidad de daño mortal igual al resultado.
***Exigencia de Nurgle:*** **Heal (D3)** cada unidad amiga **^^Swords of Chaos^^**. Después, elige una unidad amiga **^^Swords of Chaos^^** que haya curado algún punto de daño este turno. Hasta el inicio de la siguiente ronda de batalla, esa unidad tiene **^^Ward (6+)^^**.
***Exigencia de Slaanesh:*** Suma 2" a la característica de Move de las unidades amigas **^^Swords of Chaos^^** hasta el inicio de la siguiente ronda de batalla</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Caballeros del Primer Círculo" id="bc74-534b-123a-aed7" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si hay más unidades amigas **^^Swords of Chaos^^** en el campo de batalla que unidades colocadas en reserva, elige una unidad amiga **^^Swords of Chaos^^** que no haya sido desplegada.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esa unidad en reserva **in the Ruinous Skies**. Ahora se considera desplegada.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Despliegue^^**</characteristic>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Descenso desde cielos ruinosos" id="fc5c-fcd2-bf78-1509" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige una unidad amiga **^^Swords of Chaos^^** que esté **in the Ruinous Skies**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca esa unidad en cualquier lugar del campo de batalla a más de 9" de todas las unidades enemigas</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
