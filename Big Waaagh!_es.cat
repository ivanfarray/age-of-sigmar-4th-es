                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Un auténtico escurridizo" id="d950-517f-83d4-7a23" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dc52-436f-dd2d-676b" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Un auténtico escurridizo" id="272c-a1b0-9221-6652" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
                    <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Defensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Puedes usar esta habilidad si esta unidad tiene la palabra clave **^^Power of the Waaagh!^^** y ninguna unidad amiga ha usado una habilidad **^^Brutal Kunnin&apos;^^** este turno.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la ronda de batalla, las unidades amigas **^^Big Waaagh!^^** tienen **^^Ward (5+)^^** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Astucia brutal^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="El viejo uno-dos" id="f1ea-0d6a-658a-e291" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7fd7-def3-a1f8-be5c" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="El viejo uno-dos" id="7657-daa4-7abb-5d94" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
                  <attributes>
