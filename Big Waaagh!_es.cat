                    <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
                    <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
                  </attributes>
                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, tu fase de héroe</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Puedes usar esta habilidad si esta unidad tiene la palabra clave **^^Power of the Waaagh!^^** y ninguna unidad amiga ha usado una habilidad **^^Brutal Kunnin&apos;^^** este turno.</characteristic>
                    <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Durante el resto de la ronda de batalla, las armas de combate cuerpo a cuerpo de las unidades amigas **^^Big Waaagh!^^** tienen **Crítico (2 impactos)** mientras estén totalmente a 12" o menos de esta unidad.</characteristic>
                    <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f">**^^Astucia brutal^^**</characteristic>
                    <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="¡A machacar!" id="5882-3f1f-5e5b-0e26" hidden="false" import="true" type="upgrade">
              <constraints>
