  <sharedSelectionEntries>
    <selectionEntry name="Rasgos de batalla: Gran Waaagh!" id="5f83-4fe9-9e63-f951" hidden="false" import="true" publicationId="8b1b-f2c7-890e-2bbe" type="upgrade">
      <categoryLinks>
        <categoryLink name="Reference" id="a836-6d9c-af8d-da50" hidden="false" primary="true" targetId="3360-1158-e879-9606"/>
      </categoryLinks>
      <profiles>
        <profile name="Poseídos por el poder del Waaagh!" id="5a8c-9c52-91d3-5854" hidden="false" typeId="907f-a48-6a04-f788" typeName="Ability (Passive)">
          <attributes>
            <attribute name="Color" typeId="50fe-4f29-6bc3-dcc6">Black</attribute>
            <attribute name="Type" typeId="bf11-4e10-3ab1-06f4">Special</attribute>
            <attribute name="Parent Node" typeId="e2e1-15ca-d345-22b8"/>
          </attributes>
          <characteristics>
            <characteristic name="Keywords" typeId="b977-7c5e-33b2-428e"/>
            <characteristic name="Effect" typeId="fd7f-888d-3257-a12b">Mientras una unidad amiga tenga la palabra clave **^^Power of the Waaagh!^^**:
• Si esa unidad tiene la palabra clave **^^Mandíbulas de Hierro^^**, suma 1 a las tiradas de correr y de carga de esa unidad.
• Si esa unidad tiene la palabra clave **^^Chikoz Crueles^^**, los ataques de esa unidad logran impactos críticos con tiradas de impacto sin modificar de 5+.</characteristic>
          </characteristics>
        </profile>
        <profile name="Reagrupar a los clanes de guerra" id="8d81-3f4f-614c-7e91" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Gray</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Rallying</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, tu fase de movimiento</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Si tu general está en el campo de batalla, elige como objetivo una unidad amiga **^^Big Waaagh!^^** que empezara la batalla con 3 o más miniaturas y que haya sido destruida.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Coloca una unidad de reemplazo con la mitad de miniaturas de la unidad objetivo (redondeando hacia arriba) totalmente a 12" o menos de tu general y a más de 9" de todas las unidades enemigas.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Jefes de renombre" id="322f-2ae7-dd4d-71da" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Black</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla, fase de despliegue</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 1 **^^Hero^^** amiga **^^Big Waaagh! Mandíbulas de Hierro^^** que no sea **^^Unique^^** y hasta 1 **^^Hero^^** amiga **^^Big Waaagh! Chikoz Crueles^^** que no sea **^^Unique^^**, siempre que no tengan un rasgo heroico.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Da a cada objetivo 1 rasgo heroico de los rasgos heroicos de Big Waaagh!.
**Nota del diseñador:** *Estos rasgos heroicos se entregan a los objetivos durante la fase de despliegue, no durante la composición del ejército.*</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="El poder del Waaagh!" id="becb-75ef-4ad4-c808" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Yellow</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Special</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por turno, tu fase de héroe</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">Elige como objetivos hasta 1 unidad amiga **^^Big Waaagh! Mandíbulas de Hierro^^** y hasta 1 unidad amiga **^^Big Waaagh! Chikoz Crueles^^**.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Los objetivos tienen la palabra clave **^^Power of the Waaagh!^^** durante el resto de la ronda de batalla.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
