                  <characteristics>
                    <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Una vez por batalla (ejército), Reacción: Has declarado la habilidad &apos;Ira de Brodd&apos; para una unidad amiga</characteristic>
                    <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
